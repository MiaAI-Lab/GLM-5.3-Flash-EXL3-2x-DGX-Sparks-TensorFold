+        self.fn, self.held = on_tokens, None
+
+    def __call__(self, tokens) -> None:
+        if self.fn is not None:
+            self.flush()
+            self.held = list(tokens)
+
+    def flush(self) -> None:
+        if self.held is not None:
+            held, self.held = self.held, None
+            self.fn(held)
+
