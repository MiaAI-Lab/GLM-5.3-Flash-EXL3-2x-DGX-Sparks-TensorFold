+    """The fewest rows of a sharded pool whose parts each hold one stream's window (``capacity`` tokens)."""
+
+    align = world * 2048
+    return world * (-(-capacity // align) * align)
+
+
+def sizes(pool_rows: int, dsa: int, kv: str, capacity: int, world: int = 2) -> int:
+    """``budget``, at least ``floor`` (the rows past the memory then are the caller's to account for: ``plan`` is the
+    start-up's, which shrinks the window to a part instead)."""
+
+    return max(budget(pool_rows, dsa, kv, world), floor(capacity, world))
