+from __future__ import annotations
+
+import os
+from types import SimpleNamespace
+
+import torch
+import triton
+import triton.language as tl
+
+from tensorfold.cuda.comm import _DTYPES
+
+ON = os.environ.get("TF_GLM_KV_SHARD", "0") == "1"
+TRASH = 2048                      # latent rows past a half: a non-owner's writes of a decode window's rows
+SEND_MIB = 64                     # the owner's send buffer: fetched rows go in pieces of this many MiB
+
+RANK = 0
+WORLD = 2
+HALF = 0                          # pool rows a part, one a rank: a half at two ranks (latent rows a rank: HALF + TRASH)
