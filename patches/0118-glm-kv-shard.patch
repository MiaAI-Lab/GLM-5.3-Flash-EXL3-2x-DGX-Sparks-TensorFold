+        raise ValueError(f"TF_GLM_KV_SHARD=1: the memory of a {pool_rows}-token pool holds {rows} sharded tokens "
+                         f"({part} a part at {world} ranks), too little for the requested {limit}-token window "
+                         f"(a part must hold at least {max(MIN_PART, int(limit) // 4)}): lower --context, or free "
