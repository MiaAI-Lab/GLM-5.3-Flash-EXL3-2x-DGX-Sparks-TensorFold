+def setup(rank: int, world: int, pool_rows: int, heads=None) -> None:
+    """Every rank, once the pool is sized: ``pool_rows`` (every part) over ``world`` ranks; ``heads``: each rank's
+    attention heads (None: an even split)."""
+
