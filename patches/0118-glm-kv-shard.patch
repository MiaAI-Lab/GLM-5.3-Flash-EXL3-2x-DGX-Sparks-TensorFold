+    align = world * 2048
+    lat, pk = kv8.row_bytes(512, kv), kv8.row_bytes(128, kv) / 4
+    mem = pool_rows * dsa * (lat + pk)
+    return max(0, int((mem - TRASH * dsa * lat) // (dsa * (lat / world + pk))) // align * align)
