+def _keepalive_seconds() -> float:
+    """``TENSORFOLD_SSE_KEEPALIVE_S`` (default 15): the longest a streamed reply stays silent before a keep-alive
+    comment; 0 turns keep-alives off."""
+
+    raw = os.environ.get("TENSORFOLD_SSE_KEEPALIVE_S", "15")
+    try:
+        seconds = float(raw)
+    except ValueError:
+        seconds = math.nan
+    if not math.isfinite(seconds) or seconds < 0:
+        raise ValueError(f"TENSORFOLD_SSE_KEEPALIVE_S={raw!r}: seconds of silence before a keep-alive, 0 for none")
+    return seconds
+
+
+_SSE_KEEPALIVE_S = _keepalive_seconds()
+
+
+class _Keepalive:
+    """A streamed reply's writes, plus an SSE comment line (``: keepalive``) whenever nothing has been written for
+    ``seconds`` while ``with`` holds it (patch 0112). A request that waits for a lane or fills a long prompt sends
+    nothing else, and a proxy in front drops a stream that stays silent (Cloudflare: after about two minutes); SSE
+    clients skip comment lines. Every write holds one lock, since the comments come from their own thread, and
+    leaving ``with`` ends that thread before it returns, so no comment follows the reply's last event."""
+
+    COMMENT = b": keepalive\n\n"
+
+    def __init__(self, wfile: Any, seconds: float) -> None:
+        self.wfile, self.seconds = wfile, seconds
+        self.lock = threading.Lock()
+        self.last = time.monotonic()
+        self.stop = threading.Event()
+        self.thread: threading.Thread | None = None
+
+    def write(self, data: bytes) -> None:
+        with self.lock:
+            self.wfile.write(data)
+            self.wfile.flush()
+            self.last = time.monotonic()
+
+    def __enter__(self) -> None:
+        if self.seconds > 0:
+            self.thread = threading.Thread(target=self._beat, name="sse-keepalive", daemon=True)
+            self.thread.start()
+
+    def __exit__(self, *exc: Any) -> None:
+        self.stop.set()
+        if self.thread is not None:          # a comment being written goes out first, before the reply's last event
+            self.thread.join()
+
+    def _beat(self) -> None:
+        while not self.stop.wait(max(0.0, self.last + self.seconds - time.monotonic())):
+            with self.lock:
+                if time.monotonic() - self.last < self.seconds:      # an event went out meanwhile
+                    continue
+                try:
+                    self.wfile.write(self.COMMENT)
+                    self.wfile.flush()
+                except OSError:                   # the client has gone
+                    return
+                self.last = time.monotonic()
+
+
