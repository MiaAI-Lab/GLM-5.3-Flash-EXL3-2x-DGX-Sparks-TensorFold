+@triton.jit
+def _digit(hist, need, prefix, fixed, p: tl.constexpr):
+    """_select_rows' step from a pass's histogram: the digit of the K-th best, the count still needed below it, the
+    prefix and mask with it."""
+    bins = tl.arange(0, 256)
+    at_or_above = tl.sum(hist, 0) - tl.cumsum(hist, 0) + hist           # values with this digit or a higher one
+    digit = tl.max(tl.where(at_or_above >= need, bins, 0), 0)
+    need -= tl.sum(tl.where(bins > digit, hist, 0), 0)
+    prefix = prefix | (digit.to(tl.uint32) << (24 - 8 * p))
+    fixed = fixed | (tl.full((), 0xFF, tl.uint32) << (24 - 8 * p))
+    return digit, need, prefix, fixed
