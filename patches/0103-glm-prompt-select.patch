+@triton.jit
+def _digit_hist(row, NP, prefix, fixed, p: tl.constexpr, BLOCK: tl.constexpr, KEYS: tl.constexpr):
+    """The histogram of byte 3 - p of the order keys matching ``prefix`` on ``fixed`` among NP values at ``row``:
+    fp32 scores (their ``_order_key``), or with KEYS order keys already (int32 bits)."""
+    hist = tl.zeros((256,), dtype=tl.int32)
+    for c in range(0, NP, BLOCK):
+        i = c + tl.arange(0, BLOCK)
+        ok = i < NP
+        if KEYS:
+            u = tl.load(row + i, mask=ok, other=0).to(tl.uint32, bitcast=True)
+        else:
+            u = _order_key(tl.load(row + i, mask=ok, other=0.0))
+        match = ok & ((u & fixed) == prefix)
+        hist += tl.histogram(((u >> (24 - 8 * p)) & 0xFF).to(tl.int32), 256, mask=match)
+    return hist
+
