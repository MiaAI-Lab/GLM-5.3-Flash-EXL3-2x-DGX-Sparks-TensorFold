# Idle trim (TF_GLM_IDLE_TRIM_S, off by default): a rank that has had no stream for that many seconds gives back the memory it
# only caches, once per idle spell: Python garbage (gc.collect), torch's unused cached CUDA blocks (empty_cache) and the C
# heap's free pages (malloc_trim). A long prompt's prefill scratch stays in torch's cache after its request ends, and on the
# Spark's one memory pool that is memory the OS, the other rank's NCCL buffers and the next start cannot use: field reports
# of MemAvailable that stays low after the agents disconnect, and of reserved CUDA memory ~25 GB above what is in use
# (issues #143, #168, #197). The KV pool, the kept prompts and the weights are not touched (empty_cache frees only blocks no
# tensor uses), so the next request prefills no more than it would have; it can pay the CUDA allocations the trim freed.
# Every rank runs its own timer (a daemon thread on the rank's ``idle`` flag): no new message between the ranks. Each trim
# logs "[tensorfold] rank N idle S s: trimmed X GiB of cached CUDA memory"; /health's idle_trim has the count and the bytes.
# Same replies: memory only.
diff --git tensorfold/families/glm5_next/cuda/multi.py tensorfold/families/glm5_next/cuda/multi.py
index 7b6016b..4f69fcb 100644
--- tensorfold/families/glm5_next/cuda/multi.py
+++ tensorfold/families/glm5_next/cuda/multi.py
@@ -98,6 +98,39 @@ def watchdog_exits(value: str | None = None) -> bool:
     return raw == "1"
 
 
+def idle_trim_seconds(value: str | None = None) -> float:
+    """TF_GLM_IDLE_TRIM_S: seconds a rank may sit idle (no stream, none queued) before it gives the memory it only
+    caches back to the system (torch's cached blocks, Python garbage, the C heap's free pages); 0 (default): never."""
+
+    value = os.environ.get("TF_GLM_IDLE_TRIM_S", "") if value is None else value
+    try:
+        s = 0.0 if value.strip() == "" else float(value)
+    except ValueError:
+        s = -1.0
+    if s < 0:
+        raise ValueError(f"TF_GLM_IDLE_TRIM_S: seconds (0: off), not {value!r}")
+    return s
+
+
+def trim_memory() -> tuple[int, int]:
+    """Return what this process only caches to the system: Python garbage, torch's unused cached CUDA blocks and the C
+    heap's free pages. Returns (bytes torch had reserved, bytes it reserves now). Nothing a stream or a kept prompt
+    holds is touched: ``empty_cache`` frees only blocks no tensor uses."""
+
+    import gc
+
+    before = torch.cuda.memory_reserved()
+    gc.collect()
+    torch.cuda.empty_cache()
+    try:
+        import ctypes
+
+        ctypes.CDLL("libc.so.6").malloc_trim(0)
+    except (OSError, AttributeError):
+        pass
+    return before, torch.cuda.memory_reserved()
+
+
 def _watch(seconds: float, what: str) -> None:
