+    def _set_idle(self, value: bool) -> bool:
+        """Protocol idle transition, atomic with this rank's trim. Return the old state."""
+        with self.idle_lock:
+            old = self.idle
+            if old != value:
+                self.idle_epoch += 1
+            self.idle = value
+            return old
+
+    def _trim_work(self, busy: bool) -> None:
+        """Cover pre-message admission/vision and post-IDLE spill work too.
+
+        Only the scheduler/follow thread changes this flag. Release the local lock
+        BEFORE CUDA work, doorbells, queue waits or collectives; trim never uses transport.
+        """
+        with self.idle_lock:
+            if busy != self.trim_busy:
+                self.idle_epoch += 1
+            self.trim_busy = busy
+
+    def _trim_idle(self) -> None:
+        """All ranks: one local trim per uninterrupted, work-free idle epoch."""
+        import sys
+
+        torch.cuda.set_device(self.device_index)
+        since = None
+        epoch = None
+        done = False
+        poll = min(5.0, max(0.5, self.idle_trim_s / 4))
+        while not self.trim_stop.wait(poll):
+            with self.idle_lock:
+                eligible = self.idle and not self.trim_busy
+                observed = self.idle_epoch
+            if not eligible:
+                since, done, epoch = None, False, None
+                continue
+            # The clock is deliberately outside the critical section. Revalidate the
+            # epoch under the SAME lock used by EVERY busy/idle transition before trim.
+            now = time.monotonic()
+            with self.idle_lock:
+                if not self.idle or self.trim_busy or observed != self.idle_epoch:
+                    since, done, epoch = None, False, None
+                    continue
+                if epoch != observed:
+                    since, done, epoch = now, False, observed
+                if done or now - since < self.idle_trim_s:
+                    continue
+                done = True
+                try:
+                    before, after = trim_memory()
+                except Exception as exc:  # failed attempt is once per spell; context releases lock
+                    print(f"[tensorfold] rank {self.rank} idle trim failed: {exc!r}", file=sys.stderr, flush=True)
+                    continue
+                self.trims += 1
+                self.trimmed_bytes += max(0, before - after)
+                print(f"[tensorfold] rank {self.rank} idle {self.idle_trim_s:g} s: trimmed "
+                      f"{(before - after) / 2**30:.2f} GiB of cached CUDA memory ({before / 2**30:.2f} -> "
+                      f"{after / 2**30:.2f} GiB reserved)", file=sys.stderr, flush=True)
+
