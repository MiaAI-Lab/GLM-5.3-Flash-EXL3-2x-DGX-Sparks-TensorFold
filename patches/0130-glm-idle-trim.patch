+        self.idle_trim_s = idle_trim_seconds()           # TF_GLM_IDLE_TRIM_S, read now: a typo fails at start
+        self.trims = 0                                   # idle spells that ended in a trim, and what they gave back
+        self.trimmed_bytes = 0
+        self.trim_stop = threading.Event()
+        if self.idle_trim_s > 0 and torch.cuda.is_available():
+            self.device_index = torch.cuda.current_device()
+            threading.Thread(target=self._trim_idle, name="idle-trim", daemon=True).start()
         self.exit_on_broken = exit_on_broken()
         self.broken: Exception | None = None
         self.requeue: list[Stream] = []                  # rank 0: streams given back to the scheduler's queue
@@ -746,6 +786,39 @@ class MultiDecoder:
                 "carry": dict(self.carry, ms_total=round(self.carry["ms_total"], 1), ms_max=round(self.carry["ms_max"], 1),
                               refused=dict(self.carry["refused"]))}
 
+    def _trim_idle(self) -> None:
+        """Both ranks, a thread: once ``idle`` has held for TF_GLM_IDLE_TRIM_S, trim the memory this rank only caches
+        (``trim_memory``), once per idle spell. The prefill scratch of a long prompt stays in torch's cache after its
+        request ends; on the Spark's one memory pool that is memory nothing else can use. The pool, the kept prompts
+        and the weights are not touched, so the next request prefills no more than it would have."""
+
+        import sys
+
+        torch.cuda.set_device(self.device_index)
+        since: float | None = None
+        done = False
+        poll = min(5.0, max(0.5, self.idle_trim_s / 4))
+        while not self.trim_stop.wait(poll):
+            if not self.idle:
+                since, done = None, False
+                continue
+            now = time.monotonic()
+            if since is None:
+                since = now
+            if done or now - since < self.idle_trim_s:
+                continue
+            done = True
+            try:
+                before, after = trim_memory()
+            except Exception as exc:                  # noqa: BLE001  (a trim that fails is skipped, never fatal)
+                print(f"[tensorfold] rank {self.rank} idle trim failed: {exc!r}", file=sys.stderr, flush=True)
+                continue
+            self.trims += 1
+            self.trimmed_bytes += max(0, before - after)
+            print(f"[tensorfold] rank {self.rank} idle {self.idle_trim_s:g} s: trimmed "
+                  f"{(before - after) / 2**30:.2f} GiB of cached CUDA memory ({before / 2**30:.2f} -> "
+                  f"{after / 2**30:.2f} GiB reserved)", file=sys.stderr, flush=True)
+
