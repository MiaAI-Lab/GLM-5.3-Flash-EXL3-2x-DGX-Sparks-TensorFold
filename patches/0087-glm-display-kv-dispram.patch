         pass                       # unwinding: the first failure is the one to report
 
 
+def _map_span_dispram(ordinary: int, display: int) -> Span:
+    """``map_span`` from dispramd (kindling spark-os): ``ordinary`` bytes of device memory and at least
+    ``display`` bytes of the reservation right above them, one virtual range. Fails closed like the DRM path: no
+    client, no daemon or a slice short of ``display`` stops the start."""
+    try:
+        import dispram
+    except ImportError as exc:
+        raise RuntimeError(f"{ENV}: {BACKEND_ENV}=dispram, but the dispram client is not importable (mount "
+                           "/opt/kindling/dispram/python and put it on PYTHONPATH)") from exc
+    if not dispram.available():
+        raise RuntimeError(f"{ENV}: {BACKEND_ENV}=dispram, but dispramd does not answer (mount /run/dispram)")
+    total = ordinary + display
+    index = torch.cuda.current_device()
+    torch.cuda.synchronize(index)
+    pointer, _, tail = _step("dispram.map_glued", dispram.map_glued, total, index)
+    if tail < display:
+        raise RuntimeError(f"{ENV}: dispramd lent {tail} B of the reservation, short of {display} B")
+    return Span(pointer, total)
+
+
 def map_span(ordinary: int, display: int) -> Span:
