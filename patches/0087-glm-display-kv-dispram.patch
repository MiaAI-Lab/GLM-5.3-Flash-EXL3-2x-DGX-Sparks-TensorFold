+def backend() -> str:
+    """Where the span's reservation half comes from: ``drm`` (the default) or ``dispram`` (kindling spark-os)."""
+    value = (os.environ.get(BACKEND_ENV) or "drm").strip().lower()
+    if value not in ("drm", "dispram"):
+        raise ValueError(f"{BACKEND_ENV}={value!r}: drm or dispram")
+    return value
+
