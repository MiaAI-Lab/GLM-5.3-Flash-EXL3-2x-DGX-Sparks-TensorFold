diff --git tensorfold/cuda/server.py tensorfold/cuda/server.py
--- tensorfold/cuda/server.py
+++ tensorfold/cuda/server.py
@@ -66,6 +66,18 @@
     text = config.get("text_config") or config
     limit = text.get("max_position_embeddings") or config.get("max_position_embeddings")
     return int(limit) if isinstance(limit, int) and limit > 0 else 0
+
+
+def tool_call_rejections(names: list[str], offered: int, stats: dict[str, Any]) -> dict[str, Any]:
+    """Calls a reply made to tools the request did not offer (#103): they stay text and never run. One log line names
+    them (the names only, never an argument); TF_GLM_TOOL_DIAGNOSTICS=1 also lists them in the reply's "tensorfold"
+    block (a stream's last event) as ``tool_call_rejections``, so a gateway can tell the reply from an answer."""
+
+    print(f"[tensorfold] tool call rejected: unknown_tool_name {names!r} ({offered} tools offered); kept as text",
+          flush=True)
+    if os.environ.get("TF_GLM_TOOL_DIAGNOSTICS", "").strip() != "1":
+        return stats
+    return {**stats, "tool_call_rejections": [{"reason": "unknown_tool_name", "name": n} for n in names]}
 
 
