# Chunked request bodies (Transfer-Encoding: chunked) on POST routes, issues #67 and #74. v0.6.0 reads a body only by
# Content-Length: a chunked request (what a proxy or an HTTP client streaming its body sends) has none, so the body was
# read as empty ("messages must be a list" 400) and its unread chunks were parsed as the next request on the
# keep-alive connection (the stdlib answers that in HTTP/0.9 mode: an HTML error page with no status line).
# The reader is not written here: it is tensorfold/server/request_body.py read_body(), upstream TensorFold's 977f2cc
# by Jordi Posthumus (JordiPosthumus), which patch 0084 adds for the Anthropic route (chunked incl. extensions and
# trailers, strict sizes, Content-Length + Transfer-Encoding refused, size limit enforced while reading, the connection
# closed on any framing error). This patch only uses it at the remaining body-reading sites, each keeping its own limit:
# chat/completions and the tokenizer routes in cuda/http.py (96 MiB: up to 50 pictures or 4 clips as data URLs),
# the MLX-style server/http.py (32 MiB), /v1/responses (32 MiB), and the 404 path's _discard_body (32 MiB). Requires 0084.
# Behaviour change: a body with both Content-Length and Transfer-Encoding, or any other transfer coding, is now a 400
# with Connection: close (read_body's rule) instead of being read by Content-Length.

diff --git tensorfold/cuda/http.py tensorfold/cuda/http.py
--- tensorfold/cuda/http.py
+++ tensorfold/cuda/http.py
@@ -12,6 +12,7 @@
 from tensorfold.server.cancellation import RequestCancelled, socket_cancellation
 from tensorfold.server.errors import CapacityError, RequestError, admission_response, error_body
 from tensorfold.server.http import Server
+from tensorfold.server.request_body import read_body
 from tensorfold.server.stacks import Rearming
 
 if TYPE_CHECKING:
@@ -65,13 +66,9 @@
             """Read a refused request's body, so it cannot reach the next request on this connection."""
 
             try:
-                length = int(self.headers.get("Content-Length", 0))
-            except ValueError:
-                length = -1
-            if 0 <= length <= 32 * 1024**2:
-                self.rfile.read(length)
-            else:
-                self.close_connection = True
+                read_body(self)                  # Content-Length or chunked; a refusal has closed the connection
+            except RequestError:
+                pass
 
         def _stream_error(self, error: dict[str, Any]) -> None:
             """End an open stream with an error event and ``[DONE]``, as the MLX server does."""
@@ -111,12 +108,10 @@
                 self._discard_body()
                 return self._json(404, {"error": "not found"})
             try:
-                length = int(self.headers.get("Content-Length", 0))
-                if not 0 <= length <= 96 * 1024**2:          # up to 50 pictures or 4 clips as data URLs
-                    self.close_connection = True             # the unread body must not reach the next request
-                    return self._json(400, {"error": {"message": "request body exceeds the 96 MiB limit",
-                                                      "type": "invalid_request_error"}})
-                body = json.loads(self.rfile.read(length) or b"{}")
+                # up to 50 pictures or 4 clips as data URLs; Content-Length or chunked (patch 0094)
+                body = json.loads(read_body(self, limit=96 * 1024**2) or b"{}")
+            except RequestError as exc:
+                return self._json(400, {"error": {"message": str(exc), "type": "invalid_request_error"}})
             except (json.JSONDecodeError, UnicodeDecodeError):
                 return self._json(400, {"error": {"message": "the request body is not JSON", "type": "invalid_request_error"}})
             if tokenizer:                                   # vLLM's /tokenize and /detokenize
