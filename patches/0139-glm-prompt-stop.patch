+class PromptStopped(Exception):
+    """A prompt's prefill ended at a chunk boundary on a stop every rank agreed to (``PromptStop``); ``at``: the
+    rows committed (the caches hold the prompt's rows before it, a state like any prefix's)."""
+
+    def __init__(self, at: int) -> None:
+        super().__init__(f"the prompt's prefill stopped after {at} rows: the client left")
+        self.at = at
