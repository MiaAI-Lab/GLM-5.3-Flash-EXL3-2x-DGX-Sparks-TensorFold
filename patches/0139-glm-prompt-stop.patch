+def prompt_stop_on(env=None) -> bool:
+    """TF_GLM_PROMPT_STOP: "1" (default) a single-stream prompt votes after each chunk whether to stop (``PromptStop``);
+    "0" every prompt fills to its end. Every rank must agree (the vote is a collective)."""
+
+    import os
+
+    value = ((os.environ if env is None else env).get("TF_GLM_PROMPT_STOP", "1") or "1").strip()
+    if value not in ("0", "1"):
+        raise ValueError(f"TF_GLM_PROMPT_STOP is 0 or 1, not {value!r}")
+    return value == "1"
+
+
+class PromptStop:
+    """A single-stream prompt's stop at chunk boundaries (after upstream TensorFold's 05dfb7b by Ash Hart (ashhart,
+    Apache-2.0): a cancelled prompt stops at its next chunk; the multi-rank vote is our code). ``poll`` (rank 0: the
+    request's ``cancelled``, the client gone; other ranks: None) is this rank's wish; ``__call__`` all-gathers every
+    rank's wish as one int32 each and stops when any rank wishes, so every rank stops after the same chunk, as
+    ``StopVote`` ends a decode. One tiny gather a chunk (a chunk runs for seconds); the rows of the chunks committed
+    stay a valid prefix state."""
+
+    def __init__(self, w, poll=None) -> None:
+        self.w, self.poll = w, poll
+        self.stop = False
+
+    def mine(self) -> bool:
+        try:
+            return bool(self.poll is not None and self.poll())
+        except Exception:                 # noqa: BLE001  (a broken poll never stops the ranks apart)
+            return False
+
+    def __call__(self) -> bool:
+        wish = self.mine()
+        comm = getattr(self.w, "comm", None)
+        if comm is not None and int(getattr(self.w, "world", 1)) > 1:
+            dev = self.w.device
+            flag = torch.tensor([int(wish)], dtype=torch.int32, device=dev)
+            got = torch.empty((self.w.world,), dtype=torch.int32, device=dev)
+            comm.all_gather(flag, got)
+            wish = bool(int(got.max().item()))
+        self.stop = self.stop or wish
+        return self.stop
+
