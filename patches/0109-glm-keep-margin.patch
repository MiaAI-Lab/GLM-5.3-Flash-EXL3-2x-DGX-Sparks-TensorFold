+def keep_margin(value: str | None = None) -> int:
+    """TF_GLM_KEEP_MARGIN: 0 (off, the default) or the fewest tokens a request keeps its own prompt state short of its
+    prompt's end (``grid_point``), 0 to 4,096."""
+
+    value = os.environ.get("TF_GLM_KEEP_MARGIN", "") if value is None else value
+    value = value.strip()
+    if value in ("", "0"):
+        return 0
+    if not value.isdecimal() or int(value) > 4096:
+        raise ValueError(f"TF_GLM_KEEP_MARGIN: 0 (off) or the tokens to keep a prompt state short of its end, "
+                         f"at most 4096; not {value!r}")
+    return int(value)
+
+
+def grid_point(n: int, cut: int, grid: int, margin: int = 0) -> int | None:
     """Where a drafted request of an n-token prompt resumed at ``cut`` keeps its prompt state, or None for nowhere.
 
     Off (grid 0) and on-grid prompts: at n. Otherwise at B = floor(n / grid) * grid, when B lies past ``cut`` (so
-    B > 0); the request then prefills up to B, keeps that state, and resumes from it to n."""
+    B > 0); the request then prefills up to B, keeps that state, and resumes from it to n.
+
+    ``margin`` (TF_GLM_KEEP_MARGIN, 0: off): at B = floor((n - margin) / grid) * grid instead (n - margin without a
+    grid), when B lies past ``cut``. A kept state is a recurrent state, so only a later prompt that holds all of its
+    tokens resumes from it; one at (or within a few tokens of) n is lost to the next prompt that branches off in the
+    last tokens: the next turn of a conversation whose generation prompt ended in tokens the client does not send
+    back (GLM's ``<think>`` after ``<|assistant|>``), an edited or retried last message, a tool call's re-rendered
+    tail. That prompt then resumed at the conversation's previous kept state, or at 0. With a margin it resumes at B
+    and prefills the margin's tokens again."""
 
+    if margin:
+        point = (n - margin) // grid * grid if grid else n - margin
+        return point if point > cut else None
     if not grid or n % grid == 0:
         return n
     point = n // grid * grid
