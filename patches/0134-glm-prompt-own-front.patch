+def select_pools(qi: torch.Tensor, wts: torch.Tensor, pk: torch.Tensor, pos: int, R: int, np_max: int,
+                 pos_dev: torch.Tensor, out: torch.Tensor) -> None:
+    """The prompt selection's pools of R rows at positions pos .. pos + R - 1, int32 [R, TOPK_POOLS] ascending into
