# Standalone follow-up patch requiring upstream PR #134 and #158; draft until integrated.
# Keep literal </think> in GLM <arg_value> (and Qwen <parameter=>) from splitting a real tool call.
# This preserves #158 argument-aware envelope handling and Codex streaming / alias support.
--- tensorfold/cuda/reply_text.py
+++ tensorfold/cuda/reply_text.py
@@ -239,6 +239,46 @@
 
 
 _THINK_CLOSE = "</think>"
+def _think_close_outside_values(text: str, start: int, end: int) -> int:
+    """Find a reasoning terminator without reading through an actual tool argument.
+
+    A text explanation mentioning <arg_value> is not an argument. Only valid
+    <tool_call> heads may own GLM/Qwen values or JSON string literals.
+    """
+    pos = start
+    while (close := text.find(_THINK_CLOSE, pos, end)) >= 0:
+        inside_tool_value = False
+        for opened in _TOOL_CALL_OPEN_RE.finditer(text, start, close):
+            if not _call_head(text, opened.end()):
+                continue
+            call_end = _tool_call_end(text, opened.start())
+            if call_end is not None and call_end <= close:
+                continue
+            body = text[opened.end():close]
+            if body.rfind("<arg_value>") > body.rfind("</arg_value>"):
+                inside_tool_value = True
+                break
+            qwen = list(re.finditer(r"<parameter=[^>\s]+>", body, re.IGNORECASE))
+            if qwen and qwen[-1].start() > body.rfind("</parameter>"):
+                inside_tool_value = True
+                break
+            if body.lstrip().startswith(("{", "[")):
+                quoted = escaped = False
+                for char in body:
+                    if escaped:
+                        escaped = False
+                    elif quoted and char == "\\":
+                        escaped = True
+                    elif char == '"':
+                        quoted = not quoted
+                if quoted:
+                    inside_tool_value = True
+                    break
+        if not inside_tool_value:
+            return close
+        pos = close + len(_THINK_CLOSE)
+    return -1
+
