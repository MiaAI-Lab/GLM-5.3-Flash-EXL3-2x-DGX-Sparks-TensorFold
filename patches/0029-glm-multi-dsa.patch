     out = torch.empty((R, k), dtype=torch.int64, device=scores.device)
     _select_rows[(R,)](scores, out, NP, pos_dev if pos_dev is not None else scores,
-                       K=k, BLOCK=1024, VISIBLE=pos_dev is not None, num_warps=4)
