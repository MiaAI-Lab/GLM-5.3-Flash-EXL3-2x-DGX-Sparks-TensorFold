+# TF_GLM_DRAFT_SKIP=1: a prompt's taps go into DFlash2's context only within reach of the points its context is read
+# at (the prompt's end, its kept points); the rows before are never read
+DRAFT_SKIP = os.environ.get("TF_GLM_DRAFT_SKIP", "0") == "1"
+
+
+class WindowTaps:
+    """``ctx.add_taps`` for a prompt's chunks, committing only the rows within ``reach`` before one of ``points``: a
+    ring holds its last ``ring`` rows only and a block pass reads its window only, so what a later pass or kept state
+    reads is what a full commit leaves. The ranges start on the ``t_max`` steps a full commit takes from the chunk's
+    start (the same launches for those rows); the context's end moves past the rows left out."""
+
+    def __init__(self, ctx: DraftContext, points: Sequence[int]) -> None:
+        self.ctx, self.points = ctx, sorted(set(points))
+        self.reach = ctx.ring or ctx.window + ctx.block + 1
+        self.step = ctx.owner.t_max
+
+    def _skip_to(self, p: int) -> None:
+        if p > self.ctx.context_end:
+            self.ctx.context_end = p
+            self.ctx.pos_dev.fill_(p)
+
+    def add_taps(self, taps: torch.Tensor) -> None:
+        a = self.ctx.context_end
+        z = a + taps.shape[0]
+        spans: list[list[int]] = []
+        for p in self.points:
+            lo, hi = max(a, p - self.reach), min(z, p)
+            if lo >= hi:
+                continue
+            lo = a + (lo - a) // self.step * self.step
+            if spans and lo <= spans[-1][1]:
+                spans[-1][1] = max(spans[-1][1], hi)
+            else:
+                spans.append([lo, hi])
+        for lo, hi in spans:
+            self._skip_to(lo)
+            self.ctx.add_taps(taps[lo - a:hi - a])
+        self._skip_to(z)
+
+
 @dataclass
 class DraftRequest:
     """One stream's draft for a round: ``Drafter.propose``'s arguments with the stream's context."""
