+++ tensorfold/families/glm5_next/cuda/multi_tune.py
@@ -35,6 +35,22 @@
 import torch


+def decode_defaults(world: int, env=None) -> None:
+    """Set TP4's existing decode options before loading/capture and the ranks' settings comparison.
+
+    One engine runs in each rank process. Use its resolved world, not a launcher-specific TP variable.
+    Explicit nonempty values win; empty values mean the default, as in the recipe's config.sh.
+    Other TP sizes are untouched. No arithmetic, transport, side-stream or profile setting changes.
+    """
+    if world != 4:
+        return
+    env = os.environ if env is None else env
+    for key, value in (("TF_GLM_MULTI_SAMPLER", "packed"), ("TF_GLM_MULTI_DEPTH", "joint"),
+                       ("TF_GLM_MULTI_ASYNC", "1"), ("TF_GLM_EXL3_DEC_ORDER", "2")):
+        if not env.get(key):
+            env[key] = value
+
+
 @dataclass
 class MultiSettings:
     sampler: str = "streams"
