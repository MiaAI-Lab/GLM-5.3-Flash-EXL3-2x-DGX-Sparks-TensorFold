# Kept states: a stream that continues its conversation without resuming from that conversation's own turn state keeps
# the conversation id (patch 0089 minted a new one), so TF_GLM_KEEP_PER_CHAT counts the conversation once. That
# happens when a client rewinds before the kept turns (an edit, a regenerate, a tool loop re-sent: issue #104), when a
# state comes back from the spill tier, or when the conversation's states were dropped. The conversation is the one
# whose own kept state the prompt repeats past its first prompt and the first 32 tokens of the reply to it, ids no other
# conversation wrote. /health and /metrics count these streams and their prefill (chats_continued,
# chats_continued_prefill_tokens); rank 0 logs one prefilling 4096 tokens or more, with where the prompt left the kept
# state and what it resumed from. Builds on 0089-glm-kept-state (Thomas Wade, PR #65). By @wojo. Apache-2.0.
diff --git tensorfold/families/glm5_next/cuda/multi.py tensorfold/families/glm5_next/cuda/multi.py
index 06f33e7..9eccfff 100644
--- tensorfold/families/glm5_next/cuda/multi.py
+++ tensorfold/families/glm5_next/cuda/multi.py
@@ -249,6 +249,44 @@ def cap_victim(kept: list):
     return kept[0]
 
 
+# a conversation's first reply: the tokens of it a later prompt must repeat to continue that conversation
+CHAT_MATCH = 32
+# a continued conversation's prefill from this many tokens on is logged (rank 0)
+CHAT_LOG_TOKENS = 4096
+
+
+def continued_chat(kept: list, prompt: list[int], roots: dict[int, int]):
+    """The kept state of the conversation a prompt continues when it did not resume from one of that conversation's own
+    turn states (it fell back to a shared prefix, to a state read back from disk or a paused prefill, or to nothing):
+    the most recently used own state whose ids repeat the prompt past its conversation's first prompt (``roots``: its
+    length) and the first ``CHAT_MATCH`` tokens of the reply to it. Only that conversation wrote those, so a second
+    conversation behind the same system prompt and opening message does not join it, and an edit of the first message
+    starts a new one. None when there is none. Deterministic in ``kept``'s order, so both ranks agree."""
+
+    for c in reversed(kept):
+        chat = getattr(c, "chat", 0)
+        if not getattr(c, "own", False) or chat not in roots or getattr(c, "images", False):
+            continue
+        n = roots[chat] + CHAT_MATCH
+        if len(c.ids) >= n and len(prompt) >= n and c.ids[n - 1] == prompt[n - 1] and c.ids[:n] == prompt[:n]:
+            return c
+    return None
+
+
+def common_prefix(a: list[int], b: list[int]) -> int:
+    """The tokens two id lists share from the start."""
+
+    n = min(len(a), len(b))
+    lo, hi = 0, n                       # a[:lo] == b[:lo]; the first difference is before hi
+    while lo < hi:
+        mid = (lo + hi + 1) // 2
+        if a[lo:mid] == b[lo:mid]:
+            lo = mid
+        else:
+            hi = mid - 1
+    return lo
+
+
