+    def _continued(self, chat: int, prior, hit, cut: int, prompt: list[int]) -> None:
+        """Both ranks: a stream continues conversation ``chat`` without resuming from its own turn state (``prior``:
+        that conversation's state it repeats; ``hit``: what it resumed from, None for nothing). Counted; rank 0 logs a
+        large prefill with where the prompt left the kept state and what it resumed from."""
+
+        self.chats_continued += 1
+        self.chats_continued_prefill += len(prompt) - cut
+        if self.rank or len(prompt) - cut < CHAT_LOG_TOKENS:
+            return
+        source = ("nothing" if hit is None else "a shared prefix" if getattr(hit, "shared", False)
+                  else "a state that is not a turn's own (read back from disk, or a paused prefill)")
+        at = common_prefix(prior.ids, prompt)
+        why = (f"it went back to token {at}, before that conversation's newest kept state ({len(prior.ids)} tokens)"
+               if at < len(prior.ids) else
+               f"its kept state of {len(prior.ids)} tokens could not serve it (no DFlash2 window, off the grid, or "
+               "draft:false)")
+        print(f"[tensorfold] conversation {chat}: resumed at {cut} of {len(prompt)} tokens from {source}, "
+              f"prefilling {len(prompt) - cut}; {why}", flush=True)
+
     def _ctx(self, lane: Lane):
         """The lane's slot's DFlash2 context."""
