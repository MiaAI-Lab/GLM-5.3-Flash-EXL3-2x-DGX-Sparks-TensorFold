+def _tool_call_end(text: str, start: int) -> int | None:
+    """End of an envelope, not a literal closer inside a GLM argument value.
+
+    GLM values are delimited by </arg_value>; tool markup inside that value is
+    file/argument data, not an envelope boundary. Incomplete values stay held.
+    This boundary is shared by content hiding, end parsing and ThinkSplit.
+    """
+
+    pos = start + len(_CALL_OPEN)
+    while (edge := _TOOL_CALL_EDGE_RE.search(text, pos)) is not None:
+        if edge.group("close") is not None:
+            return edge.end()
+        value_end = text.find("</arg_value>", edge.end())
+        if value_end < 0:
+            return None
+        pos = value_end + len("</arg_value>")
+    return None
+
+
+def _tool_call_blocks(text: str):
+    pos = 0
+    while (opened := _TOOL_CALL_OPEN_RE.search(text, pos)) is not None:
+        end = _tool_call_end(text, opened.start())
+        if end is None:
+            return
+        yield opened.start(), end, text[opened.end():end - len(_CALL_CLOSE)].strip()
+        pos = end
 
 
