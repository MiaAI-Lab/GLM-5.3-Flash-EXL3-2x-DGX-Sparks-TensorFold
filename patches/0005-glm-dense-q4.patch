+                and name != "lm_head.weight" and "kv_b_proj" not in name
+                and "experts." not in name.replace("shared_experts.", "") and _F8_NAMES.search(name)):
+            n = base(name, info)[0] // 2
+            return n // 2 + n // 64 * 4, extra
+        return total, extra
+    return transform
