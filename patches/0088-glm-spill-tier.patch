+    def _spillable(self, c) -> bool:
+        return self._unspillable(c) is None
+
+    def _unwritten(self, why: str) -> None:
+        st = self.disk.stats
+        st.unwritten_evicted += 1
+        st.unwritten[why] = st.unwritten.get(why, 0) + 1
