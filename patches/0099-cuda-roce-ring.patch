+// relay every stripe that has arrived (until: 0), or every one up to sequence ``until``, waiting for those (they
+// have arrived: this rank's kernel for that sequence waited on them); returns how many were relayed, -1 on failure
+static int relay(roce_ctx_t *c, uint32_t until) {
+    int done = 0;
+    for (int e = 0; e < c->n_relay; e++) {
+        for (;;) {
+            const uint32_t seq = c->relay_last[e] + 1;
+            if (until != 0 && (int32_t)(seq - until) > 0) {
+                break;
+            }
+            const uint64_t flag_index = (((uint64_t)c->relay_src[e] * ROCE_SLOTS + (seq & 1u)) * (uint64_t)c->n_flag +
+                                         (uint64_t)c->relay_stripe[e]);
+            volatile uint32_t *flag = (volatile uint32_t *)(c->region + c->flag_off + flag_index * ROCE_FLAG_STRIDE);
+            if (__atomic_load_n(flag, __ATOMIC_ACQUIRE) != seq) {
+                if (until == 0) {
+                    break;
+                }
+                if (!atomic_load_explicit(&c->running, memory_order_relaxed)) {
+                    snprintf(c->err, sizeof(c->err), "RoCE proxy stopped waiting to relay rank %d's seq %u",
+                             c->relay_src[e], seq);
+                    return -1;
+                }
+                continue;
+            }
+            if (forward(c, e, seq) != 0) {
+                return -1;
+            }
+            c->relay_last[e] = seq;
+            done++;
+        }
+    }
+    return done;
+}
