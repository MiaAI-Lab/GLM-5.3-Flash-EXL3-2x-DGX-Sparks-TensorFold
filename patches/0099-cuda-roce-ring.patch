+    struct ibv_send_wr flag_wr;
+    memset(&flag_wr, 0, sizeof(flag_wr));
+    flag_wr.wr_id = (uint64_t)dst | ROCE_FWD_BIT;
+    flag_wr.sg_list = &flag_sge;
+    flag_wr.num_sge = 1;
+    flag_wr.opcode = IBV_WR_RDMA_WRITE;
+    flag_wr.send_flags = IBV_SEND_SIGNALED | IBV_SEND_INLINE;
+    flag_wr.wr.rdma.remote_addr = remote + c->flag_off + flag_index * ROCE_FLAG_STRIDE;
+    flag_wr.wr.rdma.rkey = c->peer_rkey[s][dst];
+    struct ibv_send_wr data_wr, *first_wr = &flag_wr;
+    struct ibv_sge data_sge;
+    if (bytes != 0) {
