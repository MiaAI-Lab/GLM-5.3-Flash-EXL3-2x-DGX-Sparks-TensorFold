+    const uint32_t slot = seq & 1u;
+    const uint64_t flag_index = (((uint64_t)src * ROCE_SLOTS + slot) * (uint64_t)c->n_flag + (uint64_t)s);
+    volatile uint32_t *len = (volatile uint32_t *)(c->region + c->flag_off + flag_index * ROCE_FLAG_STRIDE +
+                                                   ROCE_LEN_OFFSET);
+    const uint32_t nbytes = __atomic_load_n(len, __ATOMIC_ACQUIRE);
