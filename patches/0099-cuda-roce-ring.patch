+        snprintf(c->err, sizeof(c->err), "RoCE ring: rank %d's payload length %u (seq %u) is invalid", src, nbytes,
+                 seq);
+        return -1;
+    }
+    uint64_t offset;
+    uint32_t bytes;
+    stripe_range(nbytes, c->n_flag, s, &offset, &bytes);
