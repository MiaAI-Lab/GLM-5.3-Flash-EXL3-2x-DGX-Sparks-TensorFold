+    def _remember(self, key: tuple, data: bytes, detail: str, tokens: int, decoded, budget: int) -> FittedPicture:
+        """Fit a picture that was not seen before and remember what that cost (its bytes too, to fit it again)."""
+
+        canvas = self._picture(decoded, tokens)
+        if not PICTURE_CACHE:
+            return canvas                     # off: the fitted canvas, exactly the path before this cache existed
+        head = b"image" + json.dumps(list(canvas.shape)).encode()
+        raw = canvas.numpy().tobytes()
+        seen = FittedPicture(rows=canvas.shape[1] // 28 * (canvas.shape[2] // 28),
+                             key=int.from_bytes(hashlib.sha256(head + b"\0" + raw).digest()[:8], "big") >> 2,
+                             shape=tuple(canvas.shape), pixels=int(decoded.width) * int(decoded.height),
+                             digest=hashlib.sha256(raw).digest(), data=data, detail=detail,
+                             tokens=int(tokens), min_tokens=self.limits.min_tokens, canvas=canvas)
+        if budget >= PICTURE_UNCAPPED:                        # a decode squeezed by the pixel budget is not kept
+            self._pictures[key] = seen
+            held = sum(len(x.data) for x in self._pictures.values())
+            while held > PICTURE_CACHE_MB * 1024 * 1024 and len(self._pictures) > 1:
+                held -= len(self._pictures.popitem(last=False)[1].data)
+        self._hold_canvas(seen)
+        return seen
+
+    def _hold_canvas(self, seen: FittedPicture) -> None:
+        """Keep the last few canvases in hand: a request re-encodes the pictures a resume did not keep, usually one."""
+
+        if not PICTURE_CANVASES:
+            return
+        self._canvases[seen] = True                # by the record itself: two sources can fit to the same canvas
+        while len(self._canvases) > PICTURE_CANVASES:
+            old = next(iter(self._canvases))
+            del self._canvases[old]
+            if old is not seen:
+                old.canvas = None
+
+    def _canvas(self, picture: FittedPicture):
+        """A remembered picture's pixels, read again from its bytes (the tower only needs the pictures a resume did
+        not keep: in practice the ones the request just brought, which were misses and are still in hand)."""
+
+        from .images import _decode
+
+        L = self.image_limits
+        decoded = _decode(picture.data, picture.detail, L, L.max_total_pixels)
+        canvas = self._picture(decoded, picture.tokens)
+        del decoded
+        picture.canvas = canvas
+        self._hold_canvas(picture)
+        return canvas
