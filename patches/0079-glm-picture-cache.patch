 # -- the frontend ------------------------------------------------------------------------------------------------
+@dataclass(eq=False)
+class FittedPicture:
+    """A picture an earlier request with the same bytes already read: its placeholder count, its key and its pixels.
+
+    ``GlmPrepared.items`` holds one of these in place of a canvas; ``canvas`` is filled in when the picture is fitted
+    and dropped again once it is old, so the tower can ask for it (``GlmVision._canvas``) on the rare occasion it has
+    to encode a picture the prompt's resume did not keep."""
+
+    rows: int                          # the placeholder tokens the prompt spells out for it: (H // 28) * (W // 28)
+    key: int                           # 62-bit key of its kind, shape and pixels (prompt reuse tells pictures apart)
+    shape: tuple                       # the fitted canvas's shape: all ``_rows`` needs
+    pixels: int                        # the decoded picture's width * height (the request's pixel budget counts it)
+    digest: bytes                      # sha256 of the canvas: the prompt's content hash keeps its meaning
+    data: bytes = b""                  # the source's bytes, to fit it again if its canvas has been let go
+    detail: str = "auto"
+    tokens: int = 0
+    min_tokens: int = 16
+    canvas: Any = None
+
