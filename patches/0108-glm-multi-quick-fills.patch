+    def _quick(self, lane: Lane) -> bool:
+        """Rank 0: whether a filling stream's prompt is quick (TF_GLM_QUICK_ROWS): foreground, at most ``quick`` rows
+        left (a replay of a kept head: none)."""
+        return bool(self.quick) and not lane.s.background and len(lane.s.prompt) - lane.st.pos <= self.quick
