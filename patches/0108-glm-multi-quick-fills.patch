 stream's rows get the bits of a chunk of their own; the shortest remaining prompts first, within the same row
@@ -180,6 +180,21 @@ def fill_share(value: str | None = None) -> float:
     return share
 
 
+def quick_rows(fill: int, value: str | None = None) -> int:
+    """TF_GLM_QUICK_ROWS: a prompt whose rows still to fill are at most this many (default 1,024, at most the
+    TF_GLM_FILL_ROWS chunk: one chunk; 0: off) fills before the next decode round instead of waiting its turn by
+    TF_GLM_FILL_SHARE, so the short prompts of a burst all reach their first token before the streams decode on.
+    The quick fills are bertholomus' (TensorFold branch glm-dsa-tp4, 14b43b0, Apache-2.0: TF_GLM_QUICK_ROWS); this
+    scheduler's code is ours."""
+
+    value = os.environ.get("TF_GLM_QUICK_ROWS", "") if value is None else value
+    value = value.strip()
+    rows = 1024 if value == "" else int(value) if value.isdecimal() else -1
+    if rows < 0:
+        raise ValueError(f"TF_GLM_QUICK_ROWS: rows (0: off), not {value!r}")
+    return min(rows, fill)
+
+
 def keep_per_chat(value: str | None = None) -> int:
     """TF_GLM_KEEP_PER_CHAT: the kept states one conversation holds at its own turn boundaries (0, the default: no limit, what
