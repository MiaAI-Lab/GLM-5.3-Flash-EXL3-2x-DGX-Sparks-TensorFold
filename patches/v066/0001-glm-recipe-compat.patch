+#pragma unroll
+                for (int i = 0; i < NQ; ++i) {
+                    kx[i] = reinterpret_cast<const float4*>(sm.k[r])[kp + KP * i];
+                    qx[i] = reinterpret_cast<const float4*>(sm.q[r])[kp + KP * i];
+                }
+            };
