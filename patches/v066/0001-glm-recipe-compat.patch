+                }
+            }
+        }
+        __syncthreads(); MARK(4);
+
+        // 5. Every thread: its sums of (k E) S0^T and (q E) S0^T; Y = beta (v - (k E) S0^T) into g, the (q E) S0^T
+        // of the rows it finishes kept in o1.
+        float o1[OWN];
+        {
+            float4 ck[NQ], cq[NQ], nk[NQ], nq[NQ];
