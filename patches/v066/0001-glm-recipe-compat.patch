+def pieces(spans: list[tuple[int, int]], piece: int = PIECE) -> list[tuple[int, int]]:
+    out = []
+    for a, n in spans:
+        for o in range(0, n, piece):
+            out.append((a + o, min(piece, n - o)))
+    return out
