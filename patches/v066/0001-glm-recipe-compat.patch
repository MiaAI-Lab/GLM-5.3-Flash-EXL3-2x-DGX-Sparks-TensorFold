+"""DFlash2 for several streams at once: one drafter's weights, a context ring per stream, block passes and context
+updates of several streams in one launch sequence, each stream's candidates the bits of its own solo ``Drafter``.
+
+Every kernel of a block pass is row-independent (the 4-bit matmuls run the same groups and K slices at any row
+count, ``qmm``; norms, rotary, the dynamic convolutions per block, ``_prep``) except the block attention, which reads
+each stream's own ring (a per-segment slot and position table), and the two ops whose kernels could depend on the row
+count (cuBLAS's selector projection and ``torch.topk``), which run per stream on that stream's rows alone. Context
+updates stack every stream's kept rows; each row carries its own position and ring destination.
+
+API (both ranks call it identically, the same streams in the same order):
+
+    md = MultiDrafter(drafter, streams=8)          # drafter: a dflash2.Drafter (its weights are shared)
+    ctx = md.contexts[i]                            # stream i's DraftContext (duck-types a Drafter's context for
+                                                    # decode.prefill / take_snapshot / restore: add_taps, reset,
+                                                    # context_end, pos_dev, kc, vc, ring, window)
+    chains = md.propose([DraftRequest(ctx, pending, depth, sampling, confidence, ...), ...])
+    md.commit([(ctx, taps), ...])                   # each stream's kept rows' taps [n, 5 * D], after verify
+    md.capture()                                    # CUDA graphs: block passes of 1..streams, updates by row bucket
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Sequence
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+import triton
+import triton.language as tl
+
+from tensorfold.engine.exact_sampling import Sampling
+
+from . import glue
+from .dflash2 import NO_LIMIT, Drafter, _dconv, _mm, merge_candidates
+
+
+@triton.jit
+def _dattn_seg_kernel(Q, K, V, OUT, POS, SLOT, window, scale, L, SLOT_ROWS,
+                      N: tl.constexpr, G: tl.constexpr, NH: tl.constexpr, HD: tl.constexpr, CAP: tl.constexpr,
+                      BK: tl.constexpr, CAUSAL: tl.constexpr, RING: tl.constexpr):
+    """``dflash2._dattn_kernel`` for block ``seg`` (program 1) of L rows side by side: its queries at rows seg * N of
+    Q [heads, L, HD], its context in slot SLOT[seg] (rows slot * CAP .. of K / V [kv heads, SLOT_ROWS, HD]) at
+    position POS[seg]. The same loop and arithmetic as the solo kernel, so each block gets its solo bits."""
+
+    kvh = tl.program_id(0)
+    seg = tl.program_id(1)
+    M: tl.constexpr = G * N
+    m = tl.arange(0, M)
+    qh = kvh * G + m // N
+    qr = m % N
+    d = tl.arange(0, HD)
+    q = tl.load(Q + (qh[:, None] * L + seg * N + qr[:, None]) * HD + d[None, :])
+    s = tl.load(POS + seg).to(tl.int32)
+    base = kvh.to(tl.int64) * SLOT_ROWS + tl.load(SLOT + seg).to(tl.int64) * CAP
+    klen = s + N
+    qpos = s + qr
+    m_i = tl.full([M], -1e30, tl.float32)
+    l_i = tl.zeros([M], tl.float32)
+    acc = tl.zeros([M, HD], tl.float32)
+    lo = 0
+    if RING:
+        lo = tl.maximum(s - window, 0) // BK * BK
+    for start in range(lo, klen, BK):
+        kk = start + tl.arange(0, BK)
+        kin = kk < klen
+        if RING:
+            row = kk % CAP
+        else:
+            row = kk
+        k = tl.load(K + (base + row[:, None]) * HD + d[None, :], mask=kin[:, None], other=0.0)
+        v = tl.load(V + (base + row[:, None]) * HD + d[None, :], mask=kin[:, None], other=0.0)
+        sc = tl.dot(q, tl.trans(k)) * scale
+        ok = kin[None, :] & (((kk[None, :] < s) & (qpos[:, None] - kk[None, :] <= window)) | (kk[None, :] >= s))
+        if CAUSAL:
+            ok = ok & (kk[None, :] <= qpos[:, None])
+        sc = tl.where(ok, sc, float("-inf"))
+        m_new = tl.maximum(m_i, tl.max(sc, axis=1))
+        alpha = tl.exp(m_i - m_new)
+        p = tl.exp(sc - m_new[:, None])
+        l_i = l_i * alpha + tl.sum(p, axis=1)
+        acc = acc * alpha[:, None] + tl.dot(p.to(tl.bfloat16), v)
+        m_i = m_new
+    out = acc / l_i[:, None]
+    tl.store(OUT + (seg * N + qr[:, None]) * (NH * HD) + qh[:, None] * HD + d[None, :], out.to(tl.bfloat16))
+
+
+class DraftContext:
+    """One stream's DFlash2 context: its slot of the shared ring pool (``kc`` / ``vc`` per layer are views
+    [kv heads, ring rows, head_dim]) and where its committed rows end. Stands in for a solo ``Drafter`` wherever one
+    stream's context is handled on its own (``decode.prefill``, ``take_snapshot``, ``restore``)."""
+
+    def __init__(self, owner: "MultiDrafter", slot: int) -> None:
+        d = owner.d
+        self.owner, self.slot = owner, slot
+        self.ring, self.window, self.block, self.capacity = d.ring, d.window, d.block, d.capacity
+        self.tap_layers = d.tap_layers
+        cap = owner.cap
+        self.kc = [c[:, slot * cap:(slot + 1) * cap] for c in owner.kc]
+        self.vc = [c[:, slot * cap:(slot + 1) * cap] for c in owner.vc]
+        self.pos_dev = owner.pos[slot:slot + 1]          # the device mirror of context_end (restore fills it)
+        self.context_end = 0
+
+    def reset(self) -> None:
+        self.context_end = 0
+        self.pos_dev.zero_()
+
+    def add_taps(self, taps: torch.Tensor) -> None:
+        """This stream's committed rows' taps alone (a prompt's chunks): ``MultiDrafter.commit`` of one stream."""
+        self.owner.commit([(self, taps)])
+
+    def propose(self, pending: int, depth: int, sampling: Sampling | None, confidence: float = 0.0, *,
+                beta: float = 0.0, round_ms: tuple[float, ...] | None = None) -> list[int]:
+        return self.owner.propose([DraftRequest(self, pending, depth, sampling, confidence, beta, round_ms)])[0]
+
+
+@dataclass
+class DraftRequest:
+    """One stream's draft for a round: ``Drafter.propose``'s arguments with the stream's context."""
+
+    ctx: DraftContext
+    pending: int
+    depth: int
+    sampling: Sampling | None = None
+    confidence: float = 0.0
+    beta: float = 0.0
+    round_ms: tuple[float, ...] | None = None
+
+
+class MultiDrafter:
+    """Up to ``streams`` DFlash2 streams over one ``Drafter``'s weights (its own context buffers stay unused).
+
+    The ring pool per layer is [kv heads, streams * cap + trash, head_dim]: stream i's rows at i * cap .. (the
+    drafter's ring, or a flat capacity + block when it has none), then ``trash`` rows that padded context updates
+    (a captured row bucket larger than the rows kept) write to."""
+
+    def __init__(self, drafter: Drafter, streams: int = 4, *, tap_rows: int | None = None) -> None:
+        d = self.d = drafter
+        if streams < 1:
+            raise ValueError("a multi-stream drafter needs at least one stream")
+        self.streams = streams
+        self.dev = d.dev
+        self.block = d.block
+        self.cap = d.cap
+        n = self.block
+        # context updates: rows per launch (every stream's kept rows stacked), padded to a multiple of the block
+        rows = max(64, streams * (tap_rows or d.tap_rows))
+        self.t_max = -(-rows // n) * n
+        self.trash = self.t_max
+        self.slot_rows = streams * self.cap + self.trash
+        KV, hd = d.kvh, d.hd
+        self.kc = [torch.zeros((KV, self.slot_rows, hd), dtype=torch.bfloat16, device=self.dev) for _ in d.layers]
+        self.vc = [torch.zeros((KV, self.slot_rows, hd), dtype=torch.bfloat16, device=self.dev) for _ in d.layers]
+        self.pos = torch.zeros((streams + 1,), dtype=torch.int64, device=self.dev)   # + the trash entry
+        self.contexts = [DraftContext(self, i) for i in range(streams)]
+        pinned = torch.cuda.is_available()
+        # block passes: [pending x streams | slot x streams | position x streams]
+        self.b_meta = torch.zeros((3 * streams,), dtype=torch.int64, device=self.dev)
+        self.b_host = torch.zeros((3 * streams,), dtype=torch.int64, pin_memory=pinned)
+        self.ids = torch.full((streams * n,), d.mask_id, dtype=torch.int32, device=self.dev)
+        self.ar = torch.arange(max(64, n), device=self.dev)
+        # context updates: [position x t_max | destination row x t_max | slot x streams | end x streams]
+        T = self.t_max
+        self.t_meta = torch.zeros((2 * T + 2 * streams,), dtype=torch.int64, device=self.dev)
+        self.t_host = torch.zeros((2 * T + 2 * streams,), dtype=torch.int64, pin_memory=pinned)
