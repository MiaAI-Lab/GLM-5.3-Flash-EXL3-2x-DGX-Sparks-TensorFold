+def _move(t, a: int, b: int, m: int, spanned: bool = False) -> None:
+    """t[b:b + m] = t[a:a + m] (rows), safe when they overlap; ``spanned``: by a kernel, not a memcpy."""
+
+    def put(dst, src):
+        if spanned:                        # the same bytes through an elementwise kernel
+            import torch
+
+            torch.bitwise_or(src.view(torch.uint8), 0, out=dst.view(torch.uint8))
+        else:
+            dst.copy_(src)
+
+    gap = abs(a - b)
+    if gap >= m:
+        put(t[b:b + m], t[a:a + m])
+        return
+    step = gap
+    starts = range(0, m, step) if b < a else reversed(range(0, m, step))
+    for s in starts:                       # down: front to back; up: back to front
+        k = min(step, m - s)
+        put(t[b + s:b + s + k], t[a + s:a + s + k])
