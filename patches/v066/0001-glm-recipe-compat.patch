+
+    def drop_graphs(self) -> None:
+        self.block_graphs, self.tap_graphs = {}, {}
+
+    # -- the context ---------------------------------------------------------------------------------------------
+    def _launch_taps(self, pieces: list[tuple[DraftContext, torch.Tensor, int]]) -> None:
+        St, Tm = self.streams, self.t_max
