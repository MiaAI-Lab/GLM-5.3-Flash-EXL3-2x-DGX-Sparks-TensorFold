+                    pieces, used = [], 0
+        if pieces:
+            self._launch_taps(pieces)
+
+    # -- drafts -------------------------------------------------------------------------------------------------
+    @torch.no_grad()
+    def candidates(self, reqs: Sequence[tuple[DraftContext, int, int]]) -> list[tuple[np.ndarray, ...]]:
