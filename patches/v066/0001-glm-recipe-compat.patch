+            self.t_ready.synchronize()                   # the last update's table has left t_host
+        h = self.t_host
+        h[2 * Tm:2 * Tm + St].fill_(St)
+        h[2 * Tm + St:].zero_()
+        off = 0
+        for j, (c, part, p0) in enumerate(pieces):
+            r = part.shape[0]
+            self.tap_in[off:off + r].copy_(part)
+            p = torch.arange(p0, p0 + r, dtype=torch.int64)
