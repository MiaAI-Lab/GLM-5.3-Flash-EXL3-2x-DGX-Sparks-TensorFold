+            T = next(b for b in self.buckets if b >= off)
+            g = self.tap_graphs[T]
+        if T > off:                                      # padded rows: the trash
+            h[off:T] = 0
+            h[Tm + off:Tm + T] = St * self.cap + torch.arange(off, T, dtype=torch.int64)
