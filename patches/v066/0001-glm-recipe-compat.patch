+                n = total * 16 // (2 * 16 + 9)          # its values: total = 2n + 9n / 16
+                return n + n // F8_BLOCK * 4 + n * 9 // 16, extra
+            n = total // 2
+            return n + n // F8_BLOCK * 4, extra
+        return total, extra
+    return transform
