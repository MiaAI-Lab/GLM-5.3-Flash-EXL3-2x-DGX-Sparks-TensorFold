+        pools = prompt_pools(scores, TOPK_POOLS, cand)                                  # ascending pool index
         _tokens[(n,)](pools, at, tokens[a:a + n], counts[a:a + n], W=width, K=TOPK_POOLS, PL=POOL, BLOCK=1024,
                       num_warps=4)
