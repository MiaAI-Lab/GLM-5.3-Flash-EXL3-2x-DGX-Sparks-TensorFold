# Opt-in portable TP4 decode kernels. See docs/tp4-decode-tuning.md for provenance and checks.

diff --git tensorfold/families/glm5_next/cuda/exl3.cu tensorfold/families/glm5_next/cuda/exl3.cu
--- tensorfold/families/glm5_next/cuda/exl3.cu
+++ tensorfold/families/glm5_next/cuda/exl3.cu
@@ -51,6 +51,16 @@
     b0[1] = mcg2(s & 0xffffu, w >> 16);
     b1[0] = mcg2(__byte_perm(t, 0u, 0x4421), __byte_perm(w, 0u, 0x4421));   // (w >> 12) & 0xffff, (w >> 8) & 0xffff
     b1[1] = mcg2(__byte_perm(t, 0u, 0x4410), w & 0xffffu);                  // (w >> 4) & 0xffff, w & 0xffff
+}
+
+// Decode-only compile-time choice. The prompt/grouped kernels keep their own
+// unpack path. Both helpers construct exactly the same fp16 MMA operands.
+__device__ __forceinline__ void decode_tile_dec(uint32_t w, int lane, uint32_t (&b0)[2], uint32_t (&b1)[2]) {
+#if TF_GLM_DECODE_PRMT
+    decode_tile_p(w, lane, b0, b1);
+#else
+    decode_tile(w, lane, b0, b1);
+#endif
 }
 
 __device__ __forceinline__ void mma16816(float (&d)[4], const uint32_t (&a)[4], const uint32_t (&b)[2]) {
@@ -445,7 +455,7 @@
 #pragma unroll
                 for (int i = 0; i < NT; ++i) {
                     uint32_t b0[2], b1[2];
-                    decode_tile(words[i], lane, b0, b1);
+                    decode_tile_dec(words[i], lane, b0, b1);
                     mma16816(acc[i][0], a, b0);
                     mma16816(acc[i][1], a, b1);
                 }
@@ -476,7 +486,7 @@
 #pragma unroll
         for (int i = 0; i < NT; ++i) {
             uint32_t b0[2], b1[2];
-            decode_tile(words[i], lane, b0, b1);
+                decode_tile_dec(words[i], lane, b0, b1);
             mma16816(acc[i][0], a, b0);
             mma16816(acc[i][1], a, b1);
         }
diff --git tensorfold/families/glm5_next/cuda/exl3_mm.py tensorfold/families/glm5_next/cuda/exl3_mm.py
--- tensorfold/families/glm5_next/cuda/exl3_mm.py
