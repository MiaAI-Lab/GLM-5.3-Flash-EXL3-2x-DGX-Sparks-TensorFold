-                extra_cuda_cflags=["-O3"], verbose=False)
+    prmt = os.environ.get("TF_GLM_EXL3_DEC_PRMT", "0")
+    if prmt not in ("0", "1"):
+        raise ValueError("TF_GLM_EXL3_DEC_PRMT: expected 0 or 1")
+    return load(name=f"tensorfold_glm_exl3_v21_prmt{prmt}", sources=[str(here / "exl3.cpp"), str(here / "exl3.cu")],
