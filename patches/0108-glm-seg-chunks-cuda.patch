+
+// latent.seg_attention's chunk pass on an FP8 cache: QA [R, H, 512] bf16 (16 < H <= 24), LC the arena's rows (512
+// e4m3 codes, then the row's fp32 scale; RS bytes apart), POS / BASE / SPR [R] int32 (segments.SegRows), TOK [R, W]
+// int32 selected tokens (sparse rows' first CNT[r] read), PO / PM / PL the chunk partials of nch chunks
+// [nch, R, H, (512)] fp32, as _seg_chunks stores them; ctas: CTAs (0: one an item, R * nch).
+void seg_chunks(const at::Tensor& QA, const at::Tensor& LC, int64_t RS, const at::Tensor& POS, const at::Tensor& BASE,
+                const at::Tensor& SPR, const at::Tensor& TOK, const at::Tensor& CNT, at::Tensor PO, at::Tensor PM,
+                at::Tensor PL, int64_t nch, double scale, int64_t ctas) {
+    TORCH_CHECK(QA.is_cuda() && QA.scalar_type() == at::kBFloat16 && LC.element_size() == 1 &&
+                POS.scalar_type() == at::kInt && BASE.scalar_type() == at::kInt && SPR.scalar_type() == at::kInt &&
+                TOK.scalar_type() == at::kInt && CNT.scalar_type() == at::kInt &&
+                PO.scalar_type() == at::kFloat && PM.scalar_type() == at::kFloat && PL.scalar_type() == at::kFloat,
+                "seg chunks: dtypes");
+    const int64_t R = QA.size(0), H = QA.size(1);
+    TORCH_CHECK(QA.dim() == 3 && QA.size(2) == LW && H > 16 && H <= HQ && QA.is_contiguous() && LC.is_contiguous() &&
+                TOK.is_contiguous() && TOK.dim() == 2 && POS.numel() >= R && BASE.numel() >= R && SPR.numel() >= R &&
+                PO.is_contiguous() && PM.is_contiguous() && PL.is_contiguous() && PO.numel() >= nch * R * H * LW &&
+                PM.numel() >= nch * R * H && PL.numel() >= nch * R * H && nch >= 1, "seg chunks: shapes");
+    TORCH_CHECK(RS % 16 == 0 && RS >= LW + 4, "seg chunks: an FP8 cache of 16-byte aligned rows");
+    TORCH_CHECK(LC.numel() / RS < (int64_t(1) << 31), "seg chunks: arena rows past int32");
+    if (R == 0) return;
+    const c10::cuda::CUDAGuard guard(QA.device());
+    static bool attr = false;
+    if (!attr) {
+        C10_CUDA_CHECK(cudaFuncSetAttribute(seg_chunks_kernel, cudaFuncAttributeMaxDynamicSharedMemorySize,
+                                            (int)sizeof(Smem)));
+        attr = true;
+    }
+    const int items = (int)(R * nch);
+    const int grid = ctas > 0 && ctas < items ? (int)ctas : items;
+    Win w{POS.data_ptr<int32_t>(), BASE.data_ptr<int32_t>(), SPR.data_ptr<int32_t>(), TOK.data_ptr<int32_t>(),
+          CNT.data_ptr<int32_t>(), (int)TOK.size(1), (int)R, items, grid};
+    seg_chunks_kernel<<<grid, NT, sizeof(Smem), at::cuda::getCurrentCUDAStream()>>>(
+        reinterpret_cast<const __nv_bfloat16*>(QA.data_ptr()), reinterpret_cast<const uint8_t*>(LC.data_ptr()),
+        (int)RS, w, PO.data_ptr<float>(), PM.data_ptr<float>(), PL.data_ptr<float>(), (int)H, (float)scale);
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) { m.def("seg_chunks", &seg_chunks); }
