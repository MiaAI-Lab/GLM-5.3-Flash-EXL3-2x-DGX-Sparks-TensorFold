+def prompt_arith_code(split=None) -> list[int]:
+    """The prompt kernels' choices that set a prompt's bits, one int each: in the ranks' startup comparison, so every
+    rank runs the same, and in the prompt cache's identity (the spill tier's folders are keyed on the engine's agreed
+    settings), so a kept state is never resumed under other arithmetic than made it. In order: TF_GLM_PROMPT_PARTIALS
+    (``split``'s: fp32 or bf16 partials), TF_GLM_MSA (msa.cu, not sparse_onepass's bits), TF_GLM_EXL3_PROMPT (the
+    routed experts' prompt kernels, not the decode kernels' bits), TF_GLM_SPARSE_ONEPASS (the one-pass sparse attention,
+    not the chunk programs' bits), TF_GLM_LATENT_MMA (the latent projections on the tensor cores, not the decode
+    kernels' bits), TF_GLM_HC_MMA (hc_pre's mixing dots on the tensor cores), TF_GLM_KDA_CHUNKED (KDA's chunked
+    form). Not in it, because they leave every bit as it was: TF_GLM_PROMPT_SELECT (0103), TF_GLM_EXL3_PASS / _ORDER /
+    _ROWROT, TF_GLM_PREFILL_OVERLAP, the split's exchange and its microbatches."""
+
+    from . import hcsplit
+    from .exl3_mm import prompt_kernels
+
+    partials = "fp32" if split is None else split.partials
+    return [hcsplit.PARTIALS.index(partials), int(msa.ENABLED), int(prompt_kernels()), int(latent.SPARSE_ONEPASS),
+            int(latent.PROMPT_MMA), int(glue.HC_MMA), int(kda_mod.CHUNKED)]
+
+
