     return f"tf_glm_request_{n}" if rank == 1 else f"tf_glm_request_r{rank}_{n}"
 
 
+
+def odd_ranks(rows: list[list[int]]) -> list[int]:
+    """The ranks whose startup settings (every int of their row but the last, the spare memory) differ from rank 0's:
+    the ranks' startup comparison (``mine`` in ``GlmEngine.__init__``), which refuses to start when any differ."""
+
+    return [r for r, row in enumerate(rows) if row[:-1] != rows[0][:-1]]
+
