+test "graph counter capture gate rejects execution and propagates a closed peer barrier" {
+    const Gate = struct {
+        calls: usize = 0,
+        closed: bool = true,
+        fn agreeRanks(self: *@This(), _: std.mem.Allocator, _: u32, text: []const u8) !void {
+            try std.testing.expectEqualStrings("glm-transport-probe capture snapshots complete", text);
+            self.calls += 1;
+            if (self.closed) return error.TestPeerStillCapturing;
+        }
+    };
+    const drained: Comm.Stats = .{ .roce_enqueues = 28, .roce_ops = 28, .relayed_stripes = 112 };
+    var captured = drained;
+    captured.roce_enqueues += 2; // Capture records host enqueues, not GPU execution.
+    captured.nccl_enqueues += 1;
+    var gate: Gate = .{};
+    try std.testing.expectError(error.TestPeerStillCapturing, captureReady(std.testing.allocator, &gate, 3, drained, captured));
+    try std.testing.expectEqual(@as(usize, 1), gate.calls);
+    gate.closed = false;
+    try captureReady(std.testing.allocator, &gate, 3, drained, captured);
+    try std.testing.expectEqual(@as(usize, 2), gate.calls);
+    captured.relayed_stripes += 1; // Remote progress is not evidence of local capture execution.
+    try std.testing.expectError(error.CaptureExecutedTransport, captureReady(std.testing.allocator, &gate, 3, drained, captured));
+    try std.testing.expectEqual(@as(usize, 2), gate.calls); // A mismatched rank never releases peers.
+}
