+    const env: identity.Env = .{ .engine = "fixture-engine", .patches = "fixture-patches", .model_revision = "fixture-model" };
+    for ([_]u32{ 1, 2, 3, 4 }) |world| {
+        const o: Options = .{ .context = 8, .drafts = false, .parallel = 2, .tp = world };
+        const off = try cacheStartup(.{}, null, o, .dflash2);
+        try std.testing.expect(!off.kv.on and off.spill == null);
+        try std.testing.expectError(error.BadKvShard, cacheStartup(error.BadKvShard, null, o, .dflash2));
+        try std.testing.expectError(error.NoEngineId, cacheStartup(.{}, error.NoEngineId, o, .dflash2));
+        if (world != 2) {
+            try std.testing.expectError(error.KvShardNeedsTwoRanks, cacheStartup(.{ .on = true }, null, o, .dflash2));
+            try std.testing.expectError(error.SpillV2NeedsTwoRanks, cacheStartup(.{}, env, o, .dflash2));
+        }
+    }
+}
