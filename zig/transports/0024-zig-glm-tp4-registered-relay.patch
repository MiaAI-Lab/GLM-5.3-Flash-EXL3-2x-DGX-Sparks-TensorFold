+                .{ .world = world, .changed = @intCast(changed), .failure = error.BadKvShard, .words = "kv_shard=unreadable", .uniform_words = false, .continued = &continued },
+                .{ .world = world, .changed = @intCast(changed), .failure = error.NoEngineId, .words = "spill_v2=unreadable", .uniform_words = false, .continued = &continued },
