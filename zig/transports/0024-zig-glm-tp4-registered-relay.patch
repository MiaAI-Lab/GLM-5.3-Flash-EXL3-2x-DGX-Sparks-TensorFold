+        prefetch: ?[]const u8 = null,
+    };
+    fn parse(world: u32, in: Input) !Startup {
+        const enabled = if (in.registered_rdma) |v| blk: {
+            if (std.mem.eql(u8, v, "1")) break :blk true;
+            if (std.mem.eql(u8, v, "0")) break :blk false;
+            return error.BadGlmTp4RegisteredRdma;
+        } else false;
+        const roce_enabled = !std.mem.eql(u8, in.roce_enabled orelse "1", "0");
+        const ring = std.mem.eql(u8, in.ring orelse "0", "1");
