diff --git a/zig/src/cuda/roce_region.zig b/zig/src/cuda/roce_region.zig
new file mode 100644
index 00000000..9089374a
--- /dev/null
+++ b/zig/src/cuda/roce_region.zig
@@ -0,0 +1,93 @@
+//! RoCE-only host-region ownership. The default retains CUDA allocated mapped memory.
+//! Registered-memory approach credited to BertholomusAI (Albert Lee),
+//! bertholomus/TensorFold b8b115e7, dsv41/rdma.zig (mmap + HostRegister).
+//! neither variant changes the RoCE wire protocol or any model arithmetic.
+const std = @import("std");
+const abi = @import("abi.zig");
+const Driver = @import("driver.zig").Driver;
+const memory = @import("memory.zig");
+
+pub const Mode = enum(u8) {
+    allocated = 0,
+    registered = 1,
+};
+
+const host_register_portable: c_uint = 1;
+
+pub const Region = struct {
+    bytes: []align(16) u8,
+    dev: abi.DevicePtr,
+    owner: union(Mode) {
+        allocated: memory.HostBuffer,
+        registered: struct { mem: []align(std.heap.page_size_min) u8, d: *const Driver },
+    },
+
+    pub fn alloc(d: *const Driver, len: usize, mode: Mode) !Region {
+        if (len == 0) return error.Invalid;
+        switch (mode) {
+            .allocated => {
+                var b = try memory.HostBuffer.allocMapped(d, len);
+                errdefer b.free();
+                const dev = try b.device();
+                @memset(b.bytes, 0);
+                return .{ .bytes = b.bytes, .dev = dev, .owner = .{ .allocated = b } };
+            },
+            .registered => {
+                // Round the allocation length to 64 KiB; mmap supplies a system-page
+                // aligned address. CUDA pins it; close MRs before unregistering.
+                const size = try roundedBytes(len);
+                const mem = try std.posix.mmap(null, size, .{ .READ = true, .WRITE = true }, .{ .TYPE = .PRIVATE, .ANONYMOUS = true }, -1, 0);
+                var registered = false;
+                errdefer {
+                    if (!registered or d.api.cuMemHostUnregister(mem.ptr) == abi.success) std.posix.munmap(mem);
+                }
+                @memset(mem, 0);
+                try d.check(d.api.cuMemHostRegister_v2(mem.ptr, mem.len, host_register_portable | abi.host_register_devicemap), "RoCE cuMemHostRegister");
+                registered = true;
+                var dev: abi.DevicePtr = 0;
+                try d.check(d.api.cuMemHostGetDevicePointer_v2(&dev, mem.ptr, 0), "RoCE cuMemHostGetDevicePointer");
+                return .{ .bytes = @alignCast(mem[0..len]), .dev = dev, .owner = .{ .registered = .{ .mem = mem, .d = d } } };
+            },
+        }
+    }
+
+    pub fn free(r: *Region) void {
+        switch (r.owner) {
+            .allocated => |*b| b.free(),
+            .registered => |*v| {
+                // An unregister failure must not unmap pages CUDA may still own.
+                // Shutdown cannot return an error; leak until process exit instead.
+                if (v.d.api.cuMemHostUnregister(v.mem.ptr) == abi.success) std.posix.munmap(v.mem);
+            },
+        }
+        r.* = undefined;
+    }
+};
+
+fn roundedBytes(len: usize) !usize {
+    if (len == 0) return error.Invalid;
+    return (try std.math.add(usize, len, 65535)) & ~@as(usize, 65535);
+}
+
+test "registered RoCE length rounds without overflow" {
+    try std.testing.expectEqual(@as(usize, 65536), try roundedBytes(1));
+    try std.testing.expectEqual(@as(usize, 65536), try roundedBytes(65536));
+    try std.testing.expectEqual(@as(usize, 131072), try roundedBytes(65537));
+    try std.testing.expectError(error.Invalid, roundedBytes(0));
+    try std.testing.expectError(error.Overflow, roundedBytes(std.math.maxInt(usize)));
+}
+
+test "both region allocation paths compile without opening CUDA" {
+    // A runtime condition keeps both ownership paths semantically checked.
+    // The standalone host test never supplies a driver or touches a GPU.
+    const Probe = struct {
+        fn run(d: ?*const Driver, mode: Mode) !void {
+            if (d) |driver| {
+                var r = try Region.alloc(driver, 65537, mode);
+                r.free();
+            }
+        }
+    };
+    try Probe.run(null, .allocated);
+    try Probe.run(null, .registered);
+}
