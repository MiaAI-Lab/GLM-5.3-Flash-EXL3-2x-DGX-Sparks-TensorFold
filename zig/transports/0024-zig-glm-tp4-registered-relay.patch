+                if (!std.mem.eql(u8, v, "0") and !std.mem.eql(u8, v, "1")) return error.BadRoceRing;
+            }
+            if (!ring) return error.RegisteredRdmaRequiresRing;
+            if (!std.mem.eql(u8, in.roce_enabled orelse "", "1")) return error.RegisteredRdmaRequiresRoce;
+            if (!std.mem.eql(u8, in.max_kb orelse "512", "512")) return error.RegisteredRdmaRequires512KiB;
+        }
+        return .{
+            .mode = if (enabled or roce_enabled) .roce else .nccl,
+            .memory = if (enabled) .registered else .allocated,
+            .required = enabled,
+            .prefetch = !std.mem.eql(u8, in.prefetch orelse "1", "0"),
+            .ring = ring,
+            .roce_enabled = roce_enabled,
+        };
+    }
+    fn read(world: u32) !Startup {
