+fn agreeStartup(gpa: Allocator, link: Link, rank: u32, base: []const u8, parsed: anyerror!Startup, admission: anyerror!void) !Startup {
+    var row: [8]u8 = if (parsed) |s| s.row() else |_| @splat(0);
+    // A local cache-feature refusal must also stop peers with otherwise identical
+    // settings (for example, a binary without the optional shard kernels).
+    if (admission) |_| {} else |_| row[0] = 0;
+    // Fixed-size binary suffix: no ambiguity between settings and profile fields.
+    const text = try std.mem.concat(gpa, u8, &.{ base, &row });
+    defer gpa.free(text);
+    try link.agreeTransport(gpa, rank, text, transport_protocol_version);
+    const settings = try parsed;
+    try admission;
+    return settings;
+}
+fn sameMemoryProfile(rows: []const u8, stride: usize, world: usize) !void {
+    if (stride < 4 or world == 0 or rows.len != stride * world) return error.BadRoceRow;
+    for (0..world) |p| if (!std.mem.eql(u8, rows[2..4], rows[p * stride + 2 ..][0..2])) return error.MixedRoceProfile;
+}
