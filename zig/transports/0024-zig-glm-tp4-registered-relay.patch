+
+    /// Version the FIRST settings row, using the existing settings/verdict exchange.
+    /// Stock and earlier transport images send a plain 32-byte digest. They still
+    /// reply and consume a negative verdict, so neither side enters NCCL. Do not
+    /// return early on a follower's incompatible row: the head needs its reply.
+    pub fn agreeTransport(l: Link, gpa: Allocator, rank: u32, settings: []const u8, version: u32) !void {
+        var mine: [40]u8 = undefined;
+        @memcpy(mine[0..4], "GLMT");
+        std.mem.writeInt(u32, mine[4..8], version, .little);
+        std.crypto.hash.sha2.Sha256.hash(settings, mine[8..40], .{});
+        if (rank == 0) {
+            try l.send(.settings, &mine);
+            var same = true;
+            var compatible = true;
+            for (0..l.followers()) |i| {
+                const theirs = try l.at(i).expect(gpa, .settings);
+                defer gpa.free(theirs);
+                if (!sameTransportVersion(&mine, theirs)) compatible = false;
+                if (!std.mem.eql(u8, &mine, theirs)) same = false;
+            }
+            // Legacy peers already reject every value other than 1.
+            try l.send(.verdict, &.{if (!compatible) @as(u8, 2) else @intFromBool(same)});
+            if (!compatible) return error.IncompatibleTransportProtocol;
+            if (!same) return error.RanksDisagree;
+        } else {
+            const first = try l.expect(gpa, .settings);
+            defer gpa.free(first);
+            try l.send(.settings, &mine);
+            const v = try l.expect(gpa, .verdict);
+            defer gpa.free(v);
+            if (!sameTransportVersion(&mine, first) or (v.len == 1 and v[0] == 2)) return error.IncompatibleTransportProtocol;
+            if (v.len != 1 or v[0] != 1 or !std.mem.eql(u8, &mine, first)) return error.RanksDisagree;
+        }
+    }
+
+    fn sameTransportVersion(mine: *const [40]u8, theirs: []const u8) bool {
+        return theirs.len == mine.len and std.mem.eql(u8, mine[0..8], theirs[0..8]);
+    }
 };
 
