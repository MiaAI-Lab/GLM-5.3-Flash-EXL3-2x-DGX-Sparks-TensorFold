diff --git a/zig/tests/cuda/glm_transport_probe.zig b/zig/tests/cuda/glm_transport_probe.zig
new file mode 100644
index 00000000..662e4edb
--- /dev/null
+++ b/zig/tests/cuda/glm_transport_probe.zig
@@ -0,0 +1,434 @@
+//! Weight-free production GLM Comm qualifier. One process on each of four hosts.
+//! tf-glm-transport-probe RANK MASTER_IP PORT [REPLAYS=64]
+//! TF_GLM_TP4_REGISTERED_RDMA=1 TF_ROCE_RING=1 selects registered ring relay; otherwise set
+//! TF_GLM_ROCE=0 for the NCCL reference run. Optional allocated RoCE is not a probe profile.
+//! Run behind an external fleet-wide deadline. No model/checkpoint or Torch.
+const std = @import("std");
+const cuda = @import("cuda");
+const glm = @import("glm_cuda");
+const Comm = glm.comm.Comm;
+const guard: usize = 64;
+const sentinel: u8 = 0xa7;
+
+pub fn main(init: std.process.Init) !u8 {
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    if (args.len < 4 or args.len > 5) return error.ExpectedRankMasterPortReplays;
+    const rank = try std.fmt.parseInt(u32, args[1], 10);
+    const master = try std.Io.net.IpAddress.parse(args[2], try std.fmt.parseInt(u16, args[3], 10));
+    const replays = if (args.len == 5) try std.fmt.parseInt(usize, args[4], 10) else 64;
+    if (rank >= 4 or replays < 8) return error.BadProbeArguments;
+    run(init.gpa, init.io, rank, master, replays) catch |e| {
+        std.debug.print("FAIL rank={d} error={t}\n", .{ rank, e });
+        // Do not unwind transport/graph resources after a failed CUDA operation:
+        // a failed peer can leave a stream pending. The supervisor stops the fleet.
+        std.c._exit(1);
+    };
+    return 0;
+}
+
+fn run(gpa: std.mem.Allocator, io: std.Io, rank: u32, master: std.Io.net.IpAddress, replays: usize) !void {
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var server: ?glm.link.Server = null;
+    defer if (server) |s| s.close();
+    const link = if (rank == 0) blk: {
+        server = try glm.link.Server.open(master); // exact named interface
+        break :blk try server.?.acceptRanks(gpa, 4, 180_000);
+    } else blk: {
+        const l = try glm.link.Link.join(io, master, 180_000);
+        try l.hello(rank);
+        break :blk l;
+    };
+    defer link.close();
+    const agreement = try std.fmt.allocPrint(gpa, "glm-registered-rdma-probe-v2 replays={d}", .{replays});
+    defer gpa.free(agreement);
+    var comm = try Comm.init(gpa, link, rank, 4, agreement, {});
+    defer comm.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    const registered = if (std.c.getenv("TF_GLM_TP4_REGISTERED_RDMA")) |v| std.mem.eql(u8, std.mem.span(v), "1") else false;
+    const backend: Comm.GatherBackend = if (registered) .roce else .nccl;
+    const ring = comm.stats().roce_ring; // Actual successful proxy setup, not requested env.
+    const requested_profile = @tagName(backend);
+    const plan = checked(rank, SizePlan.init(backend, activeCutoff(&comm)));
+    const plan_text = checked(rank, std.fmt.allocPrint(gpa, "glm-probe-size-plan backend={s} ring={} cutoff={d} graph={d},{d},{d}", .{ requested_profile, ring, plan.cutoff, plan.mixed[0], plan.mixed[1], plan.mixed[2] }));
+    defer gpa.free(plan_text);
+    checked(rank, link.agreeRanks(gpa, rank, plan_text));
+    std.debug.print("PLAN rank={d} {s} eager_cases={d}\n", .{ rank, plan_text, plan.eager_len });
+    for (plan.eager[0..plan.eager_len]) |bytes| {
+        var c = checked(rank, Case.init(&driver, bytes, 0, false, rank));
+        defer c.deinit();
+        for (0..3) |seed| {
+            checked(rank, c.prepare(gpa, rank, @intCast(seed)));
+            checked(rank, c.enqueue(&comm, stream));
+            c.check(gpa, &comm, stream, rank, @intCast(seed)) catch |e| die(e, rank);
+        }
+        std.debug.print("PASS rank={d} eager bytes={d} backend={s} guard=true oracle=nccl changing=3\n", .{ rank, bytes, @tagName(checked(rank, comm.gatherBackend(c.src(), c.dst(), bytes, .u8))) });
+    }
+    // Four-byte alignment and in-place rank slices exercise the RoCE general API.
+    for ([_]bool{ false, true }) |alias| {
+        var c = checked(rank, Case.init(&driver, 16384, if (alias) 0 else 4, alias, rank));
+        defer c.deinit();
+        checked(rank, c.prepare(gpa, rank, 17));
+        checked(rank, c.enqueue(&comm, stream));
+        c.check(gpa, &comm, stream, rank, 17) catch |e| die(e, rank);
+        std.debug.print("PASS rank={d} layout alias={} offset={d} backend={s}\n", .{ rank, alias, c.offset, @tagName(checked(rank, comm.gatherBackend(c.src(), c.dst(), c.bytes, .u8))) });
+        if (alias) {
+            checked(rank, c.prepare(gpa, rank, 18));
+            checked(rank, comm.allGatherInPlace(c.src(), c.dst(), c.bytes, .u8, stream.handle));
+            c.check(gpa, &comm, stream, rank, 18) catch |e| die(e, rank);
+            std.debug.print("PASS rank={d} explicit-in-place backend=nccl\n", .{rank});
+        }
+    }
+    var mixed: [3]Case = undefined;
+    var opened: usize = 0;
+    defer for (mixed[0..opened]) |*c| c.deinit();
+    for (plan.mixed, 0..) |bytes, i| {
+        mixed[i] = checked(rank, Case.init(&driver, bytes, 0, false, rank));
+        opened += 1;
+        checked(rank, mixed[i].prepare(gpa, rank, 0));
+        // Warm all collective shapes before entering capture.
+        checked(rank, mixed[i].enqueue(&comm, stream));
+    }
+    checked(rank, stream.synchronize());
+    checked(rank, comm.check());
+    const first_backend = checked(rank, comm.gatherBackend(mixed[0].src(), mixed[0].dst(), mixed[0].bytes, .u8));
+    const middle_backend = checked(rank, comm.gatherBackend(mixed[1].src(), mixed[1].dst(), mixed[1].bytes, .u8));
+    const last_backend = checked(rank, comm.gatherBackend(mixed[2].src(), mixed[2].dst(), mixed[2].bytes, .u8));
+    if (middle_backend != .nccl) die(error.ProbeRequiresFallbackMiddle, rank);
+    if (first_backend != backend or last_backend != backend) die(error.ProbeRequiresRequestedGraphBackend, rank);
+    std.debug.print("GRAPH rank={d} backends={s},{s},{s} bytes={d},{d},{d}\n", .{ rank, @tagName(first_backend), @tagName(middle_backend), @tagName(last_backend), plan.mixed[0], plan.mixed[1], plan.mixed[2] });
+    // Every GPU is done with eager work, then wait for the proxies' trailing
+    // completion polls. Counts for captured calls are deliberately excluded.
+    phase(rank, "eager_barrier");
+    checked(rank, link.agreeRanks(gpa, rank, "glm-transport-probe eager synchronized"));
+    phase(rank, "eager_counter_drain");
+    const drained = waitCounters(&comm, io, checked(rank, eagerTarget(comm.stats(), ring))) catch |e| die(e, rank);
+    snapshot(rank, "eager_drained", drained);
+    phase(rank, "capture_begin");
+    checked(rank, cuda.graph.beginCapture(stream, .global));
+    for (&mixed) |*c| checked(rank, c.enqueue(&comm, stream));
+    phase(rank, "capture_end");
+    var graph = checked(rank, cuda.graph.endCapture(stream));
+    defer graph.deinit();
+    phase(rank, "graph_instantiate");
+    var exec = checked(rank, graph.instantiate());
+    defer exec.deinit(); // graphs die before buffers, stream and Comm
+    const before_replay = comm.stats(); // includes capture enqueues, no replay
+    checked(rank, captureReady(gpa, link, rank, drained, before_replay));
+    phase(rank, "replay_begin");
+    const t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+    for (0..replays) |iteration| {
+        if (iteration % 8 == 0) std.debug.print("PHASE rank={d} stage=replay iteration={d}/{d}\n", .{ rank, iteration, replays });
+        const seed: u32 = @intCast(iteration + 100);
+        for (&mixed) |*c| checked(rank, c.prepare(gpa, rank, seed));
+        checked(rank, exec.launchOn(stream));
+        for (&mixed) |*c| c.check(gpa, &comm, stream, rank, seed) catch |e| die(e, rank);
+    }
+    const elapsed = std.Io.Clock.awake.now(io).toNanoseconds() - t0;
+    phase(rank, "replay_barrier");
+    checked(rank, link.agreeRanks(gpa, rank, "glm-transport-probe graph synchronized"));
+    phase(rank, "replay_counter_drain");
+    const counts = waitCounters(&comm, io, checked(rank, replayTarget(before_replay, first_backend, replays, ring))) catch |e| die(e, rank);
+    snapshot(rank, "replay_drained", counts);
+    validateReplayCounts(before_replay, counts, first_backend, replays, ring) catch |e| die(e, rank);
+    std.debug.print("GRAPH_COUNTERS rank={d} replays={d} roce_ops_delta={d} relay_stripes_delta={d} enqueue_counts_unchanged=true\n", .{ rank, replays, counts.roce_ops - before_replay.roce_ops, counts.relayed_stripes - before_replay.relayed_stripes });
+    std.debug.print("COUNTERS rank={d} nccl_enqueues={d} roce_enqueues={d} roce_gpu_ops={d} relayed_stripes={d} registered_host_bytes={d}\n", .{ rank, counts.nccl_enqueues, counts.roce_enqueues, counts.roce_ops, counts.relayed_stripes, counts.registered_host_bytes });
+    if (registered and counts.registered_host_bytes == 0) die(error.NoRegisteredRegion, rank);
+    const profile = requested_profile;
+    if (std.mem.eql(u8, profile, "roce") and (counts.roce_ops == 0 or counts.roce_enqueues == 0)) die(error.NoRoceExecution, rank);
+    if (std.mem.eql(u8, profile, "roce") and ring and counts.relayed_stripes == 0) die(error.NoRelayExecution, rank);
+    if (!ring and counts.relayed_stripes != 0) die(error.UnexpectedDirectRelay, rank);
+    checked(rank, link.agreeRanks(gpa, rank, "glm-registered-rdma-probe-v2 passed"));
+    std.debug.print("PASS rank={d} mixed-graph=true replays={d} slot-reuse=true guards=true exact=true elapsed_ns={d} (includes host checks; not a benchmark)\n", .{ rank, replays, elapsed });
+}
+
+// Probe support is intentionally bounded. Read the live transport's agreed slot size,
+// not an environment default. The registered RDMA cutoff is fixed at 512 KiB.
+const max_probe_bytes: usize = (1024 << 10) + 16;
+fn activeCutoff(comm: *const Comm) u64 {
+    if (comm.extra) |x| {
+        if (x.r) |r| return r.slot_bytes;
+    }
+    return 0;
+}
+const SizePlan = struct {
+    cutoff: u64,
+    eager: [10]usize = .{ 8, 16, 68, 4096, 16384, 98304, 262144, 524288, 524304, 1048576 },
+    eager_len: usize = 10,
+    mixed: [3]usize = .{ 16384, 524304, 32768 },
+    fn init(backend: Comm.GatherBackend, cutoff: u64) !SizePlan {
+        switch (backend) {
+            .nccl => if (cutoff != 0) return error.ProbeProfileMismatch,
+            .roce => if (cutoff != 512 << 10) return error.UnsupportedProbeCutoff,
+        }
+        return .{ .cutoff = cutoff };
+    }
+};
+const CaseSizes = struct { send: usize, recv: usize, oracle: usize };
+fn caseSizes(bytes: usize, offset: usize) !CaseSizes {
+    if (bytes == 0 or bytes > max_probe_bytes or (offset != 0 and offset != 4)) return error.UnsupportedProbeCase;
+    const payload = try std.math.mul(usize, 4, bytes);
+    const edges = try std.math.add(usize, 2 * guard, offset);
+    return .{ .send = try std.math.add(usize, bytes, edges), .recv = try std.math.add(usize, payload, edges), .oracle = payload };
+}
+
+const Case = struct {
+    send: cuda.DeviceBuffer,
+    recv: cuda.DeviceBuffer,
+    oracle: cuda.DeviceBuffer,
+    bytes: usize,
+    offset: usize,
+    alias: bool,
+    rank: u32,
+    fn init(d: *const cuda.Driver, bytes: usize, offset: usize, alias: bool, rank: u32) !Case {
+        if (rank >= 4) return error.BadCaseRank;
+        const sizes = try caseSizes(bytes, offset);
+        var send = try cuda.DeviceBuffer.alloc(d, sizes.send);
+        errdefer send.free();
+        var recv = try cuda.DeviceBuffer.alloc(d, sizes.recv);
+        errdefer recv.free();
+        return .{ .send = send, .recv = recv, .oracle = try cuda.DeviceBuffer.alloc(d, sizes.oracle), .bytes = bytes, .offset = offset, .alias = alias, .rank = rank };
+    }
+    fn deinit(c: *Case) void {
+        c.oracle.free();
+        c.recv.free();
+        c.send.free();
+    }
+    fn src(c: *const Case) u64 {
+        return if (c.alias) c.dst() + c.rank * c.bytes else c.send.ptr + guard + c.offset;
+    }
+    fn dst(c: *const Case) u64 {
+        return c.recv.ptr + guard + c.offset;
+    }
+    fn prepare(c: *Case, gpa: std.mem.Allocator, rank: u32, seed: u32) !void {
+        const input = try gpa.alloc(u8, c.bytes);
+        defer gpa.free(input);
+        pattern(input, rank, seed);
+        try c.send.fill8(sentinel, null);
+        try c.recv.fill8(sentinel, null);
+        try c.oracle.fill8(0, null);
+        if (c.alias) try c.recv.upload(guard + c.offset + rank * c.bytes, input) else try c.send.upload(guard + c.offset, input);
+    }
+    fn enqueue(c: *Case, comm: *Comm, stream: cuda.Stream) !void {
+        try comm.allGatherThen(c.src(), c.dst(), c.bytes, .u8, stream.handle, .{});
+    }
+    fn check(c: *Case, gpa: std.mem.Allocator, comm: *Comm, stream: cuda.Stream, rank: u32, seed: u32) !void {
+        try stream.synchronize();
+        try comm.check(); // proxy/abort failures cannot masquerade as returned bytes
+        try comm.lib.check(comm.lib.api.ncclAllGather(c.src(), c.oracle.ptr, c.bytes, .u8, comm.comm, stream.handle), "probe NCCL oracle");
+        try stream.synchronize();
+        try comm.check();
+        const actual = try gpa.alloc(u8, c.recv.len);
+        defer gpa.free(actual);
+        try c.recv.download(0, actual);
+        const expected = try gpa.alloc(u8, 4 * c.bytes);
+        defer gpa.free(expected);
+        for (0..4) |p| pattern(expected[p * c.bytes ..][0..c.bytes], @intCast(p), seed);
+        const payload = actual[guard + c.offset ..][0 .. 4 * c.bytes];
+        if (!std.mem.eql(u8, expected, payload)) return error.WrongRankBytes;
+        for (actual[0 .. guard + c.offset]) |b| if (b != sentinel) return error.GuardBefore;
+        for (actual[guard + c.offset + 4 * c.bytes ..]) |b| if (b != sentinel) return error.GuardAfter;
+        try c.oracle.download(0, expected);
+        if (!std.mem.eql(u8, expected, payload)) return error.NcclOracleMismatch;
+        if (!c.alias) {
+            const source = try gpa.alloc(u8, c.send.len);
+            defer gpa.free(source);
+            try c.send.download(0, source);
+            pattern(expected[0..c.bytes], rank, seed);
+            if (!std.mem.eql(u8, expected[0..c.bytes], source[guard + c.offset ..][0..c.bytes])) return error.SourceChanged;
+            for (source[0 .. guard + c.offset]) |b| if (b != sentinel) return error.SourceGuardBefore;
+            for (source[guard + c.offset + c.bytes ..]) |b| if (b != sentinel) return error.SourceGuardAfter;
+        }
+    }
+};
+fn pattern(out: []u8, rank: u32, seed: u32) void {
+    for (out, 0..) |*b, i| b.* = @truncate((@as(u64, seed) *% 104729) ^ (@as(u64, rank + 1) *% 65497) ^ (@as(u64, i) *% 251) ^ (i >> 7));
+    // These are bytes, not arithmetic: preserve signed zero/NaN payloads/subnormals.
+    if (out.len >= 64) for ([_]u32{ 0, 0x80000000, 0x7fc01234 | rank, 1, 0x7f800000, 0xff800000 }, 0..) |word, i| {
+        std.mem.writeInt(u32, out[4 * i ..][0..4], word, .little);
+    };
+}
+
+// Fail at the call site, before any CUDA/transport resource defers can block.
+// Keep the original error; Zig 0.17 does not support errdefer error capture.
+fn checked(rank: u32, result: anytype) @typeInfo(@TypeOf(result)).error_union.payload {
+    return result catch |e| die(e, rank);
+}
+
+fn die(e: anyerror, rank: u32) noreturn {
+    std.debug.print("FAIL rank={d} error={t} (fleet supervisor must stop peers)\n", .{ rank, e });
+    std.c._exit(1);
+}
+
+fn phase(rank: u32, name: []const u8) void {
+    if (@import("builtin").is_test) return;
+    std.debug.print("PHASE rank={d} stage={s}\n", .{ rank, name });
+}
+fn snapshot(rank: u32, name: []const u8, s: Comm.Stats) void {
+    if (@import("builtin").is_test) return;
+    std.debug.print("SNAPSHOT rank={d} stage={s} nccl_enqueues={d} roce_enqueues={d} roce_ops={d} relay_stripes={d}\n", .{ rank, name, s.nccl_enqueues, s.roce_enqueues, s.roce_ops, s.relayed_stripes });
+}
+
+// Snapshot BEFORE the barrier: a fast rank must not replay until every peer has
+// sampled its counters. A peer's relay proxy can forward remote stripes before
+// its own GPU launches anything, so a barrier before sampling is insufficient.
+fn captureReady(gpa: std.mem.Allocator, link: anytype, rank: u32, drained: Comm.Stats, before: Comm.Stats) !void {
+    snapshot(rank, "capture_snapshot", before);
+    if (!sameExecutionCounts(drained, before)) {
+        snapshot(rank, "capture_expected", drained);
+        return error.CaptureExecutedTransport;
+    }
+    phase(rank, "capture_snapshot_barrier");
+    try link.agreeRanks(gpa, rank, "glm-transport-probe capture snapshots complete");
+}
+
+// Proxy polls can lag GPU synchronization. Bound each drain independently, and
+// include transport failure checks rather than accepting partial abort output.
+fn waitCounters(comm: *const Comm, io: std.Io, target: Comm.Stats) !Comm.Stats {
+    const deadline = std.Io.Clock.awake.now(io).toNanoseconds() + 5 * std.time.ns_per_s;
+    while (true) {
+        try comm.check();
+        const current = comm.stats();
+        if (reachedCounters(current, target)) return current;
+        if (std.Io.Clock.awake.now(io).toNanoseconds() >= deadline) {
+            std.debug.print("COUNTER_DRAIN_TIMEOUT rank={d} roce={d}/{d} stripes={d}/{d}\n", .{ comm.rank, current.roce_ops, target.roce_ops, current.relayed_stripes, target.relayed_stripes });
+            return error.ProxyCounterDrainTimeout;
+        }
+        try std.Io.sleep(io, .fromMilliseconds(1), .awake);
+    }
+}
+fn reachedCounters(current: Comm.Stats, target: Comm.Stats) bool {
+    return current.roce_ops >= target.roce_ops and current.relayed_stripes >= target.relayed_stripes;
+}
+fn eagerTarget(current: Comm.Stats, ring: bool) !Comm.Stats {
+    if (current.roce_ring != ring) return error.ProbeTopologyMismatch;
+    if (!ring and current.relayed_stripes != 0) return error.UnexpectedDirectRelay;
+    var target = current;
+    target.roce_ops = current.roce_enqueues;
+    // tf_roce_set_ring sets n_relay=n_flag. Every gather forwards each stripe,
+    // including empty payload stripes' flags, so this also drains relay posts.
+    if (ring) target.relayed_stripes = try std.math.mul(u64, current.roce_enqueues, current.roce_stripes);
+    return target;
+}
+fn replayTarget(before: Comm.Stats, backend: Comm.GatherBackend, replays: usize, ring: bool) !Comm.Stats {
+    if (before.roce_ring != ring) return error.ProbeTopologyMismatch;
+    if (!ring and before.relayed_stripes != 0) return error.UnexpectedDirectRelay;
+    var target = before;
+    const calls = try std.math.mul(u64, replays, 2);
+    switch (backend) {
+        .roce => {
+            target.roce_ops = try std.math.add(u64, before.roce_ops, calls);
+            if (ring) target.relayed_stripes = try std.math.add(u64, before.relayed_stripes, try std.math.mul(u64, calls, before.roce_stripes));
+        },
+        .nccl => {},
+    }
+    return target;
+}
+fn sameExecutionCounts(a: Comm.Stats, b: Comm.Stats) bool {
+    return a.roce_ops == b.roce_ops and a.relayed_stripes == b.relayed_stripes;
+}
+fn validateReplayCounts(before: Comm.Stats, after: Comm.Stats, backend: Comm.GatherBackend, replays: usize, ring: bool) !void {
+    if (before.roce_ring != after.roce_ring or after.roce_ring != ring) return error.ProbeTopologyMismatch;
+    if (!ring and after.relayed_stripes != 0) return error.UnexpectedDirectRelay;
+    if (before.nccl_enqueues != after.nccl_enqueues or before.roce_enqueues != after.roce_enqueues) return error.HostEnqueueDuringReplay;
+    const target = try replayTarget(before, backend, replays, ring);
+    switch (backend) {
+        .roce => {
+            if (after.roce_ops < target.roce_ops) return error.RoceReplayCounterMismatch;
+            if (ring and after.relayed_stripes < target.relayed_stripes) return error.RelayReplayCounterMismatch;
+        },
+        .nccl => if (!sameExecutionCounts(before, after)) return error.UnexpectedCustomReplay,
+    }
+}
+
+test "graph counters require relay progress and no host enqueue during replay" {
+    const before: Comm.Stats = .{ .nccl_enqueues = 4, .roce_enqueues = 32, .roce_ops = 30, .relayed_stripes = 120, .roce_stripes = 4, .roce_ring = true };
+    var after = try replayTarget(before, .roce, 64, true);
