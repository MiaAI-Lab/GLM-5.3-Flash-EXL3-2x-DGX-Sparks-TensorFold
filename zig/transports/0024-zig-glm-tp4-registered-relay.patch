+/// Registered relay requires the advertised subnet graph of a ring: neighbors
+/// reachable, both diagonals absent. This checks addresses, not physical cabling
+/// or isolation; operators must verify those independently.
+pub fn planRegisteredRing(addrs: []const [max_ports]?Addr) !Plan {
+    const plan = try planRoutes(addrs, true);
+    for (0..2) |rank| {
+        const diagonal = [_][max_ports]?Addr{ addrs[rank], addrs[rank + 2] };
+        if (planRoutes(&diagonal, false)) |_| {
+            return error.RegisteredRingHasDiagonalRoute;
+        } else |e| if (e != error.NoSharedSubnet) return e;
+    }
