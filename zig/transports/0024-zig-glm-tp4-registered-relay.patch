+const Transport = enum(u8) { nccl, roce };
+const Startup = struct {
+    mode: Transport,
+    memory: roce.region.Mode,
+    required: bool,
+    prefetch: bool,
+    ring: bool,
+    roce_enabled: bool,
+
+    const Input = struct {
