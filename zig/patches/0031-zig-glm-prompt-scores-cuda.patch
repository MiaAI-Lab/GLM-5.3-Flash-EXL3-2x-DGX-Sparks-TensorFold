index 0000000000000000000000000000000000000000..99e5ddc680eab8309d553f738cdd3e69e1c5636f
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_prompt_index.zig
@@ -0,0 +1,212 @@
+//! A prompt chunk's DSA indexer in CUDA: pool scores (glm_prompt_scores.cu) and one-pass top-K pools
+//! (glm_prompt_pools.cu), ported from BadAd84's Python patches 0105 (TF_GLM_SCORES_CUDA) and 0101 (prompt_pools).
+//! The same scores as Triton `_scores`, bit for bit, and the same pools as `_select_rows`; the Triton launches stay
+//! the fallback (switch off, a build without the fatbins, a pool count off the 64 grid).
+const std = @import("std");
+const cuda = @import("cuda");
+
+pub const topk: usize = 512;
+/// glm_prompt_scores: rows a CTA (a warp each), 64-pool tiles a CTA, threads.
+pub const score_rows: usize = 8;
+pub const score_tiles: usize = 16;
+pub const score_pools: usize = 64;
+/// glm_prompt_pools: threads a row, candidates its shared memory holds.
+pub const pool_threads: usize = 256;
+pub const cap_max: usize = 4096;
+
+/// TF_GLM_SCORES_CUDA (default on; "0": Triton `_scores` and selection, today's path) and TF_GLM_SELECT_FLOOR
+/// (default on; "0": Triton selection with the CUDA scores, to bisect a difference).
+pub const Switches = struct {
+    scores: bool = true,
+    select: bool = true,
+
+    pub fn parse(scores_text: ?[]const u8, select_text: ?[]const u8) Switches {
+        const on = !off(scores_text);
+        return .{ .scores = on, .select = on and !off(select_text) };
+    }
+    pub fn read() Switches {
+        return parse(env("TF_GLM_SCORES_CUDA"), env("TF_GLM_SELECT_FLOOR"));
+    }
+    fn off(text: ?[]const u8) bool {
+        return std.mem.eql(u8, std.mem.trim(u8, text orelse return false, " "), "0");
+    }
+    fn env(name: [:0]const u8) ?[]const u8 {
+        return std.mem.sliceTo(std.c.getenv(name) orelse return null, 0);
+    }
+};
+
+pub const Cfg = struct { grid: [3]u32, block: u32 };
+
+/// glm_prompt_scores' launch: rows in CTAs of 8, the pool blocks in runs of 16 (NP a multiple of 64).
+pub fn scoresCfg(rows: usize, np: usize) !Cfg {
+    if (!scoresFit(np) or rows == 0 or rows > std.math.maxInt(i32)) return error.BadScoresLaunch;
+    const blocks = np / score_pools;
+    return .{ .grid = .{ @intCast(cdiv(rows, score_rows)), @intCast(cdiv(blocks, score_tiles)), 1 }, .block = score_rows * 32 };
+}
+pub fn scoresFit(np: usize) bool {
+    return np > 0 and np % score_pools == 0 and np <= std.math.maxInt(i32);
+}
+
+/// 0101's PROMPT_TILES: (most scores a row, CAP, TARGET). Speed only.
+pub const Tile = struct { cap: usize, target: usize };
+pub fn promptTile(np: usize) Tile {
+    if (np <= 12288) return .{ .cap = 1024, .target = 724 };
+    if (np <= 32768) return .{ .cap = 2048, .target = 1024 };
+    return .{ .cap = 4096, .target = 2048 };
+}
+
+/// glm_prompt_pools' launch: one CTA a row.
+pub fn poolsCfg(rows: usize, np: usize, k: usize) !Cfg {
+    if (rows == 0 or rows > std.math.maxInt(i32) or np < k or k == 0 or np > std.math.maxInt(i32)) return error.BadPoolsLaunch;
+    return .{ .grid = .{ @intCast(rows), 1, 1 }, .block = pool_threads };
+}
+
+pub const Kernels = struct {
+    scores_mod: cuda.Module,
+    pools_mod: cuda.Module,
+    scores_fn: cuda.Function,
+    pools_fn: cuda.Function,
+
+    /// cuda.kernels.glm_prompt_scores / glm_prompt_pools (empty when the build has no such fatbin).
+    pub fn load(d: *const cuda.Driver, scores_image: []const u8, pools_image: []const u8) !Kernels {
+        if (scores_image.len == 0 or pools_image.len == 0) return error.NoPromptIndexKernels;
+        var sm = try cuda.Module.load(d, scores_image);
+        errdefer sm.unload();
+        var pm = try cuda.Module.load(d, pools_image);
+        errdefer pm.unload();
+        return .{ .scores_mod = sm, .pools_mod = pm, .scores_fn = try sm.function("glm_prompt_scores"), .pools_fn = try pm.function("glm_prompt_pools") };
+    }
+    pub fn unload(k: *Kernels) void {
+        k.scores_mod.unload();
+        k.pools_mod.unload();
+    }
+    /// out [rows, np] fp32: qi [rows, 32 * 128] bf16, w bf16 head weights (w_stride apart), pk FP8 keys (rs-byte rows,
+    /// the fp32 scale at byte 128), pos int32 [1] (row r at pos + r).
+    pub fn scores(k: *const Kernels, s: cuda.Stream, qi: u64, w: u64, w_stride: usize, pk: u64, rs: usize, out: u64, pos: u64, rows: usize, np: usize, scale: f32, wscale: f32) !void {
+        const c = try scoresCfg(rows, np);
+        if (rs % 16 != 0 or rs < 128 + 4 or pk % 16 != 0) return error.BadScoresLaunch;
+        var a: cuda.Args = .{};
+        for ([_]u64{ qi, w }) |x| a.add(x);
+        a.add(@as(c_int, @intCast(w_stride)));
+        a.add(pk);
+        a.add(@as(c_int, @intCast(rs)));
+        for ([_]u64{ out, pos }) |x| a.add(x);
+        a.add(@as(c_int, @intCast(rows)));
+        a.add(@as(c_int, @intCast(np)));
+        a.add(scale);
+        a.add(wscale);
+        try cuda.launch.launch(k.scores_fn, .{ .grid = .{ .x = c.grid[0], .y = c.grid[1] }, .block = .{ .x = c.block } }, s, &a);
+    }
+    /// out [rows, kk] int64: each row's kk best pools of scores [rows, np] ascending; path: 0 or int32 [rows].
+    pub fn pools(k: *const Kernels, s: cuda.Stream, scores_ptr: u64, out: u64, rows: usize, np: usize, kk: usize, path: u64) !void {
+        const c = try poolsCfg(rows, np, kk);
+        const t = promptTile(np);
+        var a: cuda.Args = .{};
+        for ([_]u64{ scores_ptr, out }) |x| a.add(x);
+        for ([_]usize{ np, kk, t.cap, t.target }) |x| a.add(@as(c_int, @intCast(x)));
+        a.add(path);
+        try cuda.launch.launch(k.pools_fn, .{ .grid = .{ .x = c.grid[0] }, .block = .{ .x = c.block } }, s, &a);
+    }
+};
+
+/// The prompt engine's choice: the kernels when loaded (switch on, fatbins built), and whether they select too.
+pub const Use = struct {
+    k: ?*const Kernels = null,
+    select: bool = false,
+
+    /// glm_prompt_scores for np pools, else null (Triton `_scores`).
+    pub fn scores(u: Use, np: usize) ?*const Kernels {
+        return if (scoresFit(np)) u.k else null;
+    }
+    /// glm_prompt_pools for a prompt block, else null (Triton `_select_rows` / `_select_split`).
+    pub fn pools(u: Use, np: usize) ?*const Kernels {
+        return if (u.select and np >= topk) u.k else null;
+    }
+};
+
+/// `_order_key`: a score as a u32 whose unsigned order is the scores' (-0 as +0).
+pub fn orderKey(s: f32) u32 {
+    const bits: i32 = @bitCast(s + 0.0);
+    return @bitCast(bits ^ ((bits >> 31) | std.math.minInt(i32)));
+}
+
+/// `_select_rows`' pools for one row, on the CPU: the k best keys, ties to the lower pool, ascending.
+pub fn topPoolsRef(gpa: std.mem.Allocator, row: []const f32, out: []i64) !void {
+    if (out.len > row.len) return error.BadPoolsLaunch;
+    const order = try gpa.alloc(u32, row.len);
+    defer gpa.free(order);
+    for (order, 0..) |*o, i| o.* = @intCast(i);
+    const Ctx = struct {
+        row: []const f32,
+        fn better(c: @This(), a: u32, b: u32) bool {
+            const ka = orderKey(c.row[a]);
+            const kb = orderKey(c.row[b]);
+            return ka > kb or (ka == kb and a < b);
+        }
+    };
+    std.mem.sort(u32, order, Ctx{ .row = row }, Ctx.better);
+    const best = order[0..out.len];
+    std.mem.sort(u32, best, {}, std.sort.asc(u32));
+    for (out, best) |*o, i| o.* = i;
+}
+
+fn cdiv(a: usize, b: usize) usize {
+    return (a + b - 1) / b;
+}
+
+test "TF_GLM_SCORES_CUDA defaults on, 0 is the Triton path, TF_GLM_SELECT_FLOOR=0 keeps the CUDA scores" {
+    try std.testing.expectEqual(Switches{ .scores = true, .select = true }, Switches.parse(null, null));
+    try std.testing.expectEqual(Switches{ .scores = true, .select = true }, Switches.parse("1", ""));
+    try std.testing.expectEqual(Switches{ .scores = false, .select = false }, Switches.parse("0", null));
+    try std.testing.expectEqual(Switches{ .scores = false, .select = false }, Switches.parse(" 0 ", "1"));
+    try std.testing.expectEqual(Switches{ .scores = true, .select = false }, Switches.parse(null, "0"));
+}
+
+test "scores launch: 8 rows a CTA, 16 pool blocks a CTA, pool counts on the 64 grid only" {
+    // a 512-row block at 590k: 147,456 pools, 2,304 blocks
+    try std.testing.expectEqual(Cfg{ .grid = .{ 64, 144, 1 }, .block = 256 }, try scoresCfg(512, 147456));
+    try std.testing.expectEqual(Cfg{ .grid = .{ 11, 1, 1 }, .block = 256 }, try scoresCfg(88, 1024));
+    try std.testing.expectEqual(Cfg{ .grid = .{ 1, 2, 1 }, .block = 256 }, try scoresCfg(1, 64 * 17));
+    try std.testing.expectError(error.BadScoresLaunch, scoresCfg(512, 1000));
+    try std.testing.expectError(error.BadScoresLaunch, scoresCfg(0, 1024));
+    try std.testing.expect(!scoresFit(0));
+    try std.testing.expect(scoresFit(262144));
+}
+
+test "pools launch and 0101's tiles" {
+    try std.testing.expectEqual(Cfg{ .grid = .{ 512, 1, 1 }, .block = 256 }, try poolsCfg(512, 147456, topk));
+    try std.testing.expectError(error.BadPoolsLaunch, poolsCfg(512, 511, topk));
+    try std.testing.expectEqual(Tile{ .cap = 1024, .target = 724 }, promptTile(12288));
+    try std.testing.expectEqual(Tile{ .cap = 2048, .target = 1024 }, promptTile(12289));
+    try std.testing.expectEqual(Tile{ .cap = 2048, .target = 1024 }, promptTile(32768));
+    try std.testing.expectEqual(Tile{ .cap = 4096, .target = 2048 }, promptTile(32769));
+    try std.testing.expect(promptTile(1 << 30).cap <= cap_max);
+}
+
+test "the CPU reference: best keys, -0 equal to +0, ties to the lower pool, ascending" {
+    const gpa = std.testing.allocator;
+    const inf = std.math.inf(f32);
+    const row = [_]f32{ 1, -inf, 3, 0.0, -0.0, 3, 2, -inf };
+    var out: [4]i64 = undefined;
+    try topPoolsRef(gpa, &row, &out);
+    try std.testing.expectEqualSlices(i64, &.{ 0, 2, 5, 6 }, &out);
+    var five: [5]i64 = undefined;
+    try topPoolsRef(gpa, &row, &five);
+    try std.testing.expectEqualSlices(i64, &.{ 0, 2, 3, 5, 6 }, &five);
+    var all: [7]i64 = undefined;
+    try topPoolsRef(gpa, &row, &all);
+    try std.testing.expectEqualSlices(i64, &.{ 0, 1, 2, 3, 4, 5, 6 }, &all);
+    try std.testing.expectEqual(orderKey(0.0), orderKey(-0.0));
+    try std.testing.expect(orderKey(-1) < orderKey(-0.5) and orderKey(-inf) < orderKey(-1) and orderKey(1) < orderKey(inf));
+}
+
+test "the prompt engine takes the kernels only when loaded: scores on the 64 grid, pools when selecting" {
+    const k: *const Kernels = @ptrFromInt(0x1000);
+    try std.testing.expect((Use{}).scores(1024) == null);
+    try std.testing.expect((Use{ .k = k }).scores(1024) == k);
+    try std.testing.expect((Use{ .k = k }).scores(1000) == null);
+    try std.testing.expect((Use{ .k = k }).pools(1024) == null);
+    try std.testing.expect((Use{ .k = k, .select = true }).pools(1024) == k);
+    try std.testing.expect((Use{ .k = k, .select = true }).pools(511) == null);
+    try std.testing.expect((Use{ .select = true }).pools(1024) == null);
+}
diff --git a/zig/tests/cuda/glm_index_check.zig b/zig/tests/cuda/glm_index_check.zig
new file mode 100644
index 0000000000000000000000000000000000000000..595a5df2feb58ae3c80b7a5f58ae42abafd27227
--- /dev/null
+++ b/zig/tests/cuda/glm_index_check.zig
@@ -0,0 +1,161 @@
+//! tf-glm-index-check AOT_DIR (GPU): the prompt indexer's CUDA kernels (BadAd84's 0105 / 0101 ported,
+//! cuda_prompt_index.zig) against the captured Triton ones on the same inputs: glm_prompt_scores vs `_scores` byte
+//! for byte, glm_prompt_pools vs `_select_rows` (and a CPU top-K on a few rows), on random FP8 keys and on tied
+//! scores, 512-row blocks at 1k..262k pools (4k..1M tokens). Prints each kernel's time a block.
+const std = @import("std");
+const cuda = @import("cuda");
+const glm = @import("glm_cuda");
+const idx = glm.prompt_index;
+const grid = glm.prefill_grid;
+
+const R = 512;
+const nps = [_]usize{ 1024, 4096, 16384, 65536, 147456, 262144 };
+
+fn bf16(x: f32) u16 {
+    const b: u32 = @bitCast(x);
+    return @intCast((b + 0x7FFF + ((b >> 16) & 1)) >> 16);
+}
+
+pub fn main(init: std.process.Init) !void {
+    const gpa = init.gpa;
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    if (args.len != 2) return error.ExpectedAotDirectory;
+    var d = try cuda.Driver.open();
+    defer d.close();
+    var ctx = try cuda.Context.init(&d, 0);
+    defer ctx.deinit();
+    var s = try cuda.Stream.init(&d, true);
+    defer s.deinit();
+    var set = try cuda.aot.Set.load(gpa, init.io, &d, ctx.device, args[1]);
+    defer set.deinit();
+    var memo: glm.triton.Memo = .{ .gpa = gpa };
+    defer memo.deinit();
+    const tri: glm.triton.Tri = .{ .set = &set, .s = s, .memo = &memo };
+    var k = try idx.Kernels.load(&d, cuda.kernels.glm_prompt_scores, cuda.kernels.glm_prompt_pools);
+    defer k.unload();
+
+    const np_max = nps[nps.len - 1];
+    var rng = std.Random.DefaultPrng.init(0x105);
+    const rand = rng.random();
+    // queries [R, 32 * 128] bf16, head weights in columns 128.. of [R, 160] bf16, FP8 keys [np_max, 144]
+    const q = try gpa.alloc(u16, R * 4096);
+    defer gpa.free(q);
+    for (q) |*x| x.* = bf16(rand.floatNorm(f32));
+    const w = try gpa.alloc(u16, R * 160);
+    defer gpa.free(w);
+    for (w) |*x| x.* = bf16(rand.floatNorm(f32));
+    const pk = try gpa.alloc(u8, np_max * 144);
+    defer gpa.free(pk);
+    for (0..np_max) |p| {
+        const row = pk[p * 144 ..][0..144];
+        for (row[0..128]) |*c| {
+            c.* = rand.int(u8);
+            if (c.* & 0x7F == 0x7F) c.* ^= 1; // no e4m3 NaN (S.1111.111)
+        }
+        std.mem.writeInt(u32, row[128..132], @bitCast(0.01 + rand.float(f32) * 0.09), .little);
+        @memset(row[132..], 0);
+    }
+    var dq = try cuda.DeviceBuffer.fromHost(&d, std.mem.sliceAsBytes(q));
+    defer dq.free();
+    var dw = try cuda.DeviceBuffer.fromHost(&d, std.mem.sliceAsBytes(w));
+    defer dw.free();
+    var dk = try cuda.DeviceBuffer.fromHost(&d, pk);
+    defer dk.free();
+    var dpos = try cuda.DeviceBuffer.alloc(&d, 16);
+    defer dpos.free();
+    var sa = try cuda.DeviceBuffer.alloc(&d, R * np_max * 4);
+    defer sa.free();
+    var sb = try cuda.DeviceBuffer.alloc(&d, R * np_max * 4);
+    defer sb.free();
+    var pa = try cuda.DeviceBuffer.alloc(&d, R * idx.topk * 8);
+    defer pa.free();
+    var pb = try cuda.DeviceBuffer.alloc(&d, R * idx.topk * 8);
+    defer pb.free();
+    var path = try cuda.DeviceBuffer.alloc(&d, R * 4);
+    defer path.free();
+    const ha = try gpa.alloc(u8, R * np_max * 4);
+    defer gpa.free(ha);
+    const hb = try gpa.alloc(u8, R * np_max * 4);
+    defer gpa.free(hb);
+    var fails: usize = 0;
+    for (nps) |np| {
+        const pos: i32 = @intCast(np * 4 - R - 100); // the last rows see nearly every pool, the first ~R/4 fewer
+        try dpos.upload(0, std.mem.asBytes(&pos));
+        const gy = (np / 64 + grid.score_loop - 1) / grid.score_loop;
+        const wts = dw.ptr + 128 * 2;
+        for (0..2) |_| try tri.scores(.{ R, gy, 1 }, dq.ptr, wts, 160, dk.ptr, dk.ptr, sa.ptr, dpos.ptr, R, @intCast(np), grid.score_scale, grid.wscale_h32, .{ .H = 32, .HP = 32, .D = 128, .BP = 64, .L = grid.score_loop, .RS = 144, .FP8 = 1 });
+        try k.scores(s, dq.ptr, wts, 160, dk.ptr, 144, sb.ptr, dpos.ptr, R, np, grid.score_scale, grid.wscale_h32);
+        try s.synchronize();
+        const t0 = now(init.io);
+        try tri.scores(.{ R, gy, 1 }, dq.ptr, wts, 160, dk.ptr, dk.ptr, sa.ptr, dpos.ptr, R, @intCast(np), grid.score_scale, grid.wscale_h32, .{ .H = 32, .HP = 32, .D = 128, .BP = 64, .L = grid.score_loop, .RS = 144, .FP8 = 1 });
+        try s.synchronize();
+        const t1 = now(init.io);
+        try k.scores(s, dq.ptr, wts, 160, dk.ptr, 144, sb.ptr, dpos.ptr, R, np, grid.score_scale, grid.wscale_h32);
+        try s.synchronize();
+        const t2 = now(init.io);
+        const bytes = R * np * 4;
+        try sa.download(0, ha[0..bytes]);
+        try sb.download(0, hb[0..bytes]);
+        const diff = differ(f32, ha[0..bytes], hb[0..bytes]);
+        if (diff > 0) fails += 1;
+        std.debug.print("np {d}: scores {d} of {d} differ; Triton {d:.2} ms, CUDA {d:.2} ms\n", .{ np, diff, R * np, ms(t0, t1), ms(t1, t2) });
+        fails += try pools(gpa, init.io, tri, &k, s, sa, ha[0..bytes], pa, pb, path, np, "scores");
+        // tied scores: each a multiple of 1/4 in [0, 4), -inf past a row's visible pools as the scoring writes them
+        const f: []f32 = @alignCast(std.mem.bytesAsSlice(f32, ha[0..bytes]));
+        for (f, 0..) |*x, i| x.* = if (i % np < (@as(usize, @intCast(pos)) + i / np + 1) / 4) @as(f32, @floatFromInt(rand.uintLessThan(u32, 16))) * 0.25 else -std.math.inf(f32);
+        try sa.upload(0, ha[0..bytes]);
+        fails += try pools(gpa, init.io, tri, &k, s, sa, ha[0..bytes], pa, pb, path, np, "ties");
+    }
+    std.debug.print("{s}: {d} failures\n", .{ if (fails == 0) "PASS" else "FAIL", fails });
+    if (fails != 0) std.process.exit(1);
+}
+
+/// Triton `_select_rows` and glm_prompt_pools on the scores in sa (host copy `host`); the first rows also on the CPU.
+fn pools(gpa: std.mem.Allocator, io: std.Io, tri: glm.triton.Tri, k: *const idx.Kernels, s: cuda.Stream, sa: cuda.DeviceBuffer, host: []const u8, pa: cuda.DeviceBuffer, pb: cuda.DeviceBuffer, path: cuda.DeviceBuffer, np: usize, what: []const u8) !usize {
+    try tri.select_rows(.{ R, 1, 1 }, sa.ptr, pa.ptr, @intCast(np), sa.ptr, "*fp32", .{ .K = grid.topk_pools, .BLOCK = 1024, .VIS = 0 });
+    try k.pools(s, sa.ptr, pb.ptr, R, np, idx.topk, path.ptr);
+    try s.synchronize();
+    const t0 = now(io);
+    try tri.select_rows(.{ R, 1, 1 }, sa.ptr, pa.ptr, @intCast(np), sa.ptr, "*fp32", .{ .K = grid.topk_pools, .BLOCK = 1024, .VIS = 0 });
+    try s.synchronize();
+    const t1 = now(io);
+    try k.pools(s, sa.ptr, pb.ptr, R, np, idx.topk, path.ptr);
+    try s.synchronize();
+    const t2 = now(io);
+    const a = try gpa.alloc(i64, R * idx.topk);
+    defer gpa.free(a);
+    const b = try gpa.alloc(i64, R * idx.topk);
+    defer gpa.free(b);
+    try pa.download(0, std.mem.sliceAsBytes(a));
+    try pb.download(0, std.mem.sliceAsBytes(b));
+    var p: [R]i32 = undefined;
+    try path.download(0, std.mem.sliceAsBytes(&p));
+    var taken = [3]usize{ 0, 0, 0 };
+    for (p) |x| taken[@intCast(x)] += 1;
+    var fails: usize = 0;
+    var rows: usize = 0;
+    for (0..R) |r| rows += @intFromBool(!std.mem.eql(i64, a[r * idx.topk ..][0..idx.topk], b[r * idx.topk ..][0..idx.topk]));
+    if (rows > 0) fails += 1;
+    const f: []const f32 = @alignCast(std.mem.bytesAsSlice(f32, host));
+    var want: [idx.topk]i64 = undefined;
+    for ([_]usize{ 0, 1, R / 2, R - 1 }) |r| {
+        try idx.topPoolsRef(gpa, f[r * np ..][0..np], &want);
+        if (!std.mem.eql(i64, &want, b[r * idx.topk ..][0..idx.topk])) fails += 1;
+    }
+    std.debug.print("np {d} {s}: pools of {d} rows differ from Triton; paths row/candidates/fallback {d}/{d}/{d}; Triton {d:.2} ms, CUDA {d:.2} ms\n", .{ np, what, rows, taken[0], taken[1], taken[2], ms(t0, t1), ms(t1, t2) });
+    return fails;
+}
+
+fn differ(comptime T: type, a: []const u8, b: []const u8) usize {
+    const x: []const T = @alignCast(std.mem.bytesAsSlice(T, a));
+    const y: []const T = @alignCast(std.mem.bytesAsSlice(T, b));
+    var n: usize = 0;
+    for (x, y) |p, q| n += @intFromBool(@as(u32, @bitCast(p)) != @as(u32, @bitCast(q)));
+    return n;
+}
+fn now(io: std.Io) std.Io.Timestamp {
+    return std.Io.Timestamp.now(io, .awake);
+}
+fn ms(a: std.Io.Timestamp, b: std.Io.Timestamp) f64 {
+    return @as(f64, @floatFromInt(a.durationTo(b).nanoseconds)) / 1e6;
+}
