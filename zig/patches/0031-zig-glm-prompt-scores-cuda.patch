diff --git a/tools/glm_pools_emulate/cuda_runtime.h b/tools/glm_pools_emulate/cuda_runtime.h
new file mode 100644
index 0000000000000000000000000000000000000000..bf8bade4fef88351e1d9b7b0f2e27dcc7bfb9378
--- /dev/null
+++ b/tools/glm_pools_emulate/cuda_runtime.h
@@ -0,0 +1,44 @@
+// Stand-ins for the CUDA names glm_prompt_pools.cu uses, so its kernel runs as host C++ (emulate.cpp): one OS thread
+// per CUDA thread, __syncthreads a real barrier over the block, a warp's shuffles a real exchange between its lanes,
+// shared memory a function static (blocks run one after another).
+#pragma once
+#include <algorithm>
+#include <atomic>
+#include <barrier>
+#include <cstdint>
+#include <cstring>
+#define __global__
+#define __device__
+#define __forceinline__ inline
+#define __restrict__
+#define __launch_bounds__(x)
+#define __shared__ static
+struct dim3 { unsigned x, y, z; };
+struct float4 { float x, y, z, w; };
+inline thread_local dim3 threadIdx, blockIdx;
+namespace emu {
+inline std::barrier<>* block_bar;
+inline std::barrier<>* warp_bar[32];
+inline int xbuf[1024];
+}  // namespace emu
+inline void __syncthreads() { emu::block_bar->arrive_and_wait(); }
+inline int __shfl_up_sync(unsigned, int v, int d) {
+  const int t = (int)threadIdx.x, l = t & 31;
+  std::barrier<>* w = emu::warp_bar[t >> 5];
+  emu::xbuf[t] = v;
+  w->arrive_and_wait();
+  const int r = l >= d ? emu::xbuf[t - d] : v;
+  w->arrive_and_wait();
+  return r;
+}
+inline int atomicAdd(int* p, int v) { return std::atomic_ref<int>(*p).fetch_add(v); }
+inline int atomicMax(int* p, int v) {
+  std::atomic_ref<int> a(*p);
+  int old = a.load();
+  while (old < v && !a.compare_exchange_weak(old, v)) {}
+  return old;
+}
+inline int __float_as_int(float f) { int i; std::memcpy(&i, &f, 4); return i; }
+inline float __fadd_rn(float a, float b) { return a + b; }
+using std::max;
+using std::min;
diff --git a/tools/glm_pools_emulate/emulate.cpp b/tools/glm_pools_emulate/emulate.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e1b052a120ca528c43d12adab0ba473bf7a6edce
--- /dev/null
+++ b/tools/glm_pools_emulate/emulate.cpp
@@ -0,0 +1,96 @@
+// glm_prompt_pools.cu (a prompt chunk's top-K pools, BadAd84's 0101 in CUDA) run on the host, every thread of a block
+// at once with real barriers, against a plain top-K (`_select_rows`: best order keys, ties to the lower pool,
+// ascending). Random, tied, all-equal, -inf-tailed, signed-zero, skewed and decoy (fewer than K at the floor) rows,
+// at pool counts around every CAP; each of the three paths must be taken.
+// No nvcc or GPU: clang++ -std=c++20 -I tools/glm_pools_emulate tools/glm_pools_emulate/emulate.cpp -o <out> && <out>
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <random>
+#include <thread>
+#include <vector>
+#include "../../zig/kernels/cuda/glm_prompt_pools.cu"
+
+static int tile_cap(int np) { return np <= 12288 ? 1024 : np <= 32768 ? 2048 : 4096; }
+static int tile_target(int np) { return np <= 12288 ? 724 : np <= 32768 ? 1024 : 2048; }
+
+// every block in turn, its 256 threads at once
+static void run(int rows, const float* s, long long* out, int np, int k, int* path) {
+  for (int b = 0; b < rows; b++) {
+    std::barrier<> block(glm_pools::T);
+    std::vector<std::barrier<>*> warps;
+    for (int w = 0; w < glm_pools::WARPS; w++) warps.push_back(new std::barrier<>(32));
+    emu::block_bar = &block;
+    for (int w = 0; w < glm_pools::WARPS; w++) emu::warp_bar[w] = warps[w];
+    std::vector<std::thread> ts;
+    for (int t = 0; t < glm_pools::T; t++)
+      ts.emplace_back([=] {
+        blockIdx = {(unsigned)b, 0, 0};
+        threadIdx = {(unsigned)t, 0, 0};
+        glm_prompt_pools(s, out, np, k, tile_cap(np), tile_target(np), path);
+      });
+    for (auto& t : ts) t.join();
+    for (auto* w : warps) delete w;
+  }
+}
+
+static uint32_t key(float s) { return glm_pools::order_key(s); }
+
+static std::vector<long long> reference(const float* row, int np, int k) {
+  std::vector<int> o(np);
+  for (int i = 0; i < np; i++) o[i] = i;
+  std::stable_sort(o.begin(), o.end(), [&](int a, int b) { return key(row[a]) > key(row[b]); });
+  std::vector<long long> best(o.begin(), o.begin() + k);
+  std::sort(best.begin(), best.end());
+  return best;
+}
+
+enum Kind { normal, ties, equal, tail, zeros, skewed, decoy };
+
+static void fill(std::mt19937_64& g, float* row, int np, Kind kind) {
+  std::normal_distribution<float> nd(0.0f, 3.0f);
+  const int visible = kind == tail ? std::max(512, (int)(g() % (unsigned)np) + 1) : np;
+  for (int i = 0; i < np; i++) {
+    float v = nd(g);
+    if (kind == ties) v = (float)(int)(g() % 9) * 0.5f;
+    if (kind == equal) v = 1.25f;
+    if (kind == zeros) v = g() % 3 == 0 ? 0.0f : g() % 2 ? -0.0f : (float)(g() % 1000) * 1e-3f - 0.6f;
+    if (kind == skewed) v = i % 997 == 0 ? 100.0f + (float)(g() % 5) : -INFINITY;
+    if (kind == decoy) v = (float)(g() % 1000) * 1e-3f;   // the sampled runs high below: the floor overshoots
+    row[i] = i < visible ? v : -INFINITY;
+  }
+  if (kind == decoy && np > 4096)   // _sample_floor's runs: fewer than K pools at or above the floor
+    for (int s = 0; s < glm_pools::NS * 8; s++) {
+      const long long j = (long long)(s / 8) * np / glm_pools::NS / 8 * 8 + s % 8;
+      if (j < np) row[j] = 10.0f + (float)(g() % 100000) * 1e-4f;
+    }
+}
+
+int main() {
+  std::mt19937_64 g(0x101);
+  const int K = 512;
+  int fails = 0, paths[3] = {0, 0, 0};
+  const int nps[] = {512, 1000, 1024, 4096, 4097, 12288, 12289, 20001, 32768, 32769, 40000, 70001};
+  for (int np : nps)
+    for (Kind kind : {normal, ties, equal, tail, zeros, skewed, decoy}) {
+      const int rows = 2;
+      std::vector<float> s((size_t)rows * np + 4);
+      float* base = s.data() + (np % 4 ? 1 : 0);   // an unaligned row now and then: the scalar loads
+      for (int r = 0; r < rows; r++) fill(g, base + (size_t)r * np, np, kind);
+      std::vector<long long> out((size_t)rows * K, -7);
+      std::vector<int> path(rows, -1);
+      run(rows, base, out.data(), np, K, path.data());
+      for (int r = 0; r < rows; r++) {
+        paths[path[r]]++;
+        const auto want = reference(base + (size_t)r * np, np, K);
+        if (!std::equal(want.begin(), want.end(), out.begin() + (size_t)r * K)) {
+          fails++;
+          printf("np %d kind %d row %d (path %d) differs\n", np, (int)kind, r, path[r]);
+        }
+      }
+    }
+  printf("paths: whole row %d, candidates %d, whole row after candidates %d\n", paths[0], paths[1], paths[2]);
+  if (paths[1] == 0 || paths[2] == 0) { fails++; printf("a path was never taken\n"); }
+  printf("%s (%d failures)\n", fails ? "FAIL" : "PASS", fails);
+  return fails != 0;
+}
