+test "exchanges: a fixed block a rank when captured, RoCE up to its slot, else the crossing rows, paired across ranks" {
+    var ls: shard.Lists = .{};
+    // captured: every row of the window, the transport by the block's size (16 rows fill the default 512 KiB slot)
+    try std.testing.expectEqual(@as(usize, 512 << 10), 16 * dec.row_bytes);
+    const g = dec.plan(.q, 0x1000, 0x100000, 16, 1, true, true, &ls);
+    try std.testing.expectEqual(dec.Way.gather, g.way);
+    try std.testing.expectEqual(@as(usize, 16 * 32 * 512), g.count);
+    try std.testing.expectEqual(@as(u64, 0x100000), g.recv);
+    const w = dec.plan(.out, 0x1000, 0x100000, 17, 0, true, false, &ls);
+    try std.testing.expectEqual(dec.Way.swap, w.way);
+    try std.testing.expectEqual(@as(u64, 0x100000), w.recv); // the peer's block of rank 0 is the first
+    try std.testing.expectEqual(@as(u64, 0x100000 + 17 * dec.row_bytes), dec.plan(.out, 0x1000, 0x100000, 17, 1, true, false, &ls).recv);
+    // uncaptured: the crossing rows, as runs of whole streams; rank r's sends meet rank 1 - r's receives
+    var prng = std.Random.DefaultPrng.init(118);
+    const rnd = prng.random();
+    for (0..500) |_| {
+        const rows = rnd.intRangeAtMost(usize, 1, 64);
+        var orank: [64]i32 = undefined;
+        var r: usize = 0;
+        var streams: usize = 0;
+        while (r < rows) : (streams += 1) {
+            const n = @min(rows - r, rnd.intRangeAtMost(usize, 1, 16));
+            const o: i32 = rnd.intRangeAtMost(i32, 0, 1);
+            @memset(orank[r..][0..n], o);
+            r += n;
+        }
+        var lists: [2]shard.Lists = undefined;
+        for (0..2) |k| lists[k] = try shard.lists(orank[0..rows], k);
+        for ([_]shard.Exchange{ .q, .out }) |x| {
+            var sent: usize = 0;
+            for (0..2) |k| {
+                const mine = dec.plan(x, 0x1000 + k * 0x1000000, 0x8000000 + k * 0x1000000, rows, 1 - k, false, rnd.boolean(), &lists[k]);
+                const theirs = dec.plan(x, 0x1000 + (1 - k) * 0x1000000, 0x8000000 + (1 - k) * 0x1000000, rows, k, false, rnd.boolean(), &lists[1 - k]);
+                try std.testing.expectEqual(dec.Way.rows, mine.way);
+                try std.testing.expect(mine.out.n <= streams);
+                try std.testing.expectEqual(mine.out.n, theirs.in.n);
+                for (mine.out.slice(), theirs.in.slice()) |o, i| {
+                    try std.testing.expectEqual(o[1], i[1]);
+                    // a run leaves from its rows of `send` and lands at the same rows of the peer's block of `recv`
+                    try std.testing.expectEqual(o[0] - (0x1000 + k * 0x1000000), i[0] - dec.block(0x8000000 + (1 - k) * 0x1000000, k, rows));
+                    sent += o[1];
+                }
+                // what a rank sends: the queries of the rows the peer owns, the peer's heads of its own
+                for (mine.out.slice()) |o| {
+                    const first = (o[0] - (0x1000 + k * 0x1000000)) / dec.row_bytes;
+                    for (first..first + o[1] / dec.row_bytes) |row| try std.testing.expectEqual(x == .out, orank[row] == @as(i32, @intCast(k)));
+                }
+            }
+            // every row crosses once an exchange, one way or the other
+            try std.testing.expectEqual(rows * dec.row_bytes, sent);
+        }
+    }
+}
+
+// -- the two-rank model ---------------------------------------------------------------------------------------------
+
+/// The model's memory: named host buffers, a pointer valid only inside one of them.
+const Mem = struct {
+    names: [64][]const u8 = undefined,
+    spans: [64][]u8 = undefined,
+    n: usize = 0,
+    fn add(m: *Mem, name: []const u8, b: []u8) u64 {
+        m.names[m.n] = name;
+        m.spans[m.n] = b;
+        m.n += 1;
+        return @intFromPtr(b.ptr);
+    }
+    fn of(m: *const Mem, addr: u64) ?usize {
+        for (m.spans[0..m.n], 0..) |s, i| if (addr >= @intFromPtr(s.ptr) and addr < @intFromPtr(s.ptr) + s.len) return i;
+        return null;
+    }
+    fn at(m: *const Mem, addr: u64, len: usize) ![]u8 {
+        const i = m.of(addr) orelse return error.OffBuffer;
+        const s = m.spans[i];
+        const off = addr - @intFromPtr(s.ptr);
+        if (off + len > s.len) return error.OffBuffer;
+        return s[off..][0..len];
+    }
+    fn word(m: *const Mem, addr: u64) !i32 {
+        return std.mem.readInt(i32, (try m.at(addr, 4))[0..4], .little);
+    }
+};
+
+fn toBf16(x: f32) u16 {
+    if (std.math.isNan(x)) return 0x7fc0;
+    const b: u32 = @bitCast(x);
+    return @truncate((b + 0x7fff + ((b >> 16) & 1)) >> 16);
+}
+fn fromBf16(h: u16) f32 {
+    return @bitCast(@as(u32, h) << 16);
+}
+
+/// The modelled Triton kernels: `_seg_lat_write` (a row's latent quantized into LC at BASE + POS), `_seg_chunks` with
+/// `_merge` (a row's output from its queries and the key rows it reads: BASE + its tokens' positions when SPR, else
+/// BASE + 0 .. POS; NaN with none), each address checked against the buffers.
+fn exec(m: *const Mem, s: *const Recorder.Saved) !void {
+    const rows: usize = s.grid[0];
+    if (std.mem.eql(u8, s.name, "_seg_lat_write")) {
+        const stride: usize = @intCast(arg(s, "lat_stride").value.i32);
+        for (0..rows) |r| {
+            const row: usize = @intCast(try m.word(ptrArg(s, "BASE") + 4 * r) + try m.word(ptrArg(s, "POS") + 4 * r));
+            var x: [512]f32 = undefined;
+            const lat = try m.at(ptrArg(s, "LAT") + 2 * r * stride, 1024);
+            for (&x, 0..) |*v, j| v.* = fromBf16(std.mem.readInt(u16, lat[2 * j ..][0..2], .little));
+            mla.quantizeRow(&x, try m.at(ptrArg(s, "LC") + row * 528, 528));
+        }
+    } else if (std.mem.eql(u8, s.name, "_seg_chunks")) {
+        const w: usize = @intCast(constArg(s, "W"));
+        for (0..rows) |r| {
+            const spr = try m.word(ptrArg(s, "SPR") + 4 * r);
+            const base: usize = @intCast(try m.word(ptrArg(s, "BASE") + 4 * r));
+            const n: usize = @intCast(if (spr != 0) try m.word(ptrArg(s, "CNT") + 4 * r) else try m.word(ptrArg(s, "POS") + 4 * r) + 1);
+            var acc: [512]f32 = @splat(0);
+            for (0..n) |i| {
+                const tok: usize = @intCast(if (spr != 0) try m.word(ptrArg(s, "TOK") + 4 * (r * w + i)) else @as(i32, @intCast(i)));
+                var k: [512]f32 = undefined;
+                mla.dequantRow(try m.at(ptrArg(s, "LC") + (base + tok) * 528, 528), &k);
+                for (&acc, k) |*a, v| a.* += v;
+            }
+            for (0..32) |h| {
+                const q = try m.at(ptrArg(s, "QA") + 2 * (r * 32 + h) * 512, 1024);
+                const o = try m.at(ptrArg(s, "PO") + 4 * (r * 32 + h) * 512, 2048);
+                for (0..512) |j| {
+                    const v: f32 = if (n == 0) std.math.nan(f32) else fromBf16(std.mem.readInt(u16, q[2 * j ..][0..2], .little)) * (1 + acc[j]);
+                    std.mem.writeInt(u32, o[4 * j ..][0..4], @bitCast(v), .little);
+                }
+            }
+            _ = try m.at(ptrArg(s, "PM") + 4 * r * 32, 4 * 32);
+            _ = try m.at(ptrArg(s, "PL") + 4 * r * 32, 4 * 32);
+        }
+    } else if (std.mem.eql(u8, s.name, "_merge")) {
+        for (0..rows) |r| {
+            const from = try m.at(ptrArg(s, "PO") + 4 * r * 32 * 512, 4 * 32 * 512);
+            const to = try m.at(ptrArg(s, "OUT") + 2 * r * 32 * 512, 2 * 32 * 512);
+            for (0..32 * 512) |j| std.mem.writeInt(u16, to[2 * j ..][0..2], toBf16(@bitCast(std.mem.readInt(u32, from[4 * j ..][0..4], .little))), .little);
+        }
+    } else return error.UnmodelledKernel;
+}
+
+/// The buffers a launch or a device call reads and writes (by Mem index), for the race check.
+const Access = struct {
+    reads: std.StaticBitSet(64) = .empty,
+    writes: std.StaticBitSet(64) = .empty,
+    fn add(a: *Access, m: *const Mem, addr: u64, write: bool) void {
+        const i = m.of(addr) orelse return;
+        if (write) a.writes.set(i) else a.reads.set(i);
+    }
+    fn launch(a: *Access, m: *const Mem, s: *const Recorder.Saved) void {
+        const lat = std.mem.eql(u8, s.name, "_seg_lat_write");
+        for (s.args[0..s.nargs]) |x| if (x.value == .ptr) {
+            const out = for ([_][]const u8{ "PO", "PM", "PL", "OUT" }) |o| {
+                if (std.mem.eql(u8, o, x.name)) break true;
+            } else lat and std.mem.eql(u8, x.name, "LC");
+            a.add(m, x.value.ptr.addr, out);
+        };
+    }
+    fn op(a: *Access, m: *const Mem, o: *const Op) void {
+        switch (o.*) {
+            .counts => |c| {
+                a.add(m, c.in, false);
+                a.add(m, c.own, false);
+                a.add(m, c.out, true);
+            },
+            .exchange => |p| {
+                a.add(m, p.send, false);
+                a.add(m, p.recv, true);
+            },
+            .select => |c| {
+                a.add(m, c.recv, false);
+                a.add(m, c.own, false);
+                a.add(m, c.out, true);
+            },
+            .fork, .join => {},
+        }
+    }
+};
+
+/// Between the fork and the join, nothing the side stream writes is touched on the main stream and nothing the main
+/// stream writes is read on the side.
+fn races(m: *const Mem, l: *const Log) !void {
+    var f: ?usize = null;
+    var j: ?usize = null;
+    for (l.at[0..l.n], 0..) |e, i| switch (e.op) {
+        .fork => f = i,
+        .join => j = i,
+        else => {},
+    };
+    const fi = f orelse return;
+    const ji = j orelse return error.NeverJoined;
+    var side: Access = .{};
+    var main: Access = .{};
+    for (l.side.launches[l.at[fi].side..l.at[ji].side]) |*s| side.launch(m, s);
+    for (l.main.launches[l.at[fi].main..l.at[ji].main]) |*s| main.launch(m, s);
+    for (l.at[fi + 1 .. ji]) |*e| main.op(m, &e.op);
+    var touched = main.reads;
+    touched.setUnion(main.writes);
+    if (side.writes.intersectWith(touched).count() != 0 or main.writes.intersectWith(side.reads).count() != 0) return error.StreamsRace;
+}
+
+/// One rank's progress through its log: the launches before each device call, then the call.
+const Cursor = struct {
+    l: *const Log,
+    i: usize = 0,
+    mi: usize = 0,
+    si: usize = 0,
+    fn launches(c: *Cursor, m: *const Mem, main: usize, side: usize) !void {
+        while (c.mi < main) : (c.mi += 1) try exec(m, &c.l.main.launches[c.mi]);
+        while (c.si < side) : (c.si += 1) try exec(m, &c.l.side.launches[c.si]);
+    }
+    /// Up to the next exchange (returned) or the end (null).
+    fn next(c: *Cursor, m: *const Mem) !?*const dec.Plan {
+        while (c.i < c.l.n) {
+            const e = &c.l.at[c.i];
+            try c.launches(m, e.main, e.side);
+            c.i += 1;
+            switch (e.op) {
+                .exchange => |*p| return p,
+                .counts => |x| dec.countsRef(ints(try m.at(x.in, 4 * x.rows)), ints(try m.at(x.own, 4 * x.rows)), ints(try m.at(x.out, 4 * x.rows))),
+                .select => |x| dec.selectRef(try m.at(x.recv, x.rows * dec.row_bytes), try m.at(x.out, x.rows * dec.row_bytes), ints(try m.at(x.own, 4 * x.rows)), dec.row_bytes),
+                .fork, .join => {},
+            }
+        }
+        try c.launches(m, c.l.main.n, c.l.side.n);
+        return null;
+    }
+};
+
+fn ints(b: []u8) []i32 {
+    return @alignCast(std.mem.bytesAsSlice(i32, b));
+}
+
+/// Both ranks' halves of one exchange, as the transport moves them (the peer's bytes from before the exchange).
+fn swap(m: *const Mem, p: [2]*const dec.Plan) !void {
+    if (p[0].way != p[1].way or p[0].count != p[1].count) return error.ExchangeMismatch;
+    const n = p[0].count * 2;
+    for (0..2) |k| {
+        const mine = p[k];
+        const theirs = p[1 - k];
+        switch (mine.way) {
+            .gather => {
+                @memcpy(try m.at(mine.recv + (1 - k) * n, n), try m.at(theirs.send, n));
+                @memcpy(try m.at(mine.recv + k * n, n), try m.at(mine.send, n));
+            },
+            .swap => @memcpy(try m.at(mine.recv, n), try m.at(theirs.send, n)),
+            .rows => {
+                if (mine.in.n != theirs.out.n) return error.ExchangeMismatch;
+                for (mine.in.slice(), theirs.out.slice()) |i, o| {
+                    if (i[1] != o[1]) return error.ExchangeMismatch;
+                    @memcpy(try m.at(i[0], i[1]), try m.at(o[0], o[1]));
+                }
+            },
+        }
+    }
+}
+
+/// Both ranks' logs in step: each up to its next exchange, the exchange, on to the end.
+fn lockstep(m: *const Mem, logs: [2]*const Log) !void {
+    var c: [2]Cursor = .{ .{ .l = logs[0] }, .{ .l = logs[1] } };
+    while (true) {
+        const a = try c[0].next(m);
+        const b = try c[1].next(m);
+        if (a == null and b == null) return;
+        if (a == null or b == null) return error.ExchangeMismatch;
+        try swap(m, .{ a.?, b.? });
+    }
+}
+
+/// One rank's buffers.
+const Rank = struct {
+    tables: seg.SegRows,
+    full: []u8, // the unsharded latent plane (every pool row)
+    local: []u8, // the sharded one: its part, then the trash rows
+    bufs: [16][]u8 = undefined,
+    nb: usize = 0,
+    fn buf(r: *Rank, m: *Mem, name: []const u8, len: usize) !u64 {
+        const b = try gpa.alignedAlloc(u8, .fromByteUnits(256), len);
+        @memset(b, 0);
+        r.bufs[r.nb] = b;
+        r.nb += 1;
+        return m.add(name, b);
+    }
+    fn deinit(r: *Rank) void {
+        for (r.bufs[0..r.nb]) |b| gpa.free(@as([]align(256) u8, @alignCast(b)));
+        gpa.free(r.full);
+        gpa.free(r.local);
+        r.tables.deinit();
+    }
+};
+
+const pool_rows = 8 * 2048;
+const sparse_from = 32;
+
+/// One random window on both ranks: unsharded attention per rank, then owner decode; true when each rank's heads of
+/// every row and its latent rows are the unsharded ones', with no race and nothing off a buffer.
+fn trial(rnd: std.Random, fixed: bool, overlap: bool) !bool {
+    var m: Mem = .{};
+    // streams in distinct extents, either part; rows dense (positions under `sparse_from`) or sparse
+    const nseg = rnd.intRangeAtMost(usize, 1, 4);
+    var slots: [8]usize = .{ 0, 1, 2, 3, 4, 5, 6, 7 };
+    rnd.shuffle(usize, &slots);
+    var segs: [4]seg.Segment = undefined;
+    var rows: usize = 0;
+    for (segs[0..nseg], slots[0..nseg]) |*s, slot| {
+        const n = rnd.intRangeAtMost(usize, 1, 4);
+        const pos = if (rnd.boolean()) rnd.intRangeAtMost(usize, 0, sparse_from + 2) else rnd.intRangeAtMost(usize, sparse_from + 8, 1900);
+        s.* = .{ .base = slot * 2048, .pos = pos, .rows = n, .ring_base = slot * 64 };
+        rows += n;
+    }
+    var rk: [2]Rank = undefined;
+    var made: usize = 0;
+    defer for (rk[0..made]) |*r| r.deinit();
+    for (0..2) |k| {
+        const sh = try shard.Shard.init(k, 2, pool_rows, shard.trash);
+        rk[k] = .{ .tables = try seg.SegRows.initShard(gpa, 64, 8, 64, sh), .full = try gpa.alloc(u8, pool_rows * 528), .local = try gpa.alloc(u8, (sh.part + sh.trash) * 528) };
+        made += 1;
+        _ = try rk[k].tables.fill(segs[0..nseg], sparse_from);
+        rk[k].tables.dev = .{ .d = undefined, .ptr = m.add("tables", std.mem.sliceAsBytes(rk[k].tables.host)), .len = rk[k].tables.host.len * 4, .borrowed = true };
+        @memset(rk[k].full, 0);
+        _ = m.add("full", rk[k].full);
+        _ = m.add("local", rk[k].local);
+    }
+    // the history: latent rows before each stream's position, alike on both ranks (and on the owner's part)
+    var x: [512]f32 = undefined;
+    for (segs[0..nseg]) |s| for (0..s.pos) |t| {
+        for (&x) |*v| v.* = mla.bf16(rnd.float(f32) * 4 - 2);
+        mla.quantizeRow(&x, rk[0].full[(s.base + t) * 528 ..][0..528]);
+    };
+    @memcpy(rk[1].full, rk[0].full);
+    for (0..2) |k| {
+        const part = pool_rows / 2;
+        @memcpy(rk[k].local[0 .. part * 528], rk[k].full[k * part * 528 ..][0 .. part * 528]);
+        rnd.bytes(rk[k].local[part * 528 ..]); // the trash rows: anything
+    }
+    // the window's inputs: the latent rows and the selection replicated, the queries each rank's own heads
+    const lat_len = rows * 512 * 2;
+    var lat_bytes: [16 * 1024]u8 = undefined;
+    for (0..rows * 512) |j| std.mem.writeInt(u16, lat_bytes[2 * j ..][0..2], toBf16(rnd.float(f32) * 4 - 2), .little);
+    var tokens: [16 * 2051]i32 = @splat(0);
+    var counts: [64]i32 = @splat(0);
+    {
+        var r: usize = 0;
+        for (segs[0..nseg]) |s| for (0..s.rows) |i| {
+            const q = s.pos + i;
+            if (q >= sparse_from) {
+                counts[r] = rnd.intRangeAtMost(i32, 1, 12);
+                for (0..@intCast(counts[r])) |j| tokens[r * 2051 + j] = rnd.intRangeLessThan(i32, 0, @intCast(q));
+            } else {
+                counts[r] = rnd.intRangeAtMost(i32, 0, 4); // read by nothing
+                for (0..8) |j| tokens[r * 2051 + j] = rnd.intRangeLessThan(i32, 0, 2000);
+            }
+            r += 1;
+        };
+    }
+    const row = dec.row_bytes;
+    var ptr: [2]struct { lat: u64, qa: u64, ol: u64, ref: u64, po: u64, pm: u64, pl: u64, tok: u64, cnt: u64, p: dec.Ptrs } = undefined;
+    for (0..2) |k| {
+        const r = &rk[k];
+        ptr[k].lat = try r.buf(&m, "lat", lat_len);
+        @memcpy(try m.at(ptr[k].lat, lat_len), lat_bytes[0..lat_len]);
+        ptr[k].qa = try r.buf(&m, "qa", rows * row);
+        const qa = try m.at(ptr[k].qa, rows * row);
+        for (0..rows * 32 * 512) |j| std.mem.writeInt(u16, qa[2 * j ..][0..2], toBf16(rnd.float(f32) * 2 - 1), .little);
+        ptr[k].ol = try r.buf(&m, "ol", rows * row);
+        ptr[k].ref = try r.buf(&m, "ref", rows * row);
+        ptr[k].po = try r.buf(&m, "po", 5 * rows * 32 * 512 * 4);
+        ptr[k].pm = try r.buf(&m, "pm", 5 * rows * 32 * 4);
+        ptr[k].pl = try r.buf(&m, "pl", 5 * rows * 32 * 4);
+        ptr[k].tok = try r.buf(&m, "tokens", rows * 2051 * 4);
+        @memcpy(try m.at(ptr[k].tok, rows * 2051 * 4), std.mem.sliceAsBytes(tokens[0 .. rows * 2051]));
+        ptr[k].cnt = try r.buf(&m, "counts", 64 * 4);
+        @memcpy(try m.at(ptr[k].cnt, 64 * 4), std.mem.sliceAsBytes(&counts));
+        const sz = dec.layout(rows);
+        ptr[k].p = .{ .qall = try r.buf(&m, "qall", sz[0]), .olp = try r.buf(&m, "olp", sz[1]), .orecv = try r.buf(&m, "orecv", sz[2]), .ce = try r.buf(&m, "ce", sz[3]), .po = try r.buf(&m, "po2", sz[4]), .pm = try r.buf(&m, "pm2", sz[5]), .pl = try r.buf(&m, "pl2", sz[6]) };
+    }
+    const recs = try gpa.alloc(Recorder, 6);
+    defer gpa.free(recs);
+    for (recs) |*r| r.* = .{};
+    const hb = hbOf(rows);
+    const ri: i32 = @intCast(rows);
+    // each rank unsharded (cuda_forward.dsaMtp): its heads over the whole plane
+    for (0..2) |k| {
+        const t: Tri = .{ .rec = &recs[4 + k] };
+        const tb = &rk[k].tables;
+        const lc: u64 = @intFromPtr(rk[k].full.ptr);
+        try t.seg_lat_write(.{ rows, 1, 1 }, ptr[k].lat, 512, lc, lc, try tb.ptr(0), try tb.ptr(1), .{ .LW = 512, .RS = 528, .FP8 = 1 });
+        try t.seg_chunks(.{ rows, (32 + hb - 1) / hb, 5 }, ptr[k].qa, lc, lc, try tb.ptr(0), try tb.ptr(1), try tb.ptr(3), ptr[k].tok, ptr[k].cnt, ptr[k].po, ptr[k].pm, ptr[k].pl, ri, .{ .W = 2051, .H = 32, .LW = 512, .CH = 512, .SCALE = 0.0625, .HBT = @intCast(hb), .KTT = 32, .RS = 528, .FP8 = 1 });
+        try t.merge(.{ rows, 32, 1 }, ptr[k].po, ptr[k].pm, ptr[k].pl, ptr[k].ref, ptr[k].cnt, ri, .{ .H = 32, .LW = 512, .NCH = 5, .SPARSE = 0 });
+        for (recs[4 + k].launches[0..recs[4 + k].n]) |*s| try exec(&m, s);
+    }
+    // each rank sharded: the latent write through the glue, then owner decode
+    var logs: [2]Log = undefined;
+    const roce = rnd.boolean(); // the ranks' RoCE choice is the size's, alike on both
+    for (0..2) |k| {
+        const tb = &rk[k].tables;
+        logs[k] = .{ .main = &recs[2 * k], .side = &recs[2 * k + 1], .rank = k, .fixed = fixed, .roce = roce, .lists = try shard.lists(tb.plane(9 + @as(usize, @backingInt(shard.Glue.orank)))[0..rows], k) };
+        const t: Tri = .{ .rec = &recs[2 * k] };
+        const lc: u64 = @intFromPtr(rk[k].local.ptr);
+        try dec.latWrite(t, tb, rows, ptr[k].lat, lc);
+        try dec.run(&logs[k], t, .{ .rows = rows, .rank = k, .hb = hb, .qa = ptr[k].qa, .lc = lc, .pos = try tb.ptr(0), .lbase = try dec.plane(tb, .lbase), .sparse = try dec.plane(tb, .sparse_eff), .own = try dec.plane(tb, .own), .tokens = ptr[k].tok, .counts = ptr[k].cnt, .out = ptr[k].ol, .po = ptr[k].po, .pm = ptr[k].pm, .pl = ptr[k].pl, .overlap = overlap }, ptr[k].p);
+    }
+    for (&logs) |*l| races(&m, l) catch return false;
+    lockstep(&m, .{ &logs[0], &logs[1] }) catch |e| switch (e) {
+        error.OffBuffer, error.ExchangeMismatch => return false,
+        else => return e,
+    };
+    // each rank's heads of every row, bit for bit; the latent rows where the glue puts them
+    for (0..2) |k| {
+        if (!std.mem.eql(u8, try m.at(ptr[k].ol, rows * row), try m.at(ptr[k].ref, rows * row))) return false;
+        const sh = rk[k].tables.shard.?;
+        var r: usize = 0;
+        for (segs[0..nseg]) |s| for (0..s.rows) |i| {
+            const want = rk[k].full[(s.base + s.pos + i) * 528 ..][0..528];
+            const at = if (sh.owns(s.base)) sh.local(s.base) + s.pos + i else sh.trashRow(r);
+            if (!std.mem.eql(u8, rk[k].local[at * 528 ..][0..528], want)) return false;
+            r += 1;
+        };
+    }
+    return true;
+}
+
+test "two ranks' owner decode gives each rank its unsharded heads, captured or not, side stream on or off" {
+    var prng = std.Random.DefaultPrng.init(1180);
+    const rnd = prng.random();
+    for (0..24) |i| {
+        if (!try trial(rnd, i % 2 == 0, i % 4 < 2)) {
+            std.debug.print("owner decode trial {d} differs from the unsharded attention\n", .{i});
+            return error.TestUnexpectedResult;
+        }
+    }
+}
+
+test "every owner decode mutant is caught by the two-rank model" {
+    defer dec.mutant = .none;
+    var prng = std.Random.DefaultPrng.init(1181);
+    const rnd = prng.random();
+    for (std.enums.values(dec.Mutant)) |mu| {
+        if (mu == .none) continue;
+        dec.mutant = mu;
+        var caught = false;
+        for (0..12) |i| {
+            // the select-before-join race needs the side stream; the others show in either form
+            if (!try trial(rnd, i % 2 == 0, mu == .select_before_join or i % 4 < 2)) {
+                caught = true;
+                break;
+            }
+        }
+        if (!caught) {
+            std.debug.print("owner decode mutant {t} survived\n", .{mu});
+            return error.MutantSurvived;
+        }
+    }
+}
diff --git a/zig/src/families/glm_cuda/cuda_shard_keep.zig b/zig/src/families/glm_cuda/cuda_shard_keep.zig
new file mode 100644
index 0000000000000000000000000000000000000000..2348e3800542d1e11c3b466095a909d13e2893c8
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_shard_keep.zig
@@ -0,0 +1,128 @@
+//! TF_GLM_KV_SHARD (patch 0118, two ranks) beside filling prompts and kept prompt states: prompt borrowing (multi.py
+//! `_admitted`'s twins, `_untwin`, `_revoke_twins`) and a resume's latent rows (`_place_hit`, `_rescue`, `Arena.carry`,
+//! shard.py `send_rows` / `recv_rows`). GLM Zig keeps a prompt state as a copy outside the pool (cuda_snapshot.zig), not
+//! as an extent in it, so a state's latent rows are on one rank only: the owner of the part its stream lay in when it
+//! was kept (its home); every other section (pooled keys, rings, recurrent and conv states, the drafter's rings) is on
+//! both. A resume puts its new extent in the home part when that part has the room (nothing travels), else carries the
+//! rows from the home owner's state to the new extent's owner (TF_GLM_KV_SHARD_CARRY, from `carry_min` tokens), else
+//! starts from 0. A fresh prompt borrows free rows of the other part while it fills (TF_GLM_KV_SHARD_TWINS): both ranks
+//! hold its latent rows and attend as unsharded, nothing is sent; the twin is held for the whole fill and given back
+//! when the prompt is in, before its first decode round. Host side, and the carry's transfers generic over the device;
+//! cuda_engine.zig applies them, on every rank alike (the same pool, the same calls).
+const std = @import("std");
+const builtin = @import("builtin");
+const shard = @import("cuda_shard.zig");
+const Pool = @import("cuda_pool.zig").Pool;
+const G = @import("cuda_geometry.zig").Geometry;
+
+/// A kept state under this many tokens is never carried (multi.py CARRY_MIN): recomputing it costs under a second of
+/// prefill, which a carry (11 planes sent and received while no lane decodes) does not repay.
+pub const carry_min: usize = 2048;
+
+// -- prompt borrowing ---------------------------------------------------------------------------------------------------
+
+/// Extent `eid`'s fill borrows free rows of the other part (Pool.borrow: placed alike on every rank, all or none), held
+/// until the prompt is in -> the twin's base (null: that part has no room; the prompt then fills sharded). Two parts
+/// only (a part a rank); on an error nothing stays borrowed or held.
+pub fn borrow(pool: *Pool, eid: u64) !?usize {
+    if (pool.parts() != 2) return error.KvShardNeedsTwoRanks;
+    if (!try pool.borrow(eid)) return null;
+    errdefer pool.giveBack(eid) catch unreachable;
+    const x = try pool.extent(eid);
+    const twin = pool.twinIn(eid, 1 - pool.partOf(x.base)) orelse return error.NoTwin;
+    if (!mut(.borrow_unheld)) pool.hold(eid, true);
+    return twin;
+}
+
+/// Whether a placement may take extent `eid`'s twins back now (multi.py `_revoke_twins`): it has some, and no fill
+/// part way through its layers holds them.
+pub fn revocable(pool: *const Pool, eid: u64) bool {
+    return pool.hasTwins(eid) and !pool.holding(eid);
+}
+
+// -- a resume's latent rows -----------------------------------------------------------------------------------------------
+
+/// Why a resume starts from 0 instead (Python's carry refusals that apply here): the carry is off, or the state is
+/// under `carry_min`.
+pub const Why = enum { off, small };
+
+/// Where a resume's latent rows come from: the new extent already in the home part (`here`), moved there before any row
+/// is written (`move`: its new base), the state's rows carried into the extent where it is (`carry`), or none: the
+/// prompt from 0 (`recompute`).
+pub const Resume = union(enum) { here, move: usize, carry, recompute: Why };
+
+/// A prefill resuming a kept state of `at` tokens whose home is part `home` into fresh extent `eid` (newSeq's: no row
+/// written yet). Never a carry when the home part has the room, whatever the other part holds (Python's rule: carry only
+/// to save a recompute). Every rank answers alike: the same pool, the same state, the agreed switch.
+pub fn resumeIn(pool: *const Pool, eid: u64, home: usize, at: usize, carry_on: bool) !Resume {
+    if (home >= pool.parts()) return error.BadPart;
+    const x = try pool.extent(eid);
+    if (x.twin != null or pool.hasTwins(eid)) return error.Twinned;
+    if (pool.partOf(x.base) == home and !mut(.never_here)) return .here;
+    if (!mut(.no_move)) if (try pool.placeIn(x.size, eid, home)) |base| return .{ .move = base };
+    if (!carry_on) return .{ .recompute = .off };
+    if (at < carry_min and !mut(.carry_small)) return .{ .recompute = .small };
+    return .carry;
+}
+
+/// This rank's part of a resume's latent rows: the home owner's state holds them, the new extent's owner needs them.
+/// `copy`: both here (a restore puts them back); `send` / `recv`: a carry; `none`: no latent row here either way.
+pub const Latent = enum { copy, none, send, recv };
+
+pub fn latentRole(sh: shard.Shard, home: usize, part: usize) Latent {
+    if (home == part) return if (sh.rank == home or mut(.copy_anywhere)) .copy else .none;
+    if (sh.rank == home) return .send;
+    if (sh.rank == part) return .recv;
+    return .none;
+}
+
+/// A carry: the home owner's kept state's latent planes (`src[i]`, `n` rows each) to the new owner's (`dst[i]`), the
+/// same pieces of at most `piece` rows on both ranks (each send meets its receive). The receiver lands each piece in
+/// `stage` and copies it into place, as a restore copies (a plane may lie in the display span, which a transport must
+/// not write across). The transfers held against the prompt's side stream (`hold` / `release`, as the history fetch:
+/// two collectives of one communicator never run at once). `dev`: send, recv, copy, hold, release (the engine's GPU
+/// side, the tests' wire). The bytes this rank sent or received.
+pub fn carry(dev: anytype, role: Latent, src: [G.dsa_layers]u64, dst: [G.dsa_layers]u64, n: usize, stage: u64, piece: usize) !usize {
+    if (role != .send and role != .recv) return error.NotACarry;
+    if (piece == 0) return error.BadRows;
+    const row = G.latent_row;
+    const planes: usize = if (mut(.carry_ten_planes)) G.dsa_layers - 1 else G.dsa_layers;
+    var moved: usize = 0;
+    try dev.hold();
+    for (0..planes) |i| {
+        const cut = if (role == .send and mut(.send_whole)) n else piece;
+        var at: usize = 0;
+        while (at < n) : (at += cut) {
+            const k = @min(cut, n - at);
+            if (role == .send) {
+                try dev.send(src[i] + at * row, k * row);
+            } else if (mut(.recv_in_place)) {
+                try dev.recv(dst[i] + at * row, k * row);
+            } else {
+                try dev.recv(stage, k * row);
+                try dev.copy(dst[i] + at * row, stage, k * row);
+            }
+            moved += k * row;
+        }
+    }
+    try dev.release();
+    return moved;
+}
+
+// -- mutants: each rule above turned the wrong way, in test builds only (cuda_shard_keep_test.zig kills them) ----------
+
+pub const Mutant = enum {
+    none,
+    borrow_unheld, // a fill's twin not held: a placement could take it back part way through the prompt
+    never_here, // a resume in its home part treated as elsewhere (moved or carried for nothing)
+    no_move, // a resume whose home part has the room carries instead of moving there
+    carry_small, // a state under carry_min carried
+    copy_anywhere, // the rank without the state's rows copies them back (garbage, or a NoLatentRows)
+    carry_ten_planes, // a carry sends one plane short
+    send_whole, // the sender sends each plane whole while the receiver cuts pieces
+    recv_in_place, // the receiver's transport writes into the plane (the display span) instead of the stage
+};
+pub var mutant: Mutant = .none;
+inline fn mut(m: Mutant) bool {
+    return builtin.is_test and mutant == m;
+}
diff --git a/zig/src/families/glm_cuda/cuda_shard_keep_test.zig b/zig/src/families/glm_cuda/cuda_shard_keep_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..f6169d1fcc0c0063f34fc7ae742afa0242dcf7ea
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_shard_keep_test.zig
@@ -0,0 +1,273 @@
+//! cuda_shard_keep.zig's tests: prompt borrowing on two ranks' pools, a resume's decision (here, moved home, carried,
+//! from 0), each rank's part of a resume's latent rows, and the carry's transfers on a two-rank host model (each rank's
+//! planes in host memory, the transfers through a wire whose sends and receives must meet in order and size). Every
+//! keep mutant is caught by the check written for it (`killers`).
+const std = @import("std");
+const shard = @import("cuda_shard.zig");
+const keep = @import("cuda_shard_keep.zig");
+const Pool = @import("cuda_pool.zig").Pool;
+const G = @import("cuda_geometry.zig").Geometry;
+
+const gpa = std.testing.allocator;
+const E = G.extent;
+const row = G.latent_row;
+const planes = G.dsa_layers;
+
+// -- borrowing -------------------------------------------------------------------------------------------------------
+
+/// Two ranks' pools from the same calls: an extent of 2 x E rows in part 0, its prompt borrowing part 1's rows.
+fn borrowing() anyerror!bool {
+    var p: [2]Pool = .{ try Pool.initParts(gpa, 8 * E, 2), try Pool.initParts(gpa, 8 * E, 2) };
+    defer for (&p) |*q| q.deinit();
+    var twin: [2]?usize = undefined;
+    for (&p, &twin) |*q, *t| {
+        const a = (try q.alloc(2 * E)).?;
+        (try q.get(a)).owner = 0;
+        t.* = try keep.borrow(q, a);
+        // held for the fill: no placement takes it back
+        if (keep.revocable(q, a) or !q.holding(a)) return false;
+        q.hold(a, false);
+        if (!keep.revocable(q, a)) return false;
+        try q.giveBack(a);
+        if (q.hasTwins(a)) return false;
+    }
+    // placed alike on both ranks, in the other part's first free rows
+    if (twin[0] == null or twin[0].? != 4 * E or twin[1].? != twin[0].?) return false;
+    // no room in the other part: none, and nothing left behind
+    var full = try Pool.initParts(gpa, 8 * E, 2);
+    defer full.deinit();
+    const a = (try full.alloc(2 * E)).?;
+    _ = try full.add(4 * E, 3 * E);
+    if ((try keep.borrow(&full, a)) != null or full.hasTwins(a)) return false;
+    return true;
+}
+
+test "borrowing: a twin in the other part, placed alike on both ranks, held for its fill, none without room" {
+    try std.testing.expect(try borrowing());
+}
+
+test "borrowing is the two parts' (a part a rank): a pool of three refuses it, with nothing borrowed or held" {
+    var p = try Pool.initParts(gpa, 9 * E, 3);
+    defer p.deinit();
+    const a = (try p.alloc(E)).?;
+    (try p.get(a)).owner = 0;
+    const free = p.freeRows();
+    try std.testing.expectError(error.KvShardNeedsTwoRanks, keep.borrow(&p, a));
+    try std.testing.expect(!p.hasTwins(a) and !p.holding(a) and p.freeRows() == free);
+}
+
+// -- a resume's decision --------------------------------------------------------------------------------------------------
+
+/// Every case of `resumeIn`: the extent already home; moved home (its new base, and the move across parts applies);
+/// carried where home has no room; from 0 with the carry off or a state under the minimum; a twinned extent refused.
+fn resuming() anyerror!bool {
+    var p = try Pool.initParts(gpa, 8 * E, 2);
+    defer p.deinit();
+    const a = (try p.alloc(2 * E)).?; // part 0
+    const b = (try p.alloc(2 * E)).?; // part 1 (fewer live: none yet counted, more free rows)
+    (try p.get(a)).owner = 0;
+    (try p.get(b)).owner = 1;
+    if (p.partOf((try p.extent(b)).base) != 1) return error.TestUnexpectedResult;
+    if ((try keep.resumeIn(&p, a, 0, 5000, true)) != .here) return false;
+    if ((try keep.resumeIn(&p, b, 1, 100, false)) != .here) return false; // (at home: no rule about the carry or the size)
+    // b's state lives in part 0, which has room: moved there, not carried, whatever the carry
+    const moved = try keep.resumeIn(&p, b, 0, 5000, true);
+    if (moved != .move or moved.move != 2 * E) return false;
+    if ((try keep.resumeIn(&p, b, 0, 100, false)) != .move) return false;
+    // part 0 full: carried from the minimum up, else from 0 (by why)
+    _ = try p.add(2 * E, 2 * E);
+    if ((try keep.resumeIn(&p, b, 0, keep.carry_min, true)) != .carry) return false;
+    const off = try keep.resumeIn(&p, b, 0, 5000, false);
+    const small = try keep.resumeIn(&p, b, 0, keep.carry_min - 64, true);
+    if (off != .recompute or off.recompute != .off or small != .recompute or small.recompute != .small) return false;
+    // a home that is no part, or an extent holding twins (a fill's), refused
+    if (keep.resumeIn(&p, b, 2, 5000, true)) |_| return false else |_| {}
+    var q = try Pool.initParts(gpa, 8 * E, 2);
+    defer q.deinit();
+    const c = (try q.alloc(E)).?;
+    _ = try keep.borrow(&q, c);
+    if (keep.resumeIn(&q, c, 1, 5000, true)) |_| return false else |e| if (e != error.Twinned) return false;
+    return true;
+}
+
+test "a resume: in its state's part as it is, moved there when it has room, else carried, else from 0 (carry off, or under the minimum)" {
+    try std.testing.expect(try resuming());
+    // the move applies across the parts (the extent is fresh: nothing to copy) and the state's part then holds it
+    var p = try Pool.initParts(gpa, 8 * E, 2);
+    defer p.deinit();
+    _ = (try p.alloc(E)).?;
+    const b = (try p.alloc(E)).?;
+    const r = try keep.resumeIn(&p, b, 0, 4096, true);
+    _ = try p.move(b, r.move, null, true);
+    try std.testing.expectEqual(@as(usize, 0), p.partOf((try p.extent(b)).base));
+}
+
+/// Each rank's part for every (home, part): one copier when they agree, else one sender (the home's owner) and one
+/// receiver (the extent's), the rank between them none.
+fn roles() anyerror!bool {
+    for (0..2) |home| for (0..2) |part| {
+        var copy: usize = 0;
+        var send: usize = 0;
+        var recv: usize = 0;
+        for (0..2) |rank| {
+            const sh = try shard.Shard.init(rank, 2, 8 * E, shard.trash);
+            switch (keep.latentRole(sh, home, part)) {
+                .copy => copy += 1 + @as(usize, @intFromBool(rank != home)) * 10,
+                .send => send += 1 + @as(usize, @intFromBool(rank != home)) * 10,
+                .recv => recv += 1 + @as(usize, @intFromBool(rank != part)) * 10,
+                .none => {},
+            }
+        }
+        if (home == part and !(copy == 1 and send == 0 and recv == 0)) return false;
+        if (home != part and !(copy == 0 and send == 1 and recv == 1)) return false;
+    };
+    return true;
+}
+
+test "a resume's latent rows: copied back where the state and the extent are one rank's, else sent by the state's and received by the extent's" {
+    try std.testing.expect(try roles());
+}
+
+// -- the carry on two ranks ----------------------------------------------------------------------------------------------
+
+/// The two ranks' devices: a wire of sends the other rank's receives must meet in order and size, host memory for the
+/// planes, and checks that the transport writes only the stage and that the transfers are held.
+const Wire = struct {
+    sends: std.ArrayList([]const u8) = .empty,
+    taken: usize = 0,
+    fn deinit(w: *Wire) void {
+        w.sends.deinit(gpa);
+    }
+};
+
+const Dev = struct {
+    wire: *Wire,
+    stage: u64,
+    stage_bytes: usize,
+    held: bool = false,
+    holds: usize = 0,
+    bad: ?[]const u8 = null,
+    pub fn send(d: *Dev, at: u64, n: usize) !void {
+        if (!d.held) d.bad = "a send not held";
+        const p: [*]const u8 = @ptrFromInt(at);
+        try d.wire.sends.append(gpa, p[0..n]);
+    }
+    pub fn recv(d: *Dev, at: u64, n: usize) !void {
+        if (!d.held) d.bad = "a receive not held";
+        if (at != d.stage or n > d.stage_bytes) d.bad = "the transport wrote past the stage";
+        if (d.wire.taken >= d.wire.sends.items.len) return error.NoMatchingSend;
+        const sent = d.wire.sends.items[d.wire.taken];
+        d.wire.taken += 1;
+        if (sent.len != n) return error.UnmatchedSizes;
+        const p: [*]u8 = @ptrFromInt(at);
+        @memcpy(p[0..n], sent);
+    }
+    pub fn copy(_: *Dev, dst: u64, src: u64, n: usize) !void {
+        const p: [*]u8 = @ptrFromInt(dst);
+        const q: [*]const u8 = @ptrFromInt(src);
+        @memcpy(p[0..n], q[0..n]);
+    }
+    pub fn hold(d: *Dev) !void {
+        d.held = true;
+        d.holds += 1;
+    }
+    pub fn release(d: *Dev) !void {
+        d.held = false;
+    }
+};
+
+/// A carry of `n` rows in pieces of `piece`, the home owner's state to the extent's owner at local row `to`: true when
+/// the receiver's planes hold the state's rows there and nothing else of theirs changed, both ranks' calls met, the
+/// stage alone took the transport's bytes and every transfer was held.
+fn carried(rnd: std.Random, n: usize, piece: usize, to: usize, part_rows: usize) !bool {
+    // the home owner's kept state: 11 planes of n rows (its latent section)
+    const state = try gpa.alloc(u8, planes * n * row);
+    defer gpa.free(state);
+    rnd.bytes(state);
+    // the receiver's latent planes: a part and its trash rows each, its rows as they were
+    const plane_bytes = (part_rows + shard.trash) * row;
+    const mine = try gpa.alloc(u8, planes * plane_bytes);
+    defer gpa.free(mine);
+    rnd.bytes(mine);
+    const before = try gpa.dupe(u8, mine);
+    defer gpa.free(before);
+    const stage = try gpa.alloc(u8, piece * row);
+    defer gpa.free(stage);
+    var src: [planes]u64 = undefined;
+    var dst: [planes]u64 = undefined;
+    for (0..planes) |i| {
+        src[i] = @intFromPtr(state.ptr) + i * n * row;
+        dst[i] = @intFromPtr(mine.ptr) + i * plane_bytes + to * row;
+    }
+    var wire: Wire = .{};
+    defer wire.deinit();
+    var d0: Dev = .{ .wire = &wire, .stage = 0, .stage_bytes = 0 };
+    var d1: Dev = .{ .wire = &wire, .stage = @intFromPtr(stage.ptr), .stage_bytes = stage.len };
+    // the sender's calls first (its sends queue), then the receiver's meet them
+    const sent = try keep.carry(&d0, .send, src, @splat(0), n, 0, piece);
+    const got = keep.carry(&d1, .recv, @splat(0), dst, n, @intFromPtr(stage.ptr), piece) catch return false;
+    if (wire.taken != wire.sends.items.len or sent != got or sent != shard.carryBytes(n)) return false;
+    if (d0.bad != null or d1.bad != null or d0.holds != 1 or d1.holds != 1 or d0.held or d1.held) return false;
+    for (0..planes) |i| {
+        const p = mine[i * plane_bytes ..][0..plane_bytes];
+        const b = before[i * plane_bytes ..][0..plane_bytes];
+        if (!std.mem.eql(u8, p[to * row ..][0 .. n * row], state[i * n * row ..][0 .. n * row])) return false;
+        if (!std.mem.eql(u8, p[0 .. to * row], b[0 .. to * row])) return false;
+        if (!std.mem.eql(u8, p[(to + n) * row ..], b[(to + n) * row ..])) return false;
+    }
+    return true;
+}
+
+const carry_cases = [_][4]usize{
+    // n, piece, to, part rows
+    .{ 2112, 2112, 2048, 4096 }, // one piece a plane
+    .{ 2112, 500, 0, 4096 }, // ragged pieces
+    .{ 2048, 1024, 2048, 4096 }, // whole pieces
+    .{ 1, 7, 6143, 6144 }, // a row, the part's last
+};
+
+test "a carry: the home owner's state's latent rows land in the extent owner's planes, through its stage, in pieces both ranks cut alike, held" {
+    var prng = std.Random.DefaultPrng.init(1301);
+    for (carry_cases) |c| try std.testing.expect(try carried(prng.random(), c[0], c[1], c[2], c[3]));
+    // not a carry's role, or no piece
+    var wire: Wire = .{};
+    defer wire.deinit();
+    var d: Dev = .{ .wire = &wire, .stage = 0, .stage_bytes = 0 };
+    try std.testing.expectError(error.NotACarry, keep.carry(&d, .copy, @splat(0), @splat(0), 64, 0, 64));
+    try std.testing.expectError(error.BadRows, keep.carry(&d, .send, @splat(0), @splat(0), 64, 0, 0));
+}
+
+// -- mutants --------------------------------------------------------------------------------------------------------------
+
+fn anyCarry() anyerror!bool {
+    var prng = std.Random.DefaultPrng.init(1302);
+    for (carry_cases) |c| if (!try carried(prng.random(), c[0], c[1], c[2], c[3])) return false;
+    return true;
+}
+
+/// The check that must fail under each mutant.
+fn killer(m: keep.Mutant) *const fn () anyerror!bool {
+    return switch (m) {
+        .none => unreachable,
+        .borrow_unheld => borrowing,
+        .never_here, .no_move, .carry_small => resuming,
+        .copy_anywhere => roles,
+        .carry_ten_planes, .send_whole, .recv_in_place => anyCarry,
+    };
+}
+
+test "every keep mutant is caught by the check written for it, which passes unmutated" {
+    defer keep.mutant = .none;
+    for (std.enums.values(keep.Mutant)) |m| {
+        if (m == .none) continue;
+        const check = killer(m);
+        keep.mutant = .none;
+        try std.testing.expect(try check());
+        keep.mutant = m;
+        const passed = check() catch false;
+        if (passed) {
+            std.debug.print("keep mutant {t} survived\n", .{m});
+            return error.MutantSurvived;
+        }
+    }
+}
diff --git a/zig/src/families/glm_cuda/cuda_shard_prompt.zig b/zig/src/families/glm_cuda/cuda_shard_prompt.zig
new file mode 100644
index 0000000000000000000000000000000000000000..429b28ed4d965d14ec7d34090fb4d4d4ac790ca2
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_shard_prompt.zig
@@ -0,0 +1,345 @@
+//! TF_GLM_KV_SHARD's prompt path (patch 0118, glm5_next/cuda/forward.py `_sharded_attend` / `_shard_sparse`, shard.py
+//! `history` / `fetch`, two ranks): a prompt chunk's DSA attention when its stream's latent rows live on one rank only
+//! (cuda_shard.zig). The selection runs replicated (the pooled index keys are on both ranks). The owner then sends the
+//! other rank the history rows the chunk's tokens name, once each and in position order (marked, scanned, compacted:
+//! glm_shard.cu), a bounded piece at a time; the other rank writes the chunk's own latents after them and attends over
+//! that compact copy with its tokens renumbered in place, which reads the same bytes in the same order: the same bits.
+//! A chunk with rows under the dense limit fetches its whole history at its positions instead (those rows read every
+//! earlier position). The attention launches are the unsharded chunk's (`_lat_write`, `_dense_chunks` + `_merge`,
+//! `_sparse_onepass`) with LC moved to the copy: no new Triton variant. The copy is made once and bounded
+//! (`historyRows`): a chunk whose union outgrows it goes in row blocks, each with its own union (counted). Prompt
+//! chunks are never captured, so a union's count is read on the host: one stream synchronize a layer (Python's
+//! `int(cum[-1])` / `nonzero` did the same).
+const std = @import("std");
+const builtin = @import("builtin");
+const cuda = @import("cuda");
+const shard = @import("cuda_shard.zig");
+const state = @import("cuda_state.zig");
+const grid = @import("cuda_prefill_grid.zig");
+const Comm = @import("cuda_comm.zig").Comm;
+const G = @import("cuda_geometry.zig").Geometry;
+
+/// A latent row (FP8: 512 values and their scale) and a chunk row's tokens.
+const row = G.latent_row;
+const width = G.tokens;
+
+/// glm_shard.cu's scan segments (GLM_SHARD_SCAN_SEGS): `sums` holds this many int32 and the total after them.
+pub const scan_segs = 1024;
+/// A context this short holds its whole history in the copy (no chunk ever blocks); a longer one half of it.
+pub const whole_rows: usize = 262144;
+/// The row blocks a chunk is cut into when its union outgrows the copy are whole tiles of this many rows: their tokens,
+/// counts and queries stay 16-byte aligned (`_sparse_onepass`'s one captured variant), and the positions 64 rows name
+/// (64 x 2,051) fit every copy, so the halving always ends.
+pub const block_rows: usize = 64;
+
+comptime {
+    std.debug.assert(block_rows * width <= whole_rows);
+    std.debug.assert(row % 16 == 0 and (block_rows * width * 4) % 16 == 0);
+}
+
+/// History rows the copy holds before a chunk's own, at a context of `context` tokens: all of it up to `whole_rows`,
+/// else half (Python measured ~43% of a 1M history in one 2,048-row chunk's union, ~230 MB a layer).
+pub fn historyRows(context: usize) usize {
+    return if (context <= whole_rows) context else @max(whole_rows, context / 2);
+}
+
+// -- buffers ----------------------------------------------------------------------------------------------------------
+
+/// The fetch's buffers, made once at start (the sharded pool's sizing counts them): the copy (`historyRows` rows, then a
+/// chunk's own), the marks (one a position of the context, scanned in place into cum), the scan's sums and total, and a
+/// zero word (the POS of the chunk's own rows in the copy, which start after the fetched rows).
+pub const Ptrs = struct { copy: u64, mark: u64, sums: u64, zero: u64 };
+
+pub fn layout(context: usize, chunk: usize) [4]usize {
+    return .{ (historyRows(context) + chunk) * row, context * 4, (scan_segs + 1) * 4, 16 };
+}
+
+/// Bytes `Buffers` takes (~269 MiB at 1M tokens and 2,048-row chunks, ~68 MiB at 128K).
+pub fn bytes(context: usize, chunk: usize) usize {
+    return state.aligned(&layout(context, chunk));
+}
+
+pub const Buffers = struct {
+    arena: state.Arena,
+    p: Ptrs,
+    pub fn init(d: *const cuda.Driver, context: usize, chunk: usize) !Buffers {
+        const sizes = layout(context, chunk);
+        var a = try state.Arena.init(d, &sizes); // zeroed: the zero word stays 0
+        errdefer a.deinit();
+        var at: [4]u64 = undefined;
+        for (&at, sizes) |*p, n| p.* = a.take(n);
+        return .{ .arena = a, .p = .{ .copy = at[0], .mark = at[1], .sums = at[2], .zero = at[3] } };
+    }
+    pub fn deinit(b: *Buffers) void {
+        b.arena.deinit();
+    }
+};
+
+// -- glm_shard.cu --------------------------------------------------------------------------------------------------------
+
+pub const Kernels = struct {
+    module: cuda.Module,
+    mark_fn: cuda.Function,
+    sums_fn: cuda.Function,
+    offsets_fn: cuda.Function,
+    scan_fn: cuda.Function,
+    compact_fn: cuda.Function,
+    renumber_fn: cuda.Function,
+    /// glm_shard.cu's image (cuda.kernels.glm_shard; empty in a host-only build).
+    pub fn load(d: *const cuda.Driver, image: []const u8) !Kernels {
+        if (image.len == 0) return error.NoKvShardKernels;
+        var m = try cuda.Module.load(d, image);
+        errdefer m.unload();
+        return .{
+            .module = m,
+            .mark_fn = try m.function("glm_shard_mark"),
+            .sums_fn = try m.function("glm_shard_sums"),
+            .offsets_fn = try m.function("glm_shard_offsets"),
+            .scan_fn = try m.function("glm_shard_scan"),
+            .compact_fn = try m.function("glm_shard_compact"),
+            .renumber_fn = try m.function("glm_shard_renumber"),
+        };
+    }
+    pub fn unload(k: *Kernels) void {
+        k.module.unload();
+    }
+    /// The marks [limit] zeroed, then a one at every token below `limit` of tokens [n] (cuda_shard.markHistory).
+    pub fn mark(k: *const Kernels, s: cuda.Stream, tokens: u64, n: usize, m: u64, limit: usize) !void {
+        if (limit > 0) try s.d.check(s.d.api.cuMemsetD32Async(m, 0, limit, s.handle), "cuMemsetD32Async");
+        if (n == 0 or limit == 0) return;
+        var a: cuda.Args = .{};
+        a.add(tokens);
+        a.add(@as(i64, @intCast(n)));
+        a.add(m);
+        a.add(try int(limit));
+        try cuda.launch.launch(k.mark_fn, .{ .grid = .{ .x = try blocks(n, 256) }, .block = .{ .x = 256 } }, s, &a);
+    }
+    /// m [n] scanned in place (cuda_shard.prefixSum), its total to sums[scan_segs].
+    pub fn scan(k: *const Kernels, s: cuda.Stream, m: u64, n: usize, sums: u64) !void {
+        var a: cuda.Args = .{};
+        a.add(m);
+        a.add(@as(i64, @intCast(n)));
+        a.add(sums);
+        try cuda.launch.launch(k.sums_fn, .{ .grid = .{ .x = scan_segs / 256 }, .block = .{ .x = 256 } }, s, &a);
+        var o: cuda.Args = .{};
+        o.add(sums);
+        try cuda.launch.launch(k.offsets_fn, .{ .grid = .{ .x = 1 }, .block = .{ .x = 1 } }, s, &o);
+        try cuda.launch.launch(k.scan_fn, .{ .grid = .{ .x = scan_segs / 256 }, .block = .{ .x = 256 } }, s, &a);
+    }
+    /// Latent row t of `src` to row cum[t] - 1 of `dst` where cum steps, for t below `limit` (cum 0: every row t to row
+    /// t; `compactRef`).
+    pub fn compact(k: *const Kernels, s: cuda.Stream, src: u64, cum: u64, limit: usize, dst: u64) !void {
+        if (limit == 0) return;
+        if ((src | dst) % 16 != 0) return error.BadCompact;
+        var a: cuda.Args = .{};
+        for ([_]u64{ src, cum }) |x| a.add(x);
+        a.add(@as(i64, @intCast(limit)));
+        a.add(@as(i64, row / 16));
+        a.add(dst);
+        try cuda.launch.launch(k.compact_fn, .{ .grid = .{ .x = try blocks(limit, 16) }, .block = .{ .x = 256 } }, s, &a);
+    }
+    /// tokens [n] renumbered in place to rows of the copy (cuda_shard.renumber).
+    pub fn renumber(k: *const Kernels, s: cuda.Stream, tokens: u64, n: usize, cum: u64, limit: usize) !void {
+        if (n == 0) return;
+        var a: cuda.Args = .{};
+        a.add(tokens);
+        a.add(@as(i64, @intCast(n)));
+        a.add(cum);
+        a.add(try int(limit));
+        try cuda.launch.launch(k.renumber_fn, .{ .grid = .{ .x = try blocks(n, 256) }, .block = .{ .x = 256 } }, s, &a);
+    }
+};
+
+fn int(n: usize) !c_int {
+    if (n > std.math.maxInt(c_int)) return error.BadRows;
+    return @intCast(n);
+}
+fn blocks(n: usize, per: usize) !u32 {
+    const b = (n + per - 1) / per;
+    if (b > std.math.maxInt(i32)) return error.BadRows;
+    return @intCast(b);
+}
+
+/// glm_shard_compact as host code (tools/glm_shard_emulate holds the kernel to it): row t of `plane` to row cum[t] - 1
+/// of `out` where cum steps, for t below `limit`; cum null: every row t to row t.
+pub fn compactRef(plane: []const u8, cum: ?[]const i32, limit: usize, out: []u8) void {
+    for (0..limit) |t| {
+        var d = t;
+        if (cum) |c| {
+            const prev: i32 = if (t > 0) c[t - 1] else 0;
+            if (c[t] == prev) continue;
+            d = @intCast(prev);
+        }
+        @memcpy(out[d * row ..][0..row], plane[t * row ..][0..row]);
+    }
+}
+
+// -- one chunk's DSA layer --------------------------------------------------------------------------------------------
+
+/// This rank's side of a sharded chunk: the stream's owner sends its rows, the other rank receives them and attends over
+/// the copy.
+pub const Role = enum { send, recv };
+
+/// A rank's side of a chunk on cache view `v` (cuda_state.CacheView): the owner's view sends, a view with no latent
+/// rows here receives; null on both ranks while the prompt borrows a twin (TF_GLM_KV_SHARD_TWINS: the view marked
+/// `twin`, the owner's own rows and the other rank's twin), which runs the chunk unsharded: each rank writes and
+/// attends its own copy, nothing is sent. Another rank's rows here without the mark are no view this engine makes.
+pub fn roleOf(v: state.CacheView) !?Role {
+    if (v.twin and !mut(.twin_fetches)) return null;
+    if (v.owner) return .send;
+    if (!v.hasLatent()) return .recv;
+    return error.KvShardTwinPrompt;
+}
+
+/// The fetch's counters, this rank's (rank 0's go to kv_parts' prompt_*: it takes part in every fetch).
+pub const Stats = struct {
+    fetches: u64 = 0, // chunk layers that moved history rows (sent or received)
+    rows: u64 = 0, // latent rows moved
+    bytes: u64 = 0,
+    syncs: u64 = 0, // host reads of a union's count
+    blocked: u64 = 0, // chunk layers whose union outgrew the copy and went in row blocks
+    blocks: u64 = 0, // the row blocks those ran
+};
+
+/// The copy's bounds: `hist` history rows before a chunk's own (`historyRows`), `chunk` rows a chunk at most, and the
+/// rows a transfer carries (`piece`: cuda_shard.piece, 64 MiB; both ranks cut alike, so each send meets its receive).
+pub const Limits = struct { hist: usize, chunk: usize, piece: usize = shard.piece(row) };
+
+/// A chunk's DSA layer after its selection: `rows` rows from position `pos`; `sparse` when rows past the dense limit
+/// attend to their tokens ([rows][2,051] int32 at `tokens`, -1 none; renumbered in place on the receiving rank); `lc`
+/// the sending rank's view of the stream's latent rows, the chunk's own already written.
+pub const Chunk = struct { role: Role, rows: usize, pos: usize, sparse: bool, tokens: u64, lc: u64 = 0 };
+
+/// forward.py `_sharded_attend` for two ranks. `dev` is the device's side: glm_shard.cu (mark, scan, count, compact,
+/// renumber), the transfers (send, recv, inside hold / release), and the chunk's attention launches (latWrite, dense,
+/// sparse); the GPU's in cuda_prefill.zig, the tests' model in cuda_shard_prompt_test.zig.
+/// A chunk with rows under the dense limit fetches the history [0, pos) whole at its positions, and each rank attends as
+/// unsharded over its view or the copy. Otherwise both ranks mark the positions below `pos` the tokens name and read
+/// their count; the sender compacts and sends those rows; the receiver writes the chunk's own rows after them, renumbers
+/// its tokens and attends over the copy; the sender attends over its own view after its sends. A union past
+/// `lim.hist` rows is cut in halves (whole `block_rows` tiles) until each fits; both ranks read the same counts (the
+/// tokens are replicated), so they cut alike.
+pub fn attend(dev: anytype, p: Ptrs, lim: Limits, c: Chunk, st: *Stats) !void {
+    if (c.rows == 0 or c.rows > lim.chunk or lim.piece == 0) return error.BadRows;
+    const send = c.role == .send;
+    if (send and c.lc == 0) return error.NoLatentRows;
+    // what the attention reads: the sender its own view, the receiver the copy
+    const att = if (send and !mut(.owner_reads_copy)) c.lc else p.copy;
+    var moved: usize = 0;
+    defer st.fetches += @intFromBool(moved > 0);
+    if (c.pos < grid.sparse_from) {
+        // a row under the dense limit reads every earlier position: the history whole, at its positions
+        if (c.pos > lim.hist) return error.KvShardFetchRows;
+        const whole = send and c.pos > 0;
+        if (whole and !mut(.send_before_compact)) try dev.compact(c.lc, 0, c.pos, p.copy);
+        moved += try move(dev, send, p.copy, c.pos, lim.piece, st);
+        if (whole and mut(.send_before_compact)) try dev.compact(c.lc, 0, c.pos, p.copy);
+        if (!send) try dev.latWrite(p.copy, null);
+        try dev.dense(att);
+        if (c.sparse) try dev.sparse(att, 0, c.rows);
+        return;
+    }
+    if (!c.sparse) return error.MissingIndex; // past the dense limit every row attends to its tokens
+    var todo: [16][2]usize = undefined;
+    todo[0] = .{ 0, c.rows };
+    var left: usize = 1;
+    var cut = false;
+    while (left > 0) {
+        left -= 1;
+        const lo = todo[left][0];
+        const hi = todo[left][1];
+        const tok = c.tokens + lo * width * 4;
+        const n_tok = (hi - lo) * width;
+        if (mut(.block_marks_chunk)) try dev.mark(c.tokens, c.rows * width, p.mark, c.pos) else try dev.mark(tok, n_tok, p.mark, c.pos);
+        try dev.scan(p.mark, c.pos, p.sums);
+        const n = try dev.count(p.sums);
+        st.syncs += 1;
+        if (n > lim.hist) {
+            // a union the copy cannot hold: the block in two (a 64-row tile names at most 64 x 2,051 positions)
+            if (hi - lo <= block_rows or left + 2 > todo.len) return error.KvShardFetchRows;
+            const half = if (mut(.cut_unaligned)) (hi - lo) / 2 else std.mem.alignForward(usize, (hi - lo) / 2, block_rows);
+            todo[left] = .{ lo + half, hi };
+            todo[left + 1] = .{ lo, lo + half };
+            left += 2;
+            cut = true;
+            continue;
+        }
+        if (cut) st.blocks += 1;
+        if (send and !mut(.send_before_compact)) try dev.compact(c.lc, p.mark, c.pos, p.copy);
+        moved += try move(dev, send, p.copy, n, lim.piece, st);
+        if (send) {
+            if (mut(.send_before_compact)) try dev.compact(c.lc, p.mark, c.pos, p.copy);
+            continue;
+        }
+        // the chunk's own rows after the fetched ones (rows of a block name positions up to its last row's)
+        try dev.latWrite(if (mut(.own_rows_first)) p.copy else p.copy + n * row, p.zero);
+        if (!mut(.skip_renumber)) try dev.renumber(tok, n_tok, p.mark, c.pos);
+        try dev.sparse(p.copy, lo, hi);
+    }
+    if (cut) st.blocked += 1;
+    // the owner attends after its sends: the other rank starts on its copy at once
+    if (send) try dev.sparse(att, 0, c.rows);
+}
+
+/// `n` rows of the copy from the sender to the receiver, `piece` rows a transfer, held against the split's side stream
+/// (shard.py `_sharded_attend`: the fetch waits for that stream and it for the fetch, so two collectives of one
+/// communicator never run at once). The rows moved.
+fn move(dev: anytype, send: bool, at: u64, n: usize, piece: usize, st: *Stats) !usize {
+    if (n == 0) return 0;
+    if (!mut(.no_hold)) try dev.hold();
+    var i: usize = 0;
+    while (i < n) : (i += piece) {
+        const k = @min(piece, n - i);
+        if (send) try dev.send(at + i * row, k * row) else try dev.recv(at + i * row, k * row);
+    }
+    if (!mut(.no_hold)) try dev.release();
+    st.rows += n;
+    st.bytes += n * row;
+    return n;
+}
+
+// -- the engine's side --------------------------------------------------------------------------------------------------
+
+/// One rank's prompt fetch: its view of the parts, the kernels and buffers (made at start), and the counters. The prompt
+/// engine's `shard` points here (cuda_prefill.Engine); its device is cuda_prefill's ShardDev.
+pub const Fetch = struct {
+    sh: shard.Shard,
+    comm: *const Comm,
+    k: Kernels,
+    b: Buffers,
+    lim: Limits,
+    stats: Stats = .{},
+
+    pub fn init(d: *const cuda.Driver, comm: *const Comm, sh: shard.Shard, context: usize, chunk: usize) !Fetch {
+        if (sh.world != 2 or comm.world != 2 or comm.rank != sh.rank) return error.KvShardNeedsTwoRanks;
+        if (context == 0 or chunk == 0) return error.BadRows;
+        var b = try Buffers.init(d, context, chunk);
+        errdefer b.deinit();
+        var k = try Kernels.load(d, cuda.kernels.glm_shard);
+        errdefer k.unload();
+        return .{ .sh = sh, .comm = comm, .k = k, .b = b, .lim = .{ .hist = historyRows(context), .chunk = chunk } };
+    }
+
+    pub fn deinit(f: *Fetch) void {
+        f.k.unload();
+        f.b.deinit();
+    }
+};
+
+// -- mutants: each rule above turned the wrong way, in test builds only (cuda_shard_prompt_test.zig kills them) --------
+
+pub const Mutant = enum {
+    none,
+    skip_renumber, // the receiver attends with the tokens' history positions
+    own_rows_first, // the chunk's own rows written over the copy's first rows
+    send_before_compact, // the sender sends its copy before compacting the rows into it
+    owner_reads_copy, // the sender attends over its copy, not its view
+    no_hold, // a transfer not held against the split's side stream
+    cut_unaligned, // a row block off the 64-row tiles (off `_sparse_onepass`'s variant)
+    block_marks_chunk, // every row block marks the whole chunk's tokens
+    twin_fetches, // a borrowing prompt's chunk fetches as if it had no twin (its owner then sends rows the other has)
+};
+pub var mutant: Mutant = .none;
+inline fn mut(m: Mutant) bool {
+    return builtin.is_test and mutant == m;
+}
diff --git a/zig/src/families/glm_cuda/cuda_shard_prompt_test.zig b/zig/src/families/glm_cuda/cuda_shard_prompt_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..61ee28c8bf55f725d79726a8ba78dee39bd36522
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_shard_prompt_test.zig
@@ -0,0 +1,626 @@
+//! cuda_shard_prompt.zig's host tests (no GPU): the sharded prompt chunk's Triton launches against the captured
+//! variants, the copy's sizing, a rank's side, and a two-rank host model of the history fetch against each rank's
+//! unsharded attention, bit for bit: chunks with rows under the dense limit (the whole history at its positions) and
+//! past it (the union of the positions the tokens name), the union in row blocks when it outgrows the copy, transfers
+//! in pieces, held against a split's side stream or not, either rank the owner. The model also kills every
+//! cuda_shard_prompt Mutant. The attention launches are cuda_prefill's own (ShardAttn on a recording engine); the
+//! Triton kernels are modelled (`exec`): a row's output is a function of its queries and of exactly the latent rows
+//! the real kernel reads, in the order it reads them, so a wrong pointer, offset, block, count, token or order changes
+//! the bits.
+const std = @import("std");
+const cuda = @import("cuda");
+const aot = cuda.aot;
+const sp = @import("cuda_shard_prompt.zig");
+const shard = @import("cuda_shard.zig");
+const state = @import("cuda_state.zig");
+const pre = @import("cuda_prefill.zig");
+const grid = @import("cuda_prefill_grid.zig");
+const tri_mod = @import("cuda_triton.zig");
+const Tri = tri_mod.Tri;
+const Recorder = tri_mod.Recorder;
+const G = @import("cuda_geometry.zig").Geometry;
+
+const gpa = std.testing.allocator;
+const W = G.tokens;
+const RS = G.latent_row;
+/// A rank's heads at TP=2, and a row's absorbed queries or attention output (bf16 [32][512]).
+const H = 32;
+const qrow = H * 512 * 2;
+
+fn arg(s: *const Recorder.Saved, name: []const u8) aot.Arg {
+    for (s.args[0..s.nargs]) |a| if (std.mem.eql(u8, a.name, name)) return a;
+    std.debug.panic("{s} has no argument {s}", .{ s.name, name });
+}
+fn ptrArg(s: *const Recorder.Saved, name: []const u8) u64 {
+    return arg(s, name).value.ptr.addr;
+}
+
+/// The captured kernel set the engine replays (zig/tests/cuda/glm_p1/aot/aot.json, read from the repository root: the
+/// test step's working directory). fixtures_aot_variants.json, which the decode tests use, holds too few of the prompt
+/// kernels' variants.
+const Captured = struct {
+    text: []u8,
+    parsed: std.json.Parsed(aot.SetJson),
+    fn load() !Captured {
+        const text = std.Io.Dir.cwd().readFileAlloc(std.testing.io, "zig/tests/cuda/glm_p1/aot/aot.json", gpa, .limited(1 << 24)) catch |e| switch (e) {
+            error.FileNotFound => return error.SkipZigTest,
+            else => return e,
+        };
+        errdefer gpa.free(text);
+        return .{ .text = text, .parsed = try std.json.parseFromSlice(aot.SetJson, gpa, text, .{ .ignore_unknown_fields = true }) };
+    }
+    fn deinit(c: *Captured) void {
+        c.parsed.deinit();
+        gpa.free(c.text);
+    }
+};
+
+/// The first captured variant a recorded launch would run (aot.matches, the engine's own choice).
+fn variant(ks: []const aot.KernelJson, s: *const Recorder.Saved) ?usize {
+    for (ks, 0..) |k, i| {
+        if (std.mem.eql(u8, k.@"fn", s.name) and aot.matches(k, s.args[0..s.nargs], s.consts[0..s.nconsts])) return i;
+    }
+    return null;
+}
+
+/// Pointers an arena carves for `sizes` from `base` (state.Arena.take: 256-byte steps).
+fn carve(base: u64, sizes: []const usize, out: []u64) void {
+    var at = base;
+    for (sizes, out) |n, *p| {
+        p.* = at;
+        at += std.mem.alignForward(usize, n, 256);
+    }
+}
+
+/// The prompt scratch's pointers the attention launches take, and POS.
+const Bufs = struct { lat: u64, qa: u64, ol: u64, po: u64, pm: u64, pl: u64, dummy: u64, tokens: u64, counts: u64, origins: u64, pos: u64 };
+
+/// A prompt engine as far as the attention launches read it: `g`, `tri` (recording), `pos_dev` and the scratch
+/// pointers they take (the rest undefined).
+fn engine(rec: *Recorder, rank: usize, at: Bufs) !pre.Engine {
+    var e: pre.Engine = undefined;
+    e.g = try G.init(2, rank);
+    e.tri = .{ .rec = rec };
+    e.pos_dev = at.pos;
+    e.lane = null;
+    e.s.lat = at.lat;
+    e.s.qa = at.qa;
+    e.s.ol = at.ol;
+    e.s.po = at.po;
+    e.s.pm = at.pm;
+    e.s.pl = at.pl;
+    e.s.dummy = at.dummy;
+    e.s.tokens = at.tokens;
+    e.s.counts = at.counts;
+    e.s.origins = at.origins;
+    e.s.nch = 64;
+    e.s.part_rows = grid.att_rows;
+    return e;
+}
+
+test "the prompt fetch's launches find the variant of their unsharded launch at every chunk size" {
+    var set = try Captured.load();
+    defer set.deinit();
+    const ks = set.parsed.value.kernels;
+    // the prompt scratch's buffers and the fetch's as arenas carve them (every buffer 256-aligned), the stream's latent
+    // rows at an extent of its part, POS at a slot's 32-byte stride
+    var b: [11]u64 = undefined;
+    carve(0x7e00_0000_0000, &.{ 2048 * 1024, 2048 * qrow, 2048 * qrow, 512 * H * 512 * 4, 4096, 4096, 16, 2048 * W * 4, 2048 * 4, 40 * 16, 32 }, &b);
+    var f: [4]u64 = undefined;
+    carve(0x7d00_0000_0000, &sp.layout(1 << 20, 2048), &f);
+    const p: sp.Ptrs = .{ .copy = f[0], .mark = f[1], .sums = f[2], .zero = f[3] };
+    const lc: u64 = 0x7c00_0000_0000 + 3 * 2048 * RS;
+    const rec = try gpa.create(Recorder);
+    defer gpa.destroy(rec);
+    const plain = try gpa.create(Recorder);
+    defer gpa.destroy(plain);
+    var prng = std.Random.DefaultPrng.init(1182);
+    const rnd = prng.random();
+    for ([_]usize{ 1, 3, 63, 64, 65, 150, 512, 513, 2048 }) |rows| for ([_]usize{ 0, 1000, 2000, 2051, 9000 }) |pos| {
+        rec.* = .{};
+        plain.* = .{};
+        const sparse_rows = pos + rows - 1 >= grid.sparse_from;
+        const at: Bufs = .{ .lat = b[0], .qa = b[1], .ol = b[2], .po = b[3], .pm = b[4], .pl = b[5], .dummy = b[6], .tokens = b[7], .counts = b[8], .origins = b[9], .pos = b[10] };
+        const e = try engine(rec, 1, at);
+        const u = try engine(plain, 1, at);
+        // cuda_prefill.dsaLayer's unsharded launches: the latent write, the dense rows, the sparse rows
+        try u.latWrite(lc, u.pos_dev, rows);
+        try u.denseRows(lc, rows, pos, sparse_rows);
+        if (sparse_rows) try u.onepass(lc, 0, rows);
+        // the receiving rank's: its own rows into the copy (at their positions, or after a union's n rows from the zero
+        // word), the dense rows over the copy, the sparse rows over it whole or in 64-row blocks
+        const a: pre.ShardAttn = .{ .e = &e, .rows = rows, .pos = pos, .sparse_rows = sparse_rows };
+        if (pos < grid.sparse_from) {
+            try a.latWrite(p.copy, null);
+            try a.dense(p.copy);
+            if (sparse_rows) try a.sparse(p.copy, 0, rows);
+        } else {
+            try a.latWrite(p.copy + rnd.intRangeAtMost(usize, 0, sp.historyRows(1 << 20)) * RS, p.zero);
+            var lo: usize = 0;
+            while (lo < rows) : (lo += sp.block_rows * rnd.intRangeAtMost(usize, 1, 4)) try a.sparse(p.copy, lo, @min(rows, lo + sp.block_rows * 4));
+        }
+        // a chunk with dense rows: the unsharded launches with LC moved, one for one (the same grids in the same order);
+        // past the dense limit: the latent write and each block's onepass against the unsharded ones
+        const whole = pos < grid.sparse_from;
+        if (whole) try std.testing.expectEqual(plain.n, rec.n);
+        for (rec.launches[0..rec.n], 0..) |*l, i| {
+            const twin = if (whole) &plain.launches[i] else for (plain.launches[0..plain.n]) |*x| {
+                if (std.mem.eql(u8, x.name, l.name)) break x;
+            } else return error.NoUnshardedTwin;
+            try std.testing.expectEqualStrings(twin.name, l.name);
+            if (whole) try std.testing.expectEqual(twin.grid, l.grid);
+            const want = variant(ks, twin) orelse return error.UnshardedHasNoVariant;
+            const got = variant(ks, l) orelse {
+                std.debug.print("{s} at {d} rows from {d}: no captured variant\n", .{ l.name, rows, pos });
+                return error.MissingTritonVariant;
+            };
+            try std.testing.expectEqual(want, got);
+        }
+    };
+}
