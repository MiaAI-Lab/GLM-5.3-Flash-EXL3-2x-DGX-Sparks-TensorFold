+    try std.testing.expectEqualSlices(u32, &.{ 16, 36 }, plan.marks);
+    _ = f.passIn(&s, p1, plan, s.join(p1, null, true).chat); // the cut and the turn, both in the request's conversation
+    const k = s.keptStats();
