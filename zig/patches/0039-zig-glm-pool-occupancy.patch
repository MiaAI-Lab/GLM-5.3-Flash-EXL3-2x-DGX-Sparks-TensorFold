@@ -0,0 +1,182 @@
+//! The KV pool's occupancy by part for the once-a-minute line: live, twin, kept, free rows and the longest free run.
+const std = @import("std");
+const pool = @import("cuda_pool.zig");
+
+/// One part's rows now. `kept_rows` sums the extents' `kept` rows.
+pub const Part = struct {
+    rows: u64 = 0,
+    live_rows: u64 = 0,
+    live: u32 = 0,
+    twin_rows: u64 = 0,
+    kept_rows: u64 = 0,
+    free: u64 = 0,
+    largest_free: u64 = 0,
+};
+
+/// Every part of `p` (one for an unsharded pool) into `out`; how many.
+pub fn read(p: *const pool.Pool, out: *[pool.max_parts]Part) usize {
+    const n = @min(p.parts(), pool.max_parts);
+    for (out[0..n], 0..) |*q, i| {
+        const r = p.partRange(i);
+        q.* = .{ .rows = r.len() };
+        var at = r.lo;
+        for (p.extents.items) |x| {
+            if (!r.has(x.base)) continue;
+            q.largest_free = @max(q.largest_free, x.base -| at);
+            at = @max(at, x.end());
+            if (x.twin != null) {
+                q.twin_rows += x.size;
+            } else if (x.owner != null) {
+                q.live_rows += x.size;
+                q.live += 1;
+            }
+            q.kept_rows += x.kept;
+        }
+        q.largest_free = @max(q.largest_free, r.hi -| at);
+        q.free = p.freeIn(i);
+    }
+    return n;
+}
+
+/// The most the occupancy line holds: the pool's figures, then `pool.max_parts` parts of the widest figures.
+pub const max_line = 192 + pool.max_parts * 256;
+
+/// The occupancy line: the pool's free rows as /health publishes them, then each part.
+pub fn line(buf: []u8, parts: []const Part, pool_rows: u64, pool_free: u64) []const u8 {
+    var w = std.Io.Writer.fixed(buf);
+    lineInto(&w, parts, pool_rows, pool_free) catch return "";
+    return w.buffered();
+}
+
+fn lineInto(w: *std.Io.Writer, parts: []const Part, pool_rows: u64, pool_free: u64) !void {
+    try w.print("pool occupancy: pool_free {d} of {d} rows", .{ pool_free, pool_rows });
+    for (parts, 0..) |q, i| {
+        try w.print("; part {d} of {d} rows: live {d} ({d} streams), twin {d}, kept {d}, free {d}, largest free run {d}", .{ i, q.rows, q.live_rows, q.live, q.twin_rows, q.kept_rows, q.free, q.largest_free });
+    }
+}
+
+/// TF_GLM_POOL_LOG_S: seconds between occupancy and spill rate lines; 60 unset, 0 none, null if not a whole number.
+pub fn logSeconds(raw: ?[]const u8) ?u32 {
+    const t = std.mem.trim(u8, raw orelse return 60, " \t\r\n");
+    if (t.len == 0) return 60;
+    return std.fmt.parseInt(u32, t, 10) catch null;
+}
+
+/// Fires at the first look and then once every `every_ns` (0: never).
+pub const Timer = struct {
+    every_ns: u64,
+    next_ns: u64 = 0,
+
+    pub fn due(t: *Timer, now_ns: u64) bool {
+        if (t.every_ns == 0 or now_ns < t.next_ns) return false;
+        t.next_ns = now_ns +| t.every_ns;
+        return true;
+    }
+
+    /// `due`, for rank 0 alone: the line is the leader's, and another rank's timer is never touched.
+    pub fn dueOn(t: *Timer, rank: usize, now_ns: u64) bool {
+        return rank == 0 and t.due(now_ns);
+    }
+};
+
+const testing = std.testing;
+
+test "an unsharded pool is one part: live, free and the longest free run" {
+    var p = try pool.Pool.init(testing.allocator, 8 * pool.alignment);
+    defer p.deinit();
+    const a = try p.add(0, pool.alignment);
+    (try p.get(a)).owner = 0;
+    const b = try p.add(3 * pool.alignment, 2 * pool.alignment);
+    (try p.get(b)).owner = 1;
+    var out: [pool.max_parts]Part = undefined;
+    try testing.expectEqual(@as(usize, 1), read(&p, &out));
+    const q = out[0];
+    try testing.expectEqual(@as(u64, 8 * pool.alignment), q.rows);
+    try testing.expectEqual(@as(u64, 3 * pool.alignment), q.live_rows);
+    try testing.expectEqual(@as(u32, 2), q.live);
+    try testing.expectEqual(@as(u64, 0), q.twin_rows);
+    try testing.expectEqual(@as(u64, 5 * pool.alignment), q.free);
+    // the gap between them is 2 extents, the tail after the second 3
+    try testing.expectEqual(@as(u64, 3 * pool.alignment), q.largest_free);
+    try testing.expectEqual(@as(u64, p.freeRows()), q.free);
+}
+
+test "a sharded pool reads each part alone, twins counted apart from live streams" {
+    var p = try pool.Pool.initParts(testing.allocator, 8 * pool.alignment, 2);
+    defer p.deinit();
+    const a = try p.add(pool.alignment, 2 * pool.alignment); // part 0: a 1-extent gap before it and a 1-extent tail
+    (try p.get(a)).owner = 0;
+    const b = try p.add(4 * pool.alignment, pool.alignment); // part 1, at its start
+    (try p.get(b)).owner = 1;
+    try testing.expect(try p.borrow(a)); // a twin of a in part 1, right after b
+    var out: [pool.max_parts]Part = undefined;
+    try testing.expectEqual(@as(usize, 2), read(&p, &out));
+    const x = out[0];
+    const y = out[1];
+    try testing.expectEqual(@as(u64, 4 * pool.alignment), x.rows);
+    try testing.expectEqual(@as(u64, 2 * pool.alignment), x.live_rows);
+    try testing.expectEqual(@as(u32, 1), x.live);
+    try testing.expectEqual(@as(u64, 2 * pool.alignment), x.free);
+    try testing.expectEqual(@as(u64, pool.alignment), x.largest_free);
+    try testing.expectEqual(@as(u64, pool.alignment), y.live_rows);
+    try testing.expectEqual(@as(u32, 1), y.live);
+    try testing.expectEqual(@as(u64, 2 * pool.alignment), y.twin_rows);
+    try testing.expectEqual(@as(u64, pool.alignment), y.free);
+    try testing.expectEqual(@as(u64, pool.alignment), y.largest_free);
+    // every row is live, twin or free
+    try testing.expectEqual(y.rows, y.live_rows + y.twin_rows + y.free);
+    try testing.expectEqual(@as(u64, p.freeRows()), x.free + y.free);
+}
+
+test "the occupancy line reads the same figures the parts hold" {
+    var buf: [512]u8 = undefined;
+    const parts = [_]Part{
+        .{ .rows = 1_566_720, .live_rows = 100_352, .live = 3, .twin_rows = 4096, .free = 1_462_272, .largest_free = 1_000_000 },
+        .{ .rows = 1_566_720, .free = 1_566_720, .largest_free = 1_566_720 },
+    };
+    try testing.expectEqualStrings("pool occupancy: pool_free 3028992 of 3133440 rows; part 0 of 1566720 rows: live 100352 (3 streams), twin 4096, kept 0, free 1462272, largest free run 1000000; part 1 of 1566720 rows: live 0 (0 streams), twin 0, kept 0, free 1566720, largest free run 1566720", line(&buf, &parts, 3_133_440, 3_028_992));
+    var tiny: [16]u8 = undefined;
+    try testing.expectEqual(@as(usize, 0), line(&tiny, &parts, 3_133_440, 3_028_992).len);
+}
+
+test "the log interval: 60 s unless set, a whole number of seconds, 0 for none" {
+    try testing.expectEqual(@as(?u32, 60), logSeconds(null));
+    try testing.expectEqual(@as(?u32, 60), logSeconds(" "));
+    try testing.expectEqual(@as(?u32, 10), logSeconds("10"));
+    try testing.expectEqual(@as(?u32, 0), logSeconds("0"));
+    try testing.expectEqual(@as(?u32, null), logSeconds("1.5"));
+    try testing.expectEqual(@as(?u32, null), logSeconds("-3"));
+    try testing.expectEqual(@as(?u32, null), logSeconds("often"));
+}
+
+test "the timer fires at its first look, then once an interval, and never at 0" {
+    var t: Timer = .{ .every_ns = 60 * std.time.ns_per_s };
+    try testing.expect(t.due(5 * std.time.ns_per_s)); // the first look, whatever the clock reads
+    try testing.expect(!t.due(30 * std.time.ns_per_s));
+    try testing.expect(!t.due(64 * std.time.ns_per_s));
+    try testing.expect(t.due(65 * std.time.ns_per_s));
+    try testing.expect(!t.due(66 * std.time.ns_per_s));
+    var off: Timer = .{ .every_ns = 0 };
+    try testing.expect(!off.due(0));
+    try testing.expect(!off.due(1 << 60));
+}
+
+test "only rank 0 takes the line, and another rank leaves the timer as it was" {
+    var t: Timer = .{ .every_ns = 60 * std.time.ns_per_s };
+    try testing.expect(!t.dueOn(1, 5 * std.time.ns_per_s));
+    try testing.expect(!t.dueOn(3, 1 << 50));
+    try testing.expectEqual(@as(u64, 0), t.next_ns);
+    try testing.expect(t.dueOn(0, 5 * std.time.ns_per_s));
+    try testing.expect(!t.dueOn(0, 6 * std.time.ns_per_s));
+    try testing.expect(!t.dueOn(1, 1 << 50));
+    var off: Timer = .{ .every_ns = 0 };
+    try testing.expect(!off.dueOn(0, 1 << 50));
+}
+
+test "a pool of the most parts, at the widest figures, still fits the line's buffer" {
+    var parts: [pool.max_parts]Part = @splat(.{ .rows = std.math.maxInt(u64), .live_rows = std.math.maxInt(u64), .live = std.math.maxInt(u32), .twin_rows = std.math.maxInt(u64), .kept_rows = std.math.maxInt(u64), .free = std.math.maxInt(u64), .largest_free = std.math.maxInt(u64) });
+    var buf: [max_line]u8 = undefined;
+    const got = line(&buf, &parts, std.math.maxInt(u64), std.math.maxInt(u64));
+    try testing.expect(got.len > 0);
+    try testing.expect(std.mem.indexOf(u8, got, "part 7 of ") != null);
+}
diff --git a/zig/src/families/glm_cuda/cuda_pool_trace_test.zig b/zig/src/families/glm_cuda/cuda_pool_trace_test.zig
