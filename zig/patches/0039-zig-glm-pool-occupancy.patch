--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_pool_trace_test.zig
@@ -0,0 +1,50 @@
+//! The request trace is found in a log full of the pool's observation lines, and none of them is taken for a trace.
+const std = @import("std");
+const lanes = @import("lanes");
+const trace = lanes.request_trace;
+const occupancy = @import("cuda_pool_occupancy.zig");
+const pool_log = @import("cuda_pool_log.zig");
+const snap_timing = @import("cuda_snap_timing.zig");
+const spill_rates = @import("cuda_spill_rates.zig");
+
+fn addLine(log: *std.ArrayList(u8), level: []const u8, line: []const u8) !void {
+    try std.testing.expect(line.len > 0);
+    try log.print(std.testing.allocator, "2026-10-28T10:00:00.000Z {s}: {s}\n", .{ level, line });
+}
+
+test "a log of every line the pool phase writes yields the trace lines, in order, and only those" {
+    const gpa = std.testing.allocator;
+    var log: std.ArrayList(u8) = .empty;
+    defer log.deinit(gpa);
+    var buf: [2048]u8 = undefined;
+    const g: u64 = 1 << 30;
+    const sizing: pool_log.Sizing = .{ .available = 96 * g, .reserve = 14 * g, .room = 82 * g, .cap = 4 * g, .spare = 4 * g, .rows = 3_133_440, .pool_bytes = 4 * g, .unified = true, .sized = true };
+    try addLine(&log, "info", pool_log.sizingLine(&buf, 0, sizing));
+    try addLine(&log, "info", pool_log.driftLine(&buf, 0, sizing, 90 * g));
+    try addLine(&log, "info", pool_log.cutLine(&buf, 1, .{ .plane = 0, .row = 700 }, 700, 256 << 20));
+    try addLine(&log, "info", pool_log.cutLine(&buf, 0, null, null, 256 << 20));
+    try addLine(&log, "info", trace.header(&buf, .{ .boot = 0xabc, .store_budget = 2240 << 20 }));
+    var parts = [_]occupancy.Part{ .{ .rows = 1_566_720, .free = 1_000_000, .largest_free = 900_000 }, .{ .rows = 1_566_720, .free = 1_566_720, .largest_free = 1_566_720 } };
+    try addLine(&log, "info", occupancy.line(&buf, &parts, 3_133_440, 2_566_720));
+    var want: [5]trace.Record = undefined;
+    for (&want, 0..) |*r, i| {
+        r.* = .{ .t_ms = 1000 * i, .prompt = @intCast(300_000 + i), .cached = if (i == 0) 0 else 299_968, .max_tokens = 1024, .chat = trace.chatHash(0xabc, @intCast(i % 2 + 1)), .first_ms = if (i == 3) null else 2000, .done_ms = 30_000, .kept = @intCast(i % 2), .chat_entries = @intCast(i % 3), .gen = if (i == 3) 0 else 800, .end = if (i == 3) .cancelled else .length };
+        try addLine(&log, "info", trace.format(&buf, r.*));
+        try addLine(&log, "info", snap_timing.line(&buf, 0, .{ .op = .take, .bytes = 1 << 30, .tokens = 262_144, .t = .{ .alloc_ns = 3_000_000, .copy_ns = 1_000_000, .sync_ns = 50_000_000 } }));
+        try addLine(&log, "info", "prompt cache: 300000 tokens, resumed at 0, kept 1; 1 states, 5000 MiB and 3000 MiB spare of 8000 MiB");
+    }
+    try addLine(&log, "info", spill_rates.windowLine(&buf, 0, .{ .ns = 60 * std.time.ns_per_s, .written = 1 << 30 }, 3.5));
+    try addLine(&log, "warn", "request trace v1 t=5 prom"); // a line cut off mid-write
+    var bad: usize = 0;
+    const got = try trace.parseAll(gpa, log.items, &bad);
+    defer gpa.free(got);
+    try std.testing.expectEqual(@as(usize, 1), bad);
+    try std.testing.expectEqual(want.len, got.len);
+    // the header is no record, and reads back where the replay takes its salt and its store from
+    const head = try trace.parseHeader(std.mem.sliceTo(std.mem.sliceTo(log.items[std.mem.indexOf(u8, log.items, trace.marker ++ "header").?..], '\n'), 0));
+    try std.testing.expectEqual(trace.Header{ .boot = 0xabc, .store_budget = 2240 << 20 }, head);
+    for (want, got) |w, r| try std.testing.expectEqualDeep(w, r);
+    // the two turns of one chat hash alike, the other chat differently
+    try std.testing.expectEqual(got[0].chat, got[2].chat);
+    try std.testing.expect(got[0].chat != got[1].chat);
+}
diff --git a/zig/src/families/glm_cuda/cuda_snap_timing.zig b/zig/src/families/glm_cuda/cuda_snap_timing.zig
new file mode 100644
index 0000000000000000000000000000000000000000..1d284b8843eb023dbc79a71432ea6c53613af326
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_snap_timing.zig
@@ -0,0 +1,235 @@
+//! Times kept-state copies (take, restore, carry, free) by phase, counts them by size for /health, logs the big ones.
+const std = @import("std");
+const lanes = @import("lanes");
+const timing = lanes.snap_timing;
+
+pub const Op = timing.Op;
+const mib: f64 = 1 << 20;
+const gib: f64 = 1 << 30;
+
+/// A monotonic clock, ns.
+pub fn nowNs() u64 {
+    var ts: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(std.c.CLOCK.MONOTONIC, &ts);
+    return @as(u64, @intCast(ts.sec)) * std.time.ns_per_s + @as(u64, @intCast(ts.nsec));
+}
+
+/// One copy's phases, ns: the device allocation, the copy calls' enqueue, the stream wait; a free times its cuMemFree.
+pub const Times = struct {
+    alloc_ns: u64 = 0,
+    copy_ns: u64 = 0,
+    sync_ns: u64 = 0,
+    free_ns: u64 = 0,
+
+    pub fn total(t: Times) u64 {
+        return t.alloc_ns + t.copy_ns + t.sync_ns + t.free_ns;
+    }
+};
+
+/// TF_GLM_SNAP_LOG_MIB: copies of this many MiB or more are logged (64; 0: none, no start-up probe); /health counts all
+pub const Settings = struct {
+    log_bytes: u64 = 64 << 20,
+
+    /// The setting's text; null for anything but a whole number of MiB (the caller keeps the default and says so).
+    pub fn parse(raw: ?[]const u8) ?Settings {
+        const t = std.mem.trim(u8, raw orelse return .{}, " \t\r\n");
+        if (t.len == 0) return .{};
+        const n = std.fmt.parseInt(u32, t, 10) catch return null;
+        return .{ .log_bytes = @as(u64, n) << 20 };
+    }
+
+    pub fn logs(s: Settings, bytes: u64) bool {
+        return s.log_bytes != 0 and bytes >= s.log_bytes;
+    }
+};
+
+/// Counters by operation and size class, written on the lane thread and the spill threads, read by the HTTP threads.
+pub const Hist = struct {
+    const Cell = struct {
+        count: std.atomic.Value(u64) = .init(0),
+        bytes: std.atomic.Value(u64) = .init(0),
+        alloc_ns: std.atomic.Value(u64) = .init(0),
+        copy_ns: std.atomic.Value(u64) = .init(0),
+        sync_ns: std.atomic.Value(u64) = .init(0),
+        free_ns: std.atomic.Value(u64) = .init(0),
+        max_ns: std.atomic.Value(u64) = .init(0),
+    };
+
+    cells: [timing.ops][timing.classes]Cell = @splat(@splat(.{})),
+
+    pub fn add(h: *Hist, op: Op, bytes: u64, t: Times) void {
+        const c = &h.cells[@backingInt(op)][timing.classOf(bytes)];
+        _ = c.count.fetchAdd(1, .monotonic);
+        _ = c.bytes.fetchAdd(bytes, .monotonic);
+        _ = c.alloc_ns.fetchAdd(t.alloc_ns, .monotonic);
+        _ = c.copy_ns.fetchAdd(t.copy_ns, .monotonic);
+        _ = c.sync_ns.fetchAdd(t.sync_ns, .monotonic);
+        _ = c.free_ns.fetchAdd(t.free_ns, .monotonic);
+        _ = c.max_ns.fetchMax(t.total(), .monotonic);
+    }
+
+    pub fn snapshot(h: *const Hist, out: *timing.Snapshot) void {
+        for (&out.cells, &h.cells) |*row, *src| {
+            for (row, src) |*c, *a| c.* = .{
+                .count = a.count.load(.monotonic),
+                .bytes = a.bytes.load(.monotonic),
+                .alloc_ns = a.alloc_ns.load(.monotonic),
+                .copy_ns = a.copy_ns.load(.monotonic),
+                .sync_ns = a.sync_ns.load(.monotonic),
+                .free_ns = a.free_ns.load(.monotonic),
+                .max_ns = a.max_ns.load(.monotonic),
+            };
+        }
+    }
+};
+
+fn ms(ns: u64) f64 {
+    return @as(f64, @floatFromInt(ns)) / 1e6;
+}
+
+/// A carry made before a restore, in its line: the bytes exchanged and the time its calls took to enqueue.
+pub const Carried = struct { bytes: u64, ns: u64 };
+
+/// One copy as its log line states it.
+pub const Copy = struct {
+    op: Op,
+    /// the state's bytes (the size class it is counted in)
+    bytes: u64,
+    /// the bytes this rank copied itself (null: all): a restore that sends or carries latent rows copies fewer
+    local: ?u64 = null,
+    /// the state's position (0: unknown)
+    tokens: u64 = 0,
+    t: Times,
+    carried: ?Carried = null,
+};
+
+/// One copy's log line.
+pub fn line(buf: []u8, rank: u32, c: Copy) []const u8 {
+    var w = std.Io.Writer.fixed(buf);
+    lineInto(&w, rank, c) catch return "";
+    return w.buffered();
+}
+
+fn lineInto(w: *std.Io.Writer, rank: u32, c: Copy) !void {
+    const size = @as(f64, @floatFromInt(c.bytes));
+    const t = c.t;
+    try w.print("rank {d}: kept-state {s}: {d:.1} MiB", .{ rank, @tagName(c.op), size / mib });
+    if (c.tokens > 0) try w.print(" at {d} tokens", .{c.tokens});
+    switch (c.op) {
+        .free => return w.print("; cuMemFree {d:.3} ms", .{ms(t.free_ns)}),
+        .carry => try w.print("; calls enqueued in {d:.3} ms (the stream's wait is the restore's sync)", .{ms(t.copy_ns)}),
+        else => try w.print("; alloc {d:.3} ms, copy {d:.3} ms, sync {d:.3} ms", .{ ms(t.alloc_ns), ms(t.copy_ns), ms(t.sync_ns) }),
+    }
+    if (c.op == .take or c.op == .restore) {
+        const moved = t.copy_ns + t.sync_ns;
+        const local = c.local orelse c.bytes;
+        try w.print("; total {d:.3} ms", .{ms(t.total())});
+        if (moved > 0) try w.print(", {d:.2} GiB/s over the copy and the wait", .{@as(f64, @floatFromInt(local)) / gib / (@as(f64, @floatFromInt(moved)) / 1e9)});
+        if (local != c.bytes) try w.print(" (the {d:.1} MiB copied on this rank)", .{@as(f64, @floatFromInt(local)) / mib});
+    }
+    if (c.carried) |k| try w.print("; carried {d:.1} MiB before the copy (enqueued in {d:.3} ms, its transfer lands in the sync)", .{ @as(f64, @floatFromInt(k.bytes)) / mib, ms(k.ns) });
+}
+
+/// What the start-up probe of cuMemAlloc and cuMemFree on a buffer the size of a fixed state measured, ns.
+pub const Probe = struct {
+    bytes: u64,
+    n: usize,
+    alloc: [8]u64 = @splat(0),
+    free: [8]u64 = @splat(0),
+};
+
+fn spread(samples: []const u64, scratch: []u64) [3]u64 {
+    const s = scratch[0..samples.len];
+    @memcpy(s, samples);
+    std.mem.sort(u64, s, {}, std.sort.asc(u64));
+    return .{ s[0], s[s.len / 2], s[s.len - 1] };
+}
+
+pub fn probeLine(buf: []u8, rank: u32, p: Probe) []const u8 {
+    if (p.n == 0 or p.n > p.alloc.len) return "";
+    var scratch: [8]u64 = undefined;
+    const a = spread(p.alloc[0..p.n], &scratch);
+    const f = spread(p.free[0..p.n], &scratch);
+    return std.fmt.bufPrint(buf, "rank {d}: cuMemAlloc and cuMemFree of a {d:.1} MiB buffer, {d} tries (min / median / max): alloc {d:.3} / {d:.3} / {d:.3} ms, free {d:.3} / {d:.3} / {d:.3} ms", .{ rank, @as(f64, @floatFromInt(p.bytes)) / mib, p.n, ms(a[0]), ms(a[1]), ms(a[2]), ms(f[0]), ms(f[1]), ms(f[2]) }) catch "";
+}
+
+const testing = std.testing;
+
+test "the log threshold: 64 MiB by default, a whole number of MiB, 0 for none" {
+    try testing.expectEqual(@as(u64, 64 << 20), Settings.parse(null).?.log_bytes);
+    try testing.expectEqual(@as(u64, 64 << 20), Settings.parse("  ").?.log_bytes);
+    try testing.expectEqual(@as(u64, 256 << 20), Settings.parse("256").?.log_bytes);
+    try testing.expect(Settings.parse("many") == null);
+    try testing.expect(Settings.parse("-1") == null);
+    const s = Settings.parse(null).?;
+    try testing.expect(!s.logs((64 << 20) - 1));
+    try testing.expect(s.logs(64 << 20));
+    try testing.expect(!Settings.parse("0").?.logs(1 << 40));
+}
+
+test "a take's line splits the time into its phases and gives the rate over the copy and the wait" {
+    var buf: [512]u8 = undefined;
+    const t: Times = .{ .alloc_ns = 3_200_000, .copy_ns = 1_100_000, .sync_ns = 61_000_000 };
+    const got = line(&buf, 0, .{ .op = .take, .bytes = 1_700_000_000, .tokens = 262_144, .t = t });
+    try testing.expectEqualStrings("rank 0: kept-state take: 1621.2 MiB at 262144 tokens; alloc 3.200 ms, copy 1.100 ms, sync 61.000 ms; total 65.300 ms, 25.50 GiB/s over the copy and the wait", got);
+}
+
+test "a restore's line carries its carry and rates the bytes it copied here; a free's line its one latency, a carry's its enqueue" {
+    var buf: [512]u8 = undefined;
+    const carry: Carried = .{ .bytes = 3_100_000_000, .ns = 400_000 };
+    // the receiving rank copies the state less the latent rows the carry brings
+    const r = line(&buf, 1, .{ .op = .restore, .bytes = 3_200_000_000, .local = 100_000_000, .tokens = 524_224, .t = .{ .copy_ns = 2_000_000, .sync_ns = 100_000_000 }, .carried = carry });
+    try testing.expect(std.mem.indexOf(u8, r, "kept-state restore: 3051.8 MiB at 524224 tokens; alloc 0.000 ms, copy 2.000 ms, sync 100.000 ms; total 102.000 ms, 0.91 GiB/s over the copy and the wait (the 95.4 MiB copied on this rank)") != null);
+    try testing.expect(std.mem.endsWith(u8, r, "; carried 2956.4 MiB before the copy (enqueued in 0.400 ms, its transfer lands in the sync)"));
+    // a restore that copied all of it states no basis for its rate
+    const whole = line(&buf, 0, .{ .op = .restore, .bytes = 1 << 30, .t = .{ .copy_ns = 1_000_000, .sync_ns = 99_000_000 } });
+    try testing.expectEqualStrings("rank 0: kept-state restore: 1024.0 MiB; alloc 0.000 ms, copy 1.000 ms, sync 99.000 ms; total 100.000 ms, 10.00 GiB/s over the copy and the wait", whole);
+    var b2: [512]u8 = undefined;
+    const f = line(&b2, 0, .{ .op = .free, .bytes = 107_986_944, .t = .{ .free_ns = 1_250_000 } });
+    try testing.expectEqualStrings("rank 0: kept-state free: 103.0 MiB; cuMemFree 1.250 ms", f);
+    var b3: [512]u8 = undefined;
+    const c = line(&b3, 0, .{ .op = .carry, .bytes = 3_100_000_000, .tokens = 524_224, .t = .{ .copy_ns = 400_000 } });
+    try testing.expectEqualStrings("rank 0: kept-state carry: 2956.4 MiB at 524224 tokens; calls enqueued in 0.400 ms (the stream's wait is the restore's sync)", c);
+    // a copy with no time at all gives no rate (never a division by zero)
+    try testing.expect(std.mem.indexOf(u8, line(&buf, 0, .{ .op = .take, .bytes = 1 << 30, .t = .{} }), "GiB/s") == null);
+    // a buffer too small gives an empty line, never a torn one
+    var tiny: [24]u8 = undefined;
+    try testing.expectEqual(@as(usize, 0), line(&tiny, 0, .{ .op = .take, .bytes = 1 << 30, .t = .{} }).len);
+}
+
+test "the histogram counts by operation and size class and reads back whole" {
+    var h: Hist = .{};
+    h.add(.take, 100 << 20, .{ .alloc_ns = 5, .copy_ns = 7, .sync_ns = 11 });
+    h.add(.take, 120 << 20, .{ .alloc_ns = 1, .copy_ns = 1, .sync_ns = 1 });
+    h.add(.take, 30 << 20, .{ .sync_ns = 9 });
+    h.add(.restore, 2 << 30, .{ .copy_ns = 3, .sync_ns = 4 });
+    h.add(.free, 100 << 20, .{ .free_ns = 13 });
+    h.add(.free, 100 << 20, .{ .free_ns = 2 });
+    var s: timing.Snapshot = .{};
+    h.snapshot(&s);
+    const mid = s.cell(.take, 1);
+    try testing.expectEqual(@as(u64, 2), mid.count);
+    try testing.expectEqual(@as(u64, 220 << 20), mid.bytes);
+    try testing.expectEqual(@as(u64, 6), mid.alloc_ns);
+    try testing.expectEqual(@as(u64, 8), mid.copy_ns);
+    try testing.expectEqual(@as(u64, 12), mid.sync_ns);
+    try testing.expectEqual(@as(u64, 23), mid.max_ns);
+    try testing.expectEqual(@as(u64, 1), s.cell(.take, 0).count);
+    try testing.expectEqual(@as(u64, 9), s.cell(.take, 0).sync_ns);
+    try testing.expectEqual(@as(u64, 1), s.cell(.restore, 6).count);
+    try testing.expectEqual(@as(u64, 0), s.cell(.carry, 6).count);
+    try testing.expectEqual(@as(u64, 7), s.cell(.restore, 6).max_ns);
