new file mode 100644
index 0000000000000000000000000000000000000000..9969b6130d01aad2c4c92e8e07ea0ec8f9e54e12
--- /dev/null
+++ b/zig/src/core/lane_host_trace_test.zig
@@ -0,0 +1,300 @@
+//! LaneHost's per-request trace: one line a request when it ends, in the format a replay reads.
+const std = @import("std");
+const lanes = @import("lanes");
+const api = @import("engine_api.zig");
+const pc = @import("prompt_cache.zig");
+const LaneHost = api.LaneHost;
+const Id = api.Id;
+const Event = api.Event;
+const Request = api.Request;
+const Reason = api.Reason;
+const trace = lanes.request_trace;
+
+/// The trace's lines, as the host hands them out (the engine thread appends, the test reads after a request's end).
+const Lines = struct {
+    mutex: std.Io.Mutex = .init,
+    items: std.ArrayList([]u8) = .empty,
+
+    fn out(ctx: ?*anyopaque, line: []const u8) void {
+        const l: *Lines = @ptrCast(@alignCast(ctx.?));
+        l.mutex.lockUncancelable(std.testing.io);
+        defer l.mutex.unlock(std.testing.io);
+        l.items.append(std.testing.allocator, std.testing.allocator.dupe(u8, line) catch return) catch {};
+    }
+
+    fn deinit(l: *Lines) void {
+        for (l.items.items) |s| std.testing.allocator.free(s);
+        l.items.deinit(std.testing.allocator);
+    }
+};
+
+const Box = struct {
+    mutex: std.Io.Mutex = .init,
+    tokens: std.ArrayList(u32) = .empty,
+    done: ?Reason = null,
+
+    fn event(ctx: *anyopaque, _: Id, e: *const Event) void {
+        const b: *Box = @ptrCast(@alignCast(ctx));
+        b.mutex.lockUncancelable(std.testing.io);
+        defer b.mutex.unlock(std.testing.io);
+        switch (e.*) {
+            .tokens => |t| b.tokens.appendSlice(std.testing.allocator, t) catch {},
+            .finished => |f| b.done = f.reason,
+            else => {},
+        }
+    }
+
+    /// Until the request finishes; a request that never does fails the test after `wait_ms`, it never hangs it.
+    fn wait(b: *Box) !Reason {
+        for (0..wait_ms) |_| {
+            b.mutex.lockUncancelable(std.testing.io);
+            const d = b.done;
+            b.mutex.unlock(std.testing.io);
+            if (d) |r| return r;
+            std.Io.sleep(std.testing.io, .fromMilliseconds(1), .awake) catch {};
+        }
+        return error.NeverFinished;
+    }
+};
+
+const wait_ms = 20_000;
+
+const Snaps = struct {
+    fn bytes(_: *anyopaque, at: u32) u64 {
+        return 64 + 4 * @as(u64, at);
+    }
+    fn save(ptr: *anyopaque, owner: ?*anyopaque, at: u32) anyerror!pc.Saved {
+        const f: *lanes.fake.Fake = @ptrCast(@alignCast(ptr));
+        return f.save(@ptrCast(@alignCast(owner.?)), at);
+    }
+    fn restore(_: *anyopaque, _: ?*anyopaque, _: pc.Saved) anyerror!void {
+        return error.BackendRestores;
+    }
+    fn drop(ptr: *anyopaque, saved: pc.Saved) void {
+        const f: *lanes.fake.Fake = @ptrCast(@alignCast(ptr));
+        f.drop(saved);
+    }
+};
+
+test "a conversation's two turns trace as two lines: lengths, the resume, the pass's keeps and the chat's states" {
+    const gpa = std.testing.allocator;
+    var cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+    defer cfg.deinit(gpa);
+    var target: lanes.fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(gpa, &cfg, target.backend(), clock.clock());
+    defer core.deinit();
+    var store = pc.Store.init(gpa, .{ .ptr = &target, .vtable = &.{ .bytes = Snaps.bytes, .save = Snaps.save, .restore = Snaps.restore, .drop = Snaps.drop } }, .{ .min_gap = 4, .min_prompt = 0 }, 1 << 20);
+    defer store.deinit();
+    var host = LaneHost.init(gpa, std.testing.io, &core, .{ .lanes = 2 });
+    host.cache = &store;
+    var lines: Lines = .{};
+    defer lines.deinit();
+    host.traceOn(0xfeed_beef, &lines, Lines.out);
+    try host.start();
+    defer host.stop();
+    const e = host.engine();
+    const t1 = [_]u32{ 3, 1, 4, 1, 5, 9, 2, 6, 5, 3 };
+    var b1: Box = .{};
+    defer b1.tokens.deinit(gpa);
+    const r1: Request = .{ .prompt = &t1, .max_tokens = 6, .history_len = 8 };
+    try e.submit(1, &r1, .{ .ctx = &b1, .event = Box.event });
+    try std.testing.expectEqual(Reason.length, try b1.wait());
+    var t2: std.ArrayList(u32) = .empty;
+    defer t2.deinit(gpa);
+    try t2.appendSlice(gpa, &t1);
+    try t2.appendSlice(gpa, b1.tokens.items[0..4]);
+    try t2.appendSlice(gpa, &.{ 7, 7, 5, 3 });
+    var b2: Box = .{};
+    defer b2.tokens.deinit(gpa);
+    const r2: Request = .{ .prompt = t2.items, .max_tokens = 12, .history_len = @intCast(t2.items.len - 2) };
+    try e.submit(2, &r2, .{ .ctx = &b2, .event = Box.event });
+    try std.testing.expectEqual(Reason.length, try b2.wait());
+
+    try std.testing.expectEqual(@as(usize, 3), lines.items.items.len); // the header, then a line a request
+    try std.testing.expectError(error.Header, trace.parse(lines.items.items[0]));
+    const head = try trace.parseHeader(lines.items.items[0]);
+    try std.testing.expectEqual(@as(u64, 0xfeed_beef), head.boot);
+    try std.testing.expectEqual(@as(?u64, 1 << 20), head.store_budget); // (the store's budget: the replay reads it)
+    const a = try trace.parse(lines.items.items[1]);
+    const b = try trace.parse(lines.items.items[2]);
+    try std.testing.expectEqual(@as(u32, 10), a.prompt);
+    try std.testing.expectEqual(@as(u32, 0), a.cached);
+    try std.testing.expectEqual(@as(u32, 6), a.max_tokens);
+    try std.testing.expectEqual(@as(u32, 6), a.gen);
+    try std.testing.expectEqual(trace.End.length, a.end);
+    try std.testing.expect(a.first_ms != null and a.first_ms.? <= a.done_ms);
+    try std.testing.expectEqual(@as(u32, 1), a.kept);
+    try std.testing.expectEqual(@as(u32, 1), a.chat_entries);
+    try std.testing.expect(a.chat != 0);
+    // the second turn resumes the first's state (8 tokens), keeps one of its own and joins the same conversation
+    try std.testing.expectEqual(@as(u32, @intCast(t2.items.len)), b.prompt);
+    try std.testing.expectEqual(@as(u32, 8), b.cached);
+    try std.testing.expectEqual(@as(u32, 12), b.max_tokens);
+    try std.testing.expectEqual(@as(u32, 12), b.gen);
+    try std.testing.expectEqual(a.chat, b.chat);
+    try std.testing.expectEqual(@as(u32, 1), b.kept);
+    try std.testing.expectEqual(@as(u32, 2), b.chat_entries);
+    try std.testing.expect(b.t_ms >= a.t_ms);
+}
+
+test "a request cancelled before its pass still traces, with no first token and no keeps" {
+    const gpa = std.testing.allocator;
+    var cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+    defer cfg.deinit(gpa);
+    var target: lanes.fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(gpa, &cfg, target.backend(), clock.clock());
+    defer core.deinit();
+    var host = LaneHost.init(gpa, std.testing.io, &core, .{ .lanes = 1 });
+    var lines: Lines = .{};
+    defer lines.deinit();
+    host.traceOn(1, &lines, Lines.out);
+    const prompt = [_]u32{ 2, 7, 1, 8 };
+    var b: Box = .{};
+    defer b.tokens.deinit(gpa);
+    const r: Request = .{ .prompt = &prompt, .max_tokens = 64 };
+    const e = host.engine();
+    try e.submit(7, &r, .{ .ctx = &b, .event = Box.event }); // (the thread is not running: it waits queued)
+    e.cancel(7);
+    try host.start();
+    defer host.stop();
+    try std.testing.expectEqual(Reason.cancelled, try b.wait());
+    try std.testing.expectEqual(@as(usize, 2), lines.items.items.len);
+    const t = try trace.parse(lines.items.items[1]);
+    try std.testing.expectEqual(@as(u32, 4), t.prompt);
+    try std.testing.expectEqual(@as(u32, 0), t.cached);
+    try std.testing.expectEqual(@as(?u32, null), t.first_ms);
+    try std.testing.expectEqual(@as(u32, 0), t.gen);
+    try std.testing.expectEqual(@as(u32, 0), t.kept);
+    try std.testing.expectEqual(@as(u64, 0), t.chat);
+    try std.testing.expectEqual(trace.End.cancelled, t.end);
+}
+
+/// One request through a one-lane host over the fake backend with the default sink: how many lines it wrote.
+fn defaultSinkLines(trace_on: bool) !usize {
+    const gpa = std.testing.allocator;
+    var cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+    defer cfg.deinit(gpa);
+    var target: lanes.fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(gpa, &cfg, target.backend(), clock.clock());
+    defer core.deinit();
+    var host = LaneHost.init(gpa, std.testing.io, &core, .{ .lanes = 1 });
+    const before = LaneHost.Trace.logged.load(.monotonic);
+    if (trace_on) host.traceOn(1, null, null); // (as the native glue does: no sink of its own)
+    try std.testing.expectEqual(trace_on, host.trace != null);
+    try host.start();
+    defer host.stop();
+    const prompt = [_]u32{ 2, 7, 1, 8 };
+    var b: Box = .{};
+    defer b.tokens.deinit(gpa);
+    const r: Request = .{ .prompt = &prompt, .max_tokens = 4 };
+    try host.engine().submit(1, &r, .{ .ctx = &b, .event = Box.event });
+    try std.testing.expectEqual(Reason.length, try b.wait());
+    try std.testing.expectEqual(@as(usize, 4), b.tokens.items.len); // (served the same either way)
+    return LaneHost.Trace.logged.load(.monotonic) - before;
+}
+
+test "a host with the trace off writes nothing to the default sink; with it on, its header and a line a request" {
+    try std.testing.expectEqual(@as(usize, 0), try defaultSinkLines(false));
+    try std.testing.expectEqual(@as(usize, 2), try defaultSinkLines(true));
+}
+
+test "a warm pass counts the state it keeps at its end with the states of its pass, and the chat after both" {
+    const gpa = std.testing.allocator;
+    var cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+    defer cfg.deinit(gpa);
+    var target: lanes.fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(gpa, &cfg, target.backend(), clock.clock());
+    defer core.deinit();
+    var store = pc.Store.init(gpa, .{ .ptr = &target, .vtable = &.{ .bytes = Snaps.bytes, .save = Snaps.save, .restore = Snaps.restore, .drop = Snaps.drop } }, .{ .min_gap = 4, .min_prompt = 0 }, 1 << 20);
+    defer store.deinit();
+    var host = LaneHost.init(gpa, std.testing.io, &core, .{ .lanes = 1, .warm_turns = true });
+    host.cache = &store;
+    var lines: Lines = .{};
+    defer lines.deinit();
+    host.traceOn(3, &lines, Lines.out);
+    try host.start();
+    defer host.stop();
+    const prompt = [_]u32{ 3, 1, 4, 1, 5, 9, 2, 6, 5, 3 };
+    var b: Box = .{};
+    defer b.tokens.deinit(gpa);
+    const r: Request = .{ .prompt = &prompt, .max_tokens = 0, .history_len = 8 };
+    try host.engine().submit(1, &r, .{ .ctx = &b, .event = Box.event });
+    try std.testing.expectEqual(Reason.length, try b.wait());
+    try std.testing.expectEqual(@as(usize, 2), lines.items.items.len);
+    const t = try trace.parse(lines.items.items[1]);
+    // the mark at the history's end (8) and the end of the prompt (10): two states, both the conversation's own
+    try std.testing.expectEqual(@as(u32, 2), t.kept);
+    try std.testing.expectEqual(@as(u32, 2), t.chat_entries);
+    try std.testing.expectEqual(@as(u64, 2), store.counts.kept);
+    try std.testing.expectEqual(@as(u32, 0), t.gen);
+}
+
+/// Two prompts fill at once on a two-lane host, a long one first: each line's `kept` is its own pass's keeps.
+fn overlappingFills(comptime stepped: bool) !void {
+    const gpa = std.testing.allocator;
+    var cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+    defer cfg.deinit(gpa);
+    var target: lanes.fake.Fake = .{ .gpa = gpa, .slice = 1, .prefill_chunks = if (stepped) 6 else 1 };
+    defer target.deinit();
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(gpa, &cfg, if (stepped) target.stepped() else target.backendSliced(), clock.clock());
+    defer core.deinit();
+    var store = pc.Store.init(gpa, .{ .ptr = &target, .vtable = &.{ .bytes = Snaps.bytes, .save = Snaps.save, .restore = Snaps.restore, .drop = Snaps.drop } }, .{ .min_gap = 4, .min_prompt = 0 }, 1 << 20);
+    defer store.deinit();
+    store.policy = .{ .recipe = true, .shared_least = 16 };
+    var host = LaneHost.init(gpa, std.testing.io, &core, .{ .lanes = 2 });
+    host.cache = &store;
+    var lines: Lines = .{};
+    defer lines.deinit();
+    host.traceOn(0xabc, &lines, Lines.out);
+    var long: [40]u32 = undefined;
+    for (&long, 0..) |*t, i| t.* = 20 + @as(u32, @intCast(i * 7 % 53));
+    var short: [10]u32 = undefined;
+    for (&short, 0..) |*t, i| t.* = 90 + @as(u32, @intCast(i * 3 % 11));
+    var b_long: Box = .{};
+    defer b_long.tokens.deinit(gpa);
+    var b_short: Box = .{};
+    defer b_short.tokens.deinit(gpa);
+    const cuts = [_]u32{ 16, 28 };
+    const r_long: Request = .{ .prompt = &long, .max_tokens = 4, .history_len = 38, .shared_prefixes = &cuts };
+    const r_short: Request = .{ .prompt = &short, .max_tokens = 4, .history_len = 8 };
+    const e = host.engine();
+    try e.submit(1, &r_long, .{ .ctx = &b_long, .event = Box.event }); // (both wait queued: the first admission takes them together)
+    try e.submit(2, &r_short, .{ .ctx = &b_short, .event = Box.event });
+    try host.start();
+    defer host.stop();
+    try std.testing.expectEqual(Reason.length, try b_long.wait());
+    try std.testing.expectEqual(Reason.length, try b_short.wait());
+    try std.testing.expectEqual(@as(usize, 3), lines.items.items.len);
+    var long_line: ?trace.Record = null;
+    var short_line: ?trace.Record = null;
+    for (lines.items.items[1..]) |text| {
+        const r = try trace.parse(text);
+        if (r.prompt == long.len) long_line = r else short_line = r;
+    }
+    const l = long_line orelse return error.NoLongLine;
+    const sh = short_line orelse return error.NoShortLine;
+    try std.testing.expectEqual(@as(u32, 3), l.kept); // (its two shared cuts and its history's end)
+    try std.testing.expectEqual(@as(u32, 1), sh.kept); // (its history's end)
+    try std.testing.expectEqual(@as(u64, 4), store.counts.kept); // (the store's count is their sum)
+    // (a shared cut is no conversation's own state)
+    try std.testing.expectEqual(@as(u32, 1), l.chat_entries);
+    try std.testing.expectEqual(@as(u32, 1), sh.chat_entries);
+    try std.testing.expect(l.chat != sh.chat);
+}
+
+test "overlapping sliced fills: each line's kept is its own pass's keeps, not the store's count while it filled" {
+    try overlappingFills(false);
+}
+
+test "overlapping stepped fills: each line's kept is its own pass's keeps, not the store's count while it filled" {
+    try overlappingFills(true);
+}
