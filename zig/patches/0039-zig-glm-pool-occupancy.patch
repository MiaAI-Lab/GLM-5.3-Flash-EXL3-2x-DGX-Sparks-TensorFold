diff --git a/zig/src/core/lanes/snap_timing.zig b/zig/src/core/lanes/snap_timing.zig
new file mode 100644
index 0000000000000000000000000000000000000000..437d233d47bd25fa51f5591fbdc55c639d7a0074
--- /dev/null
+++ b/zig/src/core/lanes/snap_timing.zig
@@ -0,0 +1,54 @@
+//! A backend's kept-state copy timings for /health: per operation and size class, the copies, bytes and time by phase.
+const std = @import("std");
+
+/// The operations: a state taken from a stream, put back into one, carried between ranks, and a state buffer freed.
+pub const Op = enum(u8) { take, restore, carry, free };
+pub const ops = @typeInfo(Op).@"enum".field_names.len;
+/// Size classes by the bytes a copy moved: under 64 MiB, then each doubling up to 4 GiB and over.
+pub const classes = 8;
+pub const class_floor_mib = [classes]u32{ 0, 64, 128, 256, 512, 1024, 2048, 4096 };
+
+/// The class of a copy of `bytes`.
+pub fn classOf(bytes: u64) usize {
+    const m = bytes >> 20;
+    var c: usize = classes - 1;
+    while (c > 0 and m < class_floor_mib[c]) c -= 1;
+    return c;
+}
+
+/// Totals over `count` copies (ns); `max_ns` is the slowest. A carry is timed to its enqueue, a free by `free_ns`.
+pub const Cell = struct {
+    count: u64 = 0,
+    bytes: u64 = 0,
+    alloc_ns: u64 = 0,
+    copy_ns: u64 = 0,
+    sync_ns: u64 = 0,
+    free_ns: u64 = 0,
+    max_ns: u64 = 0,
+};
+
+pub const Snapshot = struct {
+    cells: [ops][classes]Cell = @splat(@splat(.{})),
+
+    pub fn cell(s: *const Snapshot, op: Op, class: usize) Cell {
+        return s.cells[@backingInt(op)][class];
+    }
+};
+
+test "a copy's class is the doubling its bytes fall in" {
+    try std.testing.expectEqual(@as(usize, 0), classOf(0));
+    try std.testing.expectEqual(@as(usize, 0), classOf((64 << 20) - 1));
+    try std.testing.expectEqual(@as(usize, 1), classOf(64 << 20));
+    try std.testing.expectEqual(@as(usize, 1), classOf((128 << 20) - 1));
+    try std.testing.expectEqual(@as(usize, 2), classOf(128 << 20));
+    try std.testing.expectEqual(@as(usize, 5), classOf(1 << 30));
+    try std.testing.expectEqual(@as(usize, 6), classOf(3 << 30));
+    try std.testing.expectEqual(@as(usize, 7), classOf(4 << 30));
+    try std.testing.expectEqual(@as(usize, 7), classOf(1 << 50));
+}
+
+test "the snapshot starts empty" {
+    const s: Snapshot = .{};
+    try std.testing.expectEqual(@as(u64, 0), s.cell(.carry, 3).count);
+    try std.testing.expectEqual(@as(usize, 4), ops);
+}
