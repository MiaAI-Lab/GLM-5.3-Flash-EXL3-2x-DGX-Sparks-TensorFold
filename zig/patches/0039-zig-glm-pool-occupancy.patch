+    };
+    const line = startLine(&buf, k);
+    try testing.expectEqualStrings("keep in pool: off; pool 3133440 rows in parts of 1566720; largest keepable state 336000 tokens (budget 2240 MiB); est. largest warm resume by a local copy 783296 rows, by a carry 1048576 rows; state 103.0 MiB fixed + 6204 B a token; entry cap 16 of 32 configured (three quarters of the budget binds), no bytes cap, 1 a chat; fixed states of 16 entries need 2.15 GiB at the ceiling; eviction: oldest superseded state first, then least recently used; display cut: latent plane 0 row 700 (pool row 700 on this rank), 256 MiB of DRM display from there", line);
+    k.part_rows = null;
+    k.pool_rows = 2_101_248;
+    k.warm = warmLimits(2_101_248, null, 64, 1_048_576);
