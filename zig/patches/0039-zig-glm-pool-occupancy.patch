+    try testing.expectEqual(@as(u64, 15), s.cell(.free, 1).free_ns);
+    try testing.expectEqual(@as(u64, 0), s.cell(.free, 1).alloc_ns);
+    try testing.expectEqual(@as(u64, 13), s.cell(.free, 1).max_ns);
+}
+
+test "the probe line gives min, median and max of the tries, in order whatever order they came in" {
+    var buf: [512]u8 = undefined;
+    var p: Probe = .{ .bytes = 107_986_944, .n = 5 };
+    p.alloc[0..5].* = .{ 3_000_000, 1_000_000, 2_000_000, 9_000_000, 2_500_000 };
+    p.free[0..5].* = .{ 400_000, 300_000, 500_000, 350_000, 450_000 };
