@@ -0,0 +1,347 @@
+//! What the start-up logs about the KV pool and the kept-state budget: its sizing, the drift after it, the start line.
+const std = @import("std");
+
+const gib: f64 = 1 << 30;
+const mib: u64 = 1 << 20;
+/// The grid kept states stand on (cuda_lanes' CacheRules.grid).
+const grid: u64 = 64;
+
+fn gb(bytes: u64) f64 {
+    return @as(f64, @floatFromInt(bytes)) / gib;
+}
+
+fn mb(bytes: u64) f64 {
+    return @as(f64, @floatFromInt(bytes)) / @as(f64, mib);
+}
+
+/// Logs a line unless it is empty: the formats below give "" when their buffer is too small, never a torn line.
+pub fn emit(text: []const u8) void {
+    if (text.len > 0) std.log.info("{s}", .{text});
+}
+
+/// What `Engine.init` read when it sized the pool, and what the sizing took.
+pub const Sizing = struct {
+    /// free memory the room was read from (counting the parked pages), the reserve, and the parked pages in it
+    available: u64 = 0,
+    reserve: u64 = 0,
+    parked: u64 = 0,
+    /// the room above the reserve, the cap on it (KV_POOL_GIB or TF_GLM_CACHE_GIB) and what the pool was allowed
+    room: u64 = 0,
+    cap: u64 = 0,
+    spare: u64 = 0,
+    /// the pool's rows, the bytes its layout takes beyond the provisional caches, the display bytes credited to it
+    rows: u64 = 0,
+    pool_bytes: u64 = 0,
+    display_bytes: u64 = 0,
+    /// MemAvailable counts (a unified GPU); false: the device's free memory, which the kept-state plan does not read
+    unified: bool = false,
+    /// the room sized the pool; false for one stream or TF_GLM_POOL_ROWS
+    sized: bool = false,
+};
+
+/// The memory the pool took out of what `s.available` counted: its bytes less the display ones, which are not ordinary.
+pub fn poolNet(s: Sizing) u64 {
+    return s.pool_bytes -| s.display_bytes;
+}
+
+/// Memory gone since the pool was sized, less the pool's own bytes (negative when pages came back).
+pub fn drift(s: Sizing, available_now: u64) i64 {
+    const gone: i128 = @as(i128, s.available) - @as(i128, available_now);
+    return @intCast(std.math.clamp(gone - @as(i128, poolNet(s)), std.math.minInt(i64), std.math.maxInt(i64)));
+}
+
+/// The line `Engine.init` logs where the room sizes the pool, on every rank (each machine has its own room).
+pub fn sizingLine(buf: []u8, rank: u32, s: Sizing) []const u8 {
+    var w = std.Io.Writer.fixed(buf);
+    sizingInto(&w, rank, s) catch return "";
+    return w.buffered();
+}
+
+fn sizingInto(w: *std.Io.Writer, rank: u32, s: Sizing) !void {
+    const kind = if (s.unified) "MemAvailable" else "free device memory";
+    try w.print("rank {d}: KV pool sizing: {s} {d:.2} GiB ({d:.2} GiB of it parked pages) less the {d:.2} GiB reserve leaves a room of {d:.2} GiB", .{ rank, kind, gb(s.available), gb(s.parked), gb(s.reserve), gb(s.room) });
+    if (!s.sized) return w.writeAll("; the room did not size the pool (one stream, or TF_GLM_POOL_ROWS gave its rows)");
+    try w.print("; the cap {d:.2} GiB lets the pool spare {d:.2} GiB; its {d} rows take {d:.2} GiB ({d:.2} GiB of display credited)", .{ gb(s.cap), gb(s.spare), s.rows, gb(s.pool_bytes), gb(s.display_bytes) });
+}
+
+/// The line `cacheFor` logs when it reads the memory again: the post-pool drift the carve's pad has to cover.
+pub fn driftLine(buf: []u8, rank: u32, s: Sizing, available_now: u64) []const u8 {
+    if (!s.unified) return std.fmt.bufPrint(buf, "rank {d}: post-pool drift: not measured (the pool was sized from device memory, not MemAvailable)", .{rank}) catch "";
+    const d = drift(s, available_now);
+    const sign: []const u8 = if (d < 0) "-" else "";
+    return std.fmt.bufPrint(buf, "rank {d}: post-pool drift: MemAvailable {d:.2} GiB now against {d:.2} GiB when the pool was sized; the pool took {d:.2} GiB, so {s}{d:.2} GiB went elsewhere after it (graph capture, serving and mirror buffers)", .{ rank, gb(available_now), gb(s.available), gb(poolNet(s)), sign, gb(@abs(d)) }) catch "";
+}
+
+/// Where the DRM display memory starts in the latent planes (plane, row): the rows from there on are display memory.
+pub const Cut = struct { plane: u64, row: u64 };
+
+pub fn displayCut(plane_bytes: u64, ordinary: u64, row_bytes: u64) Cut {
+    return .{ .plane = ordinary / plane_bytes, .row = (ordinary % plane_bytes) / row_bytes };
+}
+
+/// The largest `at` on the grid, at most `max`, whose `bytes(ctx, at)` fits `limit` (0: none); `bytes` never shrinks.
+pub fn largestWithin(ctx: anytype, comptime bytes: fn (@TypeOf(ctx), u64) u64, limit: u64, max: u64) u64 {
+    var lo: u64 = 0;
+    var hi: u64 = max / grid;
+    while (lo < hi) {
+        const mid = lo + (hi - lo + 1) / 2;
+        if (bytes(ctx, mid * grid) <= limit) lo = mid else hi = mid - 1;
+    }
+    return lo * grid;
+}
+
+/// Est. longest prompt (rows) a kept extent could resume warm: two extents in a part (copy), one in each part (carry).
+pub const Warm = struct { copy: u64, carry: ?u64 };
+
+pub fn warmLimits(pool_rows: u64, part_rows: ?u64, window: u64, context: u64) Warm {
+    const home = part_rows orelse pool_rows;
+    const copy = (home / 2) -| window;
+    const carry = if (part_rows) |p| p -| window else null;
+    return .{ .copy = @min(context, copy) / grid * grid, .carry = if (carry) |c| @min(context, c) / grid * grid else null };
+}
+
+/// The budget that holds `entries` fixed states under the entry ceiling (three quarters of it), in integers rounded up.
+pub fn fixedBudget(entries: u32, fixed: u64) u64 {
+    const need: u128 = @as(u128, entries) * fixed;
+    return @intCast(@min((need * 4 + 2) / 3, std.math.maxInt(u64)));
+}
+
+/// What the start line says (cuda_native cacheFor fills it).
+pub const Keep = struct {
+    /// the switch's mode ("off": the pool keeps no prompt state) and the eviction the Store applies now
+    mode: []const u8 = "off",
+    eviction: []const u8 = "oldest superseded state first, then least recently used",
+    pool_rows: u64,
+    /// rows of a part (null: one pool)
+    part_rows: ?u64 = null,
+    context: u64,
+    window: u64,
+    /// the bytes of a state at `at` tokens, the fixed part and the marginal bytes a token
+    fixed: u64,
+    per_token: u64,
+    /// the Store's budget, its entry cap and what bound it, the byte cap (0: none) and the per-chat cap (0: none)
+    budget: u64,
+    largest: u64,
+    /// the entries configured (TF_GLM_CACHE_ENTRIES) and the cap the budget leaves them (`entries_capped`: it binds)
+    configured: u32,
+    entries: u32,
+    entries_capped: bool,
+    bytes_cap: u64 = 0,
+    per_chat: u32 = 0,
+    warm: Warm,
+    /// the display cut (null: no DRM span)
+    cut: ?Cut = null,
+    cut_pool_row: ?u64 = null,
+    display_bytes: u64 = 0,
+};
+
+/// The one line of §1.7: what a kept state is and what the pool and the Store can hold of it.
+pub fn startLine(buf: []u8, k: Keep) []const u8 {
+    var w = std.Io.Writer.fixed(buf);
+    startInto(&w, k) catch return "";
+    return w.buffered();
+}
+
+fn startInto(w: *std.Io.Writer, k: Keep) !void {
+    try w.print("keep in pool: {s}; pool {d} rows", .{ k.mode, k.pool_rows });
+    if (k.part_rows) |p| try w.print(" in parts of {d}", .{p});
+    try w.print("; largest keepable state {d} tokens", .{k.largest});
+    if (k.largest == 0) try w.writeAll(" (none: the budget is 0 or under one state)") else if (k.largest >= k.context) try w.print(" (the whole {d}-token context)", .{k.context}) else try w.print(" (budget {d} MiB)", .{k.budget / mib});
+    try w.print("; est. largest warm resume by a local copy {d} rows", .{k.warm.copy});
+    if (k.warm.carry) |c| try w.print(", by a carry {d} rows", .{c}) else try w.writeAll(", no carry (one part)");
+    try w.print("; state {d:.1} MiB fixed + {d} B a token", .{ mb(k.fixed), k.per_token });
+    if (k.budget == 0) {
+        try w.print("; no store (budget 0), {d} entries configured", .{k.configured});
+    } else {
+        try w.print("; entry cap {d} of {d} configured", .{ k.entries, k.configured });
+        try w.writeAll(if (k.entries_capped) " (three quarters of the budget binds)" else " (the configured count binds)");
+        if (k.bytes_cap > 0) try w.print(", bytes cap {d} MiB", .{k.bytes_cap / mib}) else try w.writeAll(", no bytes cap");
+        if (k.per_chat > 0) try w.print(", {d} a chat", .{k.per_chat}) else try w.writeAll(", no per-chat cap");
+    }
+    const held = if (k.budget == 0) k.configured else k.entries;
+    try w.print("; fixed states of {d} entries need {d:.2} GiB at the ceiling; eviction: {s}", .{ held, gb(fixedBudget(held, k.fixed)), k.eviction });
+    try w.writeAll("; ");
+    try cutInto(w, k.cut, k.cut_pool_row, k.display_bytes);
+}
+
+/// `c` null with display bytes reserved is dispram: one allocation, so no cut, but the memory is reserved all the same.
+fn cutInto(w: *std.Io.Writer, c: ?Cut, pool_row: ?u64, display_bytes: u64) !void {
+    const cut = c orelse {
+        if (display_bytes == 0) return w.writeAll("display cut: none");
+        return w.print("display cut: none (dispram: one allocation), {d} MiB of display reserved", .{display_bytes / mib});
+    };
+    try w.print("display cut: latent plane {d} row {d}", .{ cut.plane, cut.row });
+    if (pool_row) |r| try w.print(" (pool row {d} on this rank)", .{r});
+    try w.print(", {d} MiB of DRM display from there", .{display_bytes / mib});
+}
+
+/// A rank's own display cut, logged by every rank that reserves display memory (the start line shows rank 0's).
+pub fn cutLine(buf: []u8, rank: u32, c: ?Cut, pool_row: ?u64, display_bytes: u64) []const u8 {
+    var w = std.Io.Writer.fixed(buf);
+    w.print("rank {d}: ", .{rank}) catch return "";
+    cutInto(&w, c, pool_row, display_bytes) catch return "";
+    return w.buffered();
+}
+
+const testing = std.testing;
+
+fn testBytes(_: void, at: u64) u64 {
+    return 107_986_944 + 6204 * at;
+}
+
+test "the room line names every figure it sized from, and says when the room did not size the pool" {
+    var buf: [1024]u8 = undefined;
+    const g: u64 = 1 << 30;
+    var s: Sizing = .{ .available = 96 * g, .reserve = 14 * g + g / 2, .parked = g / 4, .room = 81 * g + g / 2, .cap = 4 * g, .spare = 4 * g, .rows = 3_133_440, .pool_bytes = 4 * g, .display_bytes = 0, .unified = true, .sized = true };
+    const line = sizingLine(&buf, 1, s);
+    try testing.expectEqualStrings("rank 1: KV pool sizing: MemAvailable 96.00 GiB (0.25 GiB of it parked pages) less the 14.50 GiB reserve leaves a room of 81.50 GiB; the cap 4.00 GiB lets the pool spare 4.00 GiB; its 3133440 rows take 4.00 GiB (0.00 GiB of display credited)", line);
+    s.sized = false;
+    const lone = sizingLine(&buf, 0, s);
+    try testing.expect(std.mem.endsWith(u8, lone, "the room did not size the pool (one stream, or TF_GLM_POOL_ROWS gave its rows)"));
+    try testing.expect(std.mem.startsWith(u8, lone, "rank 0: KV pool sizing: MemAvailable 96.00 GiB"));
+    s.unified = false;
+    try testing.expect(std.mem.indexOf(u8, sizingLine(&buf, 0, s), "free device memory 96.00 GiB") != null);
+}
+
+test "the drift is what left the machine after the pool was sized, less the pool's own bytes" {
+    const g: u64 = 1 << 30;
+    const s: Sizing = .{ .available = 90 * g, .pool_bytes = 6 * g, .display_bytes = g, .unified = true, .sized = true };
+    try testing.expectEqual(@as(u64, 5 * g), poolNet(s));
+    // 90 GiB at sizing, 82 GiB now: 8 GiB gone, 5 of them the pool's ordinary bytes
+    try testing.expectEqual(@as(i64, @intCast(3 * g)), drift(s, 82 * g));
+    try testing.expectEqual(@as(i64, 0), drift(s, 85 * g));
+    // pages that came back make it negative, and the line says so
+    try testing.expectEqual(-@as(i64, @intCast(g)), drift(s, 86 * g));
+    var buf: [1024]u8 = undefined;
+    const line = driftLine(&buf, 0, s, 86 * g);
+    try testing.expectEqualStrings("rank 0: post-pool drift: MemAvailable 86.00 GiB now against 90.00 GiB when the pool was sized; the pool took 5.00 GiB, so -1.00 GiB went elsewhere after it (graph capture, serving and mirror buffers)", line);
+    var disc = s;
+    disc.unified = false;
+    try testing.expect(std.mem.indexOf(u8, driftLine(&buf, 0, disc, 0), "not measured") != null);
+    // a pool with no sizing (the room read nothing) never underflows
+    try testing.expectEqual(@as(i64, 0), drift(.{}, 0));
+}
+
+test "the display cut is the first row past the ordinary bytes, across the planes the span holds" {
+    const row: u64 = 528;
+    const plane: u64 = 1000 * row;
+    // 300 rows of display in the last bytes of plane 0: the ordinary part ends at row 700
+    try testing.expectEqual(Cut{ .plane = 0, .row = 700 }, displayCut(plane, plane - 300 * row, row));
+    // 1500 rows of display need two planes: the span is 2 planes, ordinary bytes 500 rows in
+    try testing.expectEqual(Cut{ .plane = 0, .row = 500 }, displayCut(plane, 2 * plane - 1500 * row, row));
+    // the ordinary bytes end exactly on a plane edge
+    try testing.expectEqual(Cut{ .plane = 1, .row = 0 }, displayCut(plane, plane, row));
+}
+
+test "a rank's own cut line" {
+    var buf: [256]u8 = undefined;
+    try testing.expectEqualStrings("rank 1: display cut: latent plane 0 row 700 (pool row 1567420 on this rank), 256 MiB of DRM display from there", cutLine(&buf, 1, .{ .plane = 0, .row = 700 }, 1_567_420, 256 * mib));
+    try testing.expectEqualStrings("rank 0: display cut: latent plane 2 row 5, 64 MiB of DRM display from there", cutLine(&buf, 0, .{ .plane = 2, .row = 5 }, null, 64 * mib));
+    // dispram's span is one allocation: no cut to give, and the reservation is still said
+    try testing.expectEqualStrings("rank 1: display cut: none (dispram: one allocation), 256 MiB of display reserved", cutLine(&buf, 1, null, null, 256 * mib));
+    try testing.expectEqualStrings("rank 1: display cut: none", cutLine(&buf, 1, null, null, 0));
+    var tiny: [12]u8 = undefined;
+    try testing.expectEqual(@as(usize, 0), cutLine(&tiny, 1, null, null, 256 * mib).len);
+}
+
+test "the largest keepable state is the last grid point whose bytes fit the budget" {
+    const budget: u64 = 2240 * mib;
+    const at = largestWithin({}, testBytes, budget, 1 << 20);
+    try testing.expectEqual(@as(u64, 361_152), at);
+    try testing.expect(testBytes({}, at) <= budget);
+    try testing.expect(testBytes({}, at + 64) > budget);
+    // a budget that holds a state exactly keeps it, and a byte less does not
+    try testing.expectEqual(@as(u64, 640), largestWithin({}, testBytes, testBytes({}, 640), 1 << 20));
+    try testing.expectEqual(@as(u64, 576), largestWithin({}, testBytes, testBytes({}, 640) - 1, 1 << 20));
+    // a budget under the fixed state keeps nothing; a roomy one reaches the context
+    try testing.expectEqual(@as(u64, 0), largestWithin({}, testBytes, 50 * mib, 1 << 20));
+    try testing.expectEqual(@as(u64, 1 << 20), largestWithin({}, testBytes, 100 << 30, 1 << 20));
+    // a context that is not on the grid stops at the last grid point
+    try testing.expectEqual(@as(u64, 1000 - 1000 % 64), largestWithin({}, testBytes, 100 << 30, 1000));
+}
+
+test "warm resume estimates: half a part or pool by copy, a whole part by carry, the window off" {
+    const w = warmLimits(3_133_440, 1_566_720, 64, 1 << 20);
+    try testing.expectEqual(@as(u64, (1_566_720 / 2 - 64) / 64 * 64), w.copy);
+    // (the context, 1 Mi rows, is the shorter of the two)
+    try testing.expectEqual(@as(u64, 1 << 20), w.carry.?);
+    try testing.expectEqual(@as(u64, (1_566_720 - 64) / 64 * 64), warmLimits(3_133_440, 1_566_720, 64, 1 << 21).carry.?);
+    const lone = warmLimits(2_101_248, null, 64, 1 << 21);
+    try testing.expectEqual(@as(u64, (2_101_248 / 2 - 64) / 64 * 64), lone.copy);
+    try testing.expect(lone.carry == null);
+    // the context caps both
+    try testing.expectEqual(@as(u64, 524_224), warmLimits(3_133_440, 1_566_720, 64, 524_224).carry.?);
+    try testing.expectEqual(@as(u64, 0), warmLimits(2048, null, 4096, 1 << 20).copy);
+}
+
+test "the fixed-state budget inverts the entry ceiling in integers, rounded up" {
+    // 8 entries of 103 MiB under a three-quarters ceiling: about 1.07 GiB
+    const f = fixedBudget(8, 107_986_944);
+    try testing.expectEqual(@as(u64, 1_151_860_736), f);
+    try testing.expectEqual(@as(u64, 0), fixedBudget(0, 107_986_944));
+    // a figure that is not a multiple of 3 rounds up to the byte: 4/3, 8/3, 4, 16/3 of a byte
+    try testing.expectEqual(@as(u64, 2), fixedBudget(1, 1));
+    try testing.expectEqual(@as(u64, 3), fixedBudget(2, 1));
+    try testing.expectEqual(@as(u64, 4), fixedBudget(3, 1));
+    try testing.expectEqual(@as(u64, 6), fixedBudget(4, 1));
+    // a size past 2^53 keeps its last byte (an f64 does not hold it): 16 states of 2^49 + 1 bytes need (2^55 + 66) / 3
+    try testing.expectEqual(@as(u64, ((1 << 55) + 66) / 3), fixedBudget(16, (1 << 49) + 1));
+    // and the figure saturates instead of wrapping
+    try testing.expectEqual(@as(u64, std.math.maxInt(u64)), fixedBudget(std.math.maxInt(u32), std.math.maxInt(u64)));
+}
+
+test "the start line, sharded and unsharded, with and without a cut" {
+    var buf: [2048]u8 = undefined;
+    var k: Keep = .{
+        .pool_rows = 3_133_440,
+        .part_rows = 1_566_720,
+        .context = 1_048_576,
+        .window = 64,
+        .fixed = 107_986_944,
+        .per_token = 6204,
