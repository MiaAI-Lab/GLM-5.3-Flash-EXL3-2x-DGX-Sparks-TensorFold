+/// Copy timings under `snap_timing`: a row per operation and size class; `*_ms_total` sum its copies, `max_ms` one's.
+pub fn putSnapTiming(a: Allocator, o: *json.Object, t: api.SnapTiming.Snapshot) Allocator.Error!void {
+    const st = try json.newObject(a);
+    inline for (@typeInfo(api.SnapTiming.Op).@"enum".field_names, 0..) |name, op| {
+        var rows: std.ArrayList(Value) = .empty;
+        for (t.cells[op], api.SnapTiming.class_floor_mib) |c, floor| {
+            if (c.count == 0) continue;
+            const row = try json.newObject(a);
+            try row.put(a, "from_mib", try json.intValue(a, floor));
+            try row.put(a, "count", try json.intValue(a, c.count));
+            try row.put(a, "bytes", try json.intValue(a, c.bytes));
+            switch (@as(api.SnapTiming.Op, @fromBackingInt(@intCast(op)))) {
+                .take => {
+                    try putMs(a, row, "alloc_ms_total", c.alloc_ns);
+                    try putMs(a, row, "copy_ms_total", c.copy_ns);
+                    try putMs(a, row, "sync_ms_total", c.sync_ns);
+                },
+                .restore => {
+                    try putMs(a, row, "copy_ms_total", c.copy_ns);
+                    try putMs(a, row, "sync_ms_total", c.sync_ns);
+                },
+                .carry => try putMs(a, row, "enqueue_ms_total", c.copy_ns), // (the calls' enqueue: the transfer is the restore's sync)
+                .free => try putMs(a, row, "free_ms_total", c.free_ns), // (cuMemFree)
+            }
+            try putMs(a, row, "max_ms", c.max_ns);
+            try rows.append(a, .{ .object = row });
+        }
+        try st.put(a, name, .{ .array = try rows.toOwnedSlice(a) });
+    }
+    try o.put(a, "snap_timing", .{ .object = st });
+}
+
+/// `ns` as milliseconds to the microsecond.
+fn putMs(a: Allocator, o: *json.Object, key: []const u8, ns: u64) Allocator.Error!void {
+    try o.put(a, key, .{ .float = @round(@as(f64, @floatFromInt(ns)) / 1e3) / 1e3 });
+}
