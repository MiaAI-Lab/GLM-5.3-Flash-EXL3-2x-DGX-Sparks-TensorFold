diff --git a/zig/src/families/glm_cuda/cuda_spill_rates.zig b/zig/src/families/glm_cuda/cuda_spill_rates.zig
new file mode 100644
index 0000000000000000000000000000000000000000..969fec3e7bf82c680a160dced75fc1ac8fe8fe26
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_spill_rates.zig
@@ -0,0 +1,230 @@
+//! Spill tier rates for the once-a-minute and per-point lines: staging by mode, restores, write drains, disk written.
+const std = @import("std");
+
+const mib: f64 = 1 << 20;
+const gib: f64 = 1 << 30;
+const hour_ns: f64 = 3600e9;
+
+fn secs(ns: u64) f64 {
+    return @as(f64, @floatFromInt(ns)) / 1e9;
+}
+
+fn perSec(bytes: u64, ns: u64) f64 {
+    return if (ns == 0) 0 else @as(f64, @floatFromInt(bytes)) / (@as(f64, @floatFromInt(ns)) / 1e9);
+}
+
+/// Whether a stream was in the rounds when the tier staged (not one still filling): the pump between rounds, or idle.
+pub const Mode = enum(u8) { decoding, idle };
+
+/// One mode's staging in a window: blocks and bytes staged, the calls that staged any, and the time inside them.
+pub const Stage = struct { bytes: u64 = 0, blocks: u64 = 0, calls: u64 = 0, busy_ns: u64 = 0 };
+
+/// What a window of staging, restores and drained writes did.
+pub const Window = struct {
+    ns: u64 = 0,
+    stage: [2]Stage = @splat(.{}),
+    restores: u64 = 0,
+    restore_bytes: u64 = 0,
+    restore_ns: u64 = 0,
+    validate_ns: u64 = 0,
+    validate_max_ns: u64 = 0,
+    drained: u64 = 0,
+    drained_bytes: u64 = 0,
+    drain_ns: u64 = 0,
+    drain_max_ns: u64 = 0,
+    /// the bytes this rank's store wrote to disk in the window, and the other rank's (null: not known)
+    written: u64 = 0,
+    peer_written: ?u64 = null,
+
+    fn active(w: Window) bool {
+        return w.stage[0].blocks + w.stage[1].blocks + w.restores + w.drained + w.written > 0 or (w.peer_written orelse 0) > 0;
+    }
+};
+
+pub const Rates = struct {
+    every_ns: u64 = 60 * std.time.ns_per_s,
+    cur: Window = .{},
+    start_ns: u64 = 0,
+    started: bool = false,
+    written0: u64 = 0,
+    peer0: ?u64 = null,
+    boot_ns: u64 = 0,
+    boot_written: u64 = 0,
+    boot_started: bool = false,
+
+    pub fn staged(r: *Rates, mode: Mode, bytes: u64, blocks: u64, busy_ns: u64) void {
+        const s = &r.cur.stage[@backingInt(mode)];
+        s.bytes += bytes;
+        s.blocks += blocks;
+        s.calls += 1;
+        s.busy_ns += busy_ns;
+    }
+
+    /// A restore became ready (or its verdict came): `bytes` it read and copied, begin to verdict, the .validate ask.
+    pub fn restored(r: *Rates, bytes: u64, total_ns: u64, validate_ns: u64) void {
+        r.cur.restores += 1;
+        r.cur.restore_bytes += bytes;
+        r.cur.restore_ns += total_ns;
+        r.cur.validate_ns += validate_ns;
+        r.cur.validate_max_ns = @max(r.cur.validate_max_ns, validate_ns);
+    }
+
+    /// A write left the queue published.
+    pub fn drain(r: *Rates, bytes: u64, ns: u64) void {
+        r.cur.drained += 1;
+        r.cur.drained_bytes += bytes;
+        r.cur.drain_ns += ns;
+        r.cur.drain_max_ns = @max(r.cur.drain_max_ns, ns);
+    }
+
+    /// The ended window once `every_ns` passed (the first look starts the clock); `written`, `peer`: bytes so far.
+    pub fn tick(r: *Rates, now_ns: u64, written: u64, peer: ?u64) ?Window {
+        if (r.every_ns == 0) return null;
+        if (!r.started) {
+            r.started = true;
+            r.start_ns = now_ns;
+            r.written0 = written;
+            r.peer0 = peer;
+            if (!r.boot_started) {
+                r.boot_started = true;
+                r.boot_ns = now_ns;
+                r.boot_written = written;
+            }
+            return null;
+        }
+        if (now_ns -| r.start_ns < r.every_ns) return null;
+        var w = r.cur;
+        w.ns = now_ns - r.start_ns;
+        w.written = written -| r.written0;
+        w.peer_written = if (peer) |p| (if (r.peer0) |p0| p -| p0 else null) else null;
+        r.cur = .{};
+        r.start_ns = now_ns;
+        r.written0 = written;
+        r.peer0 = peer orelse r.peer0;
+        return w;
+    }
+
+    /// The disk written an hour since the first window, this rank's.
+    pub fn sinceBoot(r: *const Rates, now_ns: u64, written: u64) f64 {
+        const ns = now_ns -| r.boot_ns;
+        return if (ns == 0) 0 else @as(f64, @floatFromInt(written -| r.boot_written)) / gib / (@as(f64, @floatFromInt(ns)) / hour_ns);
+    }
+};
+
+fn perHour(bytes: u64, ns: u64) f64 {
+    return if (ns == 0) 0 else @as(f64, @floatFromInt(bytes)) / gib / (@as(f64, @floatFromInt(ns)) / hour_ns);
+}
+
+/// The window's line; empty when nothing moved.
+pub fn windowLine(buf: []u8, rank: u32, w: Window, since_boot_gib_hour: f64) []const u8 {
+    if (!w.active()) return "";
+    var out = std.Io.Writer.fixed(buf);
+    windowInto(&out, rank, w, since_boot_gib_hour) catch return "";
+    return out.buffered();
+}
+
+fn windowInto(out: *std.Io.Writer, rank: u32, w: Window, since_boot: f64) !void {
+    try out.print("rank {d}: spill rates over {d:.0} s (this rank's staging, restores and drains)", .{ rank, secs(w.ns) });
+    for (w.stage, [2][]const u8{ "decoding", "idle" }) |s, name| {
+        if (s.blocks == 0) continue;
+        try out.print("; staged while {s} {d:.1} MiB in {d} blocks ({d:.1} MiB/s of the {d:.2} s serviced, {d:.2} MiB/s of the window)", .{ name, @as(f64, @floatFromInt(s.bytes)) / mib, s.blocks, perSec(s.bytes, s.busy_ns) / mib, secs(s.busy_ns), perSec(s.bytes, w.ns) / mib });
+    }
+    if (w.restores > 0) {
+        try out.print("; {d} restores read {d:.1} MiB ({d:.1} MiB/s begin to verdict), the .validate gather {d:.1} ms on average and {d:.1} ms at most", .{ w.restores, @as(f64, @floatFromInt(w.restore_bytes)) / mib, perSec(w.restore_bytes, w.restore_ns) / mib, secs(w.validate_ns) * 1e3 / @as(f64, @floatFromInt(w.restores)), secs(w.validate_max_ns) * 1e3 });
+    }
+    if (w.drained > 0) {
+        try out.print("; {d} writes drained {d:.1} MiB in {d:.1} s on average and {d:.1} s at most", .{ w.drained, @as(f64, @floatFromInt(w.drained_bytes)) / mib, secs(w.drain_ns) / @as(f64, @floatFromInt(w.drained)), secs(w.drain_max_ns) });
+    }
+    try out.print("; disk written {d:.2} GiB ({d:.2} GiB/hour, {d:.2} GiB/hour since the first window)", .{ @as(f64, @floatFromInt(w.written)) / gib, perHour(w.written, w.ns), since_boot });
+    if (w.peer_written) |p| try out.print("; the other rank wrote {d:.2} GiB ({d:.2} GiB/hour)", .{ @as(f64, @floatFromInt(p)) / gib, perHour(p, w.ns) });
+}
+
+/// One point's write, when it left the queue: queued to published, with the bytes its blocks hold.
+pub fn drainLine(buf: []u8, rank: u32, at: u32, bytes: u64, ns: u64, outcome: []const u8) []const u8 {
+    return std.fmt.bufPrint(buf, "rank {d}: spill write of {d} tokens ({d:.1} MiB): {s} after {d:.2} s in the queue", .{ rank, at, @as(f64, @floatFromInt(bytes)) / mib, outcome, secs(ns) }) catch "";
+}
+
+/// One restore, begin to verdict: what it read, how fast, and what its .validate gather cost.
+pub fn restoreLine(buf: []u8, rank: u32, at: u32, bytes: u64, total_ns: u64, validate_ns: u64, verdict: []const u8) []const u8 {
+    return std.fmt.bufPrint(buf, "rank {d}: spill restore of {d} tokens: {s}; read {d:.1} MiB in {d:.2} s from begin to the .validate verdict ({d:.1} MiB/s), the .validate gather itself {d:.2} ms", .{ rank, at, verdict, @as(f64, @floatFromInt(bytes)) / mib, secs(total_ns), perSec(bytes, total_ns) / mib, secs(validate_ns) * 1e3 }) catch "";
+}
+
+const testing = std.testing;
+
+test "the first look starts the clock; a window ends once the interval passed and starts the next" {
+    var r: Rates = .{ .every_ns = 60 * std.time.ns_per_s };
+    try testing.expect(r.tick(1000, 5 << 30, 2 << 30) == null);
+    r.staged(.decoding, 8 << 20, 2, 10_000_000);
+    r.staged(.decoding, 8 << 20, 2, 10_000_000);
+    r.staged(.idle, 1 << 30, 256, 500_000_000);
+    r.restored(1 << 30, 8 * std.time.ns_per_s, 12_000_000);
+    r.restored(1 << 30, 4 * std.time.ns_per_s, 4_000_000);
+    r.drain(100 << 20, 40 * std.time.ns_per_s);
+    r.drain(100 << 20, 20 * std.time.ns_per_s);
+    try testing.expect(r.tick(1000 + 59 * std.time.ns_per_s, 5 << 30, null) == null);
+    const w = r.tick(1000 + 60 * std.time.ns_per_s, (5 << 30) + (3 << 30), (2 << 30) + (1 << 30)).?;
+    try testing.expectEqual(@as(u64, 60 * std.time.ns_per_s), w.ns);
+    try testing.expectEqual(@as(u64, 4), w.stage[0].blocks);
+    try testing.expectEqual(@as(u64, 2), w.stage[0].calls);
+    try testing.expectEqual(@as(u64, 20_000_000), w.stage[0].busy_ns);
+    try testing.expectEqual(@as(u64, 1 << 30), w.stage[1].bytes);
+    try testing.expectEqual(@as(u64, 2), w.restores);
+    try testing.expectEqual(@as(u64, 12_000_000), w.validate_max_ns);
+    try testing.expectEqual(@as(u64, 2), w.drained);
+    try testing.expectEqual(@as(u64, 40 * std.time.ns_per_s), w.drain_max_ns);
+    try testing.expectEqual(@as(u64, 3 << 30), w.written);
+    try testing.expectEqual(@as(u64, 1 << 30), w.peer_written.?);
+    // the counters start over, and so does the clock
+    try testing.expect(r.tick(1000 + 61 * std.time.ns_per_s, 8 << 30, null) == null);
+    const next = r.tick(1000 + 120 * std.time.ns_per_s, 8 << 30, null).?;
+    try testing.expectEqual(@as(u64, 0), next.restores);
+    try testing.expectEqual(@as(u64, 0), next.written);
+    try testing.expectEqual(@as(?u64, null), next.peer_written);
+    // the other rank's total, first known late, is a base and not a window's worth
+    var late: Rates = .{ .every_ns = 10 };
+    try testing.expect(late.tick(100, 0, null) == null);
+    try testing.expectEqual(@as(?u64, null), late.tick(200, 0, 5 << 30).?.peer_written);
+    try testing.expectEqual(@as(?u64, 1 << 30), late.tick(300, 0, 6 << 30).?.peer_written);
+}
+
+test "an off interval never fires, and a quiet window gives no line" {
+    var off: Rates = .{ .every_ns = 0 };
+    try testing.expect(off.tick(0, 0, null) == null);
+    try testing.expect(off.tick(1 << 50, 1 << 40, null) == null);
+    var buf: [1024]u8 = undefined;
+    try testing.expectEqual(@as(usize, 0), windowLine(&buf, 0, .{ .ns = 60 * std.time.ns_per_s }, 0).len);
+}
+
+test "the window's line gives each mode's rates, the restores, the drains and the disk written an hour" {
+    var buf: [2048]u8 = undefined;
+    const w: Window = .{
+        .ns = 60 * std.time.ns_per_s,
+        .stage = .{ .{ .bytes = 16 << 20, .blocks = 4, .calls = 2, .busy_ns = 20_000_000 }, .{ .bytes = 1 << 30, .blocks = 256, .calls = 4, .busy_ns = 500_000_000 } },
+        .restores = 2,
+        .restore_bytes = 2 << 30,
+        .restore_ns = 12 * std.time.ns_per_s,
+        .validate_ns = 16_000_000,
+        .validate_max_ns = 12_000_000,
+        .drained = 2,
+        .drained_bytes = 200 << 20,
+        .drain_ns = 60 * std.time.ns_per_s,
+        .drain_max_ns = 40 * std.time.ns_per_s,
+        .written = 3 << 30,
+        .peer_written = 1 << 30,
+    };
+    try testing.expectEqualStrings("rank 0: spill rates over 60 s (this rank's staging, restores and drains); staged while decoding 16.0 MiB in 4 blocks (800.0 MiB/s of the 0.02 s serviced, 0.27 MiB/s of the window); staged while idle 1024.0 MiB in 256 blocks (2048.0 MiB/s of the 0.50 s serviced, 17.07 MiB/s of the window); 2 restores read 2048.0 MiB (170.7 MiB/s begin to verdict), the .validate gather 8.0 ms on average and 12.0 ms at most; 2 writes drained 200.0 MiB in 30.0 s on average and 40.0 s at most; disk written 3.00 GiB (180.00 GiB/hour, 12.50 GiB/hour since the first window); the other rank wrote 1.00 GiB (60.00 GiB/hour)", windowLine(&buf, 0, w, 12.5));
+}
+
+test "the since-first-window rate is the disk written over the time since, per hour" {
+    var r: Rates = .{};
+    _ = r.tick(10 * std.time.ns_per_s, 1 << 30, null);
+    // 2 GiB written in the 1800 s since: 4 GiB an hour
+    try testing.expectApproxEqAbs(@as(f64, 4), r.sinceBoot(10 * std.time.ns_per_s + 1800 * std.time.ns_per_s, 3 << 30), 1e-9);
+    try testing.expectEqual(@as(f64, 0), r.sinceBoot(10 * std.time.ns_per_s, 3 << 30));
+}
+
+test "a drained write's and a restore's lines" {
+    var buf: [512]u8 = undefined;
+    try testing.expectEqualStrings("rank 1: spill write of 262144 tokens (1700.0 MiB): published after 41.25 s in the queue", drainLine(&buf, 1, 262_144, 1700 << 20, 41_250_000_000, "published"));
+    try testing.expectEqualStrings("rank 0: spill restore of 524224 tokens: ready; read 3000.0 MiB in 8.20 s from begin to the .validate verdict (365.9 MiB/s), the .validate gather itself 12.30 ms", restoreLine(&buf, 0, 524_224, 3000 << 20, 8_200_000_000, 12_300_000, "ready"));
+}
