+    try testing.expect(std.mem.indexOf(u8, lone, "entry cap 8 of 8 configured (the configured count binds), bytes cap 4096 MiB, no per-chat cap") != null);
+    try testing.expect(std.mem.endsWith(u8, lone, "; display cut: none"));
+    // a budget of 0 has no store: no cap to bind, and the fixed states of the configured entries are what it would need
+    k.budget = 0;
