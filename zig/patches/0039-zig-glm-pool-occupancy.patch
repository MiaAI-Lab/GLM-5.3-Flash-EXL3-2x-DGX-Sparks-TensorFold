+        const plane: u64 = (if (e.shard) |sh| sh.latentRows() else e.caches.rows) * G.latent_row;
+        const cut = pool_log.displayCut(plane, v.ordinary, G.latent_row);
+        const row: ?u64 = if (e.shard) |sh| (if (cut.row < sh.part) sh.rank * sh.part + cut.row else null) else cut.row;
