+            var b = cuda.DeviceBuffer.alloc(e.stream.d, p.bytes) catch break;
+            const t1 = snap_timing.nowNs();
+            b.free();
+            p.alloc[p.n] = t1 - t0;
+            p.free[p.n] = snap_timing.nowNs() - t1;
