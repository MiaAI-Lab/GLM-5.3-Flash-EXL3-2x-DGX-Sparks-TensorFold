--- /dev/null
+++ b/zig/src/core/lanes/request_trace.zig
@@ -0,0 +1,323 @@
+//! One line a request when it ends, for a replay of how a pool and a prompt cache served it: lengths, never content.
+const std = @import("std");
+
+/// What a line starts with after any log prefix.
+pub const marker = "request trace v1 ";
+const header_word = "header";
+
+pub const End = enum { stop, length, cancelled, failed };
+
+/// A request's trace. Times are milliseconds on the host's own clock, `t_ms` since the host started.
+pub const Record = struct {
+    /// when the request arrived
+    t_ms: u64,
+    prompt: u32,
+    /// prompt tokens a kept state served (memory or disk)
+    cached: u32,
+    max_tokens: u32,
+    /// a hash of the conversation's id (0: none), the same for every request of one conversation while the host runs
+    chat: u64,
+    /// arrival to the first reply token delivered (null: none was)
+    first_ms: ?u32,
+    /// arrival to the end
+    done_ms: u32,
+    /// kept states the request's pass added
+    kept: u32,
+    /// the conversation's own kept states after the pass
+    chat_entries: u32,
+    /// reply tokens delivered
+    gen: u32,
+    end: End,
+};
+
+/// TF_GLM_TRACE: on when unset, blank, `1` or `on`; off for `0` or `off`; null for anything else.
+pub fn enabled(raw: ?[]const u8) ?bool {
+    const t = std.mem.trim(u8, raw orelse return true, " \t\r\n");
+    if (t.len == 0 or std.mem.eql(u8, t, "1") or std.mem.eql(u8, t, "on")) return true;
+    if (std.mem.eql(u8, t, "0") or std.mem.eql(u8, t, "off")) return false;
+    return null;
+}
+
+/// Whether `rank` writes a trace: rank 0 only (the lane host and the cache are there), unless TF_GLM_TRACE is off.
+pub fn wanted(rank: usize, raw: ?[]const u8) ?bool {
+    const on = enabled(raw) orelse return null;
+    return rank == 0 and on;
+}
+
+/// The conversation id hashed with the host's boot salt: equal ids hash alike within one run and not across runs.
+pub fn chatHash(boot: u64, chat: u32) u64 {
+    if (chat == 0) return 0;
+    return @max(1, std.hash.Wyhash.hash(boot, std.mem.asBytes(&chat)));
+}
+
+/// What a run's header says: the hash salt and the store (with none, a line reads chat=0 cached=0 kept=0 entries=0).
+pub const Header = struct {
+    boot: u64,
+    /// the prompt cache's byte budget (null: the host has no store)
+    store_budget: ?u64 = null,
+};
+
+/// The line a run starts its trace with: the format, the run's salt, the store and the keys.
+pub fn header(buf: []u8, h: Header) []const u8 {
+    var w = std.Io.Writer.fixed(buf);
+    w.print(marker ++ header_word ++ " boot={x:0>16}", .{h.boot}) catch return "";
+    (if (h.store_budget) |b| w.print(" store=on budget={d}", .{b}) else w.writeAll(" store=off")) catch return "";
+    w.writeAll(" keys=t,prompt,cached,max,chat,first,done,kept,entries,gen,end") catch return "";
+    return w.buffered();
+}
+
+/// The header in `line`, which may carry a log prefix; any other line is `error.NotATrace`.
+pub fn parseHeader(line: []const u8) ParseError!Header {
+    const at = std.mem.indexOf(u8, line, marker) orelse return error.NotATrace;
+    const rest = std.mem.trim(u8, line[at + marker.len ..], " \t\r\n");
+    if (!std.mem.startsWith(u8, rest, header_word)) return error.NotATrace;
+    var boot: ?u64 = null;
+    var store: ?bool = null;
+    var budget: ?u64 = null;
+    var words = std.mem.tokenizeAny(u8, rest, " \t");
+    while (words.next()) |w| {
+        const eq = std.mem.indexOfScalar(u8, w, '=') orelse continue;
+        const key = w[0..eq];
+        const val = w[eq + 1 ..];
+        if (std.mem.eql(u8, key, "boot")) {
+            boot = try number(u64, val, 16);
+        } else if (std.mem.eql(u8, key, "store")) {
+            store = if (std.mem.eql(u8, val, "on")) true else if (std.mem.eql(u8, val, "off")) false else return error.BadNumber;
+        } else if (std.mem.eql(u8, key, "budget")) {
+            budget = try number(u64, val, 10);
+        }
+    }
+    const on = store orelse return error.MissingKey;
+    return .{ .boot = boot orelse return error.MissingKey, .store_budget = if (on) (budget orelse return error.MissingKey) else null };
+}
+
+/// The request's line; empty only when `buf` is under 256 bytes.
+pub fn format(buf: []u8, r: Record) []const u8 {
+    var w = std.Io.Writer.fixed(buf);
+    w.print(marker ++ "t={d} prompt={d} cached={d} max={d} chat={x:0>16} first=", .{ r.t_ms, r.prompt, r.cached, r.max_tokens, r.chat }) catch return "";
+    (if (r.first_ms) |f| w.print("{d}", .{f}) else w.writeAll("-")) catch return "";
+    w.print(" done={d} kept={d} entries={d} gen={d} end={s}", .{ r.done_ms, r.kept, r.chat_entries, r.gen, @tagName(r.end) }) catch return "";
+    return w.buffered();
+}
+
+pub const ParseError = error{ NotATrace, Header, MissingKey, BadNumber, BadEnd };
+
+fn number(comptime T: type, text: []const u8, base: u8) ParseError!T {
+    return std.fmt.parseInt(T, text, base) catch error.BadNumber;
+}
+
+/// The record in `line`, which may carry a log prefix; keys it does not know are ignored; the header is `error.Header`.
+pub fn parse(line: []const u8) ParseError!Record {
+    const at = std.mem.indexOf(u8, line, marker) orelse return error.NotATrace;
+    const rest = std.mem.trim(u8, line[at + marker.len ..], " \t\r\n");
+    if (std.mem.startsWith(u8, rest, header_word)) return error.Header;
+    var t: ?u64 = null;
+    var prompt: ?u32 = null;
+    var cached: ?u32 = null;
+    var max: ?u32 = null;
+    var chat: ?u64 = null;
+    var first: ?u32 = null;
+    var seen_first = false;
+    var done: ?u32 = null;
+    var kept: ?u32 = null;
+    var entries: ?u32 = null;
+    var gen: ?u32 = null;
+    var end: ?End = null;
+    var words = std.mem.tokenizeAny(u8, rest, " \t");
+    while (words.next()) |w| {
+        const eq = std.mem.indexOfScalar(u8, w, '=') orelse continue;
+        const key = w[0..eq];
+        const val = w[eq + 1 ..];
+        if (std.mem.eql(u8, key, "t")) {
+            t = try number(u64, val, 10);
+        } else if (std.mem.eql(u8, key, "prompt")) {
+            prompt = try number(u32, val, 10);
+        } else if (std.mem.eql(u8, key, "cached")) {
+            cached = try number(u32, val, 10);
+        } else if (std.mem.eql(u8, key, "max")) {
+            max = try number(u32, val, 10);
+        } else if (std.mem.eql(u8, key, "chat")) {
+            chat = try number(u64, val, 16);
+        } else if (std.mem.eql(u8, key, "first")) {
+            seen_first = true;
+            first = if (std.mem.eql(u8, val, "-")) null else try number(u32, val, 10);
+        } else if (std.mem.eql(u8, key, "done")) {
+            done = try number(u32, val, 10);
+        } else if (std.mem.eql(u8, key, "kept")) {
+            kept = try number(u32, val, 10);
+        } else if (std.mem.eql(u8, key, "entries")) {
+            entries = try number(u32, val, 10);
+        } else if (std.mem.eql(u8, key, "gen")) {
+            gen = try number(u32, val, 10);
+        } else if (std.mem.eql(u8, key, "end")) {
+            end = std.meta.stringToEnum(End, val) orelse return error.BadEnd;
+        }
+    }
+    if (!seen_first) return error.MissingKey;
+    return .{
+        .t_ms = t orelse return error.MissingKey,
+        .prompt = prompt orelse return error.MissingKey,
+        .cached = cached orelse return error.MissingKey,
+        .max_tokens = max orelse return error.MissingKey,
+        .chat = chat orelse return error.MissingKey,
+        .first_ms = first,
+        .done_ms = done orelse return error.MissingKey,
+        .kept = kept orelse return error.MissingKey,
+        .chat_entries = entries orelse return error.MissingKey,
+        .gen = gen orelse return error.MissingKey,
+        .end = end orelse return error.MissingKey,
+    };
+}
+
+/// Every record in a log's text, in order; other lines are skipped, `bad` counts the trace lines that did not parse.
+pub fn parseAll(gpa: std.mem.Allocator, text: []const u8, bad: *usize) std.mem.Allocator.Error![]Record {
+    var out: std.ArrayList(Record) = .empty;
+    errdefer out.deinit(gpa);
+    bad.* = 0;
+    var lines = std.mem.splitScalar(u8, text, '\n');
+    while (lines.next()) |line| {
+        const r = parse(line) catch |err| {
+            if (err != error.NotATrace and err != error.Header) bad.* += 1;
+            continue;
+        };
+        try out.append(gpa, r);
+    }
+    return out.toOwnedSlice(gpa);
+}
+
+const testing = std.testing;
+
+fn sample(i: u32) Record {
+    return .{
+        .t_ms = 1_000 * @as(u64, i) + 17,
+        .prompt = 300_000 + i,
+        .cached = if (i % 2 == 0) 0 else 299_968,
+        .max_tokens = 1024,
+        .chat = chatHash(0xfeed_beef_1234_5678, i % 4 + 1),
+        .first_ms = if (i % 5 == 4) null else 1_900 + i,
+        .done_ms = 40_000 + i,
+        .kept = i % 3,
+        .chat_entries = i % 3 + 1,
+        .gen = if (i % 5 == 4) 0 else 700 + i,
+        .end = @fromBackingInt(@intCast(i % 4)),
+    };
+}
+
+test "a record formats to the documented line" {
+    var buf: [256]u8 = undefined;
+    const r: Record = .{ .t_ms = 61_000, .prompt = 524_224, .cached = 524_160, .max_tokens = 256, .chat = 0xab, .first_ms = 2_345, .done_ms = 9_876, .kept = 2, .chat_entries = 3, .gen = 256, .end = .length };
+    try testing.expectEqualStrings("request trace v1 t=61000 prompt=524224 cached=524160 max=256 chat=00000000000000ab first=2345 done=9876 kept=2 entries=3 gen=256 end=length", format(&buf, r));
+    var none = r;
+    none.first_ms = null;
+    none.end = .cancelled;
+    try testing.expect(std.mem.indexOf(u8, format(&buf, none), " first=- done=9876 ") != null);
+}
+
+test "every record round-trips through its line, with or without a log prefix" {
+    var buf: [256]u8 = undefined;
+    var pre: [320]u8 = undefined;
+    for (0..40) |i| {
+        const r = sample(@intCast(i));
+        const line = format(&buf, r);
+        try testing.expectEqualDeep(r, try parse(line));
+        const prefixed = try std.fmt.bufPrint(&pre, "2026-10-28T10:00:00.123Z info(lane_host): {s}\r", .{line});
+        try testing.expectEqualDeep(r, try parse(prefixed));
+    }
+    // the widest values still fit and come back
+    const wide: Record = .{ .t_ms = std.math.maxInt(u64), .prompt = std.math.maxInt(u32), .cached = std.math.maxInt(u32), .max_tokens = std.math.maxInt(u32), .chat = std.math.maxInt(u64), .first_ms = std.math.maxInt(u32), .done_ms = std.math.maxInt(u32), .kept = std.math.maxInt(u32), .chat_entries = std.math.maxInt(u32), .gen = std.math.maxInt(u32), .end = .failed };
+    try testing.expectEqualDeep(wide, try parse(format(&buf, wide)));
+    var tiny: [32]u8 = undefined;
+    try testing.expectEqual(@as(usize, 0), format(&tiny, wide).len);
+}
+
+test "a reader ignores keys it does not know and takes the keys in any order" {
+    const line = "x request trace v1 end=stop gen=5 future=1 entries=1 kept=0 done=900 first=300 chat=0000000000000001 max=64 cached=0 prompt=100 t=5";
+    const r = try parse(line);
+    try testing.expectEqual(@as(u64, 5), r.t_ms);
+    try testing.expectEqual(@as(?u32, 300), r.first_ms);
+    try testing.expectEqual(End.stop, r.end);
+}
+
+test "lines that are not records say why" {
+    try testing.expectError(error.NotATrace, parse("info: prompt cache: 10 tokens, resumed at 0, kept 1"));
+    try testing.expectError(error.Header, parse("request trace v1 header boot=0000000000000001 keys=t"));
+    try testing.expectError(error.MissingKey, parse("request trace v1 t=1 prompt=2"));
+    // `first` has to be there, even as `-`
+    try testing.expectError(error.MissingKey, parse("request trace v1 t=1 prompt=2 cached=0 max=4 chat=00 done=1 kept=0 entries=0 gen=0 end=stop"));
+    try testing.expectError(error.BadNumber, parse("request trace v1 t=1 prompt=two cached=0 max=4 chat=00 first=- done=1 kept=0 entries=0 gen=0 end=stop"));
+    try testing.expectError(error.BadNumber, parse("request trace v1 t=1 prompt=-2 cached=0 max=4 chat=00 first=- done=1 kept=0 entries=0 gen=0 end=stop"));
