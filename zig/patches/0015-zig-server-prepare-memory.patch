+    other[0] = (try json.parse(a, "{\"role\":\"user\",\"content\":\"another\"}")).ok;
+    const same = try k.restore(std.testing.failing_allocator, .{ .array = other });
+    try std.testing.expect(same.array.ptr == other.ptr);
+}
