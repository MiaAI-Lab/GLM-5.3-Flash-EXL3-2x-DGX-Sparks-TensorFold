+test "the union test asks for more candidates while the nucleus reaches a shard's edge, then draws the whole-shard token" {
+    const gpa = std.testing.allocator;
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    // eight near-equal head entries, four on each of two ranks, then a tail near -20
+    const logits = try a.alloc([]const []const f64, 2);
+    for (logits, 0..) |*rank, k| {
