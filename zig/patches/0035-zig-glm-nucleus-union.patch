+        .{ .widths = &.{ 300, 500, 200, 400 }, .count = 16, .head = 8, .grid = true },
+        .{ .widths = &.{ 500, 500 }, .count = 16, .head = 9, .grid = true },
+        .{ .widths = &.{ 16385, 16383 }, .count = 16384, .head = 5, .grid = false },
+        .{ .widths = &.{ 16384, 16385 }, .count = 16384, .head = 5, .grid = true },
+    };
+    const samplings = [_]S.Sampling{
+        .{ .seed = 11, .top_k = 0, .top_p = 0.9 },
+        .{ .seed = 12, .top_k = 0, .top_p = 0.99 },
+        .{ .seed = 13, .top_k = 0, .top_p = 0.5 },
+        .{ .seed = 14, .top_k = 0, .top_p = 0.9, .min_p = 0.05 },
+        .{ .seed = 15, .top_k = 0, .top_p = 0.9999, .min_p = 0.2 },
+    };
+    const positions = [_]u64{ 101, 202, 303 };
+    var prng = std.Random.DefaultPrng.init(0x5eed);
+    for (cases, 0..) |c, ci| {
+        var accepted: usize = 0;
+        for (samplings) |s| {
+            var arena = std.heap.ArenaAllocator.init(gpa);
+            defer arena.deinit();
+            const logits = try peakedLogits(arena.allocator(), prng.random(), c.widths, positions.len, c.head, c.grid);
+            errdefer std.debug.print("case {d}, seed {d}\n", .{ ci, s.seed });
+            if (try unionMatchesWholeShards(gpa, logits, c.count, &positions, s)) accepted += 1;
+        }
+        // the cases are peaked far above their candidates' edge, so the test is not vacuous
+        try std.testing.expect(accepted >= 3);
