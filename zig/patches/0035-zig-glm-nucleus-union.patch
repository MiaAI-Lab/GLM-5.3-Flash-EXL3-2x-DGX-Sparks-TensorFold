+/// Synthetic shards: logits[k][r] is rank k's row r, already divided by the temperature. `count` candidates a rank and row
+/// (ids -1 past the shard's width), masses in fixed point against the row's global top, as the kernels send them.
+const Rig = struct {
+    gpa: Allocator,
+    world: usize,
+    rows: usize,
+    count: usize,
+    vals: []f64,
+    ids: []i64,
+    mass: []i64,
+    sums: []i64,
+    widths: []i64,
+
+    const Order = struct {
+        row: []const f64,
+        fn less(o: Order, a: usize, b: usize) bool {
+            if (o.row[a] != o.row[b]) return o.row[a] > o.row[b];
+            return a < b;
+        }
+    };
+
+    fn init(gpa: Allocator, logits: []const []const []const f64, count: usize) !Rig {
+        const world = logits.len;
+        const rows = logits[0].len;
+        var g: Rig = .{ .gpa = gpa, .world = world, .rows = rows, .count = count, .vals = try gpa.alloc(f64, world * rows * count), .ids = try gpa.alloc(i64, world * rows * count), .mass = try gpa.alloc(i64, world * rows * count), .sums = try gpa.alloc(i64, world * rows), .widths = try gpa.alloc(i64, world * rows) };
+        errdefer g.deinit();
+        for (0..rows) |r| {
+            var top = -std.math.inf(f64);
+            for (logits) |rank| for (rank[r]) |v| {
+                top = @max(top, v);
+            };
+            var offset: usize = 0;
+            for (logits, 0..) |rank, k| {
+                const row = rank[r];
+                const order = try gpa.alloc(usize, row.len);
+                defer gpa.free(order);
+                for (order, 0..) |*o, i| o.* = i;
+                std.mem.sort(usize, order, Order{ .row = row }, Order.less);
+                var sum: i64 = 0;
+                for (row) |v| sum += @intFromFloat(@floor(@exp(v - top) * mass_scale));
+                const at = (k * rows + r) * count;
+                for (0..count) |j| {
+                    if (j < row.len) {
+                        const v = row[order[j]];
+                        g.vals[at + j] = v;
+                        g.ids[at + j] = @intCast(offset + order[j]);
+                        g.mass[at + j] = @intFromFloat(@floor(@exp(v - top) * mass_scale));
+                    } else {
+                        g.vals[at + j] = -std.math.inf(f64);
+                        g.ids[at + j] = -1;
+                        g.mass[at + j] = 0;
+                    }
+                }
+                g.sums[k * rows + r] = sum;
+                g.widths[k * rows + r] = @intCast(row.len);
+                offset += row.len;
+            }
+        }
+        return g;
+    }
+
+    fn deinit(g: *Rig) void {
+        g.gpa.free(g.vals);
+        g.gpa.free(g.ids);
+        g.gpa.free(g.mass);
+        g.gpa.free(g.sums);
+        g.gpa.free(g.widths);
+    }
+
+    fn shares(g: *const Rig) Shares {
+        return .{ .world = g.world, .rows = g.rows, .count = g.count, .vals = g.vals, .ids = g.ids, .mass = g.mass, .sums = g.sums, .widths = g.widths };
+    }
+};
