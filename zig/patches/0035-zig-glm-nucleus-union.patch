+/// Union draw on `narrow` candidates against the per-shard draw on whole shards (what the engine's last retry sends): when
+/// the union test accepts, the token and the share must be bit for bit the whole-shard draw. Returns whether it accepted.
+fn unionMatchesWholeShards(gpa: Allocator, logits: []const []const []const f64, count: usize, positions: []const u64, s: S.Sampling) !bool {
+    var widest: usize = 0;
+    for (logits) |rank| widest = @max(widest, rank[0].len);
+    var narrow = try Rig.init(gpa, logits, count);
+    defer narrow.deinit();
+    var whole = try Rig.init(gpa, logits, widest);
+    defer whole.deinit();
+    const rows = narrow.rows;
+    var want: [8]Drawn = undefined;
+    try std.testing.expect(try drawShares(gpa, whole.shares(), positions, s, want[0..rows]));
+    var got: [8]Drawn = undefined;
+    const accepted = try drawSharesWithUnion(gpa, narrow.shares(), positions, s, got[0..rows], true);
+    if (accepted) for (want[0..rows], got[0..rows]) |w, x| {
+        try std.testing.expectEqual(w.token, x.token);
+        try std.testing.expectEqual(@as(u64, @bitCast(w.share)), @as(u64, @bitCast(x.share)));
+    };
+    return accepted;
+}
+
+/// A peaked row: `head` random slots across the ranks get logits in [-3, 0] (on a 0.5 grid when `grid`, so values tie
+/// within and across shards), every other entry sits near -20.
+fn peakedLogits(arena: Allocator, rng: std.Random, widths: []const usize, rows: usize, head: usize, grid: bool) ![]const []const []const f64 {
+    const logits = try arena.alloc([]const []const f64, widths.len);
+    for (logits, widths) |*rank, w| {
+        const rr = try arena.alloc([]const f64, rows);
+        for (rr) |*row| {
+            const v = try arena.alloc(f64, w);
+            for (v) |*x| x.* = -20.0 - 2.0 * rng.float(f64);
+            row.* = v;
+        }
+        rank.* = rr;
+    }
+    for (0..rows) |r| for (0..head) |_| {
+        const k = rng.uintLessThan(usize, widths.len);
+        const i = rng.uintLessThan(usize, widths[k]);
+        const v = -3.0 * rng.float(f64);
+        @constCast(logits[k][r])[i] = if (grid) @floor(v * 2.0) / 2.0 else v;
+    };
+    return logits;
+}
