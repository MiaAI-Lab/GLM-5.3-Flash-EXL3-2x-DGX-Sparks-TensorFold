+    try std.testing.expect(!try unionMatchesWholeShards(gpa, logits, 1, &.{9}, s)); // two of eight
+    try std.testing.expect(!try unionMatchesWholeShards(gpa, logits, 4, &.{9}, s)); // the nucleus ends on the edge candidate
+    try std.testing.expect(try unionMatchesWholeShards(gpa, logits, 5, &.{9}, s)); // one tail entry shows the edge is past it
+}
+
+test "without a top_p cut or a min_p floor no narrow candidates cover, so a narrow retry cannot succeed" {
+    const gpa = std.testing.allocator;
+    var arena = std.heap.ArenaAllocator.init(gpa);
