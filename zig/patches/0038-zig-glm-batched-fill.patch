+//! TF_GLM_MULTI_PREFILL=2 (recipe patches 0049 / 0062, multi_prefill.py layout): where each waiting prompt's chunk sits in
+//! one batched prompt chunk, and how many rows the row-independent work runs over.
+//!
+//! The pieces lie back to back as in Python, each starting on a 16-row boundary (a view's pointers into the prompt
+//! buffers keep the 16-byte class a chunk of its own has: the captured Triton variants are keyed by it, and a piece at
+//! an odd row misses them: cuda_aot_coverage_test), and the shared work (embedding, glue, projections, MoE, norm) runs
+//! over `total` rows, the last piece's end (the gap rows between pieces are zero tokens; they go through the shared work
+//! like any row, so the engine zeroes what a piece's state work leaves unwritten there: Engine.chunkMany). Every piece's
+//! launches are its own chunk's (its rows are a lone chunk's: `cuda_aot_coverage_test.chunk_rows`); the shared ones are
+//! over a row count the set has variants for (that test runs random layouts).
+const std = @import("std");
+
+/// Pieces of one chunk at most: the origins scratch holds a slot per attention block (40), a piece's blocks being its
+/// rows / 512 rounded up; 8 is also the most streams.
+pub const max_pieces: usize = 8;
+/// Attention blocks (512 rows each, one origins slot apiece) a batched chunk holds at most: the origins scratch's 40 slots
+/// (prompt chunk rows / 512 plus a partly filled block a piece, 16384 / 512 + 8 at most).
+pub const max_slots: usize = 40;
+/// A piece's first row is a multiple of this.
+pub const piece_align: usize = 16;
+
+pub const Layout = struct {
+    /// pieces placed
+    n: usize = 0,
+    /// each placed piece's index in the wants and its first row
+    who: [max_pieces]usize = undefined,
+    lo: [max_pieces]usize = undefined,
+    /// the last piece's end: the rows the shared work runs over
+    total: usize = 0,
+};
+
+/// The wants (rows each piece asks) in order, placed as they fit in `cap` rows: one that does not fit is skipped and a
+/// later, smaller one may take its room (Python's `_group` goes on the same way); at most `max_pieces`.
+pub fn plan(wants: []const usize, cap: usize) Layout {
+    var l: Layout = .{};
+    var slots: usize = 0;
+    for (wants, 0..) |rows, i| {
+        if (l.n == max_pieces) break;
+        const lo = std.mem.alignForward(usize, l.total, piece_align);
+        const need = (rows + 511) / 512;
+        if (rows == 0 or lo + rows > cap or slots + need > max_slots) continue;
+        slots += need;
+        l.who[l.n] = i;
+        l.lo[l.n] = lo;
+        l.n += 1;
+        l.total = lo + rows;
+    }
+    return l;
+}
+
+test "plan: pieces back to back on 16-row boundaries, what does not fit skipped, at most eight" {
+    const cap = 2048;
+    var l = plan(&.{30}, cap);
+    try std.testing.expectEqual(@as(usize, 1), l.n);
+    try std.testing.expectEqual(@as(usize, 0), l.lo[0]);
+    try std.testing.expectEqual(@as(usize, 30), l.total);
+    // three short prompts: 30 -> 32, 5 -> 48, 17 ends at 65
+    l = plan(&.{ 30, 5, 17 }, cap);
+    try std.testing.expectEqualSlices(usize, &.{ 0, 1, 2 }, l.who[0..l.n]);
+    try std.testing.expectEqualSlices(usize, &.{ 0, 32, 48 }, l.lo[0..l.n]);
+    try std.testing.expectEqual(@as(usize, 65), l.total);
+    l = plan(&.{ 5, 3 }, cap);
+    try std.testing.expectEqual(@as(usize, 16), l.lo[1]);
+    try std.testing.expectEqual(@as(usize, 19), l.total);
+    // a piece that does not fit is skipped, a later one takes the room
+    l = plan(&.{ 1024, 1500, 64, 900 }, cap);
+    try std.testing.expectEqualSlices(usize, &.{ 0, 2, 3 }, l.who[0..l.n]);
+    try std.testing.expectEqualSlices(usize, &.{ 0, 1024, 1088 }, l.lo[0..l.n]);
+    try std.testing.expectEqual(@as(usize, 1988), l.total);
+    // a full chunk is alone
+    l = plan(&.{ 2048, 64 }, cap);
+    try std.testing.expectEqual(@as(usize, 1), l.n);
+    try std.testing.expectEqual(@as(usize, 2048), l.total);
+    // the gap to the next boundary counts: 2040 rows then 16 more does not fit
+    l = plan(&.{ 2033, 15, 16 }, cap);
+    try std.testing.expectEqualSlices(usize, &.{0}, l.who[0..l.n]);
+    l = plan(&.{ 2032, 16 }, cap);
+    try std.testing.expectEqualSlices(usize, &.{ 0, 1 }, l.who[0..l.n]);
+    try std.testing.expectEqual(@as(usize, 2048), l.total);
+    // nine short ones: eight placed
+    l = plan(&.{ 1, 1, 1, 1, 1, 1, 1, 1, 1 }, cap);
+    try std.testing.expectEqual(@as(usize, 8), l.n);
+    try std.testing.expectEqual(@as(usize, 113), l.total);
+    l = plan(&.{}, cap);
+    try std.testing.expectEqual(@as(usize, 0), l.n);
+    try std.testing.expectEqual(@as(usize, 0), l.total);
+}
+
+test "plan: a 1-row and a 16320-row piece take 33 origins slots and are placed; slots never pass the scratch's 40" {
+    var l = plan(&.{ 1, 16320 }, 16384);
+    try std.testing.expectEqual(@as(usize, 2), l.n);
+    try std.testing.expectEqual(@as(usize, 16), l.lo[1]);
+    // 8 pieces of 2049 rows: 5 slots each = 40; a ninth is out by count, and by slots
+    l = plan(&.{ 2049, 2049, 2049, 2049, 2049, 2049, 2049, 2049 }, 1 << 20);
+    try std.testing.expectEqual(@as(usize, 8), l.n);
+    const five = [_]usize{ 16384 - 8 * 16, 1, 513, 1, 1 };
+    l = plan(&five, 1 << 20);
+    var slots: usize = 0;
+    for (0..l.n) |i| slots += (five[l.who[i]] + 511) / 512;
+    try std.testing.expect(slots <= max_slots);
+    // a piece past the slots is skipped, a smaller later one takes the room
+    var wants: [8]usize = .{ 20000, 20000, 20000, 20000, 20000, 20000, 1, 1 }; // 40 slots each: only the first
+    l = plan(&wants, 1 << 20);
+    try std.testing.expectEqualSlices(usize, &.{0}, l.who[0..l.n]);
+    wants[0] = 512 * 39;
+    l = plan(&wants, 1 << 20);
+    try std.testing.expectEqualSlices(usize, &.{ 0, 6 }, l.who[0..l.n]);
+}
+
+test "plan: any wants give aligned, disjoint pieces within the chunk" {
+    var prng = std.Random.DefaultPrng.init(0x49);
+    const rnd = prng.random();
+    for (0..5000) |_| {
+        var wants: [10]usize = undefined;
+        const k = rnd.intRangeAtMost(usize, 0, wants.len);
+        for (wants[0..k]) |*w| w.* = if (rnd.boolean()) rnd.intRangeAtMost(usize, 1, 63) else rnd.intRangeAtMost(usize, 1, 32) * 64;
+        const l = plan(wants[0..k], 2048);
+        try std.testing.expect(l.n <= max_pieces);
+        var end: usize = 0;
+        for (0..l.n) |i| {
+            try std.testing.expectEqual(@as(usize, 0), l.lo[i] % piece_align);
+            try std.testing.expect(l.lo[i] >= end);
+            end = l.lo[i] + wants[l.who[i]];
+        }
+        try std.testing.expectEqual(end, l.total);
+        try std.testing.expect(l.total <= 2048);
+    }
+}
