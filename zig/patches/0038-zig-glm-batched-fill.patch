+    var set = try loadSet();
+    defer set.deinit();
+    drv = Fake.driver();
+    const c = configs[0];
+    const most = capMax(c);
+    const s = try gpa.create(Sweep);
+    defer gpa.destroy(s);
+    try s.init(set.value.kernels, most);
+    defer s.deinit();
+    var prng = std.Random.DefaultPrng.init(0x49_62);
+    const rnd = prng.random();
+    var missing: usize = 0;
+    var many_pieces: usize = 0;
+    for (0..400) |trial| {
+        // up to eight prompts' next chunks, each the rows a chunk of its own has (chunk_rows), at a grid position
+        var wants: [10]usize = undefined;
+        const k = rnd.intRangeAtMost(usize, 2, wants.len);
+        for (wants[0..k]) |*w| w.* = if (rnd.boolean()) rnd.intRangeAtMost(usize, 1, 63) else rnd.intRangeAtMost(usize, 1, 16) * 64;
+        const lay = many.plan(wants[0..k], grid.chunk_rows);
+        if (lay.n < 2) continue;
+        many_pieces += lay.n;
+        const rank = trial % 2;
+        const e = try s.engineFor(rank, extentOf(c), .{});
+        var parities: [many.max_pieces][34]u1 = @splat(@splat(0));
+        var pieces: [many.max_pieces]pre.Engine.Piece = undefined;
+        for (0..lay.n) |i| {
+            const rows = wants[lay.who[i]];
+            // a piece anywhere on the grid: under the dense limit, past it, deep in the context
+            const pos = if (rnd.boolean()) rnd.uintLessThan(usize, 40) * grid.state_grid else rnd.uintLessThan(usize, (most - rows) / grid.state_grid + 1) * grid.state_grid;
+            const low = std.mem.alignForward(usize, pos + rows, G.extent);
+            const cap = low + rnd.uintLessThan(usize, (most - low) / G.extent + 1) * G.extent;
+            pieces[i] = .{ .lo = lay.lo[i], .rows = rows, .pos = pos, .cache = try s.caches[rank].view(0, cap, 0), .conv = dev(1 << 16), .rec = dev(1 << 16), .pos_dev = dev(64), .parity = &parities[i] };
+        }
+        s.l.run.clearRetainingCapacity();
+        try e.chunkMany(pieces[0..lay.n], lay.total);
+        for (s.l.run.items) |line| if (!s.l.seen.get(line).?) {
+            std.debug.print("a batched chunk of {d} pieces ({d} rows, rank {d}) looks up what the set lacks: {s}\n", .{ lay.n, lay.total, rank, line });
+            missing += 1;
+        };
+    }
+    try std.testing.expect(many_pieces > 800);
+    try std.testing.expectEqual(@as(usize, 0), missing);
+}
