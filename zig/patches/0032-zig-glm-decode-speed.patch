index 0000000000000000000000000000000000000000..b9c00bf9f51714733845a88f6c638bfe344df366
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_matmuls_test.zig
@@ -0,0 +1,117 @@
+//! cuda_matmuls.matmul against a driver that records each launch: its kernel, grid, block, shared bytes and cluster.
+const std = @import("std");
+const cuda = @import("cuda");
+const abi = cuda.abi;
+const mm = @import("cuda_matmuls.zig");
+const variants = @import("cuda_entries.zig").variants;
+
+const Launch = struct { symbol: []const u8, grid: [3]u32, block: u32, shared: u32, cluster: u32, group: c_int = 0 };
+const Rec = struct {
+    var log: [4]Launch = undefined;
+    var n: usize = 0;
+    fn ok() callconv(.c) c_int {
+        return 0;
+    }
+    fn note(f: abi.Function, grid: [3]u32, block: u32, shared: u32, cluster: u32) void {
+        log[n] = .{ .symbol = variants[@intFromPtr(f) - 1].symbol, .grid = grid, .block = block, .shared = shared, .cluster = cluster };
+        n += 1;
+    }
+    fn plain(f: abi.Function, gx: c_uint, gy: c_uint, gz: c_uint, bx: c_uint, _: c_uint, _: c_uint, shared: c_uint, _: abi.Stream, p: ?[*]?*anyopaque, _: ?[*]?*anyopaque) callconv(.c) c_int {
+        note(f, .{ gx, gy, gz }, bx, shared, 0);
+        // a prompt launch's last (11th) argument: the rows a group of blocks shares
+        if (std.mem.startsWith(u8, log[n - 1].symbol, "glm_qmm_prefill")) log[n - 1].group = @as(*const c_int, @ptrCast(@alignCast(p.?[10].?))).*;
+        return 0;
+    }
+    fn ex(lc: *const abi.LaunchConfig, f: abi.Function, _: ?[*]?*anyopaque, _: ?[*]?*anyopaque) callconv(.c) c_int {
+        var cluster: u32 = 0;
+        for (lc.attrs.?[0..lc.num_attrs]) |a| if (a.id == .cluster_dimension) {
+            cluster = a.value.cluster_dim.z;
+        };
+        note(f, .{ lc.grid_x, lc.grid_y, lc.grid_z }, lc.block_x, lc.shared_bytes, cluster);
+        return 0;
+    }
+};
+var drv: cuda.Driver = undefined;
+fn entries(rule: mm.Clusters) mm.Entries {
+    var api: abi.Api = undefined;
+    inline for (@typeInfo(abi.Api).@"struct".field_names) |name| @field(api, name) = @ptrCast(&Rec.ok);
+    api.cuLaunchKernel = Rec.plain;
+    api.cuLaunchKernelEx = Rec.ex;
+    drv = .{ .lib = undefined, .api = api };
+    var e: mm.Entries = undefined;
+    for (&e.functions, 0..) |*f, i| f.* = .{ .d = &drv, .handle = @ptrFromInt(i + 1) };
+    e.clusters = rule;
+    e.prompt_tiles = true;
+    return e;
+}
+/// The launches of one (rows x k) by (k x n) matmul, decode unless `prompt`.
+fn run(e: *const mm.Entries, rows: usize, n: usize, k: usize, may: bool, prompt: bool) ![]const Launch {
+    Rec.n = 0;
+    const q: mm.Q4 = .{ .w = 0x100000, .s = 0x200000, .b = 0x300000, .n = n, .k = k };
+    try mm.matmul(e, .{ .d = &drv, .handle = null }, 0x400000, k, if (prompt) 0 else 0x500000, q, 0x600000, if (prompt) 0 else 0x700000, rows, false, may, prompt, .{});
+    return Rec.log[0..Rec.n];
+}
+fn expectOne(got: []const Launch, symbol: []const u8, cluster: u32) !void {
+    try std.testing.expectEqual(@as(usize, 1), got.len);
+    try std.testing.expectEqualStrings(symbol, got[0].symbol);
+    try std.testing.expectEqual(cluster, got[0].cluster);
+}
+fn expectReduced(got: []const Launch, symbol: []const u8) !void {
+    try std.testing.expectEqual(@as(usize, 2), got.len);
+    try std.testing.expectEqualStrings(symbol, got[0].symbol);
+    try std.testing.expectEqual(@as(u32, 0), got[0].cluster);
+    try std.testing.expectEqualStrings("glm_qmm_reduce_0", got[1].symbol);
+}
+test "decode matmuls sum K slices in a cluster only past 64 rows or from 28 Mi weight values (patch 0103)" {
+    var e = entries(.wide);
+    // latency-bound: 16 Mi values (TP=2's 4096 x 4096, two slices) through the partials and reduce_kernel
+    try expectReduced(try run(&e, 8, 4096, 4096, true, false), "glm_qmm_cfg2_0_0");
+    try expectReduced(try run(&e, 64, 4096, 4096, true, false), "glm_qmm_64_0_0");
+    // bandwidth-bound: 49 Mi (12576 x 4096, four slices) and 32 Mi (4096 x 8192, eight) keep their clusters
+    try expectOne(try run(&e, 8, 12576, 4096, true, false), "glm_qmm_16_0_1", 4);
+    try expectOne(try run(&e, 1, 4096, 8192, true, false), "glm_qmm_cfg4_0_1", 8);
+    // more rows than a decode window
+    try expectOne(try run(&e, 65, 4096, 4096, true, false), "glm_qmm_64_0_1", 2);
+    // one slice: nothing to reduce
+    try expectOne(try run(&e, 8, 4096, 128, true, false), "glm_qmm_16_0_0", 0);
+    // a caller that may not cluster, or a rule of none (this engine before 0103) or all (Python before it)
+    try expectReduced(try run(&e, 8, 12576, 4096, false, false), "glm_qmm_16_0_0");
+    e = entries(.never);
+    try expectReduced(try run(&e, 8, 12576, 4096, true, false), "glm_qmm_16_0_0");
+    e = entries(.always);
+    try expectOne(try run(&e, 8, 4096, 4096, true, false), "glm_qmm_cfg2_0_1", 2);
+}
+test "TF_GLM_QMM_CLUSTERS: unset the 0103 rule, 1 every split, 0 none; none before sm_90" {
+    try std.testing.expectEqual(mm.Clusters.wide, mm.clustersFrom(null, 121));
+    try std.testing.expectEqual(mm.Clusters.always, mm.clustersFrom("1", 121));
+    try std.testing.expectEqual(mm.Clusters.never, mm.clustersFrom("0", 121));
+    try std.testing.expectEqual(mm.Clusters.wide, mm.clustersFrom("2", 90));
+    try std.testing.expectEqual(mm.Clusters.never, mm.clustersFrom("1", 86));
+    try std.testing.expectEqual(mm.Clusters.never, mm.clustersFrom(null, 80));
+}
+fn expectPrompt(got: []const Launch, symbol: []const u8, blocks: u32, group: c_int) !void {
+    try expectOne(got, symbol, 0);
+    try std.testing.expectEqual(@as([3]u32, .{ blocks, 1, 1 }), got[0].grid);
+    try std.testing.expectEqual(@as(u32, 128), got[0].block);
+    try std.testing.expectEqual(@as(u32, 41984), got[0].shared);
+    try std.testing.expectEqual(group, got[0].group);
+}
+test "prompt projections launch 64 x 64 tiles unless K >= 1024 and 96 or more 128 x 128 blocks (patch 0102)" {
+    var e = entries(.never);
+    // a 2,048-row chunk at 4096 x 4096: 16 x 32 blocks of 128 x 128
+    try expectPrompt(try run(&e, 2048, 4096, 4096, true, true), "glm_qmm_prefill_0", 512, 12);
+    // narrow (512 columns: 64 big blocks), short K (512) and few rows (64: 32 big blocks): 64 x 64
+    try expectPrompt(try run(&e, 2048, 512, 4096, true, true), "glm_qmm_prefill64_0", 32 * 8, 24);
+    try expectPrompt(try run(&e, 2048, 4096, 512, true, true), "glm_qmm_prefill64_0", 32 * 64, 32);
+    try expectPrompt(try run(&e, 64, 4096, 4096, true, true), "glm_qmm_prefill64_0", 64, 1);
+    // exactly 96 blocks with K 1024 stays wide
+    try expectPrompt(try run(&e, 2048, 768, 1024, true, true), "glm_qmm_prefill_0", 96, 16);
+    // TF_GLM_PROMPT_TILE=0: 128 x 128 throughout, as before
+    e.prompt_tiles = false;
+    try expectPrompt(try run(&e, 2048, 512, 4096, true, true), "glm_qmm_prefill_0", 64, 12);
+}
+test "TF_GLM_PROMPT_TILE: on unless 0" {
+    try std.testing.expect(mm.promptTilesFrom(null));
+    try std.testing.expect(mm.promptTilesFrom("1"));
+    try std.testing.expect(!mm.promptTilesFrom("0"));
+}
