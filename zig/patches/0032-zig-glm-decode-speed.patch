index 0000000000000000000000000000000000000000..7e4cca0c0556c025eb4bdb4cc22fec600555a413
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_dflash_test.zig
@@ -0,0 +1,159 @@
+//! A round's tap pass and the next block pass against a driver that logs each call (patch 0100's ordering).
+const std = @import("std");
+const cuda = @import("cuda");
+const abi = cuda.abi;
+const df = @import("cuda_dflash.zig");
+const Forward = @import("cuda_dflash_forward.zig").Forward;
+const shared = @import("cuda_torch_ops.zig").shared;
+
+const Call = enum { taps, block, kernel, upload, flag_async, read_async, sync, flag_read };
+const Fake = struct {
+    var log: [64]Call = undefined;
+    var n: usize = 0;
+    var syncs_left: usize = 0; // a synchronization past these fails (stops a proposal at its wait)
+    var bad_tap = false; // the first flag copied back reads 1
+    fn add(c: Call) void {
+        log[n] = c;
+        n += 1;
+    }
+    fn ok() callconv(.c) c_int {
+        return 0;
+    }
+    fn graph(g: abi.GraphExec, _: abi.Stream) callconv(.c) c_int {
+        add(if (@intFromPtr(g) == 0x10) .taps else .block);
+        return 0;
+    }
+    fn kernel(_: abi.Function, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: abi.Stream, _: ?[*]?*anyopaque, _: ?[*]?*anyopaque) callconv(.c) c_int {
+        add(.kernel);
+        return 0;
+    }
+    fn upload(_: abi.DevicePtr, _: ?*const anyopaque, _: usize, _: abi.Stream) callconv(.c) c_int {
+        add(.upload);
+        return 0;
+    }
+    fn readAsync(dst: ?*anyopaque, _: abi.DevicePtr, bytes: usize, _: abi.Stream) callconv(.c) c_int {
+        const out: [*]u8 = @ptrCast(dst.?);
+        @memset(out[0..bytes], 0);
+        if (bytes == 4 and bad_tap) {
+            out[0] = 1;
+            bad_tap = false;
+        }
+        add(if (bytes == 4) .flag_async else .read_async);
+        return 0;
+    }
+    fn read(dst: ?*anyopaque, _: abi.DevicePtr, bytes: usize) callconv(.c) c_int {
+        const out: [*]u8 = @ptrCast(dst.?);
+        @memset(out[0..bytes], 0);
+        add(.flag_read);
+        return 0;
+    }
+    fn sync(_: abi.Stream) callconv(.c) c_int {
+        add(.sync);
+        if (syncs_left == 0) return abi.error_not_ready; // an error the driver does not log
+        syncs_left -= 1;
+        return 0;
+    }
+};
+var drv: cuda.Driver = undefined;
+var fns: shared.Functions = undefined;
+var ring: [16 << 10]u8 align(16) = undefined;
+var pinned: [128 << 10]u8 align(16) = undefined;
+
+fn forward(prelaunch: bool) !Forward {
+    var api: abi.Api = undefined;
+    inline for (@typeInfo(abi.Api).@"struct".field_names) |name| @field(api, name) = @ptrCast(&Fake.ok);
+    api.cuGraphLaunch = Fake.graph;
+    api.cuLaunchKernel = Fake.kernel;
+    api.cuMemcpyHtoDAsync_v2 = Fake.upload;
+    api.cuMemcpyDtoHAsync_v2 = Fake.readAsync;
+    api.cuMemcpyDtoH_v2 = Fake.read;
+    api.cuStreamSynchronize = Fake.sync;
+    drv = .{ .lib = undefined, .api = api };
+    const s: cuda.Stream = .{ .d = &drv, .handle = null };
+    fns.strided = .{ .d = &drv, .handle = null };
+    var f: Forward = undefined;
+    f.d = &drv;
+    f.stream = s;
+    f.streams = 2;
+    f.th.base = .{ .f = &fns, .s = s };
+    f.cfg.mask = 7;
+    f.rank = try @import("cuda_dflash_config.zig").Rank.init(1, 0);
+    inline for (.{ "tap_in", "ids", "rowpos", "rowslots", "bpos", "bslots", "invalid", "candidates", "projection" }, 1..) |name, i| @field(f, name) = 0x100000 * i;
+    f.taps = @splat(null);
+    f.taps[0] = .{ .d = &drv, .handle = @ptrFromInt(0x10) };
+    f.blocks = @splat(@as(?cuda.graph.Exec, .{ .d = &drv, .handle = @ptrFromInt(0x20) }));
+    f.stager = .{ .stream = s, .host = .{ .d = &drv, .bytes = &ring }, .event = .{ .d = &drv, .handle = null } };
+    f.pin = .{ .d = &drv, .bytes = &pinned };
+    f.tap_pending = false;
+    f.prelaunch = prelaunch;
+    return f;
+}
+fn multi(f: *Forward) df.Multi {
+    var m: df.Multi = .{ .gpa = std.testing.allocator, .forward = f, .selector = undefined };
+    for (&m.contexts) |*c| c.* = .{ .capacity = 4096, .end = 32 };
+    return m;
+}
+const items = [_]df.Multi.TapItem{ .{ .slot = 0, .row0 = 0, .keep = 4 }, .{ .slot = 1, .row0 = 4, .keep = 4 } };
+/// A round's end on the drafter: its kept rows' tap pass, then both streams' block pass (stopped at its wait).
+fn round(prelaunch: bool, syncs: usize) ![]const Call {
+    var f = try forward(prelaunch);
+    var m = multi(&f);
+    Fake.n = 0;
+    Fake.syncs_left = syncs;
+    try m.commitTaps(&items, 0x900000, 8);
+    var out: [2][7]u32 = undefined;
+    var reqs = [_]df.Request{ .{ .slot = 0, .pending = 5, .count = 7, .out = &out[0] }, .{ .slot = 1, .pending = 6, .count = 7, .out = &out[1] } };
+    try std.testing.expectError(error.NotReady, m.propose(&reqs));
+    return Fake.log[0..Fake.n];
+}
+fn first(log: []const Call, c: Call) usize {
+    return std.mem.indexOfScalar(Call, log, c).?;
+}
+test "TF_GLM_DRAFT_PRELAUNCH: the block pass queues behind the round's tap pass with no wait between (patch 0100)" {
+    const on = try round(true, 0);
+    // the taps' flag rides on the proposal's one synchronization, after the block pass and its readback are queued
+    try std.testing.expect(first(on, .taps) < first(on, .flag_async));
+    try std.testing.expect(first(on, .flag_async) < first(on, .block));
+    try std.testing.expectEqual(@as(usize, 1), std.mem.count(Call, on, &.{.sync}));
+    try std.testing.expectEqual(Call.sync, on[on.len - 1]);
+    try std.testing.expectEqual(@as(usize, 0), std.mem.count(Call, on, &.{.flag_read}));
+    // 0: the round's taps are waited for and checked before the pass is staged, as before
+    const off = try round(false, 1);
+    try std.testing.expect(first(off, .taps) < first(off, .sync));
+    try std.testing.expect(first(off, .flag_read) < first(off, .block));
+    try std.testing.expectEqual(@as(usize, 2), std.mem.count(Call, off, &.{.sync}));
+}
+test "a deferred tap check still fails the round: at the proposal's wait, before another flag overwrites it, or alone" {
+    // a bad index in the round's tap pass surfaces at the block pass's synchronization
+    var f = try forward(true);
+    var m = multi(&f);
+    Fake.n = 0;
+    Fake.syncs_left = 9;
+    Fake.bad_tap = true;
+    try m.commitTaps(&items, 0x900000, 8);
+    var out: [2][7]u32 = undefined;
+    var reqs = [_]df.Request{ .{ .slot = 0, .pending = 5, .count = 7, .out = &out[0] }, .{ .slot = 1, .pending = 6, .count = 7, .out = &out[1] } };
+    try std.testing.expectError(error.BadDraftIndex, m.propose(&reqs));
+    // a second round's taps with no proposal between: the first flag is waited for and read before it is replaced
+    f = try forward(true);
+    m = multi(&f);
+    Fake.n = 0;
+    Fake.bad_tap = true;
+    try m.commitTaps(&items, 0x900000, 8);
+    try std.testing.expectError(error.BadDraftIndex, m.commitTaps(&items, 0x900000, 8));
+    // a proposal with no block pass (nothing to draft) settles the pending check itself
+    f = try forward(true);
+    m = multi(&f);
+    Fake.n = 0;
+    Fake.bad_tap = true;
+    try m.commitTaps(&items, 0x900000, 8);
+    var none = [_]df.Request{.{ .slot = 0, .pending = 5, .count = 0, .out = &out[0] }};
+    try std.testing.expectError(error.BadDraftIndex, m.propose(&none));
+}
+test "TF_GLM_DRAFT_PRELAUNCH: on unless 0" {
+    const from = @import("cuda_dflash_forward.zig").prelaunchFrom;
+    try std.testing.expect(from(null));
+    try std.testing.expect(from("1"));
+    try std.testing.expect(!from("0"));
+    try std.testing.expect(!from(" 0\n"));
+}
