@@ -0,0 +1,87 @@
+//! TF_GLM_MULTI_PREFILL: which filling prompts a sliced fill's step (cuda_lanes prefillStepFn) advances a chunk each.
+//! The oldest always (it never waits behind a newer one), then the fewest rows left, the older on a tie: a short prompt
+//! admitted behind a long one gets its first token without waiting for the whole long prompt. Every rank picks alike
+//! (orders and rows left are the same on every rank).
+const std = @import("std");
+
+/// A filling prompt: its fill's begin order and the rows its pass has left from its segment's start.
+pub const Candidate = struct { order: u64, left: usize };
+
+/// Prompts a step advances at most (TF_GLM_MULTI_PREFILL_MOST); the setting's range.
+pub const default_most: usize = 2;
+pub const most_max: usize = 8;
+
+/// TF_GLM_MULTI_PREFILL (`on`) and TF_GLM_MULTI_PREFILL_MOST (`most`), as set: the prompts a step advances. Unset, blank or
+/// "0": 1 (the oldest alone, as without it); "1": `most` of them, 2 by default, 2 to 8. Anything else is refused.
+pub fn parse(on: ?[]const u8, most: ?[]const u8) !usize {
+    const v = std.mem.trim(u8, on orelse return 1, " ");
+    if (v.len == 0 or std.mem.eql(u8, v, "0")) return 1;
+    if (!std.mem.eql(u8, v, "1")) return error.BadMultiPrefill;
+    const m = std.mem.trim(u8, most orelse return default_most, " ");
+    if (m.len == 0) return default_most;
+    const n = std.fmt.parseInt(usize, m, 10) catch return error.BadMultiPrefill;
+    if (n < 2 or n > most_max) return error.BadMultiPrefill;
+    return n;
+}
+
+/// The setting once the ranks agreed on it: this rank's read error, or 1 without sliced fills (TF_GLM_FILL=1), which it
+/// needs (whole passes have no chunks to share).
+pub fn admit(read: anyerror!usize, sliced: bool) !usize {
+    const n = try read;
+    return if (sliced) n else 1;
+}
+
+/// Up to `most` of `cands` (indices into it) in `out`, by begin order (the chunks run oldest first).
+pub fn pick(cands: []const Candidate, most: usize, out: []usize) []usize {
+    const n = @min(@min(most, cands.len), out.len);
+    if (n == 0) return out[0..0];
+    var oldest: usize = 0;
+    for (cands, 0..) |c, i| if (c.order < cands[oldest].order) {
+        oldest = i;
+    };
+    out[0] = oldest;
+    var k: usize = 1;
+    while (k < n) : (k += 1) {
+        var best: ?usize = null;
+        for (cands, 0..) |c, i| {
+            if (std.mem.indexOfScalar(usize, out[0..k], i) != null) continue;
+            if (best) |b| {
+                const o = cands[b];
+                if (c.left > o.left or (c.left == o.left and c.order > o.order)) continue;
+            }
+            best = i;
+        }
+        out[k] = best.?;
+    }
+    std.mem.sort(usize, out[0..n], cands, byOrder);
+    return out[0..n];
+}
+
+fn byOrder(cands: []const Candidate, a: usize, b: usize) bool {
+    return cands[a].order < cands[b].order;
+}
+
+test "pick: the oldest, then the fewest rows left (the older on a tie), oldest first; never more than asked" {
+    var out: [8]usize = undefined;
+    const c = [_]Candidate{ .{ .order = 4, .left = 900 }, .{ .order = 1, .left = 5000 }, .{ .order = 7, .left = 100 }, .{ .order = 3, .left = 100 } };
+    try std.testing.expectEqualSlices(usize, &.{1}, pick(&c, 1, &out));
+    try std.testing.expectEqualSlices(usize, &.{ 1, 3 }, pick(&c, 2, &out));
+    try std.testing.expectEqualSlices(usize, &.{ 1, 3, 2 }, pick(&c, 3, &out));
+    try std.testing.expectEqualSlices(usize, &.{ 1, 3, 0, 2 }, pick(&c, 8, &out));
+    try std.testing.expectEqual(@as(usize, 0), pick(&.{}, 2, &out).len);
+    try std.testing.expectEqual(@as(usize, 0), pick(&c, 0, &out).len);
+    try std.testing.expectEqualSlices(usize, &.{ 1, 3 }, pick(&c, 8, out[0..2]));
+}
+
+test "TF_GLM_MULTI_PREFILL: off unless 1, then 2 prompts a step or TF_GLM_MULTI_PREFILL_MOST's 2 to 8; anything else refused; nothing without sliced fills" {
+    try std.testing.expectEqual(@as(usize, 1), try parse(null, "4"));
+    for ([_][]const u8{ "", "0", " 0 " }) |v| try std.testing.expectEqual(@as(usize, 1), try parse(v, "4"));
+    try std.testing.expectEqual(@as(usize, 2), try parse("1", null));
+    try std.testing.expectEqual(@as(usize, 2), try parse(" 1", " "));
+    try std.testing.expectEqual(@as(usize, 8), try parse("1", "8"));
+    for ([_][]const u8{ "2", "yes", "on" }) |v| try std.testing.expectError(error.BadMultiPrefill, parse(v, null));
+    for ([_][]const u8{ "1", "9", "x", "-2" }) |m| try std.testing.expectError(error.BadMultiPrefill, parse("1", m));
+    try std.testing.expectEqual(@as(usize, 3), try admit(3, true));
+    try std.testing.expectEqual(@as(usize, 1), try admit(3, false));
+    try std.testing.expectError(error.BadMultiPrefill, admit(error.BadMultiPrefill, false));
+}
