+/// The chunks rank 0's engine ran on `s`'s sequence so far.
+fn chunksOf(p: *SlicedPair, s: *lanes.Stream) usize {
+    const seq = @intFromPtr(p.r0.lanes.get(s).?.seq);
+    var n: usize = 0;
+    for (p.e0.chunk_log.items) |c| n += @intFromBool(c[0] == seq);
+    return n;
+}
