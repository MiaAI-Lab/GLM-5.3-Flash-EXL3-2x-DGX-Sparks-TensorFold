+    const gpa = std.testing.allocator;
+    const o: Options = .{ .context = 8192, .drafts = false, .parallel = 4, .tp = 2 };
+    defer _ = TestEnv.unsetenv("TF_GLM_FILL");
+    defer _ = TestEnv.unsetenv("TF_GLM_MULTI_PREFILL");
+    defer _ = TestEnv.unsetenv("TF_GLM_MULTI_PREFILL_MOST");
+    _ = TestEnv.unsetenv("TF_GLM_FILL");
+    _ = TestEnv.unsetenv("TF_GLM_MULTI_PREFILL");
+    _ = TestEnv.unsetenv("TF_GLM_MULTI_PREFILL_MOST");
+    const before = try settings(gpa, std.testing.io, "/nonexistent-glm", "/nonexistent-kernels", o, shard.Switches{}, null);
+    defer gpa.free(before);
+    _ = TestEnv.setenv("TF_GLM_MULTI_PREFILL", "1", 1);
+    try std.testing.expectEqual(@as(usize, 2), try multiSetting());
+    const no_fill = try settings(gpa, std.testing.io, "/nonexistent-glm", "/nonexistent-kernels", o, shard.Switches{}, null);
+    defer gpa.free(no_fill);
+    try std.testing.expectEqualStrings(before, no_fill); // the recipe's default MULTI_PREFILL=1 with FILL=0: as before
+    _ = TestEnv.setenv("TF_GLM_FILL", "1", 1);
