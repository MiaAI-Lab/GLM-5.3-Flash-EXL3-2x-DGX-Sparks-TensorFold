+    _ = TestEnv.setenv("TF_GLM_MULTI_PREFILL", "0", 1);
+    const off = try settings(gpa, std.testing.io, "/nonexistent-glm", "/nonexistent-kernels", o, shard.Switches{}, null);
+    defer gpa.free(off);
+    try std.testing.expect(std.mem.endsWith(u8, off, " fill=1"));
+    _ = TestEnv.setenv("TF_GLM_MULTI_PREFILL", "2", 1);
+    try std.testing.expectError(error.BadMultiPrefill, multiSetting());
+    const bad = try settings(gpa, std.testing.io, "/nonexistent-glm", "/nonexistent-kernels", o, shard.Switches{}, null);
+    defer gpa.free(bad);
