+    // b keeps a state at 64 on the way (a segment ends inside the shared steps)
+    var sb = try lanes.Stream.init(gpa, .{ .id = "b", .prompt = &b, .max_new = 4, .reuse = .{ .marks = &.{64} } });
+    defer sb.deinit(gpa);
+    try p.begin(&sa, &sa);
+    try p.begin(&sb, &sb);
