+/// glm_race_top on the host: one rank's shard `v` (ids offset..offset + v.len) to its race_keep best and dropped bound.
+fn raceRank(v: []const f64, mass: []const i64, offset: i64, seed: u64, position: u64, row: []i64) void {
+    var keep: [race_keep]Entry = @splat(.{ .v = -std.math.inf(f64), .id = -1, .m = 0 });
+    var score: [race_keep]f64 = @splat(-std.math.inf(f64));
+    var dropped = -std.math.inf(f64);
+    var sum: i64 = 0;
+    for (v, mass, 0..) |x, m, j| {
+        sum += m;
+        const e: Entry = .{ .v = x, .id = offset + @as(i64, @intCast(j)), .m = m };
+        const sc = x - log(-log(S.uniform(seed, position, @bitCast(e.id))));
+        var k: usize = race_keep;
+        while (k > 0 and (sc > score[k - 1] or (sc == score[k - 1] and keep[k - 1].id >= 0 and before({}, e, keep[k - 1])) or keep[k - 1].id < 0)) k -= 1;
+        if (k == race_keep) {
+            dropped = @max(dropped, sc);
+            continue;
+        }
+        if (keep[race_keep - 1].id >= 0) dropped = @max(dropped, score[race_keep - 1]);
+        var i: usize = race_keep - 1;
+        while (i > k) : (i -= 1) {
+            keep[i] = keep[i - 1];
+            score[i] = score[i - 1];
+        }
+        keep[k] = e;
+        score[k] = sc;
+    }
+    for (keep, 0..) |e, j| {
+        row[j] = @bitCast(e.v);
+        row[race_keep + j] = e.id;
+        row[2 * race_keep + j] = e.m;
+    }
+    row[3 * race_keep] = sum;
+    row[3 * race_keep + 1] = @bitCast(dropped);
+}
+
+test "the race draws _draw's token and share with no cut, two ranks, and refuses a near tie" {
+    const gpa = std.testing.allocator;
+    const n = 300;
+    var prng = std.Random.DefaultPrng.init(7);
+    const rnd = prng.random();
+    var v: [2 * n]f64 = undefined;
+    var mass: [2 * n]i64 = undefined;
+    for (&v, &mass) |*x, *m| {
+        x.* = rnd.float(f64) * 12.0 - 6.0;
+        m.* = rnd.intRangeAtMost(i64, 1, 1 << 30);
+    }
+    const sampling: S.Sampling = .{ .seed = 1234, .temperature = 0.7, .top_k = 0, .top_p = 1.0 };
+    try std.testing.expect(raceable(sampling));
+    try std.testing.expect(!raceable(.{ .seed = 1, .temperature = 0.7, .top_k = 0, .top_p = 0.95 }));
+    try std.testing.expect(!raceable(.{ .seed = 1, .temperature = 0.7, .top_k = 40, .top_p = 1.0 }));
+    try std.testing.expect(!raceable(.{ .seed = 1, .temperature = 0.7, .top_k = 0, .top_p = 1.0, .min_p = 0.05 }));
+    var ids: [2 * n]i64 = undefined;
+    for (&ids, 0..) |*x, j| x.* = @intCast(j);
+    const sums = [_]i64{ massSum(mass[0..n]), massSum(mass[n..]) };
+    const widths = [_]i64{ n, n };
+    var drawn: usize = 0;
+    for (0..200) |position| {
+        const pos = [_]u64{position};
+        var full: [1]Drawn = undefined;
+        // the whole-shard draw as _draw makes it, each rank sending its whole (sorted) shard
+        var vs: [2 * n]f64 = undefined;
+        var is: [2 * n]i64 = undefined;
+        var ms: [2 * n]i64 = undefined;
+        for (0..2) |k| {
+            var list: [n]Entry = undefined;
+            for (&list, 0..) |*e, j| e.* = .{ .v = v[k * n + j], .id = ids[k * n + j], .m = mass[k * n + j] };
+            std.mem.sort(Entry, &list, {}, before);
+            for (list, 0..) |e, j| {
+                vs[k * n + j] = e.v;
+                is[k * n + j] = e.id;
+                ms[k * n + j] = e.m;
+            }
+        }
+        try std.testing.expect(try drawShares(gpa, .{ .world = 2, .rows = 1, .count = n, .vals = &vs, .ids = &is, .mass = &ms, .sums = &sums, .widths = &widths }, &pos, sampling, &full));
+        var words: [2 * (3 * race_keep + 2)]i64 = undefined;
+        raceRank(v[0..n], mass[0..n], 0, sampling.seed, position, words[0 .. 3 * race_keep + 2]);
+        raceRank(v[n..], mass[n..], n, sampling.seed, position, words[3 * race_keep + 2 ..]);
+        var raced: [1]Drawn = undefined;
+        if (!raceDraw(&words, 2, 1, &pos, sampling, &raced)) continue;
+        drawn += 1;
+        try std.testing.expectEqual(full[0].token, raced[0].token);
+        try std.testing.expectEqual(full[0].share, raced[0].share);
+    }
+    try std.testing.expect(drawn >= 195); // a near tie is rare
+    // a winner within race_margin of a dropped score is refused
+    var words: [3 * race_keep + 2]i64 = undefined;
+    raceRank(v[0..n], mass[0..n], 0, sampling.seed, 3, &words);
+    const best_v: f64 = @bitCast(words[0]);
+    const best = best_v - log(-log(S.uniform(sampling.seed, 3, @bitCast(words[race_keep]))));
+    words[3 * race_keep + 1] = @bitCast(best - race_margin / 2);
+    var out: [1]Drawn = undefined;
+    try std.testing.expect(!raceDraw(&words, 1, 1, &.{3}, sampling, &out));
+}
+
+fn massSum(xs: []const i64) i64 {
+    var t: i64 = 0;
+    for (xs) |x| t += x;
+    return t;
+}
