+/// glm_race_top's kept scores a rank (RACE_KEEP in glm_ops.cu).
+pub const race_keep: usize = 4;
+/// The host's exact score may differ from the GPU's by a few ulp (each side's log is within 1 ulp): a winner closer
+/// than this to the best dropped score is a near tie, drawn from whole shards instead.
+pub const race_margin: f64 = 1e-9;
+
+/// A draw with no top_p cut and no min_p keeps every token: the race decides it.
+pub fn raceable(s: S.Sampling) bool {
+    return s.temperature > 0 and s.top_k == 0 and !(0.0 < s.top_p and s.top_p < 1.0) and !(s.min_p > 0.0);
+}
+
+/// sampling._draw with keep = all, from each rank's race: `words` [world][rows][3 * race_keep + 2] as glm_race_top
+/// writes them (vals as f64 bits, global ids, mass, the row's mass sum, the best dropped score as f64 bits). Every
+/// candidate is rescored here as _draw scores it; the best wins as there (score, then value descending, then id), but
+/// only past every rank's dropped bound by race_margin. False: some row is a near tie.
+pub fn raceDraw(words: []const i64, world: usize, rows: usize, positions: []const u64, s: S.Sampling, out: []Drawn) bool {
+    const width = 3 * race_keep + 2;
+    for (0..rows) |r| {
+        var total: i128 = 0;
+        var bound = -std.math.inf(f64);
+        var found = false;
+        var best: Entry = undefined;
+        var best_score: f64 = undefined;
+        for (0..world) |k| {
+            const at = (k * rows + r) * width;
+            total += words[at + 3 * race_keep];
+            bound = @max(bound, @as(f64, @bitCast(words[at + 3 * race_keep + 1])));
+            for (0..race_keep) |j| {
+                const id = words[at + race_keep + j];
+                if (id < 0) continue;
+                const x: Entry = .{ .v = @bitCast(words[at + j]), .id = id, .m = words[at + 2 * race_keep + j] };
+                const score = x.v - log(-log(S.uniform(s.seed, positions[r], @bitCast(x.id))));
+                if (!found or score > best_score or (score == best_score and before({}, x, best))) {
+                    best = x;
+                    best_score = score;
+                    found = true;
+                }
+            }
+        }
+        if (!found or !(best_score > bound + race_margin)) return false;
+        out[r] = .{ .token = @intCast(best.id), .share = @as(f64, @floatFromInt(best.m)) / @as(f64, @floatFromInt(total)) };
+    }
+    return true;
+}
