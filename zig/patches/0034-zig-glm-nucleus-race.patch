+// A sampled row with no top_p cut and no min_p is a Gumbel max over every token (sampling._draw with keep = all):
+// score = double(logit) / temp - log(-log(u)), u from splitmix64(seed, position, id) as lanes/sampling.uniform. Each
+// rank keeps its RACE_KEEP best scores and writes them in mass_pack's layout (vals = double(logit) / temp, global ids,
+// fixed-point mass, the row's mass sum) with the largest score it dropped last; the host rescores them exactly and
+// takes the winner only past that bound (cuda_nucleus.raceDraw), else sends whole shards as before.
+#define RACE_KEEP 4
+__device__ __forceinline__ uint64_t glm_mix(uint64_t x) {
+    x ^= x >> 30; x *= 0xBF58476D1CE4E5B9ull; x ^= x >> 27; x *= 0x94D049BB133111EBull; return x ^ (x >> 31);
+}
+__device__ __forceinline__ bool glm_race_before(double s, double v, int64_t id, double s2, double v2, int64_t id2) {
+    return s != s2 ? s > s2 : (v != v2 ? v > v2 : id < id2);
+}
+extern "C" __global__ void glm_race_top(const __nv_bfloat16* logits, const int64_t* mass, const int64_t* sums,
+    const uint64_t* positions, int64_t* out, uint64_t columns, int64_t offset, double temp, uint64_t seed) {
+    __shared__ double ss[256 * RACE_KEEP], sv[256 * RACE_KEEP]; __shared__ int64_t si[256 * RACE_KEEP];
+    const uint64_t r = blockIdx.x, at = r * (3 * RACE_KEEP + 2);
+    const uint64_t key = glm_mix(glm_mix(seed + 0x9E3779B97F4A7C15ull) ^ (positions[r] * 0xD1B54A32D192ED03ull));
+    double s[RACE_KEEP], v[RACE_KEEP]; int64_t id[RACE_KEEP];
+    for (int k = 0; k < RACE_KEEP; ++k) { s[k] = -INFINITY; v[k] = -INFINITY; id[k] = -1; }
+    double lost = -INFINITY;  // the best score this thread dropped
+    for (uint64_t j = threadIdx.x; j < columns; j += 256) {
+        const double x = double(__bfloat162float(logits[r * columns + j])) / temp;
+        const int64_t g = int64_t(j) + offset;
+        const double u = double(glm_mix(key ^ uint64_t(g)) >> 11) * 0x1p-53 + 0x1p-54;
+        const double sc = x - log(-log(u));
+        if (!glm_race_before(sc, x, g, s[RACE_KEEP - 1], v[RACE_KEEP - 1], id[RACE_KEEP - 1])) { lost = fmax(lost, sc); continue; }
+        lost = fmax(lost, s[RACE_KEEP - 1]);
+        int k = RACE_KEEP - 1;
+        while (k > 0 && glm_race_before(sc, x, g, s[k - 1], v[k - 1], id[k - 1])) { s[k] = s[k - 1]; v[k] = v[k - 1]; id[k] = id[k - 1]; --k; }
+        s[k] = sc; v[k] = x; id[k] = g;
+    }
+    for (int k = 0; k < RACE_KEEP; ++k) { ss[threadIdx.x * RACE_KEEP + k] = s[k]; sv[threadIdx.x * RACE_KEEP + k] = v[k]; si[threadIdx.x * RACE_KEEP + k] = id[k]; }
+    __shared__ double lost_all[256]; lost_all[threadIdx.x] = lost;
+    __syncthreads();
+    if (threadIdx.x != 0) return;
+    double bs[RACE_KEEP], bv[RACE_KEEP]; int64_t bi[RACE_KEEP]; double dropped = -INFINITY;
+    for (int k = 0; k < RACE_KEEP; ++k) { bs[k] = -INFINITY; bv[k] = -INFINITY; bi[k] = -1; }
+    for (int t = 0; t < 256; ++t) dropped = fmax(dropped, lost_all[t]);
+    for (int e = 0; e < 256 * RACE_KEEP; ++e) {
+        const double sc = ss[e], x = sv[e]; const int64_t g = si[e];
+        if (g < 0) continue;
+        if (!glm_race_before(sc, x, g, bs[RACE_KEEP - 1], bv[RACE_KEEP - 1], bi[RACE_KEEP - 1])) { dropped = fmax(dropped, sc); continue; }
+        dropped = fmax(dropped, bs[RACE_KEEP - 1]);
+        int k = RACE_KEEP - 1;
+        while (k > 0 && glm_race_before(sc, x, g, bs[k - 1], bv[k - 1], bi[k - 1])) { bs[k] = bs[k - 1]; bv[k] = bv[k - 1]; bi[k] = bi[k - 1]; --k; }
+        bs[k] = sc; bv[k] = x; bi[k] = g;
+    }
+    for (int k = 0; k < RACE_KEEP; ++k) {
+        const bool real = bi[k] >= 0;
+        out[at + k] = __double_as_longlong(real ? bv[k] : -INFINITY);
+        out[at + RACE_KEEP + k] = real ? bi[k] : -1;
+        out[at + 2 * RACE_KEEP + k] = real ? mass[r * columns + uint64_t(bi[k] - offset)] : 0;
+    }
+    out[at + 3 * RACE_KEEP] = sums[r];
+    out[at + 3 * RACE_KEEP + 1] = __double_as_longlong(dropped);
+}
