+
+    pub fn tier(t: *FakeTier) pc.Tier {
+        return .{ .ptr = t, .vtable = &.{ .lookup = lookup, .begin = begin, .full = isFull, .check = check, .poll = poll, .cancel = cancel, .keep = keep, .release = release, .share = share, .touch = touch, .forget = forget, .pump = pump, .busy = busy, .flush = flush, .counts = counts } };
+    }
+
+    fn lock(t: *FakeTier) void {
+        t.mu.lockUncancelable(std.testing.io);
+    }
+
+    fn unlock(t: *FakeTier) void {
+        t.mu.unlock(std.testing.io);
+    }
+
+    fn of(ptr: *anyopaque) *FakeTier {
+        return @ptrCast(@alignCast(ptr));
+    }
+
+    /// A published point of `key` (its ids, `at` plus lookahead) whose state packs to `bytes`: its name.
+    pub fn put(t: *FakeTier, key: []const u32, at: u32, bytes: []const u8, size: u64, group: u64, shared: bool) !u64 {
+        t.lock();
+        defer t.unlock();
+        const k = try t.gpa.dupe(u32, key);
+        errdefer t.gpa.free(k);
+        const b = try t.gpa.dupe(u8, bytes);
+        errdefer t.gpa.free(b);
+        const id = t.next_id;
+        try t.points.append(t.gpa, .{ .id = id, .key = k, .at = at, .group = group, .shared = shared, .bytes = b, .parent = null, .fork = 0, .size = size });
+        t.next_id += 1;
+        return id;
+    }
+
+    /// The published point named `id`, if any.
+    pub fn point(t: *FakeTier, id: u64) ?*Pt {
+        t.lock();
+        defer t.unlock();
+        return t.find(id);
+    }
+
+    fn find(t: *FakeTier, id: u64) ?*Pt {
+        for (t.points.items) |*p| if (p.id == id) return p;
+        return null;
+    }
+
+    fn lookup(ptr: *anyopaque, want: *const pc.Want) ?pc.Point {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        t.wanted = want.*;
+        var best: ?*Pt = null;
+        for (t.points.items) |*p| {
+            if (p.key.len > want.key.len or !std.mem.eql(u32, p.key, want.key[0..p.key.len])) continue;
+            if (!t.lax and (p.at <= want.beyond or p.at > want.max_at or (want.grid > 0 and p.at % want.grid != 0))) continue;
+            if (!t.lax and want.starts.len > 0 and std.mem.indexOfScalar(u32, want.starts, p.at) == null) continue;
+            if (best == null or p.at > best.?.at) best = p;
+        }
+        const p = best orelse {
+            t.c.compatible_misses += 1;
+            return null;
+        };
+        return .{ .id = p.id, .at = p.at, .tokens = @intCast(p.key.len), .bytes = p.size, .group = p.group, .shared = p.shared };
+    }
+
+    fn isFull(ptr: *anyopaque) bool {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        t.fulls += 1;
+        if (t.full == 0) return false;
+        t.full -= 1;
+        return true;
+    }
+
+    fn check(ptr: *anyopaque, _: *const pc.Point) anyerror!void {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        try t.unfitted();
+    }
+
+    /// The next `unfit` refusal, if any is left (lock held).
+    fn unfitted(t: *FakeTier) !void {
+        if (t.unfit == 0) return;
+        t.unfit -= 1;
+        t.refused += 1;
+        return t.unfit_err;
+    }
+
+    fn begin(ptr: *anyopaque, p: *const pc.Point) anyerror!u64 {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        t.begins += 1;
+        try t.unfitted();
+        if (t.refuse > 0) {
+            t.refuse -= 1;
+            t.refused += 1;
+            return t.refuse_err;
+        }
+        if (t.busy_err) |err| if (t.jobs.items.len > 0) {
+            t.refused += 1;
+            return err;
+        };
+        if (t.find(p.id) == null) {
+            t.c.presence_refused += 1;
+            return error.PointMissing;
+        }
+        const id = t.next_job;
+        t.next_job += 1;
+        try t.jobs.append(t.gpa, .{ .id = id, .point = p.id, .left = @max(t.polls, 1), .total = @max(t.polls, 1), .fail = t.fail_next });
+        t.fail_next = null;
+        return id;
+    }
+
+    fn job(t: *FakeTier, id: u64) ?usize {
+        for (t.jobs.items, 0..) |j, i| if (j.id == id) return i;
+        return null;
+    }
+
+    fn poll(ptr: *anyopaque, id: u64, _: u64) pc.Poll {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        t.polled += 1;
+        const i = t.job(id) orelse {
+            t.misuse += 1;
+            return .{ .failed = error.NoSuchJob };
+        };
+        const j = &t.jobs.items[i];
+        if (j.fail) |err| {
+            _ = t.jobs.orderedRemove(i);
+            t.c.read_failed += 1;
+            if (err == error.CrcMismatch) t.c.crc_errors += 1;
+            return .{ .failed = err };
+        }
+        if (!t.gate.load(.acquire)) return .{ .pending = .{ .done = j.total - j.left, .total = j.total } };
+        j.left -= 1;
+        if (j.left > 0) return .{ .pending = .{ .done = j.total - j.left, .total = j.total } };
+        const pid = j.point;
+        _ = t.jobs.orderedRemove(i);
+        const p = t.find(pid) orelse return .{ .failed = error.PointMissing };
+        const saved = t.codec.unpack(t.codec.ctx, p.bytes) catch |err| return .{ .failed = err };
+        t.c.reads += 1;
+        t.c.read_bytes += p.bytes.len;
+        return .{ .ready = .{ .saved = saved, .bytes = p.size, .lineage = p.lineage } };
+    }
+
+    fn cancel(ptr: *anyopaque, id: u64) void {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        t.cancels += 1;
+        const i = t.job(id) orelse {
+            t.misuse += 1;
+            return;
+        };
+        _ = t.jobs.orderedRemove(i);
+    }
+
+    fn keep(ptr: *anyopaque, w: *const pc.Write) ?u64 {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        if (w.at < t.min_tokens) return null;
+        const key = t.gpa.dupe(u32, w.key) catch return null;
+        const lin = t.gpa.dupe(pc.Fork, w.lineage) catch {
+            t.gpa.free(key);
+            return null;
+        };
+        const id = t.next_id;
+        t.queue.append(t.gpa, .{ .id = id, .key = key, .at = w.at, .group = w.group, .shared = w.shared, .saved = w.saved, .parent = w.parent, .fork = w.fork, .size = w.bytes, .lineage = lin }) catch {
+            t.gpa.free(key);
+            t.gpa.free(lin);
+            return null;
+        };
+        t.next_id += 1;
+        t.c.writes_queued += 1;
+        return id;
+    }
+
+    /// Queued write `i` published (its state packed now).
+    fn publish(t: *FakeTier, i: usize) void {
+        const q = t.queue.orderedRemove(i);
+        const bytes = t.codec.pack(t.codec.ctx, t.gpa, q.saved) catch {
+            t.gpa.free(q.key);
+            t.gpa.free(q.lineage);
+            t.c.writes_failed += 1;
+            return;
+        };
+        t.points.append(t.gpa, .{ .id = q.id, .key = q.key, .at = q.at, .group = q.group, .shared = q.shared, .bytes = bytes, .parent = q.parent, .fork = q.fork, .size = q.size, .lineage = q.lineage }) catch {
+            t.gpa.free(q.key);
+            t.gpa.free(q.lineage);
+            t.gpa.free(bytes);
+            t.c.writes_failed += 1;
+            return;
+        };
+        t.c.writes_committed += 1;
+        t.c.written_bytes += bytes.len;
+    }
+
+    fn release(ptr: *anyopaque, id: u64, _: pc.Saved) void {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        t.released += 1;
+        for (t.queue.items, 0..) |q, i| if (q.id == id) {
+            t.c.forced_staging += 1;
+            return t.publish(i);
+        };
+    }
+
+    fn share(ptr: *anyopaque, id: u64) void {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        t.shared_marks += 1;
+        if (t.find(id)) |p| p.shared = true;
+        for (t.queue.items) |*q| if (q.id == id) {
+            q.shared = true;
+        };
+    }
+
+    fn touch(ptr: *anyopaque, _: u64) void {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        t.touched += 1;
+    }
+
+    fn forget(ptr: *anyopaque, id: u64) void {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        t.forgotten += 1;
+        for (t.queue.items, 0..) |q, i| if (q.id == id) { // a write still queued is cancelled, never published
+            t.gpa.free(q.key);
+            t.gpa.free(q.lineage);
+            _ = t.queue.orderedRemove(i);
+            t.c.writes_cancelled += 1;
+            return;
+        };
+        for (t.points.items, 0..) |p, i| if (p.id == id) {
+            t.gpa.free(p.key);
+            t.gpa.free(p.bytes);
+            t.gpa.free(p.lineage);
+            _ = t.points.orderedRemove(i);
+            return;
+        };
+    }
+
+    fn pump(ptr: *anyopaque, _: u64) void {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        while (t.queue.items.len > 0) t.publish(0);
+    }
+
+    fn busy(ptr: *anyopaque) bool {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        return t.queue.items.len > 0;
+    }
+
+    fn flush(ptr: *anyopaque, _: u64) u64 {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        t.flushed += 1;
+        if (!t.stuck) {
+            while (t.queue.items.len > 0) t.publish(0); // (pump's, under this lock)
+            return 0;
+        }
+        const left = t.queue.items.len;
+        for (t.queue.items) |q| {
+            t.gpa.free(q.key);
+            t.gpa.free(q.lineage);
+        }
+        t.queue.clearRetainingCapacity();
+        t.c.writes_cancelled += left;
+        return left;
+    }
+
+    fn counts(ptr: *anyopaque, out: []pc.TierCounts) usize {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        var c = t.c;
+        c.points = t.points.items.len;
+        c.writes_pending = t.queue.items.len;
+        const n = @min(out.len, t.ranks);
+        for (out[0..n], 0..) |*o, r| {
+            o.* = c;
+            if (r > 0) o.crc_errors = r;
+        }
+        return n;
+    }
+};
diff --git a/zig/src/core/prompt_cache_tier_test.zig b/zig/src/core/prompt_cache_tier_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..1854f19fab4f807304c722de16468964f89af880
--- /dev/null
+++ b/zig/src/core/prompt_cache_tier_test.zig
@@ -0,0 +1,881 @@
+//! The prompt cache's durable tier (wojo's GLM 0110, as the DeepSeek port's core has it): a fake in-memory tier, and a
+//! family whose state is a running hash of the prompt, so a restored state equals a fresh pass exactly when it should.
+//! (0111's continuation cases are prompt_cache_chat_test.zig's.)
+const std = @import("std");
+const pc = @import("prompt_cache.zig");
+const modes = @import("cache_modes.zig");
+const FakeTier = @import("prompt_cache_fake_tier.zig").FakeTier;
+const Allocator = std.mem.Allocator;
+const Store = pc.Store;
+const gpa = std.testing.allocator;
+
+/// A family over host memory: its live state is a position and a running hash of the prompt's tokens.
+const Sum = struct {
+    at: u32 = 0,
+    sum: u64 = 0,
+    live: usize = 0,
+    stale: ?pc.Saved = null, // `usable` refuses this state
+
+    const State = struct { at: u32, sum: u64 };
+
+    fn snapshots(f: *Sum) pc.Snapshots {
+        return .{ .ptr = f, .vtable = &.{ .bytes = bytesFn, .save = saveFn, .restore = restoreFn, .drop = dropFn, .usable = usableFn } };
+    }
+    fn of(ptr: *anyopaque) *Sum {
+        return @ptrCast(@alignCast(ptr));
+    }
+    fn bytesFn(_: *anyopaque, at: u32) u64 {
+        return 100 + @as(u64, at);
+    }
+    fn saveFn(ptr: *anyopaque, _: ?*anyopaque, at: u32) anyerror!pc.Saved {
+        const f = of(ptr);
+        if (f.at != at) return error.NotAtMark;
+        const st = try gpa.create(State);
+        st.* = .{ .at = f.at, .sum = f.sum };
+        f.live += 1;
+        return st;
+    }
+    fn restoreFn(ptr: *anyopaque, _: ?*anyopaque, saved: pc.Saved) anyerror!void {
+        const st: *State = @ptrCast(@alignCast(saved));
+        of(ptr).at = st.at;
+        of(ptr).sum = st.sum;
+    }
+    fn dropFn(ptr: *anyopaque, saved: pc.Saved) void {
+        of(ptr).live -= 1;
+        gpa.destroy(@as(*State, @ptrCast(@alignCast(saved))));
+    }
+    fn usableFn(ptr: *anyopaque, saved: pc.Saved, _: u32) bool {
+        return of(ptr).stale != saved;
+    }
+    /// The live state run on to `to` tokens of `prompt` (a fresh pass's arithmetic).
+    fn feed(f: *Sum, prompt: []const u32, to: u32) void {
+        for (prompt[f.at..to]) |t| f.sum = f.sum *% 31 +% t;
+        f.at = to;
+    }
+    fn reset(f: *Sum) void {
+        f.at = 0;
+        f.sum = 0;
+    }
+    fn fresh(prompt: []const u32, to: u32) u64 {
+        var x: Sum = .{};
+        x.feed(prompt, to);
+        return x.sum;
+    }
+
+    fn codec(f: *Sum) @import("prompt_cache_fake_tier.zig").Codec {
+        return .{ .ctx = f, .pack = pack, .unpack = unpack };
+    }
+    fn pack(_: *anyopaque, a: Allocator, saved: pc.Saved) anyerror![]u8 {
+        return a.dupe(u8, std.mem.asBytes(@as(*State, @ptrCast(@alignCast(saved)))));
+    }
+    fn unpack(ctx: *anyopaque, bytes: []const u8) anyerror!pc.Saved {
+        if (bytes.len != @sizeOf(State)) return error.SizeMismatch;
+        const st = try gpa.create(State);
+        @memcpy(std.mem.asBytes(st), bytes);
+        of(ctx).live += 1;
+        return st;
+    }
+};
+
+fn seq(comptime n: usize, base: u32) [n]u32 {
+    var out: [n]u32 = undefined;
+    for (&out, 0..) |*t, i| t.* = base + @as(u32, @intCast(i));
+    return out;
+}
+
+/// Keep `prompt`'s state at `at` as a pass would: the family stands there.
+fn keepAt(s: *Store, f: *Sum, prompt: []const u32, at: u32, info: pc.KeepInfo) bool {
+    return keepSpans(s, f, prompt, at, &.{}, info);
+}
+
+/// `keepAt` for a request that decoded the rows `spans` names.
+fn keepSpans(s: *Store, f: *Sum, prompt: []const u32, at: u32, spans: []const modes.Span, info: pc.KeepInfo) bool {
+    f.reset();
+    f.feed(prompt, at);
+    return s.keepWith(prompt, at, null, &.{}, spans, info);
+}
+
+/// Poll `r` until it is no longer pending.
+fn settle(s: *Store, r: *pc.Restore) pc.Restored {
+    while (true) {
+        const st = s.restorePoll(r, 1000);
+        if (st != .pending) return st;
+    }
+}
+
+test "without a tier the store asks nothing and counts nothing new" {
+    var f: Sum = .{};
+    var s = Store.init(gpa, f.snapshots(), .{ .min_prompt = 0 }, 1 << 20);
+    defer s.deinit();
+    const p = seq(40, 1);
+    try std.testing.expect(keepAt(&s, &f, &p, 16, .{}));
+    const pr = s.probe(&p, &.{}, &.{});
+    try std.testing.expectEqual(@as(u32, 16), pr.memory.?.at);
+    try std.testing.expect(pr.durable == null);
+    try std.testing.expectEqual(pc.TierStats{}, s.tier_stats);
+    try std.testing.expect(s.entries.items[0].point == null and s.entries.items[0].lineage.len == 0);
+    try std.testing.expectEqual(@as(u64, 0), s.tierFlush(0));
+    try std.testing.expect(s.tierCounts() == null and !s.busy());
+    try std.testing.expectEqual(@as(usize, 0), (try s.passLineage(null)).len);
+    try std.testing.expectEqual(@as(u64, 1 << 20) - 116, s.room());
+}
+
+test "a keep enqueues its write with conversation and lineage; a state that left memory restores, equal to a fresh pass" {
+    var f: Sum = .{};
+    var tier: FakeTier = .{ .gpa = gpa, .codec = f.codec(), .polls = 3 };
+    defer tier.deinit();
+    var s = Store.init(gpa, f.snapshots(), .{ .min_prompt = 0 }, 150); // room for one state
+    defer s.deinit();
+    s.setTier(tier.tier(), 7);
+    const a = seq(40, 1);
+    const chat = s.join(&a, null, true).chat;
+    const g = s.groupOf(chat);
+    try std.testing.expectEqual(@as(u64, 7 << 32) + 1, g); // the process's seed above the chat id
+    try std.testing.expect(keepAt(&s, &f, &a, 16, .{ .chat = chat }));
+    try std.testing.expectEqual(@as(usize, 1), tier.queue.items.len);
+    try std.testing.expectEqual(g, tier.queue.items[0].group);
+    try std.testing.expectEqual(@as(?u64, null), tier.queue.items[0].parent);
+    s.pump(1000);
+    try std.testing.expectEqual(@as(usize, 1), tier.points.items.len);
+    const b = seq(40, 1000); // another conversation's state takes the only room
+    try std.testing.expect(keepAt(&s, &f, &b, 16, .{}));
+    try std.testing.expectEqual(@as(usize, 1), s.entries.items.len);
+    var a2: [48]u32 = undefined;
+    @memcpy(a2[0..40], &a);
+    for (a2[40..], 0..) |*t, i| t.* = 500 + @as(u32, @intCast(i));
+    const pr = s.probe(&a2, &.{}, &.{});
+    try std.testing.expect(pr.memory == null);
+    const p = pr.durable.?;
+    try std.testing.expectEqual(@as(u32, 16), p.at);
+    try std.testing.expectEqual(g, p.group);
+    const r = try s.restoreBegin(p, &a2);
+    try std.testing.expectEqual(pc.Restored.pending, s.restorePoll(r, 1000));
+    try std.testing.expectEqual(pc.Restored.adopted, settle(&s, r));
+    try std.testing.expectEqual(@as(usize, 0), s.restoring.items.len);
+    const e = s.find(&a2, &.{}, &.{}).?; // the restored state, `b`'s evicted for its room
+    // no conversation's own state: a conversation of its own, as v1 reads one back
+    try std.testing.expect(!e.own and e.point.? == p.id and !e.shared and e.chat != chat and e.chat != 0);
+    try s.family.vtable.restore(s.family.ptr, null, e.saved);
+    f.feed(&a2, 48);
+    try std.testing.expectEqual(Sum.fresh(&a2, 48), f.sum);
+    s.resumed(e, &a2, true);
+    try std.testing.expectEqual(@as(u64, 1), tier.touched);
+    // a later keep of this pass forks the restored point's lineage at the resume point
+    try std.testing.expect(keepAt(&s, &f, &a2, 32, .{ .chat = chat, .parent = e.point, .fork = 16 }));
+    try std.testing.expectEqual(p.id, tier.queue.items[0].parent.?);
+    try std.testing.expectEqual(@as(u32, 16), tier.queue.items[0].fork);
+    try std.testing.expectEqual(@as(u64, 1), s.tier_stats.disk_hits_committed);
+    try std.testing.expectEqual(@as(u64, 16), s.tier_stats.restored_tokens);
+    try std.testing.expectEqual(@as(u64, 1), s.tier_stats.restores_begun);
+    try std.testing.expectEqual(@as(u64, 1), s.tier_stats.disk_hits);
+    try std.testing.expectEqual(@as(u64, 3), s.tier_stats.writes_enqueued);
+}
+
+test "a stale long memory state never shadows a durable point; points off the grid, the starts or the rows left are not offered" {
+    var f: Sum = .{};
+    var tier: FakeTier = .{ .gpa = gpa, .codec = f.codec() };
+    defer tier.deinit();
+    var s = Store.init(gpa, f.snapshots(), .{ .min_prompt = 0, .planned = true, .grid = 8 }, 1 << 20);
+    defer s.deinit();
+    s.setTier(tier.tier(), 0);
+    const a = seq(64, 1);
+    try std.testing.expect(keepAt(&s, &f, &a, 16, .{}));
+    try std.testing.expect(keepAt(&s, &f, &a, 32, .{}));
+    s.pump(0);
+    try std.testing.expect(keepAt(&s, &f, &a, 48, .{})); // memory only (never pumped)
+    // the 48 state goes stale: the lookup takes 32 from memory, and the durable 48 is not on disk yet
+    f.stale = s.entries.items[2].saved;
+    var pr = s.probe(&a, &.{}, &.{});
+    try std.testing.expectEqual(@as(u32, 32), pr.memory.?.at);
+    try std.testing.expect(pr.durable == null);
+    try std.testing.expectEqual(@as(u32, 8), tier.wanted.?.grid); // the family's grid: its request named no starts
+    try std.testing.expectEqual(@as(u32, 56), tier.wanted.?.max_at);
+    s.pump(0);
+    pr = s.probe(&a, &.{}, &.{});
+    try std.testing.expectEqual(@as(u32, 48), pr.durable.?.at); // not shadowed by its stale memory twin
+    // a prompt that ends at 48 leaves no row past it: 32 from memory, no point
+    pr = s.probe(a[0..48], &.{}, &.{});
+    try std.testing.expectEqual(@as(u32, 32), pr.memory.?.at);
+    try std.testing.expect(pr.durable == null);
+    // a lax tier offering off-grid or ineligible points: the store checks them itself
+    tier.lax = true;
+    _ = try tier.put(a[0..20], 20, std.mem.asBytes(&Sum.State{ .at = 20, .sum = 0 }), 0, 0, false);
+    try std.testing.expect(s.probe(a[0..48], &.{}, &.{}).durable == null); // 48 leaves no row of 48
