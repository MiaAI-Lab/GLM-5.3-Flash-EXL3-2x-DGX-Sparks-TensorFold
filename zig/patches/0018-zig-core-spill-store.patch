diff --git a/zig/src/core/spill/slots.zig b/zig/src/core/spill/slots.zig
new file mode 100644
index 0000000000000000000000000000000000000000..07395ba5c2375791e26d157b617b26ce78223da9
--- /dev/null
+++ b/zig/src/core/spill/slots.zig
@@ -0,0 +1,286 @@
+//! Port of wojo's GLM 0110 spill blocks (PR #124; BadAd84's pinned staging ring, f32226b's read-ahead correction):
+//! the store's host staging slots, carved out of caller-owned aligned buffers (pinned host memory on CUDA, allocated
+//! and budgeted by the engine before it sizes its pool). The store never allocates, pins or frees staging; it only
+//! hands slots out and takes them back. One partition each for block writes, block reads, queued small states and
+//! restores' small states, so a backlog of one never starves another.
+const std = @import("std");
+const fsio = @import("fsio.zig");
+const mutants = @import("mutants.zig");
+const Allocator = std.mem.Allocator;
+
+pub const alignment = fsio.alignment;
+pub const Buffer = fsio.Buffer;
+
+pub const Pool = enum(u2) { write, read, small, restore };
+pub const pools = [_]Pool{ .write, .read, .small, .restore };
+
+/// A slot: its partition and index (stable for the store's life; a family keeps one CUDA event per slot).
+pub const Slot = packed struct(u32) {
+    pool: Pool,
+    index: u30,
+
+    pub fn eql(a: Slot, b: Slot) bool {
+        return @as(u32, @bitCast(a)) == @as(u32, @bitCast(b));
+    }
+};
+
+/// The caller's buffers, by partition. Each must start on a 4 KiB boundary; slots are carved whole out of each one.
+pub const Staging = struct {
+    write: []const Buffer = &.{},
+    read: []const Buffer = &.{},
+    small: []const Buffer = &.{},
+    restore: []const Buffer = &.{},
+
+    fn of(s: Staging, p: Pool) []const Buffer {
+        return switch (p) {
+            .write => s.write,
+            .read => s.read,
+            .small => s.small,
+            .restore => s.restore,
+        };
+    }
+};
+
+/// Slots of `per` bytes (a multiple of 4 KiB) that fit whole in `buffers`.
+pub fn carve(buffers: []const Buffer, per: usize) usize {
+    std.debug.assert(per > 0 and per % alignment == 0);
+    var n: usize = 0;
+    for (buffers) |b| n += b.len / per;
+    return n;
+}
+
+/// PR 124's accounting: the bytes still to allocate for `want` slots of `per` when `preallocated` buffers (already
+/// charged, allocated before the pool was sized) hold what they hold. Preallocated storage is reused, never
+/// charged again; only the shortfall is.
+pub fn extraBytes(preallocated: []const Buffer, per: usize, want: usize) usize {
+    const have = if (mutants.on(.read_ahead_charges_preallocate)) 0 else carve(preallocated, per);
+    return if (have >= want) 0 else (want - have) * per;
+}
+
+/// A split of an aggregate staging cap (bytes) among the partitions: `restores` restore small slots and `smalls`
+/// queued small states first (each holds a whole small state), the rest shared by block writes and reads.
+pub const Plan = struct {
+    write: usize,
+    read: usize,
+    small: usize,
+    restore: usize,
+    block_slot: usize,
+    small_slot: usize,
+
+    pub fn bytes(p: Plan) u64 {
+        return @as(u64, p.write + p.read) * p.block_slot + @as(u64, p.small + p.restore) * p.small_slot;
+    }
+
+    pub fn of(p: Plan, pool: Pool) usize {
+        return switch (pool) {
+            .write => p.write,
+            .read => p.read,
+            .small => p.small,
+            .restore => p.restore,
+        };
+    }
+};
+
+pub fn plan(cap: u64, block_bytes: u64, small_bytes: u64, smalls: usize, restores: usize) error{StagingTooSmall}!Plan {
+    const bs = std.mem.alignForward(u64, @max(block_bytes, 1), alignment);
+    const ss = std.mem.alignForward(u64, @max(small_bytes, 1), alignment);
+    const fixed = ss * (smalls + restores);
+    if (fixed + 4 * bs > cap) return error.StagingTooSmall;
+    const blocks = (cap - fixed) / bs;
+    const write = blocks / 2;
+    return .{ .write = @intCast(write), .read = @intCast(blocks - write), .small = smalls, .restore = restores, .block_slot = @intCast(bs), .small_slot = @intCast(ss) };
+}
+
+/// The slots of every partition. Not thread-safe: the store holds its lock around every call.
+pub const Slots = struct {
+    mem: [4][]Buffer = @splat(&.{}),
+    free: [4]std.ArrayList(u30) = @splat(.empty),
+    held: [4]usize = @splat(0),
+    peak: [4]usize = @splat(0), // each partition's own peak (slots)
+    peak_bytes: u64 = 0, // the most every partition held at once (bytes)
+    per: [4]usize = @splat(0),
+    owner: [4][]u64 = @splat(&.{}), // what holds each slot (the store's job id; 0: free)
+
+    pub fn init(gpa: Allocator, staging: Staging, block_slot: usize, small_slot: usize) !Slots {
+        var s: Slots = .{};
+        errdefer s.deinit(gpa);
+        for (pools) |p| {
+            const per = if (p == .write or p == .read) block_slot else small_slot;
+            const i = @intFromEnum(p);
+            s.per[i] = per;
+            const bufs = staging.of(p);
+            for (bufs) |b| if (@intFromPtr(b.ptr) % alignment != 0) return error.UnalignedStaging;
+            const n = carve(bufs, per);
+            if (n > std.math.maxInt(u30)) return error.TooManySlots;
+            s.mem[i] = try gpa.alloc(Buffer, n);
+            s.owner[i] = try gpa.alloc(u64, n);
+            @memset(s.owner[i], 0);
+            var k: usize = 0;
+            for (bufs) |b| {
+                var off: usize = 0;
+                while (off + per <= b.len) : (off += per) {
+                    s.mem[i][k] = @alignCast(b[off..][0..per]);
+                    k += 1;
+                }
+            }
+            try s.free[i].ensureTotalCapacity(gpa, n);
+            var j: usize = n;
+            while (j > 0) {
+                j -= 1;
+                s.free[i].appendAssumeCapacity(@intCast(j)); // popped lowest first
+            }
+        }
+        return s;
+    }
+
+    pub fn deinit(s: *Slots, gpa: Allocator) void {
+        for (pools) |p| {
+            const i = @intFromEnum(p);
+            gpa.free(s.mem[i]);
+            gpa.free(s.owner[i]);
+            s.free[i].deinit(gpa);
+        }
+        s.* = undefined;
+    }
+
+    pub fn count(s: *const Slots, p: Pool) usize {
+        return s.mem[@intFromEnum(p)].len;
+    }
+
+    pub fn available(s: *const Slots, p: Pool) usize {
+        return s.free[@intFromEnum(p)].items.len;
+    }
+
+    pub fn take(s: *Slots, p: Pool, owner: u64) ?Slot {
+        const i = @intFromEnum(p);
+        const k = s.free[i].pop() orelse return null;
+        std.debug.assert(s.owner[i][k] == 0);
+        s.owner[i][k] = owner;
+        s.held[i] += 1;
+        s.peak[i] = @max(s.peak[i], s.held[i]);
+        s.peak_bytes = @max(s.peak_bytes, s.heldBytes());
+        return .{ .pool = p, .index = k };
+    }
+
+    pub fn give(s: *Slots, slot: Slot) void {
+        const i = @intFromEnum(slot.pool);
+        std.debug.assert(s.owner[i][slot.index] != 0); // a slot returned twice
+        s.owner[i][slot.index] = 0;
+        s.held[i] -= 1;
+        s.free[i].appendAssumeCapacity(slot.index);
+    }
+
+    pub fn holder(s: *const Slots, slot: Slot) u64 {
+        return s.owner[@intFromEnum(slot.pool)][slot.index];
+    }
+
+    pub fn bytes(s: *const Slots, slot: Slot) Buffer {
+        return s.mem[@intFromEnum(slot.pool)][slot.index];
+    }
+
+    /// Bytes held now, every partition.
+    pub fn heldBytes(s: *const Slots) u64 {
+        var n: u64 = 0;
+        for (0..4) |i| n += @as(u64, s.held[i]) * s.per[i];
+        return n;
+    }
+
+    /// The most bytes held at once over every partition (never more than the slots carved: the staging cap). Not
+    /// the sum of the partitions' own peaks, which were not reached together.
+    pub fn peakBytes(s: *const Slots) u64 {
+        return s.peak_bytes;
+    }
+
+    /// A partition's own peak, in slots.
+    pub fn peakOf(s: *const Slots, p: Pool) usize {
+        return s.peak[@intFromEnum(p)];
+    }
+};
+
+// -- tests ---------------------------------------------------------------------------------------------------------
+const testing = std.testing;
+
+test "read-ahead accounting: preallocated buffers are kept and only the shortfall is charged" {
+    const gpa = testing.allocator;
+    const per = 3 * alignment;
+    // a preallocated buffer that holds two and a half slots: two carved, its half slot unused
+    const pre = try gpa.alignedAlloc(u8, .fromByteUnits(alignment), 2 * per + per / 2 + alignment / 2);
+    defer gpa.free(pre);
+    const bufs = [_]Buffer{pre};
+    try testing.expectEqual(@as(usize, 2), carve(&bufs, per));
+    try testing.expectEqual(@as(usize, 5 * per), extraBytes(&bufs, per, 7));
+    try testing.expectEqual(@as(usize, 0), extraBytes(&bufs, per, 2));
+    // the extra piece the caller allocates plus the preallocated one carve at least the slots asked
+    const extra = try gpa.alignedAlloc(u8, .fromByteUnits(alignment), extraBytes(&bufs, per, 7));
+    defer gpa.free(extra);
+    const both = [_]Buffer{ pre, extra };
+    var s = try Slots.init(gpa, .{ .read = &both }, per, alignment);
+    defer s.deinit(gpa);
+    try testing.expectEqual(@as(usize, 7), s.count(.read));
+    // every slot lies inside one of the caller's buffers, aligned, disjoint
+    var seen: usize = 0;
+    for (0..7) |k| {
+        const b = s.bytes(.{ .pool = .read, .index = @intCast(k) });
+        try testing.expect(@intFromPtr(b.ptr) % alignment == 0 and b.len == per);
+        const in_pre = @intFromPtr(b.ptr) >= @intFromPtr(pre.ptr) and @intFromPtr(b.ptr) + per <= @intFromPtr(pre.ptr) + pre.len;
+        const in_extra = @intFromPtr(b.ptr) >= @intFromPtr(extra.ptr) and @intFromPtr(b.ptr) + per <= @intFromPtr(extra.ptr) + extra.len;
+        try testing.expect(in_pre or in_extra);
+        if (in_pre) seen += 1;
+    }
+    try testing.expectEqual(@as(usize, 2), seen);
+}
+
+test "slots: taken and given back, peaks and holders tracked, partitions independent" {
+    const gpa = testing.allocator;
+    const a = try gpa.alignedAlloc(u8, .fromByteUnits(alignment), 4 * alignment);
+    defer gpa.free(a);
+    const b = try gpa.alignedAlloc(u8, .fromByteUnits(alignment), 2 * alignment);
+    defer gpa.free(b);
+    var s = try Slots.init(gpa, .{ .write = &.{a}, .small = &.{b} }, alignment, 2 * alignment);
+    defer s.deinit(gpa);
+    try testing.expectEqual(@as(usize, 4), s.count(.write));
+    try testing.expectEqual(@as(usize, 1), s.count(.small));
+    try testing.expectEqual(@as(usize, 0), s.count(.read));
+    const x = s.take(.write, 7).?;
+    const y = s.take(.write, 8).?;
+    try testing.expectEqual(@as(u64, 7), s.holder(x));
+    try testing.expect(s.take(.read, 1) == null);
+    const z = s.take(.small, 9).?;
+    try testing.expect(s.take(.small, 9) == null);
+    try testing.expectEqual(@as(u64, 2 * alignment + 2 * alignment), s.heldBytes());
+    s.give(x);
+    s.give(y);
+    s.give(z);
+    try testing.expectEqual(@as(u64, 0), s.heldBytes());
+    try testing.expectEqual(@as(u64, 4 * alignment), s.peakBytes());
+}
+
+test "slots: the peak is what was held at once, not the partitions' peaks summed" {
+    const gpa = testing.allocator;
+    const a = try gpa.alignedAlloc(u8, .fromByteUnits(alignment), 4 * alignment);
+    defer gpa.free(a);
+    const b = try gpa.alignedAlloc(u8, .fromByteUnits(alignment), 4 * alignment);
+    defer gpa.free(b);
+    var s = try Slots.init(gpa, .{ .write = &.{a}, .read = &.{b} }, alignment, alignment);
+    defer s.deinit(gpa);
+    // every write slot, given back, then every read slot: never more than four slots at once
+    var held: [4]Slot = undefined;
+    for (&held, 0..) |*x, k| x.* = s.take(.write, k + 1).?;
+    for (held) |x| s.give(x);
+    for (&held, 0..) |*x, k| x.* = s.take(.read, k + 1).?;
+    try testing.expectEqual(@as(u64, 4 * alignment), s.peakBytes());
+    try testing.expectEqual(@as(usize, 4), s.peakOf(.write));
+    try testing.expectEqual(@as(usize, 4), s.peakOf(.read));
+    s.give(held[0]);
+    _ = s.take(.write, 9).?; // (four again)
+    try testing.expectEqual(@as(u64, 4 * alignment), s.peakBytes());
+}
+
+test "plan: small states first, the rest split between writes and reads" {
+    const p = try plan(128 << 20, 1_822_720, 6_684_672, 4, 2);
+    try testing.expectEqual(@as(usize, 1_822_720), p.block_slot); // (445 pages: already aligned)
+    try testing.expectEqual(@as(usize, 6_684_672), p.small_slot);
+    try testing.expect(p.bytes() <= 128 << 20);
+    try testing.expect(p.write >= 2 and p.read >= 2 and p.small == 4 and p.restore == 2);
+    try testing.expectError(error.StagingTooSmall, plan(8 << 20, 1_822_720, 6_684_672, 4, 2));
+}
diff --git a/zig/src/core/spill/store.zig b/zig/src/core/spill/store.zig
new file mode 100644
index 0000000000000000000000000000000000000000..fca7028b74e78326486acdbee9db91b48ca3f988
--- /dev/null
+++ b/zig/src/core/spill/store.zig
@@ -0,0 +1,2922 @@
+//! Port of wojo's GLM 0088 (PR #78) and 0110 (PR #124; BadAd84's block layout, lineage, write-at-keep staging ring,
+//! release and fsync order; eviction by conversation for issue #122, reported by xiepengqi) spill tier: the native,
+//! family-neutral, GPU-free spill v2 store of one rank.
+//!
+//! A kept prompt state is its rows, in blocks of `limits.block_tokens` tokens of the family's packed per-rank planes,
+//! plus named small-state sections. The family packs and unpacks bytes on its CUDA stream; this store never touches
+//! the device, never allocates staging and issues no CUDA call. It hands the engine thread aligned host slots out of
+//! the caller's staging buffers, takes them back when the engine says the device copy into or out of them is done,
+//! and does the disk work on its own threads:
+//!
+//! - writes (`keep` at an eligible keep, `stage` between rounds, `staged`/`captured` once the engine's events
+//!   complete): each missing block under a unique temporary name, its CRC-32 and SHA-256 computed, fsynced, renamed
+//!   (or hard-linked to a block with equal bytes), then the point's ids and small state, the directories fsynced, and
+//!   the manifest last. `guard` stages or cancels unpublished points before their source rows change.
+//! - reads (`lookup`, `beginRead`, `readReady`/`readRelease` between rounds, `readAwait` for a follower's bounded
+//!   wait that recycles slots while it waits, `endRead`): reader threads read and check blocks into read slots ahead
+//!   of the engine's copies; damage to a block invalidates every name linked to its inode, a missing name only itself.
+//! - room: a cap, a free-disk floor and an optional per-conversation quota, made in 0110's order: old turns past
+//!   retention on a conversation's active path, abandoned forks, whole conversations by last use, shared prefixes
+//!   last. A conversation is the branch below the deepest shared point a state extends, merged with any states that
+//!   carry the same 0111 `group`.
+//! - recovery at open: temporaries deleted, manifests parsed with fixed bounds, points with any missing or wrongly
+//!   sized file dropped, references rebuilt, unreferenced blocks collected. An exclusive lock keeps a second process
+//!   from scanning or deleting a live store.
+//!
+//! Every public function runs on the engine thread unless it says otherwise. Engine-thread calls take the store's
+//! lock only briefly and do no file I/O (deletions, touches and metadata rewrites are queued to the writer).
+const std = @import("std");
+const builtin = @import("builtin");
+const c = std.c;
+const format = @import("format.zig");
+const fsio = @import("fsio.zig");
+const slots_mod = @import("slots.zig");
+const direct_io = @import("../direct_io.zig");
+const mutants = @import("mutants.zig");
+const mut = mutants.on;
+const Allocator = std.mem.Allocator;
+
+pub const Digest = format.Digest;
+pub const Lineage = format.Lineage;
+pub const Media = format.Media;
+pub const Slot = slots_mod.Slot;
+pub const Staging = slots_mod.Staging;
+pub const Hooks = fsio.Hooks;
+
+/// The logical rows a write reads from: the family's extent and its generation. A later occupant of the same base
+/// has another generation, so a delayed staging can never attach to it.
+pub const Source = struct {
+    id: u64,
+    generation: u64,
+
+    pub fn eql(a: Source, b: Source) bool {
+        return a.id == b.id and a.generation == b.generation;
+    }
+};
+
+pub const Config = struct {
+    /// The spill directory (a local NVMe per rank; never the shared model mount). Must exist.
+    root: [:0]const u8,
+    /// The family's namespace prefix: the store is `<root>/<prefix><compat:16 hex>/`, and open prunes only other
+    /// names of exactly that shape, so families sharing a root never prune each other's stores. GLM's is
+    /// `glm-spill-`. None may begin with `native-spill-` or `spill-` (DeepSeek's native store and the Python forks
+    /// prune every name under those) or be v1's `tfspill-`. 1 to 32 bytes, no '/'.
+    prefix: []const u8,
+    rank: u32,
+    /// The agreed compatibility digest (`format.compatDigest` over the common digest every rank exchanged).
+    /// The family's startup agreement exchanges the common digest and the ordered per-rank digests and refuses
+    /// differing configurations before any spill collective; this store only trusts what it is given.
+    compat: Digest,
+    /// Written into every manifest; a point of another layout is foreign here (owner_sharded under KV sharding).
+    owner_layout: format.OwnerLayout = .replicated,
+    limits: format.Limits,
+    /// Bytes this rank's store may hold.
+    cap_bytes: u64,
+    /// No write leaves less than this free on the store's file system.
+    floor_bytes: u64 = 50 << 30,
+    /// A conversation holding more than this fraction of the cap trims its own old turns and forks first (0: off).
+    quota: f64 = 0,
+    /// Newest states kept on a conversation's active path (0: every turn until room is needed).
+    turns: u32 = 4,
+    /// Shorter states are not written.
+    min_tokens: u32 = 8192,
+    /// Bytes of unpublished writes (rows still in device memory, queued staging) past which a keep is refused.
+    backlog_bytes: u64 = 16 << 30,
+    /// The caller's staging buffers (block slots of `limits.block_bytes`, small slots of `limits.max_small_bytes`).
+    staging: Staging,
+    readers: u32 = 4,
+    /// Restores at once (each holds a restore slot for its small state).
+    max_reads: u32 = 4,
+    direct: bool = true,
+    /// Other compat namespaces kept at open, newest first (a live one, still locked, is never touched).
+    keep_builds: u32 = 1,
+    hooks: Hooks = .{},
+};
+
+pub const SectionSpec = struct { name: []const u8, len: u64 };
+
+/// What `keep` stores.
+pub const Keep = struct {
+    /// Canonical key ids of [0, at) (the prompt cache's keyed ids, picture keys included).
+    keyed: []const u32,
+    /// The raw ids when they differ from `keyed` (pictures), else null.
+    raw: ?[]const u32 = null,
+    media: []const Media = &.{},
+    lineage: Lineage,
+    origin: ?format.Origin = null,
+    shared: bool = false,
+    group: u64 = 0,
+    sections: []const SectionSpec,
+    /// Bytes of the last block when `keyed.len` is not a whole number of blocks (captured now: a mutable tail).
+    tail_bytes: u64 = 0,
+    source: Source,
+};
+
+pub const JobId = u64;
+pub const ReadId = u64;
+
+pub const Queued = struct {
+    job: JobId,
+    /// The small state's bytes: the caller fills each section at its offset (asynchronously), then `captured`.
+    small: []u8,
+    sections: []const format.Section,
+    /// The tail block's bytes when the point has a tail (filled with the small state, before `captured`).
+    tail: ?[]u8 = null,
+};
+
+pub const KeepResult = union(enum) {
+    queued: Queued,
+    /// Stored or on its way already (a shared request made it shared).
+    stored,
+    short,
+    no_space,
+    no_staging,
+    backlog,
+    invalid,
+};
+
+/// One block to pack into `dst`: the source's tokens [first, first + tokens), `bytes` long.
+pub const StageReq = struct {
+    ticket: Ticket,
+    source: Source,
+    first: u32,
+    tokens: u32,
+    dst: []u8,
+};
+
+pub const Ticket = struct { job: JobId, index: u32, slot: Slot };
+
+pub const WriteFailure = enum { io, no_space, capture, stage, missing_block, crashed, invalid };
+pub const CancelReason = enum { guard, source_gone, explicit, shutdown };
+
+pub const Completion = union(enum) {
+    published: struct { job: JobId, key: Digest, at: u32 },
+    failed: struct { job: JobId, key: Digest, why: WriteFailure },
+    cancelled: struct { job: JobId, key: Digest, why: CancelReason },
+};
+
+pub const GuardResult = struct { staged: usize = 0, cancelled: usize = 0 };
+
+pub const Query = struct {
+    keyed: []const u32,
+    media: []const Media = &.{},
+    /// Only points longer than this.
+    longer_than: u32 = 0,
+    /// The longest point the caller can resume from (below the prompt's end, and whatever its prompt cache's
+    /// `Store.usable` requires).
+    max_at: u32,
+    /// Points on this grid only (0: any).
+    grid: u32 = 0,
+};
+
+/// A lookup's point: `part` is its lineage's part salt (owner-sharded stores: the part its rows were written from,
+/// where a restore must put them back; null in a replicated store).
+pub const Hit = struct { key: Digest, at: u32, shared: bool, group: u64, part: ?u32 = null };
+
+pub const ReadyBlock = struct { index: u32, first: u32, tokens: u32, data: []const u8, slot: Slot };
+
+pub const ReadStatus = enum { more, waiting, done, failed };
+
+pub const ReadError = enum { missing, damaged, io, small, cancelled };
+
+pub const ReadDone = struct {
+    key: Digest,
+    at: u32,
+    shared: bool,
+    group: u64,
+    has_raw: bool,
+    lineage: Lineage, // gpa-owned
+    origin: ?format.Origin,
+};
+
+pub const SmallView = struct { bytes: []const u8, sections: []const format.Section };
+
+pub const Counters = struct {
+    keeps: u64 = 0,
+    queued: u64 = 0,
+    stored_skips: u64 = 0,
+    short: u64 = 0,
+    no_space: u64 = 0,
+    no_staging: u64 = 0,
+    backlog_refused: u64 = 0,
+    invalid: u64 = 0,
+    committed: u64 = 0,
+    write_failed: u64 = 0,
+    cancelled: u64 = 0,
+    cancelled_guard: u64 = 0,
+    cancelled_source: u64 = 0,
+    staged_blocks: u64 = 0,
+    guard_staged: u64 = 0,
+    written_blocks: u64 = 0,
+    written_bytes: u64 = 0,
+    written_small_bytes: u64 = 0,
+    dedup_blocks: u64 = 0,
+    dedup_bytes: u64 = 0,
+    shared_marked: u64 = 0,
+    shared_rewrites: u64 = 0,
+    pruned_turns: u64 = 0,
+    pruned_forks: u64 = 0,
+    pruned_conversations: u64 = 0,
+    pruned_shared: u64 = 0,
+    trimmed_turns: u64 = 0,
+    quota_trims: u64 = 0,
+    dropped: u64 = 0,
+    disk_lookups: u64 = 0,
+    disk_hits: u64 = 0,
+    read_deferred: u64 = 0,
+    loaded: u64 = 0,
+    loaded_tokens: u64 = 0,
+    loaded_bytes: u64 = 0,
+    load_failed: u64 = 0,
+    crc_errors: u64 = 0,
+    size_errors: u64 = 0,
+    missing_errors: u64 = 0,
+    recovered_points: u64 = 0,
+    recovered_dropped: u64 = 0,
+    /// Points recovery could not read for a reason other than damage (an I/O error, EMFILE, a busy file): left on
+    /// disk untouched, with every unreferenced block, until the next open.
+    recover_deferred: u64 = 0,
+    temps_removed: u64 = 0,
+    orphans_removed: u64 = 0,
+    builds_pruned: u64 = 0,
+    direct_refused: u64 = 0,
+    // gauges
+    points: u64 = 0,
+    blocks: u64 = 0,
+    stored_bytes: u64 = 0,
+    queued_bytes: u64 = 0,
+    pending_jobs: u64 = 0,
+    reads: u64 = 0,
+    staging_bytes: u64 = 0,
+    staging_peak_bytes: u64 = 0,
+    disk_free_bytes: u64 = 0,
+};
+
+const BlockInfo = struct { crc: u32, sha: Digest, ino: u64, bytes: u64 };
+const Inode = struct { bytes: u64, names: std.ArrayList(Digest) = .empty };
+
+const Point = struct {
+    key: Digest,
+    at: u32,
+    shared: bool,
+    group: u64,
+    used: i96,
+    created_ns: i64,
+    has_raw: bool,
+    mutable_tail: bool,
+    lineage: Lineage,
+    origin: ?format.Origin,
+    chain: []Digest,
+    tail: []u32, // ids after the last whole block
+    media: []Media,
+    blocks: []format.BlockRef,
+    sections: []format.Section,
+    ids_bytes: u64,
+    ids_crc: u32,
+    small_bytes: u64,
+    small_crc: u32,
+    files: u64 = 0, // bytes of its .ids, .st and .man
+    pins: u32 = 0, // restores holding it (freed only once none does)
+    removed: bool = false,
+
+    fn deinit(p: *Point, gpa: Allocator) void {
+        p.lineage.deinit(gpa);
+        gpa.free(p.chain);
+        gpa.free(p.tail);
+        gpa.free(p.media);
+        gpa.free(p.blocks);
+        gpa.free(p.sections);
+        gpa.destroy(p);
+    }
+
+    fn whole(p: *const Point) usize {
+        return p.chain.len;
+    }
+};
+
+const WriteJob = struct {
+    id: JobId,
+    point: *Point,
+    source: Source,
+    new: std.ArrayList(u32) = .empty, // block indices this job stages (no tail)
+    next: usize = 0,
+    tail: ?u32 = null,
+    tail_slot: ?Slot = null,
+    outstanding: u32 = 0, // staged blocks not yet written (or given back)
+    engine: u32 = 0, // of those, slots the engine holds (its copy not yet reported by `staged`)
+    small_slot: Slot,
+    capture: enum { pending, ok, failed } = .pending,
+    state: enum { open, publishing, failed, cancelled } = .open,
+    fail: WriteFailure = .io,
+    cancel: CancelReason = .explicit,
+    size: u64,
+    ids: []u8,
+    listed: bool = true, // in the staging FIFO
+    parked: bool = false,
+    shared_at_write: bool = false,
+};
+
+const ReadJob = struct {
+    id: ReadId,
+    point: *Point,
+    total: u32,
+    state: []BState,
+    slot: []Slot,
+    next_assign: u32 = 0,
+    next_hand: u32 = 0,
+    small_slot: Slot,
+    small: enum { queued, ready, failed } = .queued,
+    err: ?ReadError = null,
+    bad: std.ArrayList(Digest) = .empty,
+    lost: std.ArrayList(Digest) = .empty,
+    disk: u32 = 0, // tasks queued or running on readers
+    held: u32 = 0, // read slots it holds (reading, read, or handed and not released)
+    ended: bool = false,
+    t0: i96,
+
+    const BState = enum(u8) { idle, reading, ready, handed, failed };
+};
+
+const Task = union(enum) {
+    block: struct { job: *WriteJob, index: u32, slot: Slot },
+    point: *WriteJob,
+    shared: Digest,
+    touch: struct { key: Digest, ns: i96 },
+    unlink_block: struct { name: Digest, bytes: u64 },
+    unlink_point: struct { key: Digest, bytes: u64 },
+    sync: u64,
+};
+
+const RTask = struct { job: *ReadJob, index: ?u32, slot: Slot };
+
+pub const Store = struct {
+    gpa: Allocator,
+    io: std.Io,
+    cfg: Config,
+    hooks: Hooks,
+    root_fd: c.fd_t = -1,
+    top_fd: c.fd_t = -1,
+    rank_fd: c.fd_t = -1,
+    blocks_fd: c.fd_t = -1,
+    points_fd: c.fd_t = -1,
+    lock: fsio.Lock = .{ .fd = -1 },
+    writer: fsio.Writer = undefined,
+    block_slot: usize,
+    small_slot: usize,
+
+    mutex: std.Io.Mutex = .init,
+    work: std.Io.Condition = .init,
+    rwork: std.Io.Condition = .init,
+    done: std.Io.Condition = .init,
+
+    points: std.AutoHashMapUnmanaged(Digest, *Point) = .empty,
+    have: std.AutoHashMapUnmanaged(Digest, BlockInfo) = .empty,
+    content: std.AutoHashMapUnmanaged(Digest, Digest) = .empty,
+    inodes: std.AutoHashMapUnmanaged(u64, Inode) = .empty,
+    refs: std.AutoHashMapUnmanaged(Digest, u32) = .empty,
+    inflight: std.AutoHashMapUnmanaged(Digest, JobId) = .empty,
+    parent: std.AutoHashMapUnmanaged(Digest, ?Digest) = .empty,
+    reading: std.AutoHashMapUnmanaged(Digest, u32) = .empty,
+    waiting: std.AutoHashMapUnmanaged(Digest, *WriteJob) = .empty,
+    jobs_by_id: std.AutoHashMapUnmanaged(JobId, *WriteJob) = .empty,
+    fifo: std.ArrayList(*WriteJob) = .empty, // jobs with blocks left to stage, oldest first
+    parked: std.ArrayList(*WriteJob) = .empty,
+    tasks: std.ArrayList(Task) = .empty,
+    task_head: usize = 0,
+    rtasks: std.ArrayList(RTask) = .empty,
+    rtask_head: usize = 0,
+    reads: std.ArrayList(*ReadJob) = .empty,
+    read_turn: usize = 0,
+    completions: std.ArrayList(Completion) = .empty,
+    slots: slots_mod.Slots = .{},
+    counters: Counters = .{},
+
+    next_id: u64 = 1,
+    clock: i96 = 0,
+    stored_bytes: u64 = 0,
+    queued_bytes: u64 = 0,
+    disk_free: u64 = 0,
+    pending_free: u64 = 0, // bytes removed from the index whose files the writer has not unlinked yet
+    sync_sent: u64 = 0,
+    sync_done: u64 = 0,
+    busy: u32 = 0, // writer tasks running
+    stopping: bool = false,
+    crashed: bool = false,
+    writer_thread: ?std.Thread = null,
+    reader_threads: std.ArrayList(std.Thread) = .empty,
+
+    // -- open / close --------------------------------------------------------------------------------------------
+    /// Opens (or makes) this rank's store under `cfg.root` and recovers it; fails with StoreBusy, before scanning or
+    /// deleting anything, while another process owns it.
+    pub fn open(gpa: Allocator, io: std.Io, cfg: Config) !*Store {
+        const l = cfg.limits;
+        if (l.block_tokens == 0 or l.block_bytes == 0 or l.max_tokens == 0 or cfg.cap_bytes == 0) return error.BadConfig;
+        if (l.foreign_block_bytes > l.block_bytes or (l.foreign_block_bytes != 0 and cfg.owner_layout != .owner_sharded)) return error.BadConfig;
+        if (!std.math.isFinite(cfg.quota) or cfg.quota < 0 or cfg.quota > 1) return error.BadConfig;
+        if (cfg.prefix.len == 0 or cfg.prefix.len > 32 or std.mem.indexOfAny(u8, cfg.prefix, "/\x00") != null) return error.BadConfig;
+        const s = try gpa.create(Store);
+        s.* = .{
+            .gpa = gpa,
+            .io = io,
+            .cfg = cfg,
+            .hooks = cfg.hooks,
+            .block_slot = std.mem.alignForward(usize, @intCast(l.block_bytes), fsio.alignment),
+            .small_slot = std.mem.alignForward(usize, @intCast(@max(l.max_small_bytes, 1)), fsio.alignment),
+        };
+        s.writer = fsio.Writer.init(&s.hooks, cfg.direct);
+        errdefer s.destroy();
+        s.slots = try slots_mod.Slots.init(gpa, cfg.staging, s.block_slot, s.small_slot);
+        s.root_fd = try fsio.openDir(cfg.root);
+        var nb: [64]u8 = undefined;
+        const top = try namespaceName(&nb, cfg.prefix, cfg.compat);
+        try fsio.ensureDirAt(s.root_fd, top);
+        s.top_fd = try fsio.openDirAt(s.root_fd, top);
+        var rb: [32]u8 = undefined;
+        const rank = std.fmt.bufPrintSentinel(&rb, "rank{d}", .{cfg.rank}, 0) catch unreachable;
+        try fsio.ensureDirAt(s.top_fd, rank);
+        s.rank_fd = try fsio.openDirAt(s.top_fd, rank);
+        s.lock = fsio.Lock.take(s.rank_fd) catch |e| if (mut(.owner_lock_ignored) and e == error.Busy) fsio.Lock{ .fd = -1 } else return if (e == error.Busy) error.StoreBusy else e;
+        try fsio.ensureDirAt(s.rank_fd, "blocks");
+        try fsio.ensureDirAt(s.rank_fd, "points");
+        s.blocks_fd = try fsio.openDirAt(s.rank_fd, "blocks");
+        s.points_fd = try fsio.openDirAt(s.rank_fd, "points");
+        s.pruneBuilds(top, rank);
+        try s.scan();
+        s.disk_free = fsio.diskFree(&s.hooks, s.blocks_fd);
+        try s.reader_threads.ensureTotalCapacity(gpa, @max(cfg.readers, 1));
+        s.writer_thread = try std.Thread.spawn(.{}, writerLoop, .{s});
+        for (0..@max(cfg.readers, 1)) |_| {
+            const t = std.Thread.spawn(.{}, readerLoop, .{s}) catch |e| {
+                s.stopThreads();
+                return e;
+            };
+            s.reader_threads.appendAssumeCapacity(t);
+        }
+        return s;
+    }
+
+    fn stopThreads(s: *Store) void {
+        s.mutex.lockUncancelable(s.io);
+        s.stopping = true;
+        s.work.broadcast(s.io);
+        s.rwork.broadcast(s.io);
+        s.mutex.unlock(s.io);
+        if (s.writer_thread) |t| t.join();
+        s.writer_thread = null;
+        for (s.reader_threads.items) |t| t.join();
+        s.reader_threads.clearRetainingCapacity();
+    }
+
+    /// Stops the workers (deletions, touches and metadata rewrites already queued still run; unpublished points
+    /// stay unpublished and are reported), frees memory and releases the owner lock. Never deletes a published point.
+    pub fn close(s: *Store) void {
+        s.stopThreads();
+        s.destroy();
+    }
+
+    fn destroy(s: *Store) void {
+        const gpa = s.gpa;
+        var jit = s.jobs_by_id.valueIterator();
+        while (jit.next()) |j| freeJob(gpa, j.*, true);
+        s.jobs_by_id.deinit(gpa);
+        for (s.reads.items) |r| {
+            r.point.pins -= 1;
+            if (r.point.pins == 0 and r.point.removed) r.point.deinit(gpa);
+            freeRead(gpa, r);
+        }
+        s.reads.deinit(gpa);
+        var pit = s.points.valueIterator();
+        while (pit.next()) |p| p.*.deinit(gpa);
+        s.points.deinit(gpa);
+        s.have.deinit(gpa);
+        s.content.deinit(gpa);
+        var iit = s.inodes.valueIterator();
+        while (iit.next()) |x| x.names.deinit(gpa);
+        s.inodes.deinit(gpa);
+        s.refs.deinit(gpa);
+        s.inflight.deinit(gpa);
+        s.parent.deinit(gpa);
+        s.reading.deinit(gpa);
+        s.waiting.deinit(gpa);
+        s.fifo.deinit(gpa);
+        s.parked.deinit(gpa);
+        s.tasks.deinit(gpa);
+        s.rtasks.deinit(gpa);
+        s.completions.deinit(gpa);
+        s.reader_threads.deinit(gpa);
+        s.slots.deinit(gpa);
+        if (s.lock.fd >= 0) s.lock.release();
+        for ([_]c.fd_t{ s.points_fd, s.blocks_fd, s.rank_fd, s.top_fd, s.root_fd }) |fd| if (fd >= 0) {
+            _ = c.close(fd);
+        };
+        gpa.destroy(s);
+    }
+
+    fn freeJob(gpa: Allocator, j: *WriteJob, with_point: bool) void {
+        j.new.deinit(gpa);
+        gpa.free(j.ids);
+        if (with_point) j.point.deinit(gpa);
+        gpa.destroy(j);
+    }
+
+    fn freeRead(gpa: Allocator, r: *ReadJob) void {
+        gpa.free(r.state);
+        gpa.free(r.slot);
+        r.bad.deinit(gpa);
+        r.lost.deinit(gpa);
+        gpa.destroy(r);
+    }
+
+    fn namespaceName(buf: []u8, prefix: []const u8, compat: Digest) ![:0]const u8 {
+        const h = format.hex(&compat);
+        return std.fmt.bufPrintSentinel(buf, "{s}{s}", .{ prefix, h[0..16] }, 0) catch unreachable;
+    }
+
+    /// Whether `name` is one of this family's namespaces: `prefix` then 16 lowercase hex digits, nothing else.
+    fn isNamespace(prefix: []const u8, name: []const u8) bool {
+        if (name.len != prefix.len + 16 or !std.mem.startsWith(u8, name, prefix)) return false;
+        for (name[prefix.len..]) |ch| if (!std.ascii.isDigit(ch) and (ch < 'a' or ch > 'f')) return false;
+        return true;
+    }
+
+    fn lockS(s: *Store) void {
+        s.mutex.lockUncancelable(s.io);
+    }
+
+    fn unlockS(s: *Store) void {
+        s.mutex.unlock(s.io);
+    }
+
+    fn now(s: *Store) i96 {
+        const t = std.Io.Clock.real.now(s.io).toNanoseconds();
+        s.clock = @max(t, s.clock + 1); // strictly increasing: last use orders every point
+        return s.clock;
+    }
+
+    /// Other builds' namespaces (this family's prefix only): the newest `keep_builds` stay; of the rest, this rank's
+    /// directory goes unless a live process holds its lock. The lock is taken (not probed) and held until the
+    /// directory is gone, so a process of that build starting meanwhile fails with StoreBusy instead of losing its
+    /// store underneath it; one that holds it already is skipped. Symlinks are unlinked, never followed.
+    fn pruneBuilds(s: *Store, mine: []const u8, rank: [:0]const u8) void {
+        const gpa = s.gpa;
+        var names = fsio.list(gpa, s.root_fd) catch return;
+        defer fsio.freeList(gpa, &names);
+        const Other = struct { name: [:0]const u8, mtime: i96 };
+        var others: std.ArrayList(Other) = .empty;
+        defer others.deinit(gpa);
+        for (names.items) |n| {
+            const ours = if (mut(.prune_other_families)) std.mem.startsWith(u8, n, "native-spill-") else isNamespace(s.cfg.prefix, n);
+            if (!ours or std.mem.eql(u8, n, mine)) continue;
+            if (fsio.isSymlinkAt(s.root_fd, n)) { // never ours: the link goes, its target is left alone
+                fsio.unlinkAt(s.root_fd, n);
+                continue;
+            }
+            const st = fsio.statAt(s.root_fd, n) catch continue;
+            others.append(gpa, .{ .name = n, .mtime = st.mtime_ns }) catch return;
+        }
+        std.mem.sort(Other, others.items, {}, struct {
+            fn newer(_: void, a: Other, b: Other) bool {
+                return a.mtime > b.mtime;
+            }
+        }.newer);
+        if (others.items.len <= s.cfg.keep_builds) return;
+        for (others.items[s.cfg.keep_builds..]) |o| {
+            const dir = fsio.openDirAt(s.root_fd, o.name) catch continue;
+            defer _ = c.close(dir);
+            if (fsio.isSymlinkAt(dir, rank)) fsio.unlinkAt(dir, rank);
+            const sub = fsio.openDirAt(dir, rank) catch {
+                _ = c.unlinkat(s.root_fd, o.name, c.AT.REMOVEDIR); // empty once every rank pruned its own
+                continue;
+            };
+            defer _ = c.close(sub);
+            var lock = fsio.Lock.take(sub) catch continue; // live (or unlockable): left alone
+            defer lock.release();
+            fsio.removeTree(gpa, dir, rank); // (its owner.lock goes too, while held)
+            s.counters.builds_pruned += 1;
+            _ = c.unlinkat(s.root_fd, o.name, c.AT.REMOVEDIR);
+        }
+    }
+
+    // -- recovery ------------------------------------------------------------------------------------------------
+    fn pointName(buf: []u8, key: *const Digest, comptime suffix: []const u8) [:0]const u8 {
+        const h = format.hex(key);
+        return std.fmt.bufPrintSentinel(buf, "{s}" ++ suffix, .{h}, 0) catch unreachable;
+    }
+
+    fn blockName(buf: []u8, name: *const Digest) [:0]const u8 {
+        const h = format.hex(name);
+        return std.fmt.bufPrintSentinel(buf, "{s}.blk", .{h}, 0) catch unreachable;
+    }
+
+    /// Points whose manifest, ids, small state and every block are on disk at the sizes the manifest says; the rest
+    /// (a write a crash cut short, a damaged or foreign point) go, and so do blocks no point names. Only damage
+    /// deletes: a point that could not be read for another reason (I/O error, EMFILE, a busy file) keeps its files,
+    /// and while any did, so does every unreferenced block (it may be that point's); the next open tries again. Out of
+    /// memory fails the open with the store untouched.
+    fn scan(s: *Store) !void {
+        const gpa = s.gpa;
+        for ([_]c.fd_t{ s.points_fd, s.blocks_fd }) |dir| {
+            var names = try fsio.list(gpa, dir);
+            defer fsio.freeList(gpa, &names);
+            for (names.items) |n| if (n[0] == '.' and !mut(.scan_keeps_temps)) {
+                fsio.unlinkAt(dir, n);
+                s.counters.temps_removed += 1;
+            };
+        }
+        var present: std.AutoHashMapUnmanaged(Digest, fsio.Stat) = .empty;
+        defer present.deinit(gpa);
+        var unsure: std.AutoHashMapUnmanaged(Digest, void) = .empty; // blocks whose stat failed, not as missing
+        defer unsure.deinit(gpa);
+        var kept: std.AutoHashMapUnmanaged(Digest, void) = .empty; // points left on disk unread
+        defer kept.deinit(gpa);
+        {
+            var names = try fsio.list(gpa, s.blocks_fd);
+            defer fsio.freeList(gpa, &names);
+            for (names.items) |n| {
+                s.scanned(n);
+                const d = if (std.mem.endsWith(u8, n, ".blk")) format.parseHex(n[0 .. n.len - 4]) else null;
+                if (d == null) {
+                    fsio.unlinkAt(s.blocks_fd, n);
+                    s.counters.orphans_removed += 1;
+                    continue;
+                }
+                const st = fsio.statAt(s.blocks_fd, n) catch |e| {
+                    if (e != error.Missing) try unsure.put(gpa, d.?, {});
+                    continue;
+                };
+                try present.put(gpa, d.?, st);
+            }
+        }
+        var names = try fsio.list(gpa, s.points_fd);
+        defer fsio.freeList(gpa, &names);
+        for (names.items) |n| {
+            s.scanned(n);
+            if (!std.mem.endsWith(u8, n, ".man")) continue;
+            const key = format.parseHex(n[0 .. n.len - 4]) orelse continue;
+            const p = s.recover(key, &present, &unsure) catch |e| switch (e) {
+                error.OutOfMemory => return error.OutOfMemory,
+                error.Corrupt, error.Foreign, error.Missing, error.TooLarge, error.Short => null,
+                else => if (mut(.recover_drops_on_io)) null else {
+                    try kept.put(gpa, key, {});
+                    s.counters.recover_deferred += 1;
+                    continue;
+                },
+            };
+            if (p) |pt| {
+                try s.points.put(gpa, key, pt);
+                s.counters.recovered_points += 1;
+            } else s.counters.recovered_dropped += 1;
+        }
+        // files of no point, then blocks no point names
+        for (names.items) |n| {
+            const dot = std.mem.indexOfScalar(u8, n, '.') orelse n.len;
+            const key = format.parseHex(n[0..dot]);
+            if (key == null or !(s.points.contains(key.?) or kept.contains(key.?))) {
+                fsio.unlinkAt(s.points_fd, n);
+                s.counters.orphans_removed += 1;
+            }
+        }
+        var pit = s.points.valueIterator();
+        while (pit.next()) |pp| {
+            const p = pp.*;
+            for (p.blocks) |b| {
+                if (!s.have.contains(b.name)) try s.addBlock(b.name, b.crc, b.sha, present.get(b.name).?.ino, b.bytes);
+            }
+            s.stored_bytes += p.files;
+            s.ref(p.blocks, 1);
+        }
+        // blocks no point names (kept while a point was left unread: they may be its)
+        if (kept.count() == 0 and unsure.count() == 0) {
+            var bit = present.iterator();
+            while (bit.next()) |e| {
+                if (s.have.contains(e.key_ptr.*)) continue;
+                var bb: [80]u8 = undefined;
+                fsio.unlinkAt(s.blocks_fd, blockName(&bb, e.key_ptr));
+                s.counters.orphans_removed += 1;
+            }
+        }
+        // parents, shortest first
+        var order: std.ArrayList(*Point) = .empty;
+        defer order.deinit(gpa);
+        pit = s.points.valueIterator();
+        while (pit.next()) |p| try order.append(gpa, p.*);
+        std.mem.sort(*Point, order.items, {}, struct {
+            fn shorter(_: void, a: *Point, b: *Point) bool {
+                return a.at < b.at;
+            }
+        }.shorter);
+        for (order.items) |p| try s.parent.put(gpa, p.key, s.parentOf(p));
+        s.clock = 0;
+        for (order.items) |p| s.clock = @max(s.clock, p.used);
+    }
+
+    /// One name the scan read: counted for a watcher on another thread (Hooks.progress), and the test's hook.
+    fn scanned(s: *Store, name: []const u8) void {
+        if (s.hooks.progress) |p| _ = p.fetchAdd(1, .monotonic);
+        if (s.hooks.scanned) |f| f(s.hooks.ctx, name);
+    }
+
+    fn recover(s: *Store, key: Digest, present: *const std.AutoHashMapUnmanaged(Digest, fsio.Stat), unsure: *const std.AutoHashMapUnmanaged(Digest, void)) !*Point {
+        const gpa = s.gpa;
+        const l = s.cfg.limits;
+        var nb: [80]u8 = undefined;
+        const raw = try fsio.readSmall(gpa, s.points_fd, pointName(&nb, &key, ".man"), l.maxManifest());
+        defer gpa.free(raw);
+        var m = try format.Manifest.parse(gpa, raw, s.cfg.compat, l);
+        defer {
+            gpa.free(m.media);
+            gpa.free(m.blocks);
+            gpa.free(m.sections);
+        }
+        var lineage_owned = true;
+        defer if (lineage_owned) gpa.free(m.lineage.forks);
+        if (!std.mem.eql(u8, &m.key, &key) or m.owner_layout != s.cfg.owner_layout) return error.Corrupt;
+        const man_st = try fsio.statAt(s.points_fd, pointName(&nb, &key, ".man"));
+        const ids_raw = try fsio.readSmall(gpa, s.points_fd, pointName(&nb, &key, ".ids"), m.ids_bytes);
+        defer gpa.free(ids_raw);
+        if (ids_raw.len != m.ids_bytes or format.crc32(ids_raw) != m.ids_crc) return error.Corrupt;
+        const small_st = try fsio.statAt(s.points_fd, pointName(&nb, &key, ".st"));
+        if (small_st.size != m.small_bytes) return error.Corrupt;
+        const keyed = try gpa.alloc(u32, m.at);
+        defer gpa.free(keyed);
+        @memcpy(std.mem.sliceAsBytes(keyed), ids_raw[0 .. m.at * 4]);
+        const ch = try chainOf(gpa, keyed, l.block_tokens);
+        var ch_owned = true;
+        defer if (ch_owned) gpa.free(ch);
+        if (!std.mem.eql(u8, &format.pointKeyChained(ch, keyed, l.block_tokens, m.media), &key)) return error.Corrupt;
+        if (m.media.len > 0) { // a point with pictures: its keyed and raw ids agree with its media (version 3)
+            const raw_ids = try gpa.alloc(u32, m.at);
+            defer gpa.free(raw_ids);
+            @memcpy(std.mem.sliceAsBytes(raw_ids), ids_raw[m.at * 4 ..][0 .. m.at * 4]);
+            if (!format.mediaIds(keyed, raw_ids, m.media)) return error.Corrupt;
+        }
+        const spans = try gpa.alloc(format.Span, m.blocks.len);
+        defer gpa.free(spans);
+        format.blockNames(m.lineage, ch, keyed, l.block_tokens, spans);
+        for (m.blocks, spans) |b, sp| {
+            if (!std.mem.eql(u8, &b.name, &sp.name)) return error.Corrupt;
+            const st = present.get(b.name) orelse return if (unsure.contains(b.name)) error.Io else error.Missing;
+            if (st.size != b.bytes and !mut(.recover_no_size_check)) return error.Corrupt;
+        }
+        const p = try s.makePoint(keyed, ch, m.media, m.lineage, .{
+            .key = key, .at = m.at, .shared = m.flags.shared, .group = m.group, .created_ns = m.created_ns,
+            .has_raw = m.flags.has_raw, .mutable_tail = m.flags.mutable_tail, .origin = m.origin,
+        });
+        lineage_owned = false; // the point owns them now
+        ch_owned = false;
+        errdefer p.deinit(gpa);
+        @memcpy(p.blocks, m.blocks);
+        gpa.free(p.sections);
+        p.sections = try gpa.dupe(format.Section, m.sections);
+        p.ids_bytes = m.ids_bytes;
+        p.ids_crc = m.ids_crc;
+        p.small_bytes = m.small_bytes;
+        p.small_crc = m.small_crc;
+        p.used = man_st.mtime_ns;
+        p.files = man_st.size + m.ids_bytes + m.small_bytes;
+        return p;
+    }
+
+    const PointInit = struct {
+        key: Digest,
+        at: u32,
+        shared: bool,
+        group: u64,
+        created_ns: i64,
+        has_raw: bool,
+        mutable_tail: bool,
+        origin: ?format.Origin,
+    };
+
+    /// `keyed`'s id chain (gpa-owned): the one pass over a state's ids its key and block names derive from.
+    fn chainOf(gpa: Allocator, keyed: []const u32, block: u32) ![]Digest {
+        var ch: std.ArrayList(Digest) = .empty;
+        errdefer ch.deinit(gpa);
+        try format.chain(gpa, keyed, block, &ch);
+        return ch.toOwnedSlice(gpa);
+    }
+
+    /// A point for `keyed` (tail, media, block names) with its chain `ch`; on success it owns `ch` and `lineage`'s
+    /// forks (on an error the caller still owns both).
+    fn makePoint(s: *Store, keyed: []const u32, ch: []Digest, media: []const Media, lineage: Lineage, i: PointInit) !*Point {
+        const gpa = s.gpa;
+        const block = s.cfg.limits.block_tokens;
+        const p = try gpa.create(Point);
+        errdefer gpa.destroy(p);
+        const whole = ch.len * block;
+        const tail = try gpa.dupe(u32, keyed[whole..]);
+        errdefer gpa.free(tail);
+        const md = try gpa.dupe(Media, media);
+        errdefer gpa.free(md);
+        const nblocks = std.math.divCeil(usize, keyed.len, block) catch unreachable;
+        const spans = try gpa.alloc(format.Span, nblocks);
+        defer gpa.free(spans);
+        format.blockNames(lineage, ch, keyed, block, spans);
+        const blocks = try gpa.alloc(format.BlockRef, nblocks);
+        for (blocks, spans) |*b, sp| b.* = .{ .name = sp.name, .tokens = sp.end - sp.start, .bytes = 0, .crc = 0, .sha = format.zero_digest };
+        p.* = .{
+            .key = i.key, .at = i.at, .shared = i.shared, .group = i.group, .used = 0, .created_ns = i.created_ns,
+            .has_raw = i.has_raw, .mutable_tail = i.mutable_tail, .lineage = lineage, .origin = i.origin,
+            .chain = ch, .tail = tail, .media = md, .blocks = blocks, .sections = &.{},
+            .ids_bytes = 0, .ids_crc = 0, .small_bytes = 0, .small_crc = 0,
+        };
+        return p;
+    }
+
+    // -- block and reference bookkeeping (lock held) -------------------------------------------------------------
+    fn addBlock(s: *Store, name: Digest, crc: u32, sha: Digest, ino: u64, bytes: u64) !void {
+        const gpa = s.gpa;
+        try s.have.put(gpa, name, .{ .crc = crc, .sha = sha, .ino = ino, .bytes = bytes });
+        const gop = try s.inodes.getOrPut(gpa, ino);
+        if (!gop.found_existing) {
+            gop.value_ptr.* = .{ .bytes = bytes };
+            s.stored_bytes += bytes;
+        }
+        try gop.value_ptr.names.append(gpa, name);
+        const cg = try s.content.getOrPut(gpa, sha);
+        if (!cg.found_existing) cg.value_ptr.* = name;
+    }
+
+    /// Block `name` leaves the index; its bytes once no name holds its inode. Its file is unlinked by the writer.
+    fn dropBlock(s: *Store, name: Digest) void {
+        const info = (s.have.fetchRemove(name) orelse return).value;
+        var freed: u64 = 0;
+        if (s.inodes.getPtr(info.ino)) |ino| {
+            for (ino.names.items, 0..) |n, i| if (std.mem.eql(u8, &n, &name)) {
+                _ = ino.names.swapRemove(i);
+                break;
+            };
+            if (s.content.get(info.sha)) |cur| if (std.mem.eql(u8, &cur, &name)) {
+                if (ino.names.items.len > 0) s.content.putAssumeCapacity(info.sha, ino.names.items[0]) else _ = s.content.remove(info.sha);
+            };
+            if (ino.names.items.len == 0) {
+                s.stored_bytes -= ino.bytes;
+                freed = ino.bytes;
+                ino.names.deinit(s.gpa);
+                _ = s.inodes.remove(info.ino);
+            }
+        }
+        s.pending_free += freed;
+        s.queue(.{ .unlink_block = .{ .name = name, .bytes = freed } });
+    }
+
+    fn ref(s: *Store, blocks: []const format.BlockRef, k: i32) void {
+        for (blocks) |b| {
+            const gop = s.refs.getOrPut(s.gpa, b.name) catch continue;
+            const cur: i64 = if (gop.found_existing) gop.value_ptr.* else 0;
+            const v = cur + k;
+            if (v > 0) gop.value_ptr.* = @intCast(v) else _ = s.refs.remove(b.name);
+        }
+    }
+
+    /// Of `blocks`, those nothing names any more (no point, waiting write or write in flight) go.
+    fn gc(s: *Store, blocks: []const format.BlockRef) void {
+        for (blocks) |b| {
+            if (s.have.contains(b.name) and !s.refs.contains(b.name) and !s.inflight.contains(b.name)) s.dropBlock(b.name);
+        }
+    }
+
+    fn queue(s: *Store, t: Task) void {
+        s.tasks.append(s.gpa, t) catch {
+            std.log.err("spill: rank {d}: writer queue allocation failed", .{s.cfg.rank});
+            return;
+        };
+        s.work.signal(s.io);
+    }
+
+    fn complete(s: *Store, x: Completion) void {
+        s.completions.append(s.gpa, x) catch {};
+    }
+
+    /// A point goes from the index (its files queued for the writer), then the blocks only it named.
+    fn remove(s: *Store, key: Digest, comptime why: []const u8) void {
+        const kv = s.points.fetchRemove(key) orelse return;
+        const p = kv.value;
+        s.ref(p.blocks, -1);
+        const up = if (s.parent.fetchRemove(key)) |e| e.value else null;
+        var it = s.parent.iterator();
+        while (it.next()) |e| {
+            if (e.value_ptr.*) |v| if (std.mem.eql(u8, &v, &key)) {
+                e.value_ptr.* = up;
+            };
+        }
+        s.stored_bytes -= p.files;
+        s.pending_free += p.files;
+        s.queue(.{ .unlink_point = .{ .key = key, .bytes = p.files } });
+        @field(s.counters, why) += 1;
+        s.gc(p.blocks);
+        if (p.pins > 0) p.removed = true else p.deinit(s.gpa);
+    }
+
+    /// Whether `p`'s ids strictly extend `q`'s (block chains, then q's tail). A tail of q inside one of p's whole
+    /// blocks cannot be compared from memory (only the last block's ids are kept): not counted as an extension.
+    fn extends(s: *Store, p: *const Point, q: *const Point) bool {
+        _ = s;
+        if (q.at >= p.at) return false;
+        const k = q.chain.len;
+        if (k > p.chain.len) return false;
+        for (q.chain, p.chain[0..k]) |a, b| if (!std.mem.eql(u8, &a, &b)) return false;
+        if (q.tail.len == 0) return true;
+        if (k != p.chain.len) return false;
+        return std.mem.eql(u32, p.tail[0..q.tail.len], q.tail);
+    }
+
+    fn parentOf(s: *Store, p: *const Point) ?Digest {
+        var best: ?*Point = null;
+        var it = s.points.valueIterator();
+        while (it.next()) |qq| {
+            const q = qq.*;
+            if (q == p) continue;
+            if ((best == null or q.at > best.?.at) and s.extends(p, q)) best = q;
+        }
+        return if (best) |b| b.key else null;
+    }
+
+    /// `p` just entered the index: its parent, and the points it now stands between.
+    fn adopt(s: *Store, p: *Point) void {
+        s.parent.put(s.gpa, p.key, s.parentOf(p)) catch {};
+        var it = s.points.valueIterator();
+        while (it.next()) |qq| {
+            const q = qq.*;
+            if (q == p or !s.extends(q, p)) continue;
+            const cur = s.parent.get(q.key) orelse null;
+            if (cur == null or s.points.get(cur.?).?.at < p.at) s.parent.put(s.gpa, q.key, p.key) catch {};
+        }
+    }
+
+    // -- conversations and room (lock held) ----------------------------------------------------------------------
+    const Tree = struct {
+        keys: []Digest,
+        conv: []?usize, // a conversation id per key (null: a shared point)
+        index: std.AutoHashMapUnmanaged(Digest, usize),
+
+        fn deinit(t: *Tree, gpa: Allocator) void {
+            gpa.free(t.keys);
+            gpa.free(t.conv);
+            t.index.deinit(gpa);
+        }
+    };
+
+    fn find(uf: []usize, x: usize) usize {
+        var r = x;
+        while (uf[r] != r) r = uf[r];
+        var y = x;
+        while (uf[y] != r) {
+            const nx = uf[y];
+            uf[y] = r;
+            y = nx;
+        }
+        return r;
+    }
+
+    /// Each point's conversation: the topmost non-shared point on its path below a shared one, merged with every
+    /// point carrying the same nonzero 0111 group (a rewound or restored conversation counts once).
+    fn tree(s: *Store) !Tree {
+        const gpa = s.gpa;
+        const n = s.points.count();
+        const keys = try gpa.alloc(Digest, n);
+        errdefer gpa.free(keys);
+        var index: std.AutoHashMapUnmanaged(Digest, usize) = .empty;
+        errdefer index.deinit(gpa);
+        var it = s.points.keyIterator();
+        var i: usize = 0;
+        while (it.next()) |k| : (i += 1) {
+            keys[i] = k.*;
+            try index.put(gpa, k.*, i);
+        }
+        std.mem.sort(Digest, keys, {}, struct {
+            fn lt(_: void, a: Digest, b: Digest) bool {
+                return std.mem.order(u8, &a, &b) == .lt;
+            }
+        }.lt);
+        for (keys, 0..) |k, j| index.putAssumeCapacity(k, j);
+        const uf = try gpa.alloc(usize, n);
+        defer gpa.free(uf);
+        for (uf, 0..) |*u, j| u.* = j;
+        const conv = try gpa.alloc(?usize, n);
+        errdefer gpa.free(conv);
+        var groups: std.AutoHashMapUnmanaged(u64, usize) = .empty;
+        defer groups.deinit(gpa);
+        for (keys, 0..) |k, j| {
+            const p = s.points.get(k).?;
+            if (p.shared) {
+                conv[j] = null;
+                continue;
+            }
+            var top = j;
+            var cur = s.parent.get(k) orelse null;
+            while (cur) |ck| {
+                const q = s.points.get(ck) orelse break;
+                if (q.shared) break;
+                top = index.get(ck).?;
+                cur = s.parent.get(ck) orelse null;
+            }
+            conv[j] = top;
+        }
+        for (keys, 0..) |k, j| {
+            const top = conv[j] orelse continue;
+            const p = s.points.get(k).?;
+            if (p.group == 0) continue;
+            const gop = try groups.getOrPut(gpa, p.group);
+            if (!gop.found_existing) gop.value_ptr.* = top else {
+                const a = find(uf, top);
+                const b = find(uf, gop.value_ptr.*);
+                if (a != b) uf[@max(a, b)] = @min(a, b);
+            }
+        }
+        for (conv) |*x| if (x.*) |t| {
+            x.* = find(uf, t);
+        };
+        return .{ .keys = keys, .conv = conv, .index = index };
+    }
+
+    pub const Why = enum { pruned_turns, pruned_forks, pruned_conversations, pruned_shared };
+    pub const Victim = struct { key: Digest, why: Why };
+
+    /// The order room would be made in now (gpa-owned): what /health or a test inspects, nothing removed.
+    pub fn evictionOrder(s: *Store) ![]Victim {
+        s.lockS();
+        defer s.unlockS();
+        var v = try s.victims(null);
+        return v.toOwnedSlice(s.gpa);
+    }
+
+    /// Points in eviction order: old turns, abandoned forks, whole conversations by last use, shared states last.
+    /// `only`: a conversation's own old turns and forks (its quota).
+    fn victims(s: *Store, only: ?usize) !std.ArrayList(Victim) {
+        const gpa = s.gpa;
+        var t = try s.tree();
+        defer t.deinit(gpa);
+        const n = t.keys.len;
+        var out: std.ArrayList(Victim) = .empty;
+        errdefer out.deinit(gpa);
+        const used = try gpa.alloc(i96, n);
+        defer gpa.free(used);
+        const at = try gpa.alloc(u32, n);
+        defer gpa.free(at);
+        const par = try gpa.alloc(?usize, n);
+        defer gpa.free(par);
+        const has_kid = try gpa.alloc(bool, n);
+        defer gpa.free(has_kid);
+        @memset(has_kid, false);
+        for (t.keys, 0..) |k, j| {
+            const p = s.points.get(k).?;
+            used[j] = p.used;
+            at[j] = p.at;
+            par[j] = if (s.parent.get(k) orelse null) |pk| t.index.get(pk) else null;
+        }
+        for (0..n) |j| if (par[j]) |pj| {
+            if (t.conv[j] != null and t.conv[pj] == t.conv[j]) has_kid[pj] = true;
+        };
+        const kind = try gpa.alloc(u8, n); // 0 keep, 1 turn, 2 fork
+        defer gpa.free(kind);
+        @memset(kind, 0);
+        const Whole = struct { conv: usize, used: i96 };
+        var wholes: std.ArrayList(Whole) = .empty;
+        defer wholes.deinit(gpa);
+        var seen: std.AutoHashMapUnmanaged(usize, void) = .empty;
+        defer seen.deinit(gpa);
+        const on_path = try gpa.alloc(bool, n);
+        defer gpa.free(on_path);
+        for (0..n) |j0| {
+            const cv = t.conv[j0] orelse continue;
+            if ((try seen.getOrPut(gpa, cv)).found_existing) continue;
+            if (only != null and only.? != cv) continue;
+            var newest: ?usize = null;
+            var newest_any: ?usize = null;
+            var last: i96 = std.math.minInt(i96);
+            for (0..n) |j| {
+                if (t.conv[j] != cv) continue;
+                last = @max(last, used[j]);
+                if (newest_any == null or used[j] > used[newest_any.?]) newest_any = j;
+                if (!has_kid[j] and (newest == null or used[j] > used[newest.?])) newest = j;
+            }
+            @memset(on_path, false);
+            var path_len: usize = 0;
+            var cur: ?usize = newest orelse newest_any;
+            const keep_n = @max(1, s.cfg.turns);
+            while (cur) |j| {
+                if (t.conv[j] != cv) break;
+                on_path[j] = true;
+                if (path_len >= keep_n) kind[j] = 1;
+                path_len += 1;
+                cur = par[j];
+            }
+            for (0..n) |j| {
+                if (t.conv[j] != cv or on_path[j]) continue;
+                kind[j] = if (has_kid[j]) 1 else 2;
+            }
+            try wholes.append(gpa, .{ .conv = cv, .used = last });
+        }
+        const Ent = struct { j: usize, used: i96, at: u32 };
+        var turns: std.ArrayList(Ent) = .empty;
+        defer turns.deinit(gpa);
+        var forks: std.ArrayList(Ent) = .empty;
+        defer forks.deinit(gpa);
+        for (0..n) |j| switch (kind[j]) {
+            1 => try turns.append(gpa, .{ .j = j, .used = used[j], .at = at[j] }),
+            2 => try forks.append(gpa, .{ .j = j, .used = used[j], .at = at[j] }),
+            else => {},
+        };
+        const byUsed = struct {
+            fn lt(_: void, a: Ent, b: Ent) bool {
+                return a.used < b.used or (a.used == b.used and a.at > b.at);
+            }
+        }.lt;
+        std.mem.sort(Ent, turns.items, {}, byUsed);
+        std.mem.sort(Ent, forks.items, {}, byUsed);
+        for (turns.items) |e| try out.append(gpa, .{ .key = t.keys[e.j], .why = .pruned_turns });
+        for (forks.items) |e| try out.append(gpa, .{ .key = t.keys[e.j], .why = .pruned_forks });
+        if (only != null) return out;
+        if (mut(.evict_shared_first)) {
+            var sh: std.ArrayList(Ent) = .empty;
+            defer sh.deinit(gpa);
+            for (0..n) |j| if (t.conv[j] == null) try sh.append(gpa, .{ .j = j, .used = used[j], .at = at[j] });
+            std.mem.sort(Ent, sh.items, {}, byUsed);
+            for (sh.items) |e| try out.append(gpa, .{ .key = t.keys[e.j], .why = .pruned_shared });
+        }
+        std.mem.sort(Whole, wholes.items, {}, struct {
+            fn lt(_: void, a: Whole, b: Whole) bool {
+                return a.used < b.used;
+            }
+        }.lt);
+        var rest: std.ArrayList(Ent) = .empty;
+        defer rest.deinit(gpa);
+        for (wholes.items) |w| {
+            rest.clearRetainingCapacity();
+            for (0..n) |j| if (t.conv[j] == w.conv and kind[j] == 0) try rest.append(gpa, .{ .j = j, .used = used[j], .at = at[j] });
+            std.mem.sort(Ent, rest.items, {}, struct {
+                fn longer(_: void, a: Ent, b: Ent) bool {
+                    return a.at > b.at;
+                }
+            }.longer);
+            for (rest.items) |e| try out.append(gpa, .{ .key = t.keys[e.j], .why = .pruned_conversations });
+        }
+        rest.clearRetainingCapacity();
+        if (!mut(.evict_shared_first)) for (0..n) |j| if (t.conv[j] == null) try rest.append(gpa, .{ .j = j, .used = used[j], .at = at[j] });
+        std.mem.sort(Ent, rest.items, {}, byUsed);
+        for (rest.items) |e| try out.append(gpa, .{ .key = t.keys[e.j], .why = .pruned_shared });
+        return out;
+    }
+
+    fn removeWhy(s: *Store, key: Digest, why: Why) void {
+        switch (why) {
+            inline else => |w| s.remove(key, @tagName(w)),
+        }
+    }
+
+    /// Frees at least `nbytes` in eviction order, never `protect` or a point being read.
+    fn makeRoom(s: *Store, nbytes: u64, protect: ?Digest) void {
+        var v = s.victims(null) catch return;
+        defer v.deinit(s.gpa);
+        const target = s.stored_bytes -| nbytes;
+        for (v.items) |x| {
+            if (s.stored_bytes <= target) return;
+            if (protect != null and std.mem.eql(u8, &protect.?, &x.key)) continue;
+            if (!s.points.contains(x.key) or s.reading.contains(x.key)) continue;
+            s.removeWhy(x.key, x.why);
+        }
+    }
+
+    /// After `p` is published: on its conversation's path (its ancestors below a shared point) the newest `turns`
+    /// stay, older ones go now (they free their small files only: `p` names every block they named).
+    fn trimPath(s: *Store, p: *Point) void {
+        if (s.cfg.turns == 0 or p.shared) return;
+        var path: std.ArrayList(Digest) = .empty;
+        defer path.deinit(s.gpa);
+        var cur: ?Digest = p.key;
+        while (cur) |k| {
+            const q = s.points.get(k) orelse break;
+            if (q.shared) break;
+            path.append(s.gpa, k) catch return;
+            cur = s.parent.get(k) orelse null;
+        }
+        if (path.items.len <= s.cfg.turns) return;
+        for (path.items[s.cfg.turns..]) |k| {
+            if (!s.reading.contains(k)) s.remove(k, "trimmed_turns");
+        }
+    }
+
+    /// Bytes only `keys`' points hold: their files and blocks no other point names (each inode once).
+    fn convBytes(s: *Store, keys: []const Digest) u64 {
+        const gpa = s.gpa;
+        var mine: std.AutoHashMapUnmanaged(Digest, void) = .empty;
+        defer mine.deinit(gpa);
+        for (keys) |k| mine.put(gpa, k, {}) catch return 0;
+        var others: std.AutoHashMapUnmanaged(Digest, void) = .empty;
+        defer others.deinit(gpa);
+        var it = s.points.iterator();
+        while (it.next()) |e| {
+            if (mine.contains(e.key_ptr.*)) continue;
+            for (e.value_ptr.*.blocks) |b| others.put(gpa, b.name, {}) catch return 0;
+        }
+        var inos: std.AutoHashMapUnmanaged(u64, void) = .empty;
+        defer inos.deinit(gpa);
+        var n: u64 = 0;
+        for (keys) |k| {
+            const p = s.points.get(k).?;
+            n += p.files;
+            for (p.blocks) |b| {
+                if (others.contains(b.name)) continue;
+                const info = s.have.get(b.name) orelse continue;
+                const ino = s.inodes.get(info.ino) orelse continue;
+                var all_mine = true;
+                for (ino.names.items) |nm| if (others.contains(nm)) {
+                    all_mine = false;
+                };
+                if (!all_mine) continue;
+                if ((inos.getOrPut(gpa, info.ino) catch return n).found_existing) continue;
+                n += ino.bytes;
+            }
+        }
+        return n;
+    }
+
+    /// A write of `p` whose conversation holds more than its quota: its own old turns and forks go first.
+    fn trimOwn(s: *Store, p: *Point, need: u64) void {
+        if (s.cfg.quota <= 0 or p.shared or s.points.count() == 0) return;
+        const gpa = s.gpa;
+        var t = s.tree() catch return;
+        defer t.deinit(gpa);
+        // the conversation `p` would join: its parent's (below a shared point), or its group's
+        var cv: ?usize = null;
+        if (s.parentOf(p)) |up| {
+            const q = s.points.get(up).?;
+            if (!q.shared) cv = t.conv[t.index.get(up).?];
+        }
+        if (cv == null and p.group != 0) {
+            for (t.keys, 0..) |k, j| if (s.points.get(k).?.group == p.group) {
+                cv = t.conv[j];
+                break;
+            };
+        }
+        const conv = cv orelse return;
+        var keys: std.ArrayList(Digest) = .empty;
+        defer keys.deinit(gpa);
+        for (t.keys, 0..) |k, j| if (t.conv[j] == conv) keys.append(gpa, k) catch return;
+        const allowed: u64 = @intFromFloat(s.cfg.quota * @as(f64, @floatFromInt(s.cfg.cap_bytes)));
+        const held = s.convBytes(keys.items) + need;
+        if (held <= allowed) return;
+        s.counters.quota_trims += 1;
+        const target = s.stored_bytes -| (held - allowed);
+        var v = s.victims(conv) catch return;
+        defer v.deinit(gpa);
+        for (v.items) |x| {
+            if (s.stored_bytes <= target) break;
+            if (s.reading.contains(x.key) or !s.points.contains(x.key)) continue;
+            s.removeWhy(x.key, x.why);
+        }
+    }
+
+    // -- writes (engine thread) ----------------------------------------------------------------------------------
+    /// At an eligible keep: queue the point's missing blocks (left in device memory; `stage` asks for them between
+    /// rounds), reserve its small state's slot (and a tail block's), or say why not. Ids stored or on their way are
+    /// not written again; kept again as a shared prefix their point becomes shared, durably.
+    pub fn keep(s: *Store, k: Keep) KeepResult {
+        const gpa = s.gpa;
+        const l = s.cfg.limits;
+        const at: u32 = @intCast(@min(k.keyed.len, std.math.maxInt(u32)));
+        if (at < s.cfg.min_tokens or at == 0) return s.refuse(.short);
+        if (!s.validKeep(k)) return s.refuse(.invalid);
+        // hashing runs before the lock (the writer and readers never wait on it), one pass over the ids: the chain,
+        // from which the key and the block names derive
+        const ch = chainOf(gpa, k.keyed, l.block_tokens) catch return s.refuse(.no_staging);
+        var ch_owned = true;
+        defer if (ch_owned) gpa.free(ch);
+        const key = format.pointKeyChained(ch, k.keyed, l.block_tokens, k.media);
+        if (s.alreadyKept(key, k.shared)) return .stored;
+        var lineage = k.lineage.clone(gpa) catch return s.refuse(.no_staging);
+        const p = s.makePoint(k.keyed, ch, k.media, lineage, .{
+            .key = key, .at = at, .shared = k.shared, .group = k.group, .created_ns = 0,
+            .has_raw = k.raw != null, .mutable_tail = at % l.block_tokens != 0, .origin = k.origin,
+        }) catch {
+            lineage.deinit(gpa);
+            return s.refuse(.no_staging);
+        };
+        ch_owned = false;
+        var ok = false;
+        defer if (!ok) p.deinit(gpa);
+        // sections, laid out on 256-byte boundaries
+        const secs = gpa.alloc(format.Section, k.sections.len) catch return s.refuse(.no_staging);
+        p.sections = secs;
+        var off: u64 = 0;
+        for (k.sections, secs) |spec, *sec| {
+            off = std.mem.alignForward(u64, off, 256);
+            sec.* = .{ .name = format.Name.of(spec.name) catch unreachable, .offset = off, .len = spec.len, .crc = 0 };
+            off += spec.len;
+        }
+        p.small_bytes = off;
+        p.ids_bytes = @as(u64, at) * 4 * (if (k.raw != null) @as(u64, 2) else 1);
+        const has_tail = at % l.block_tokens != 0;
+        const full = l.fullBlockBytes(k.lineage.part).?; // (validKeep: a part where the store needs one)
+        for (p.blocks, 0..) |*b, i| b.bytes = if (has_tail and i + 1 == p.blocks.len) k.tail_bytes else full;
+        const ids = format.encodeIds(gpa, k.keyed, k.raw) catch return s.refuse(.no_staging);
+        var ids_owned = true;
+        defer if (ids_owned) gpa.free(ids);
+        s.lockS();
+        defer s.unlockS();
+        s.counters.keeps += 1;
+        if (s.points.contains(key) or s.waiting.contains(key)) { // (only the engine thread keeps: never, in practice)
+            s.counters.stored_skips += 1;
+            return .stored;
+        }
+        p.created_ns = @intCast(s.now());
+        var size: u64 = 0;
+        var new: std.ArrayList(u32) = .empty;
+        defer if (!ok) new.deinit(gpa);
+        var tail: ?u32 = null;
+        for (p.blocks, 0..) |b, i| {
+            if (s.have.contains(b.name) or s.inflight.contains(b.name)) continue;
+            size += b.bytes;
+            if (has_tail and i + 1 == p.blocks.len and !mut(.tail_staged_later)) tail = @intCast(i) else new.append(gpa, @intCast(i)) catch return s.refuseOom();
+        }
+        const need = size + p.small_bytes + p.ids_bytes + format.header_bytes + 80 * p.blocks.len;
+        // GLM 0110's pin: the point holds its references before room is made, so making room never takes a block it
+        // is about to reuse (a resumed least recently used conversation would evict its own parent's blocks, and its
+        // write fail on them). Every refusal below gives them back.
+        var pinned = false;
+        defer if (!ok and pinned) {
+            s.ref(p.blocks, -1);
+            s.gc(p.blocks);
+        };
+        if (!mut(.keep_unpinned)) {
+            s.ref(p.blocks, 1);
+            pinned = true;
+        }
+        s.trimOwn(p, need);
+        const room = s.floorShort(need);
+        const over = (s.stored_bytes + s.queued_bytes + need) -| s.cfg.cap_bytes;
+        if (@max(room, over) > s.stored_bytes) {
+            s.counters.no_space += 1;
+            return .no_space;
+        }
+        if (room > 0 or over > 0) {
+            s.makeRoom(@max(room, over), key);
+            if (s.floorShort(need) > 0 or s.stored_bytes + s.queued_bytes + need > s.cfg.cap_bytes) {
+                s.counters.no_space += 1;
+                return .no_space;
+            }
+        }
+        if (s.queued_bytes + size > s.cfg.backlog_bytes) {
+            s.counters.backlog_refused += 1;
+            return .backlog;
+        }
+        const id = s.next_id;
+        const small_slot = s.slots.take(.small, id) orelse {
+            s.counters.no_staging += 1;
+            return .no_staging;
+        };
+        var tail_slot: ?Slot = null;
+        if (tail != null) {
+            tail_slot = s.slots.take(.write, id) orelse {
+                s.slots.give(small_slot);
+                s.counters.no_staging += 1;
+                return .no_staging;
+            };
+        }
+        const j = gpa.create(WriteJob) catch {
+            s.slots.give(small_slot);
+            if (tail_slot) |t| s.slots.give(t);
+            return s.refuseOom();
+        };
+        j.* = .{ .id = id, .point = p, .source = k.source, .new = new, .tail = tail, .tail_slot = tail_slot, .small_slot = small_slot, .size = need, .ids = ids };
+        if (!pinned) { // (the keep_unpinned mutant: references taken only now)
+            s.ref(p.blocks, 1);
+            pinned = true;
+        }
+        s.registerJob(j) catch {
+            gpa.destroy(j);
+            s.slots.give(small_slot);
+            if (tail_slot) |t| s.slots.give(t);
+            return s.refuseOom();
+        };
+        ok = true;
+        ids_owned = false;
+        s.next_id += 1;
+        s.counters.queued += 1;
+        const small = s.slots.bytes(small_slot);
+        return .{ .queued = .{
+            .job = id,
+            .small = small[0..@intCast(p.small_bytes)],
+            .sections = p.sections,
+            .tail = if (tail_slot) |t| s.slots.bytes(t)[0..@intCast(k.tail_bytes)] else null,
+        } };
+    }
+
+    fn refuseOom(s: *Store) KeepResult {
+        s.counters.no_staging += 1;
+        return .no_staging;
+    }
+
+    /// A refusal decided before the lock (counted under it).
+    fn refuse(s: *Store, why: std.meta.Tag(KeepResult)) KeepResult {
+        s.lockS();
+        defer s.unlockS();
+        s.counters.keeps += 1;
+        switch (why) {
+            .short => s.counters.short += 1,
+            .invalid => s.counters.invalid += 1,
+            else => s.counters.no_staging += 1,
+        }
+        return switch (why) {
+            .short => .short,
+            .invalid => .invalid,
+            else => .no_staging,
+        };
+    }
+
+    /// Ids stored or on their way: not written again. Kept again as a shared prefix their point becomes shared,
+    /// durably (its manifest rewritten on the writer, or written so if it is still waiting).
+    fn alreadyKept(s: *Store, key: Digest, shared: bool) bool {
+        s.lockS();
+        defer s.unlockS();
+        if (s.points.get(key)) |p| {
+            s.counters.keeps += 1;
+            p.used = s.now();
+            s.queue(.{ .touch = .{ .key = key, .ns = p.used } });
+            if (shared and !p.shared and !mut(.no_upgrade)) {
+                p.shared = true;
+                s.counters.shared_marked += 1;
+                if (!mut(.upgrade_not_durable)) s.queue(.{ .shared = key });
+            }
+            s.counters.stored_skips += 1;
+            return true;
+        }
+        if (s.waiting.get(key)) |j| {
+            s.counters.keeps += 1;
+            if (shared and !j.point.shared and !mut(.waiting_not_flagged) and !mut(.no_upgrade)) {
+                j.point.shared = true; // its manifest takes the flag (or is rewritten after, if already written)
+                s.counters.shared_marked += 1;
+            }
+            s.counters.stored_skips += 1;
+            return true;
+        }
+        return false;
+    }
+
+    fn validKeep(s: *Store, k: Keep) bool {
+        const l = s.cfg.limits;
+        if (k.keyed.len > l.max_tokens) return false;
+        if (k.raw) |r| if (r.len != k.keyed.len) return false;
+        if (k.media.len > l.max_media or k.sections.len > l.max_sections or k.lineage.forks.len > l.max_forks) return false;
+        if (l.fullBlockBytes(k.lineage.part) == null) return false; // (owner-sharded: every point names its part)
+        // pictures: in order, inside the point, the keyed ids made from their digests and the raw ids beside them
+        if (!format.mediaIds(k.keyed, k.raw, k.media)) return false;
+        var total: u64 = 0;
+        for (k.sections) |sec| {
+            if (sec.name.len == 0 or sec.name.len > 32) return false;
+            total = std.mem.alignForward(u64, total, 256) + sec.len;
+        }
+        if (total > l.max_small_bytes or total > s.small_slot) return false;
+        const has_tail = k.keyed.len % l.block_tokens != 0;
+        if (has_tail and (k.tail_bytes == 0 or k.tail_bytes > l.block_bytes)) return false;
+        if (!has_tail and k.tail_bytes != 0) return false;
+        return true;
+    }
+
+    /// Bytes the floor would be short by after writing `need` more (queued writes count as written).
+    fn floorShort(s: *Store, need: u64) u64 {
+        if (mut(.floor_ignored)) return 0;
+        const want = s.cfg.floor_bytes + need + s.queued_bytes;
+        return want -| (s.disk_free + s.pending_free);
+    }
+
+    fn registerJob(s: *Store, j: *WriteJob) !void {
+        const gpa = s.gpa;
+        try s.jobs_by_id.ensureUnusedCapacity(gpa, 1);
+        try s.waiting.ensureUnusedCapacity(gpa, 1);
+        try s.fifo.ensureUnusedCapacity(gpa, 1);
+        try s.inflight.ensureUnusedCapacity(gpa, @intCast(j.new.items.len + 1));
+        s.jobs_by_id.putAssumeCapacity(j.id, j);
+        s.waiting.putAssumeCapacity(j.point.key, j);
+        for (j.new.items) |i| s.inflight.putAssumeCapacity(j.point.blocks[i].name, j.id);
+        if (j.tail) |i| s.inflight.putAssumeCapacity(j.point.blocks[i].name, j.id);
+        s.queued_bytes += j.size; // (its references were taken by `keep` before it made room)
+        s.fifo.appendAssumeCapacity(j);
+    }
+
+    /// The engine's capture of `job`'s small state (and tail) completed on the device (`ok`), or failed.
+    pub fn captured(s: *Store, job: JobId, ok: bool) void {
+        s.lockS();
+        defer s.unlockS();
+        const j = s.jobs_by_id.get(job) orelse return;
+        if (j.capture != .pending) return;
+        j.capture = if (ok) .ok else .failed;
+        if (!ok and j.state == .open) {
+            j.state = .failed;
+            j.fail = .capture;
+        }
+        if (j.tail) |ti| {
+            const slot = j.tail_slot.?;
+            j.tail_slot = null;
+            if (j.state == .open) {
+                j.outstanding += 1;
+                s.queue(.{ .block = .{ .job = j, .index = ti, .slot = slot } });
+            } else s.slots.give(slot);
+        }
+        s.settle(j);
+    }
+
+    /// Between rounds: the waiting points' next blocks, oldest point first, into free write slots (at most
+    /// `out.len`). The engine packs each one into `dst` from `source`'s rows (checking the source's generation)
+    /// and calls `staged` once its copy completed. Never waits.
+    pub fn stage(s: *Store, out: []StageReq) usize {
+        s.lockS();
+        defer s.unlockS();
+        var n: usize = 0;
+        var i: usize = 0;
+        while (i < s.fifo.items.len and n < out.len) {
+            const j = s.fifo.items[i];
+            if (j.state != .open) {
+                i += 1;
+                continue;
+            }
+            while (j.next < j.new.items.len and n < out.len) {
+                const slot = s.slots.take(.write, j.id) orelse return n;
+                out[n] = s.req(j, slot);
+                n += 1;
+            }
+            if (j.next >= j.new.items.len) {
+                j.listed = false;
+                _ = s.fifo.orderedRemove(i);
+            } else i += 1;
+        }
+        return n;
+    }
+
+    fn req(s: *Store, j: *WriteJob, slot: Slot) StageReq {
+        const idx = j.new.items[j.next];
+        j.next += 1;
+        j.outstanding += 1;
+        j.engine += 1;
+        s.counters.staged_blocks += 1;
+        const b = j.point.blocks[idx];
+        return .{
+            .ticket = .{ .job = j.id, .index = idx, .slot = slot },
+            .source = j.source,
+            .first = idx * s.cfg.limits.block_tokens,
+            .tokens = b.tokens,
+            .dst = s.slots.bytes(slot)[0..@intCast(b.bytes)],
+        };
+    }
+
+    /// The engine's copy into a staged slot completed (`ok`), or could not be made (the source changed): the
+    /// block goes to the writer, or the point is not written.
+    pub fn staged(s: *Store, t: Ticket, ok: bool) void {
+        s.lockS();
+        defer s.unlockS();
+        const j = s.jobs_by_id.get(t.job) orelse {
+            s.slots.give(t.slot);
+            return;
+        };
+        j.engine -= 1;
+        if (!ok and j.state == .open) {
+            j.state = .failed;
+            j.fail = .stage;
+            s.release(j);
+        }
+        if (j.state == .open or (ok and s.stillNamed(j, t.index))) {
+            s.queue(.{ .block = .{ .job = j, .index = t.index, .slot = t.slot } });
+        } else {
+            s.slots.give(t.slot);
+            j.outstanding -= 1;
+            s.dropInflight(j, t.index);
+            s.settle(j);
+        }
+    }
+
+    /// Whether another point or waiting write names block `index` of `j` (its bytes are worth writing anyway).
+    fn stillNamed(s: *Store, j: *WriteJob, index: u32) bool {
+        return (s.refs.get(j.point.blocks[index].name) orelse 0) > 1;
+    }
+
+    fn dropInflight(s: *Store, j: *WriteJob, index: u32) void {
+        const name = j.point.blocks[index].name;
+        if (s.inflight.get(name)) |owner| if (owner == j.id) {
+            _ = s.inflight.remove(name);
+            s.recheckParked();
+        };
+    }
+
+    /// Source rows `source.id` from token `from` on are about to change: waiting points still to stage blocks
+    /// there have them staged now into `out` (the engine queues those copies before the change, on its stream),
+    /// or, past the free slots or `out`, are cancelled. Points of an older generation of the source are cancelled.
+    pub fn guard(s: *Store, source: Source, from: u32, out: []StageReq) GuardResult {
+        s.lockS();
+        defer s.unlockS();
+        var r: GuardResult = .{};
+        var i: usize = 0;
+        while (i < s.fifo.items.len) {
+            const j = s.fifo.items[i];
+            i += 1;
+            if (j.state != .open or j.source.id != source.id) continue;
+            if (j.source.generation != source.generation) {
+                s.cancelJob(j, .source_gone);
+                r.cancelled += 1;
+                i = 0;
+                continue;
+            }
+            // the blocks left reaching past `from`
+            var needed: usize = 0;
+            for (j.new.items[j.next..]) |idx| {
+                const b = j.point.blocks[idx];
+                if (idx * s.cfg.limits.block_tokens + b.tokens > from) needed += 1;
+            }
+            if (needed == 0) continue;
+            const left = j.new.items.len - j.next;
+            if (left > out.len - r.staged or left > s.slots.available(.write) or mut(.guard_cancels_only)) {
+                s.cancelJob(j, .guard);
+                r.cancelled += 1;
+                i = 0;
+                continue;
+            }
+            while (j.next < j.new.items.len) {
+                out[r.staged] = s.req(j, s.slots.take(.write, j.id).?);
+                r.staged += 1;
+                s.counters.guard_staged += 1;
+            }
+            j.listed = false;
+            for (s.fifo.items, 0..) |x, k| if (x == j) {
+                _ = s.fifo.orderedRemove(k);
+                break;
+            };
+            i = 0;
+        }
+        return r;
+    }
+
+    /// Cancel an unpublished point (true), or false when it is past cancelling (already being published).
+    pub fn cancel(s: *Store, job: JobId) bool {
+        s.lockS();
+        defer s.unlockS();
+        const j = s.jobs_by_id.get(job) orelse return false;
+        if (j.state != .open) return j.state != .publishing;
+        s.cancelJob(j, .explicit);
+        return true;
+    }
+
+    fn cancelJob(s: *Store, j: *WriteJob, why: CancelReason) void {
+        j.state = .cancelled;
+        j.cancel = why;
+        switch (why) {
+            .guard => s.counters.cancelled_guard += 1,
+            .source_gone => s.counters.cancelled_source += 1,
+            else => {},
+        }
+        s.release(j);
+        s.settle(j);
+    }
+
+    /// A job that will not publish gives its unstaged blocks to another open job that names them (their rows are
+    /// the same bytes there, and their reservation moves with them), else lets their names go.
+    fn release(s: *Store, j: *WriteJob) void {
+        if (j.listed) {
+            for (s.fifo.items, 0..) |x, k| if (x == j) {
+                _ = s.fifo.orderedRemove(k);
+                break;
+            };
+            j.listed = false;
+        }
+        for (j.new.items[j.next..]) |idx| {
+            const name = j.point.blocks[idx].name;
+            if (!s.handOver(j, name)) {
+                if (s.inflight.get(name)) |owner| if (owner == j.id) {
+                    _ = s.inflight.remove(name);
+                };
+            }
+        }
+        j.next = j.new.items.len;
+        if (j.tail) |ti| if (j.tail_slot != null and j.capture != .pending) {
+            s.slots.give(j.tail_slot.?);
+            j.tail_slot = null;
+            s.dropInflight(j, ti);
+        };
+        s.recheckParked();
+    }
+
+    fn handOver(s: *Store, from: *WriteJob, name: Digest) bool {
+        var it = s.jobs_by_id.valueIterator();
+        while (it.next()) |kk| {
+            const k = kk.*;
+            if (k == from or k.state != .open) continue;
+            for (k.point.blocks, 0..) |b, idx| {
+                if (!std.mem.eql(u8, &b.name, &name) or b.tokens != s.cfg.limits.block_tokens) continue;
+                s.fifo.ensureUnusedCapacity(s.gpa, 1) catch return false;
+                k.new.append(s.gpa, @intCast(idx)) catch return false;
+                s.inflight.put(s.gpa, name, k.id) catch {
+                    _ = k.new.pop();
+                    return false;
+                };
+                if (!k.listed) {
+                    s.fifo.appendAssumeCapacity(k);
+                    k.listed = true;
+                }
+                // its bytes are now `k`'s to write: reserved with `k` (the giver's reservation ends with it)
+                if (!mut(.handover_unreserved)) {
+                    k.size += b.bytes;
+                    s.queued_bytes += b.bytes;
+                }
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /// Lock held: a job ready to publish goes to the writer; a failed or cancelled one with nothing outstanding
+    /// ends and frees its staging.
+    fn settle(s: *Store, j: *WriteJob) void {
+        switch (j.state) {
+            .open => if (j.next >= j.new.items.len and j.outstanding == 0 and j.capture == .ok and j.tail_slot == null) {
+                j.state = .publishing;
+                j.shared_at_write = j.point.shared;
+                s.queue(.{ .point = j });
+            },
+            .publishing => {},
+            .failed, .cancelled => if (j.outstanding == 0 and j.capture != .pending) s.endJob(j, false),
+        }
+    }
+
+    /// Lock held: `j` leaves (published or not); its references, names in flight, reservation and slots go.
+    fn endJob(s: *Store, j: *WriteJob, published: bool) void {
+        if (j.listed) {
+            for (s.fifo.items, 0..) |x, k| if (x == j) {
+                _ = s.fifo.orderedRemove(k);
+                break;
+            };
+        }
+        for (s.parked.items, 0..) |x, k| if (x == j) {
+            _ = s.parked.swapRemove(k);
+            break;
+        };
+        if (j.tail_slot) |t| s.slots.give(t);
+        s.slots.give(j.small_slot);
+        var it = s.inflight.iterator();
+        var drop: std.ArrayList(Digest) = .empty;
+        defer drop.deinit(s.gpa);
+        while (it.next()) |e| if (e.value_ptr.* == j.id) drop.append(s.gpa, e.key_ptr.*) catch {};
+        for (drop.items) |d| _ = s.inflight.remove(d);
+        _ = s.waiting.remove(j.point.key);
+        _ = s.jobs_by_id.remove(j.id);
+        s.queued_bytes -= j.size;
+        s.ref(j.point.blocks, -1);
+        s.gc(j.point.blocks);
+        const key = j.point.key;
+        if (published) {
+            s.complete(.{ .published = .{ .job = j.id, .key = key, .at = j.point.at } });
+        } else if (j.state == .cancelled) {
+            s.counters.cancelled += 1;
+            s.complete(.{ .cancelled = .{ .job = j.id, .key = key, .why = j.cancel } });
+        } else {
+            s.counters.write_failed += 1;
+            s.complete(.{ .failed = .{ .job = j.id, .key = key, .why = j.fail } });
+        }
+        freeJob(s.gpa, j, !published);
+        s.recheckParked();
+        s.done.broadcast(s.io);
+    }
+
+    fn recheckParked(s: *Store) void {
+        var i: usize = 0;
+        while (i < s.parked.items.len) {
+            const j = s.parked.items[i];
+            if (s.blocksSettled(j)) {
+                _ = s.parked.swapRemove(i);
+                j.parked = false;
+                s.queue(.{ .point = j });
+            } else i += 1;
+        }
+    }
+
+    /// Every block `j` names is on disk or no longer being written by anyone.
+    fn blocksSettled(s: *Store, j: *WriteJob) bool {
+        for (j.point.blocks) |b| if (!s.have.contains(b.name) and s.inflight.contains(b.name)) return false;
+        return true;
+    }
+
+    /// Completions since the last poll (published, failed, cancelled points), oldest first.
+    pub fn poll(s: *Store, out: []Completion) usize {
+        s.lockS();
+        defer s.unlockS();
+        const n = @min(out.len, s.completions.items.len);
+        @memcpy(out[0..n], s.completions.items[0..n]);
+        std.mem.copyForwards(Completion, s.completions.items, s.completions.items[n..]);
+        s.completions.shrinkRetainingCapacity(s.completions.items.len - n);
+        return n;
+    }
+
+    /// Unpublished points still waiting for the engine (blocks to stage or a capture to report).
+    pub fn pendingStage(s: *Store) usize {
+        s.lockS();
+        defer s.unlockS();
+        var n: usize = 0;
+        var it = s.jobs_by_id.valueIterator();
+        while (it.next()) |j| {
+            if (waitsOnEngine(j.*)) n += 1;
+        }
+        return n;
+    }
+
+    pub const Drain = struct { done: bool, unpublished: usize };
+
+    fn waitsOnEngine(j: *const WriteJob) bool {
+        if (j.engine > 0 or j.capture == .pending) return true;
+        return j.state == .open and j.next < j.new.items.len;
+    }
+
+    /// A clean stop or an idle engine: waits, at most `timeout_ns`, until every write the engine has handed over is
+    /// published and every queued metadata rewrite and deletion ran (a sync behind them). Points still waiting for
+    /// the engine (staging) are not waited for: they count in `unpublished`, as do those the deadline cut off.
+    pub fn drain(s: *Store, timeout_ns: u64) Drain {
+        const deadline = std.Io.Clock.awake.now(s.io).toNanoseconds() + timeout_ns;
+        s.lockS();
+        defer s.unlockS();
+        while (true) {
+            var engine_wait: usize = 0;
+            var writer_wait: usize = 0;
+            var it = s.jobs_by_id.valueIterator();
+            while (it.next()) |jj| {
+                const j = jj.*;
+                if (waitsOnEngine(j)) engine_wait += 1 else writer_wait += 1;
+            }
+            if (writer_wait == 0 and mut(.drain_skips_rewrites)) return .{ .done = engine_wait == 0, .unpublished = engine_wait };
+            if (writer_wait == 0) {
+                s.sync_sent += 1;
+                const want = s.sync_sent;
+                s.queue(.{ .sync = want });
+                while (s.sync_done < want) {
+                    const left = deadline - std.Io.Clock.awake.now(s.io).toNanoseconds();
+                    if (left <= 0 or s.crashed) return .{ .done = false, .unpublished = engine_wait };
+                    s.done.waitTimeout(s.io, &s.mutex, .{ .duration = .{ .raw = .fromNanoseconds(@min(left, 50 * std.time.ns_per_ms)), .clock = .awake } }) catch {};
+                }
+                return .{ .done = engine_wait == 0, .unpublished = engine_wait };
+            }
+            const left = deadline - std.Io.Clock.awake.now(s.io).toNanoseconds();
+            if (left <= 0 or s.crashed) return .{ .done = false, .unpublished = engine_wait + writer_wait };
+            s.done.waitTimeout(s.io, &s.mutex, .{ .duration = .{ .raw = .fromNanoseconds(@min(left, 50 * std.time.ns_per_ms)), .clock = .awake } }) catch {};
+        }
+    }
+
+    /// Whether unpublished points still read `source`'s rows from token `from` on (they pin those rows).
+    pub fn pins(s: *Store, source: Source, from: u32) bool {
+        s.lockS();
+        defer s.unlockS();
+        for (s.fifo.items) |j| {
+            if (j.state != .open or j.source.id != source.id) continue;
+            for (j.new.items[j.next..]) |idx| if (idx * s.cfg.limits.block_tokens + j.point.blocks[idx].tokens > from) return true;
+        }
+        return false;
+    }
+
+    /// pins(.{ .id = ids[i] }, 0) for every id under one lock and one walk of the write fifo: `out[i]` whether an
+    /// unpublished point still reads source `ids[i]`'s rows (any unstaged block). `out.len == ids.len`.
+    pub fn pinsAny(s: *Store, ids: []const u64, out: []bool) void {
+        std.debug.assert(out.len == ids.len);
+        @memset(out, false);
+        if (ids.len == 0) return;
+        s.lockS();
+        defer s.unlockS();
+        for (s.fifo.items) |j| {
+            if (j.state != .open) continue;
+            const i = std.mem.indexOfScalar(u64, ids, j.source.id) orelse continue;
+            if (out[i]) continue;
+            for (j.new.items[j.next..]) |idx| if (idx * s.cfg.limits.block_tokens + j.point.blocks[idx].tokens > 0) {
+                out[i] = true;
+                break;
+            };
+        }
+    }
+
+    // -- the writer thread ---------------------------------------------------------------------------------------
+    fn writerLoop(s: *Store) void {
+        s.lockS();
+        defer s.unlockS();
+        while (true) {
+            while (s.task_head >= s.tasks.items.len and !s.stopping) s.work.waitUncancelable(s.io, &s.mutex);
+            if (s.task_head >= s.tasks.items.len) break;
+            const t = s.tasks.items[s.task_head];
+            s.task_head += 1;
+            if (s.task_head == s.tasks.items.len) {
+                s.tasks.clearRetainingCapacity();
+                s.task_head = 0;
+            }
+            if (s.stopping) {
+                switch (t) {
+                    .block, .point => {
+                        s.dropTask(t);
+                        continue;
+                    },
+                    else => {},
+                }
+            }
+            if (s.crashed) {
+                s.dropTask(t);
+                continue;
+            }
+            s.busy += 1;
+            s.runTask(t);
+            s.busy -= 1;
+            s.done.broadcast(s.io);
+        }
+    }
+
+    /// Lock held: a task that will not run (a stop, or a simulated crash) gives back what it holds.
+    fn dropTask(s: *Store, t: Task) void {
+        switch (t) {
+            .block => |b| {
+                s.slots.give(b.slot);
+                b.job.outstanding -= 1;
+                if (b.job.state == .open) {
+                    b.job.state = .failed;
+                    b.job.fail = .crashed;
+                }
+                s.dropInflight(b.job, b.index);
+                if (!s.crashed) s.settle(b.job);
+            },
+            .point => |j| if (!s.crashed) {
+                j.state = .failed;
+                j.fail = .crashed;
+                s.endJob(j, false);
+            },
+            .sync => |g| s.sync_done = @max(s.sync_done, g),
+            else => {},
+        }
+        s.done.broadcast(s.io);
+    }
+
+    /// Lock held on entry and exit; released around the disk work.
+    fn runTask(s: *Store, t: Task) void {
+        switch (t) {
+            .block => |b| s.writeBlock(b.job, b.index, b.slot),
+            .point => |j| s.writePoint(j),
+            .shared => |k| s.rewriteShared(k),
+            .touch => |x| {
+                var nb: [80]u8 = undefined;
+                const name = pointName(&nb, &x.key, ".man");
+                s.unlockS();
+                fsio.touchAt(s.points_fd, name, x.ns);
+                s.lockS();
+            },
+            .unlink_block => |x| {
+                var nb: [80]u8 = undefined;
+                const name = blockName(&nb, &x.name);
+                s.unlockS();
+                fsio.unlinkAt(s.blocks_fd, name);
+                const free = fsio.diskFree(&s.hooks, s.blocks_fd);
+                s.lockS();
+                s.disk_free = free;
+                s.pending_free -|= x.bytes;
+            },
+            .unlink_point => |x| {
+                s.unlockS();
+                s.unlinkPointFiles(x.key);
+                const free = fsio.diskFree(&s.hooks, s.blocks_fd);
+                s.lockS();
+                s.disk_free = free;
+                s.pending_free -|= x.bytes;
+            },
+            .sync => |g| s.sync_done = @max(s.sync_done, g),
+        }
+    }
+
+    fn unlinkPointFiles(s: *Store, key: Digest) void {
+        var nb: [80]u8 = undefined;
+        fsio.unlinkAt(s.points_fd, pointName(&nb, &key, ".man")); // the manifest first: the point is gone at once
+        fsio.unlinkAt(s.points_fd, pointName(&nb, &key, ".st"));
+        fsio.unlinkAt(s.points_fd, pointName(&nb, &key, ".ids"));
+    }
+
+    fn crash(s: *Store, step: fsio.Step, name: []const u8) bool {
+        if (!fsio.crashAt(&s.hooks, step, name)) return false;
+        s.lockS();
+        s.crashed = true;
+        s.unlockS();
+        return true;
+    }
+
+    /// The writer: one block (CRC-32 and SHA-256 of its bytes), or a hard link to a block on disk with the same
+    /// bytes. Lock held on entry and exit.
+    fn writeBlock(s: *Store, j: *WriteJob, index: u32, slot: Slot) void {
+        if (j.state != .open and !s.stillNamed(j, index)) { // cancelled meanwhile and nobody else names it
+            s.slots.give(slot);
+            j.outstanding -= 1;
+            s.dropInflight(j, index);
+            s.settle(j);
+            return;
+        }
+        const b = j.point.blocks[index];
+        const data = s.slots.bytes(slot);
+        const len: usize = @intCast(b.bytes);
+        s.unlockS();
+        const crc = format.crc32(data[0..len]);
+        const sha = format.sha256(data[0..len]);
+        s.lockS();
+        var same: ?Digest = null;
+        if (s.content.get(sha)) |other| {
+            if (s.have.get(other)) |info| if (info.crc == crc and info.bytes == b.bytes) {
+                same = other;
+            };
+        }
+        if (same == null and mut(.dedup_without_sha)) {
+            var hit = s.have.iterator();
+            while (hit.next()) |e| if (e.value_ptr.crc == crc and e.value_ptr.bytes == b.bytes) {
+                same = e.key_ptr.*;
+                break;
+            };
+        }
+        s.unlockS();
+        var nb: [80]u8 = undefined;
+        const name = blockName(&nb, &b.name);
+        var linked = false;
+        var failed: ?WriteFailure = null;
+        var crashed = false;
+        if (same) |other| {
+            var ob: [80]u8 = undefined;
+            var tb: [160]u8 = undefined;
+            const tmp = s.writer.tmpName(&tb, name);
+            if (fsio.linkAt(s.blocks_fd, blockName(&ob, &other), tmp)) {
+                if (s.crash(.linked, name)) {
+                    crashed = true;
+                } else if (fsio.renameAt(&s.hooks, s.blocks_fd, tmp, name)) {
+                    linked = true;
+                } else |_| fsio.unlinkAt(s.blocks_fd, tmp);
+            } else |_| {} // gone meanwhile: written below instead
+        }
+        if (!linked and !crashed) {
+            _ = s.writer.put(s.blocks_fd, name, .{ .aligned = .{ .buf = data, .len = len } }) catch |e| {
+                if (e == error.Crashed) {
+                    s.lockS();
+                    s.crashed = true;
+                    s.unlockS();
+                    crashed = true;
+                } else failed = if (e == error.NoSpace) .no_space else .io;
+            };
+        }
+        var ino: u64 = 0;
+        if (failed == null and !crashed) {
+            if (fsio.statAt(s.blocks_fd, name)) |st| ino = st.ino else |_| failed = .io;
+        }
+        const free = fsio.diskFree(&s.hooks, s.blocks_fd);
+        s.lockS();
+        s.disk_free = free;
+        s.counters.direct_refused = s.writer.direct_refused.load(.monotonic);
+        s.slots.give(slot);
+        j.outstanding -= 1;
+        if (crashed) return;
+        if (failed) |why| {
+            if (j.state == .open) {
+                j.state = .failed;
+                j.fail = why;
+                s.release(j);
+            }
+        } else {
+            s.addBlock(b.name, crc, sha, ino, b.bytes) catch {};
+            if (linked) {
+                s.counters.dedup_blocks += 1;
+                s.counters.dedup_bytes += b.bytes;
+            } else {
+                s.counters.written_blocks += 1;
+                s.counters.written_bytes += b.bytes;
+            }
+        }
+        s.dropInflight(j, index);
+        s.settle(j);
+    }
+
+    /// The writer: a point whose blocks are all handed over. Its blocks durable first (the directory fsynced),
+    /// then its ids and small state, the directory again, then the manifest, then the directory: only now is the
+    /// point readable. Lock held on entry and exit.
+    fn writePoint(s: *Store, j: *WriteJob) void {
+        const gpa = s.gpa;
+        const p = j.point;
+        if (j.state != .publishing) {
+            s.settle(j);
+            return;
+        }
+        if (!s.blocksSettled(j)) { // a block another write owns is still on its way
+            j.parked = true;
+            s.parked.append(gpa, j) catch {};
+            return;
+        }
+        for (p.blocks) |*b| {
+            const info = s.have.get(b.name) orelse return s.failPoint(j, .missing_block);
+            b.crc = info.crc;
+            b.sha = info.sha;
+        }
+        const shared = p.shared;
+        const small = s.slots.bytes(j.small_slot);
+        s.unlockS();
+        var why: ?WriteFailure = null;
+        var crashed = false;
+        var nb: [80]u8 = undefined;
+        var nb2: [80]u8 = undefined;
+        var nb3: [80]u8 = undefined;
+        var man_bytes: u64 = 0;
+        p.ids_crc = format.crc32(j.ids);
+        for (p.sections) |*sec| sec.crc = format.crc32(small[@intCast(sec.offset)..][0..@intCast(sec.len)]);
+        p.small_crc = format.crc32(small[0..@intCast(p.small_bytes)]);
+        publish: {
+            fsio.syncDir(&s.hooks, s.blocks_fd, "blocks") catch {
+                why = .io;
+                break :publish;
+            };
+            if (s.crash(.dir_synced, "blocks")) {
+                crashed = true;
+                break :publish;
+            }
+            var m = manifestOf(p, shared, s.cfg.limits.block_tokens, s.cfg.owner_layout);
+            const raw = m.encode(gpa, s.cfg.compat) catch {
+                why = .io;
+                break :publish;
+            };
+            defer gpa.free(raw);
+            man_bytes = raw.len;
+            const files = [_]struct { name: [:0]const u8, src: fsio.Source }{
+                .{ .name = pointName(&nb, &p.key, ".ids"), .src = .{ .parts = &.{j.ids} } },
+                .{ .name = pointName(&nb2, &p.key, ".st"), .src = .{ .aligned = .{ .buf = small, .len = @intCast(p.small_bytes) } } },
+                .{ .name = pointName(&nb3, &p.key, ".man"), .src = .{ .parts = &.{raw} } },
+            };
+            const order: [3]usize = if (mut(.manifest_not_last)) .{ 2, 0, 1 } else .{ 0, 1, 2 };
+            for (order) |fi| {
+                if (fi == 2) { // the manifest last: the files it names durable first
+                    fsio.syncDir(&s.hooks, s.points_fd, "points") catch {
+                        why = .io;
+                        break :publish;
+                    };
+                    if (s.crash(.dir_synced, "points")) {
+                        crashed = true;
+                        break :publish;
+                    }
+                }
+                _ = s.writer.put(s.points_fd, files[fi].name, files[fi].src) catch |e| {
+                    if (e == error.Crashed) crashed = true else why = if (e == error.NoSpace) .no_space else .io;
+                    break :publish;
+                };
+            }
+            fsio.syncDir(&s.hooks, s.points_fd, "points") catch {
+                why = .io;
+                break :publish;
+            };
+            if (s.crash(.published, "points")) {
+                crashed = true;
+                break :publish;
+            }
+        }
+        const free = fsio.diskFree(&s.hooks, s.blocks_fd);
+        s.lockS();
+        s.disk_free = free;
+        if (crashed) {
+            s.crashed = true;
+            return;
+        }
+        if (why) |w| {
+            s.unlockS();
+            s.unlinkPointFiles(p.key);
+            s.lockS();
+            return s.failPoint(j, w);
+        }
+        for (p.blocks) |b| if (!s.have.contains(b.name)) {
+            s.queue(.{ .unlink_point = .{ .key = p.key, .bytes = 0 } }); // a block it names was dropped while it was written
+            return s.failPoint(j, .missing_block);
+        };
+        p.files = man_bytes + p.ids_bytes + p.small_bytes;
+        p.used = s.now();
+        s.points.put(gpa, p.key, p) catch {
+            s.queue(.{ .unlink_point = .{ .key = p.key, .bytes = 0 } });
+            return s.failPoint(j, .io);
+        };
+        s.ref(p.blocks, 1); // its own reference; the waiting one goes in endJob
+        s.adopt(p);
+        s.stored_bytes += p.files;
+        s.counters.committed += 1;
+        s.counters.written_small_bytes += p.small_bytes;
+        s.endJob(j, true);
+        if (p.shared and !shared and !mut(.written_no_rewrite)) s.queue(.{ .shared = p.key }); // made shared while it was written
+        s.trimPath(p);
+    }
+
+    fn failPoint(s: *Store, j: *WriteJob, why: WriteFailure) void {
+        j.state = .failed;
+        j.fail = why;
+        s.endJob(j, false);
+    }
+
+    fn manifestOf(p: *const Point, shared: bool, block_tokens: u32, layout: format.OwnerLayout) format.Manifest {
+        return .{
+            .key = p.key, .at = p.at, .block_tokens = block_tokens, .owner_layout = layout, .flags = .{ .shared = shared, .has_raw = p.has_raw, .mutable_tail = p.mutable_tail },
+            .group = p.group, .created_ns = p.created_ns, .lineage = p.lineage, .origin = p.origin, .ids_bytes = p.ids_bytes,
+            .ids_crc = p.ids_crc, .small_bytes = p.small_bytes, .small_crc = p.small_crc, .media = p.media, .blocks = p.blocks,
+            .sections = p.sections,
+        };
+    }
+
+    /// The writer: point `key`'s manifest again with its shared flag (temporary name, fsync, rename, directory
+    /// fsync, like its first write). A point dropped before is left alone; one dropped while this ran loses the
+    /// manifest this wrote back (no resurrection). Lock held on entry and exit.
+    fn rewriteShared(s: *Store, key: Digest) void {
+        const gpa = s.gpa;
+        const p = s.points.get(key) orelse return;
+        var m = manifestOf(p, p.shared, s.cfg.limits.block_tokens, s.cfg.owner_layout);
+        const raw = m.encode(gpa, s.cfg.compat) catch return;
+        defer gpa.free(raw);
+        var nb: [80]u8 = undefined;
+        const name = pointName(&nb, &key, ".man");
+        s.unlockS();
+        var crashed = false;
+        const ok = blk: {
+            if (mut(.rewrite_not_put)) {
+                const fd = c.openat(s.points_fd, name, .{ .ACCMODE = .WRONLY, .TRUNC = true, .CLOEXEC = true }, @as(c.mode_t, 0));
+                if (fd < 0) break :blk false;
+                fsio.pwriteAll(&s.hooks, fd, raw, 0) catch {};
+                _ = c.close(fd);
+            } else _ = s.writer.put(s.points_fd, name, .{ .parts = &.{raw} }) catch |e| {
+                crashed = e == error.Crashed;
+                break :blk false;
+            };
+            if (!mut(.rewrite_no_dir_fsync)) fsio.syncDir(&s.hooks, s.points_fd, "points") catch break :blk false;
+            if (s.crash(.rewritten, name)) {
+                crashed = true;
+                break :blk false;
+            }
+            break :blk true;
+        };
+        s.lockS();
+        if (crashed) {
+            s.crashed = true;
+            return;
+        }
+        if (ok) s.counters.shared_rewrites += 1;
+        if (ok and s.points.get(key) == p) s.queue(.{ .touch = .{ .key = key, .ns = p.used } }); // its last use, kept
+        if (s.points.get(key) != p and !mut(.rewrite_resurrects)) {
+            s.unlockS();
+            fsio.unlinkAt(s.points_fd, name);
+            s.lockS();
+        }
+    }
+
+    // -- lookups (engine thread) ---------------------------------------------------------------------------------
+    /// The longest complete point `q.keyed` extends with the same media before its cut, within `q`'s bounds, or
+    /// null. Points being written do not count. The prompt's block chain is hashed outside the lock, only as far as
+    /// the longest candidate needs; the comparison under it is digests and a tail of ids.
+    pub fn lookup(s: *Store, q: Query) ?Hit {
+        const gpa = s.gpa;
+        const block = s.cfg.limits.block_tokens;
+        var need: usize = 0;
+        {
+            s.lockS();
+            defer s.unlockS();
+            s.counters.disk_lookups += 1;
+            var it = s.points.valueIterator();
+            while (it.next()) |pp| if (eligible(pp.*, q)) {
+                need = @max(need, pp.*.chain.len);
+            };
+        }
+        const chain = gpa.alloc(Digest, need) catch return null;
+        defer gpa.free(chain);
+        var prev: Digest = undefined;
+        std.crypto.hash.sha2.Sha256.hash("tf-spill/ids", &prev, .{});
+        for (chain, 0..) |*d, i| {
+            var h = std.crypto.hash.sha2.Sha256.init(.{});
+            h.update(&prev);
+            h.update(std.mem.sliceAsBytes(q.keyed[i * block .. (i + 1) * block]));
+            h.final(&prev);
+            d.* = prev;
+        }
+        s.lockS();
+        defer s.unlockS();
+        var best: ?*Point = null;
+        var it = s.points.valueIterator();
+        while (it.next()) |pp| {
+            const p = pp.*;
+            if (!eligible(p, q) or p.chain.len > chain.len) continue;
+            if (best != null and (p.at < best.?.at or (p.at == best.?.at and p.used <= best.?.used))) continue;
+            var same = true;
+            for (p.chain, chain[0..p.chain.len]) |a, b| if (!std.mem.eql(u8, &a, &b)) {
+                same = false;
+                break;
+            };
+            if (!same) continue;
+            const whole = p.chain.len * block;
+            if (!std.mem.eql(u32, p.tail, q.keyed[whole..p.at])) continue;
+            if (!mediaMatch(p, q.media)) continue;
+            if (!s.complete_(p)) continue;
+            best = p;
+        }
+        const b = best orelse return null;
+        s.counters.disk_hits += 1;
+        return .{ .key = b.key, .at = b.at, .shared = b.shared, .group = b.group, .part = b.lineage.part };
+    }
+
+    fn eligible(p: *const Point, q: Query) bool {
+        if (p.at <= q.longer_than or p.at > q.max_at or p.at > q.keyed.len) return false;
+        return q.grid == 0 or p.at % q.grid == 0;
+    }
+
+    fn mediaMatch(p: *const Point, media: []const Media) bool {
+        var i: usize = 0;
+        for (media) |m| {
+            if (m.start >= p.at) continue;
+            if (i >= p.media.len or !p.media[i].eql(m)) return false;
+            i += 1;
+        }
+        return i == p.media.len;
+    }
+
+    fn complete_(s: *Store, p: *const Point) bool {
+        for (p.blocks) |b| if (!s.have.contains(b.name)) return false;
+        return true;
+    }
+
+    /// Whether this rank holds `key` complete (manifest, ids, small state, every block): what a rank answers to
+    /// the all-rank presence check.
+    /// Rank 0 asks every rank `has` with the point digest in the ordered stream; every rank answers with this, and
+    /// nobody reads unless all hold it.
+    pub fn presence(s: *Store, key: Digest) bool {
+        s.lockS();
+        defer s.unlockS();
+        const p = s.points.get(key) orelse return false;
+        return s.complete_(p);
+    }
+
+    /// The part salt of the point `key` this rank holds (null inside: a part-less point), or null when it holds none.
+    /// An owner-sharded rank checks it against the part a restore names: the same ids kept from another part are
+    /// other bytes here.
+    pub fn partOf(s: *Store, key: Digest) ?struct { part: ?u32 } {
+        s.lockS();
+        defer s.unlockS();
+        const p = s.points.get(key) orelse return null;
+        return .{ .part = p.lineage.part };
+    }
+
+    /// `key` was used now (its manifest's time follows, on the writer).
+    pub fn touch(s: *Store, key: Digest) void {
+        s.lockS();
+        defer s.unlockS();
+        const p = s.points.get(key) orelse return;
+        p.used = s.now();
+        s.queue(.{ .touch = .{ .key = key, .ns = p.used } });
+    }
+
+    /// Makes a stored point a shared prefix, durably (its manifest rewritten on the writer).
+    pub fn markShared(s: *Store, key: Digest) void {
+        s.lockS();
+        defer s.unlockS();
+        if (s.points.get(key)) |p| {
+            if (!p.shared) {
+                p.shared = true;
+                s.counters.shared_marked += 1;
+                s.queue(.{ .shared = key });
+            }
+        } else if (s.waiting.get(key)) |j| j.point.shared = true;
+    }
+
+    // -- reads (engine thread, readers) --------------------------------------------------------------------------
+    pub const BeginError = error{ Missing, NoSlot, TooMany, OutOfMemory };
+
+    /// Starts reading point `key`: its small state into a restore slot and its blocks, in order, into read slots as
+    /// they come free (several restores share the slots fairly). The point is pinned against eviction until
+    /// `endRead`. NoSlot / TooMany: defer the restore.
+    pub fn beginRead(s: *Store, key: Digest) BeginError!ReadId {
+        const gpa = s.gpa;
+        s.lockS();
+        defer s.unlockS();
+        const p = s.points.get(key) orelse return error.Missing;
+        if (!s.complete_(p)) return error.Missing;
+        if (s.liveReads() >= s.cfg.max_reads) {
+            s.counters.read_deferred += 1;
+            return error.TooMany;
+        }
+        const id = s.next_id;
+        const small_slot = s.slots.take(.restore, id) orelse {
+            s.counters.read_deferred += 1;
+            return error.NoSlot;
+        };
+        errdefer s.slots.give(small_slot);
+        const r = try gpa.create(ReadJob);
+        errdefer gpa.destroy(r);
+        const n: u32 = @intCast(p.blocks.len);
+        r.* = .{ .id = id, .point = p, .total = n, .state = try gpa.alloc(ReadJob.BState, n), .slot = undefined, .small_slot = small_slot, .t0 = std.Io.Clock.awake.now(s.io).toNanoseconds() };
+        errdefer gpa.free(r.state);
+        r.slot = try gpa.alloc(Slot, n);
+        errdefer gpa.free(r.slot);
+        @memset(r.state, .idle);
+        try s.reads.append(gpa, r);
+        errdefer _ = s.reads.pop();
+        const gop = try s.reading.getOrPut(gpa, key);
+        gop.value_ptr.* = if (gop.found_existing) gop.value_ptr.* + 1 else 1;
+        p.pins += 1;
+        s.next_id += 1;
+        p.used = s.now();
+        s.queue(.{ .touch = .{ .key = key, .ns = p.used } });
+        r.disk += 1;
+        s.rtasks.append(gpa, .{ .job = r, .index = null, .slot = small_slot }) catch {
+            r.disk -= 1;
+            r.small = .failed;
+            r.err = .io;
+        };
+        s.assign();
+        s.rwork.broadcast(s.io);
+        return id;
+    }
+
+    fn readJob(s: *Store, id: ReadId) ?*ReadJob {
+        for (s.reads.items) |r| if (r.id == id and !r.ended) return r;
+        return null;
+    }
+
+    /// Whether beginRead would refuse for capacity now (TooMany: max_reads in flight; NoSlot: no restore slot free),
+    /// changing nothing: a tier asks before the prompt cache makes room for a restore.
+    pub fn readsFull(s: *Store) bool {
+        s.lockS();
+        defer s.unlockS();
+        return s.liveReads() >= s.cfg.max_reads or s.slots.available(.restore) == 0;
+    }
+
+    fn liveReads(s: *Store) usize {
+        var n: usize = 0;
+        for (s.reads.items) |r| n += @intFromBool(!r.ended);
+        return n;
+    }
+
+    /// Lock held: free read slots go to the next blocks of the restores in flight, each to the restore holding the
+    /// fewest slots (ties in turn), so one large restore cannot keep another waiting for the whole ring.
+    fn assign(s: *Store) void {
+        const n = s.reads.items.len;
+        while (s.slots.available(.read) > 0 and n > 0) {
+            var pick: ?*ReadJob = null;
+            for (0..n) |k| {
+                const r = s.reads.items[(s.read_turn + k) % n];
+                if (r.ended or r.err != null or r.next_assign >= r.total) continue;
+                if (pick == null or r.held < pick.?.held) pick = r;
+            }
+            const r = pick orelse break;
+            s.read_turn +%= 1;
+            const slot = s.slots.take(.read, r.id) orelse break;
+            const i = r.next_assign;
+            r.next_assign += 1;
+            r.state[i] = .reading;
+            r.slot[i] = slot;
+            r.disk += 1;
+            r.held += 1;
+            s.rtasks.append(s.gpa, .{ .job = r, .index = i, .slot = slot }) catch {
+                r.disk -= 1;
+                r.held -= 1;
+                r.state[i] = .failed;
+                r.err = .io;
+                s.slots.give(slot);
+                continue;
+            };
+        }
+        s.rwork.broadcast(s.io);
+    }
+
+    fn giveRead(s: *Store, r: *ReadJob, slot: Slot) void {
+        s.slots.give(slot);
+        r.held -= 1;
+    }
+
+    fn readerLoop(s: *Store) void {
+        s.lockS();
+        defer s.unlockS();
+        while (true) {
+            while (s.rtask_head >= s.rtasks.items.len and !s.stopping) s.rwork.waitUncancelable(s.io, &s.mutex);
+            if (s.stopping) break;
+            const t = s.rtasks.items[s.rtask_head];
+            s.rtask_head += 1;
+            if (s.rtask_head == s.rtasks.items.len) {
+                s.rtasks.clearRetainingCapacity();
+                s.rtask_head = 0;
+            }
+            const r = t.job;
+            if (r.ended or (r.err != null and t.index != null)) {
+                if (t.index) |i| {
+                    s.giveRead(r, t.slot);
+                    r.state[i] = .failed;
+                } else if (r.ended) s.slots.give(t.slot); // the small slot: its reader gives it back once ended
+                r.disk -= 1;
+                s.maybeFreeRead(r);
+                s.assign();
+                continue;
+            }
+            if (t.index) |i| {
+                const b = r.point.blocks[i];
+                const buf = s.slots.bytes(t.slot);
+                s.unlockS();
+                const got = s.readBlock(b, buf);
+                s.lockS();
+                r.disk -= 1;
+                if (r.ended) {
+                    s.giveRead(r, t.slot);
+                    r.state[i] = .failed;
+                } else if (got) |_| {
+                    r.state[i] = .ready;
+                } else |e| {
+                    r.state[i] = .failed;
+                    s.giveRead(r, t.slot); // (never handed: its slot comes back now, or the job could never end)
+                    s.readFailed(r, b.name, e);
+                }
+            } else {
+                const buf = s.slots.bytes(t.slot);
+                const p = r.point;
+                s.unlockS();
+                const ok = s.readSmall(p, buf);
+                s.lockS();
+                r.disk -= 1;
+                if (r.ended) {
+                    s.slots.give(t.slot);
+                } else if (ok) r.small = .ready else {
+                    r.small = .failed;
+                    if (r.err == null) r.err = .small;
+                    s.counters.crc_errors += 1;
+                }
+            }
+            if (r.ended) {
+                s.maybeFreeRead(r);
+                s.assign();
+            }
+            s.done.broadcast(s.io);
+        }
+    }
+
+    const BlockReadError = error{ Missing, Damaged, Io };
+
+    /// A reader: block `b` into `buf` (O_DIRECT where it works), its size and CRC-32 checked. Missing: its name is
+    /// gone (links to its bytes are not in question). Damaged: wrong size, short, or CRC mismatch.
+    fn readBlock(s: *Store, b: format.BlockRef, buf: slots_mod.Buffer) BlockReadError!void {
+        var nb: [80]u8 = undefined;
+        var f = fsio.openRead(s.blocks_fd, blockName(&nb, &b.name), s.cfg.direct and !s.hooks.no_direct) catch |e| return if (e == error.Missing) error.Missing else error.Io;
+        defer f.close();
+        const st = fsio.statFd(f.fd) catch return error.Io;
+        if (st.size != b.bytes) return error.Damaged;
+        const len: usize = @intCast(b.bytes);
+        const got = f.read(buf, 0, len) catch |e| return if (e == error.EndOfFile) error.Damaged else error.Io;
+        std.debug.assert(got.ptr == buf.ptr);
+        if (!f.direct) fsio.dropPages(&s.hooks, f.fd, "block");
+        if (format.crc32(buf[0..len]) != b.crc) return error.Damaged;
+    }
+
+    fn readSmall(s: *Store, p: *const Point, buf: slots_mod.Buffer) bool {
+        var nb: [80]u8 = undefined;
+        var f = fsio.openRead(s.points_fd, pointName(&nb, &p.key, ".st"), s.cfg.direct and !s.hooks.no_direct) catch return false;
+        defer f.close();
+        const st = fsio.statFd(f.fd) catch return false;
+        if (st.size != p.small_bytes) return false;
+        const len: usize = @intCast(p.small_bytes);
+        if (len == 0) return p.small_crc == format.crc32(&.{});
+        _ = f.read(buf, 0, len) catch return false;
+        if (!f.direct) fsio.dropPages(&s.hooks, f.fd, "small");
+        if (format.crc32(buf[0..len]) != p.small_crc) return false;
+        for (p.sections) |sec| if (format.crc32(buf[@intCast(sec.offset)..][0..@intCast(sec.len)]) != sec.crc) return false;
+        return true;
+    }
+
+    fn readFailed(s: *Store, r: *ReadJob, name: Digest, e0: BlockReadError) void {
+        const e = if (mut(.lost_is_damage) and e0 == error.Missing) error.Damaged else e0;
+        switch (e) {
+            error.Missing => {
+                r.lost.append(s.gpa, name) catch {};
+                s.counters.missing_errors += 1;
+                if (r.err == null) r.err = .missing;
+            },
+            error.Damaged => {
+                r.bad.append(s.gpa, name) catch {};
+                s.counters.crc_errors += 1;
+                if (r.err == null) r.err = .damaged;
+            },
+            error.Io => if (r.err == null) {
+                r.err = .io;
+            },
+        }
+    }
+
+    /// Between rounds: `id`'s next blocks read and checked, in order, before block `upto` (null: all), at most
+    /// `out.len`. The engine copies each into the destination and calls `readRelease` once that copy completed
+    /// (a slot goes back to the readers then). `.waiting`: the next block is not read yet.
+    pub fn readReady(s: *Store, id: ReadId, upto: ?u32, out: []ReadyBlock) struct { n: usize, status: ReadStatus } {
+        s.lockS();
+        defer s.unlockS();
+        const r = s.readJob(id) orelse return .{ .n = 0, .status = .failed };
+        const stop = if (mut(.loadpart_past_upto)) r.total else @min(upto orelse r.total, r.total);
+        var n: usize = 0;
+        while (r.next_hand < stop and n < out.len) {
+            const i = r.next_hand;
+            switch (r.state[i]) {
+                .ready => {},
+                .failed => return .{ .n = n, .status = .failed },
+                else => break,
+            }
+            r.state[i] = .handed;
+            r.next_hand += 1;
+            const b = r.point.blocks[i];
+            out[n] = .{ .index = i, .first = i * s.cfg.limits.block_tokens, .tokens = b.tokens, .data = s.slots.bytes(r.slot[i])[0..@intCast(b.bytes)], .slot = r.slot[i] };
+            s.counters.loaded_bytes += b.bytes;
+            n += 1;
+        }
+        if (r.err != null and r.next_hand < stop and r.state[r.next_hand] != .ready) return .{ .n = n, .status = .failed };
+        if (r.next_hand >= r.total) return .{ .n = n, .status = .done };
+        if (r.next_hand >= stop) return .{ .n = n, .status = .done };
+        return .{ .n = n, .status = if (r.state[r.next_hand] == .ready) .more else .waiting };
+    }
+
+    /// The engine's copy out of `slot` completed: it goes back to the readers.
+    pub fn readRelease(s: *Store, slot: Slot) void {
+        s.lockS();
+        defer s.unlockS();
+        const holder = s.slots.holder(slot);
+        for (s.reads.items) |r| if (r.id == holder) {
+            r.held -= 1;
+            break;
+        };
+        s.slots.give(slot);
+        if (holder != 0) for (s.reads.items) |r| if (r.id == holder) {
+            s.maybeFreeRead(r);
+            break;
+        };
+        s.assign();
+    }
+
+    /// The engine's way to recycle slots while it waits: it polls its copies' events and calls `readRelease`.
+    pub const Recycler = struct {
+        ctx: ?*anyopaque = null,
+        recycle: ?*const fn (ctx: ?*anyopaque) void = null,
+    };
+
+    /// The follower copies up to rank 0's copied-block boundary with this, its slots recycled by its events.
+    /// A follower (or an idle engine) waiting for block `index` of `id`, at most `timeout_ns`: it gives back the read
+    /// slots its own copies held before each wait (PR 124: a rank whose peer failed early, with more blocks left
+    /// than read slots, waited for ever on a block the reader had no slot for). True once it is read, false when
+    /// the read failed, was cancelled, or the time ran out.
+    pub fn readAwait(s: *Store, id: ReadId, index: u32, timeout_ns: u64, rc: Recycler) bool {
+        const deadline = std.Io.Clock.awake.now(s.io).toNanoseconds() + timeout_ns;
+        while (true) {
+            if (rc.recycle) |f| if (!mut(.hang_no_recycle_in_wait)) f(rc.ctx);
+            s.lockS();
+            const r = s.readJob(id) orelse {
+                s.unlockS();
+                return false;
+            };
+            if (index >= r.total) {
+                s.unlockS();
+                return false;
+            }
+            const st = r.state[index];
+            if (st == .ready or st == .handed) {
+                s.unlockS();
+                return true;
+            }
+            if (st == .failed or r.ended or (r.err != null and st == .idle)) {
+                s.unlockS();
+                return false;
+            }
+            const left = deadline - std.Io.Clock.awake.now(s.io).toNanoseconds();
+            if (left <= 0) {
+                s.unlockS();
+                return false;
+            }
+            s.done.waitTimeout(s.io, &s.mutex, .{ .duration = .{ .raw = .fromNanoseconds(@min(left, 20 * std.time.ns_per_ms)), .clock = .awake } }) catch {};
+            s.unlockS();
+        }
+    }
+
+    /// The small state once read and checked (null: not yet, or failed: see `readFailure`).
+    pub fn readSmallView(s: *Store, id: ReadId) ?SmallView {
+        s.lockS();
+        defer s.unlockS();
+        const r = s.readJob(id) orelse return null;
+        if (r.small != .ready) return null;
+        return .{ .bytes = s.slots.bytes(r.small_slot)[0..@intCast(r.point.small_bytes)], .sections = r.point.sections };
+    }
+
+    pub const Failure = struct { err: ?ReadError, bad: []const Digest, lost: []const Digest };
+
+    /// Why `id` failed: the blocks whose bytes are damaged (`bad`) or whose names are gone (`lost`). Valid until
+    /// `endRead`.
+    pub fn readFailure(s: *Store, id: ReadId) Failure {
+        s.lockS();
+        defer s.unlockS();
+        const r = s.readJob(id) orelse return .{ .err = .cancelled, .bad = &.{}, .lost = &.{} };
+        return .{ .err = r.err, .bad = r.bad.items, .lost = r.lost.items };
+    }
+
+    pub const EndError = error{ Unknown, Incomplete, Failed, OutOfMemory };
+
+    /// How a restore ends: every rank agreed and copied it (`commit`), it failed on some rank (`abort`: counted as
+    /// a failed restore), or its request went away (`cancel`).
+    pub const Outcome = enum { commit, abort, cancel };
+
+    /// `.commit` only after every rank reported validation for the transaction (rank 0 publishes the entry then); a
+    /// link or rank failure ends the pair instead (no local fallback).
+    /// Ends restore `id`. `.commit`: every block was handed and copied and every rank agreed; the restore counts and
+    /// its point's lineage comes back (gpa-owned); an incomplete or failed one refuses to commit and stays open for
+    /// the caller to abort. Otherwise (`.abort`, `.cancel`) its reads stop: slots of blocks
+    /// still being read come back once their reads end. The engine must have released every handed slot's copy
+    /// (or will, through `readRelease`) and finished with the small state before calling this.
+    pub fn endRead(s: *Store, id: ReadId, outcome: Outcome) EndError!?ReadDone {
+        s.lockS();
+        defer s.unlockS();
+        const r = s.readJob(id) orelse return error.Unknown;
+        var done: ?ReadDone = null;
+        var result: EndError!?ReadDone = null;
+        if (outcome == .commit) {
+            if (r.err != null) {
+                result = error.Failed;
+            } else if (r.next_hand < r.total or r.small != .ready) {
+                result = error.Incomplete;
+            } else {
+                const p = r.point;
+                const lineage = p.lineage.clone(s.gpa) catch return error.OutOfMemory;
+                done = .{ .key = p.key, .at = p.at, .shared = p.shared, .group = p.group, .has_raw = p.has_raw, .lineage = lineage, .origin = p.origin };
+                s.counters.loaded += 1;
+                s.counters.loaded_tokens += p.at;
+                result = done;
+            }
+            if (done == null) return result; // nothing ended: the caller aborts it next
+        } else if (outcome == .abort) s.counters.load_failed += 1;
+        r.ended = true;
+        if (r.small != .queued) s.slots.give(r.small_slot); // (else its reader gives it back)
+        if (s.reading.getPtr(r.point.key)) |v| {
+            v.* -= 1;
+            if (v.* == 0) _ = s.reading.remove(r.point.key);
+        }
+        // blocks read but never handed: their slots back now (a block still reading gives its own back)
+        for (r.state, 0..) |st, i| if (st == .ready) {
+            s.giveRead(r, r.slot[i]);
+            r.state[i] = .failed;
+        };
+        s.maybeFreeRead(r);
+        s.assign();
+        return done;
+    }
+
+    fn maybeFreeRead(s: *Store, r: *ReadJob) void {
+        if (!r.ended or r.disk != 0 or r.held != 0) return;
+        for (s.reads.items, 0..) |x, k| if (x == r) {
+            _ = s.reads.orderedRemove(k);
+            break;
+        };
+        const p = r.point;
+        p.pins -= 1;
+        if (p.pins == 0 and p.removed) p.deinit(s.gpa);
+        freeRead(s.gpa, r);
+    }
+
+    /// Every rank, when a restore of `key` failed on some rank (each rank passes its own `readFailure` lists: the
+    /// abort carries only that the point is forgotten): the point goes, and so do the blocks in `bad`
+    /// (damaged bytes: every name linked to their inode too) and in `lost` (a name whose file is gone: that name
+    /// only), with every point naming one of them.
+    pub fn forget(s: *Store, key: Digest, bad: []const Digest, lost: []const Digest) void {
+        const gpa = s.gpa;
+        s.lockS();
+        defer s.unlockS();
+        var gone: std.AutoHashMapUnmanaged(Digest, void) = .empty;
+        defer gone.deinit(gpa);
+        for (bad) |b| {
+            gone.put(gpa, b, {}) catch {};
+            if (mut(.damage_not_widened)) continue;
+            if (s.have.get(b)) |info| if (s.inodes.get(info.ino)) |ino| {
+                for (ino.names.items) |nm| gone.put(gpa, nm, {}) catch {};
+            };
+        }
+        if (!mut(.lost_names_kept)) for (lost) |b| gone.put(gpa, b, {}) catch {};
+        var drop: std.ArrayList(Digest) = .empty;
+        defer drop.deinit(gpa);
+        drop.append(gpa, key) catch {};
+        var it = s.points.iterator();
+        while (it.next()) |e| {
+            if (std.mem.eql(u8, e.key_ptr, &key)) continue;
+            for (e.value_ptr.*.blocks) |b| if (gone.contains(b.name)) {
+                drop.append(gpa, e.key_ptr.*) catch {};
+                break;
+            };
+        }
+        // every one goes, read or not: a point being read is unlisted now and freed when its last read ends (those
+        // reads fail on the names dropped below); left listed, it would stay incomplete, hidden from lookups, holding
+        // its files, and claim its key as stored for ever
+        for (drop.items) |k| {
+            if (mut(.forget_skips_reading) and s.reading.contains(k) and !std.mem.eql(u8, &k, &key)) continue;
+            s.remove(k, "dropped");
+        }
+        var git = gone.keyIterator();
+        while (git.next()) |b| s.dropBlock(b.*);
+    }
+
+    /// A read-side fairness helper (0110's step between rounds): one time budget shared by every restore in flight,
+    /// each pause starting with the next restore in turn. `copy` takes one ready block (the engine's H2D copy and
+    /// event) and returns false to stop. Blocks copied.
+    pub fn stepReads(s: *Store, ids: []const ReadId, turn: *usize, budget_ns: u64, ctx: ?*anyopaque, copy: *const fn (ctx: ?*anyopaque, id: ReadId, b: ReadyBlock) bool) usize {
+        if (ids.len == 0) return 0;
+        const deadline = std.Io.Clock.awake.now(s.io).toNanoseconds() + budget_ns;
+        const k = if (mut(.budget_same_first)) 0 else turn.* % ids.len;
+        turn.* +%= 1;
+        var n: usize = 0;
+        for (0..ids.len) |x| {
+            const id = ids[(k + x) % ids.len];
+            const own = std.Io.Clock.awake.now(s.io).toNanoseconds() + budget_ns;
+            while (std.Io.Clock.awake.now(s.io).toNanoseconds() < (if (mut(.budget_each_read)) own else deadline)) {
+                var one: [1]ReadyBlock = undefined;
+                const got = s.readReady(id, null, &one);
+                if (got.n == 0) break;
+                n += 1;
+                if (!copy(ctx, id, one[0])) return n;
+            }
+        }
+        return n;
+    }
+
+    // -- status ----------------------------------------------------------------------------------------------------
+    pub fn counts(s: *Store) Counters {
+        s.lockS();
+        defer s.unlockS();
+        var x = s.counters;
+        x.points = s.points.count();
+        x.blocks = s.have.count();
+        x.stored_bytes = s.stored_bytes;
+        x.queued_bytes = s.queued_bytes;
+        x.pending_jobs = s.jobs_by_id.count();
+        x.reads = s.reads.items.len;
+        x.staging_bytes = s.slots.heldBytes();
+        x.staging_peak_bytes = s.slots.peakBytes();
+        x.disk_free_bytes = s.disk_free;
+        return x;
+    }
+
+    /// Reads the file system's free bytes now (the writer refreshes them after every write and deletion).
+    pub fn refreshDiskFree(s: *Store) void {
+        const free = fsio.diskFree(&s.hooks, s.blocks_fd);
+        s.lockS();
+        defer s.unlockS();
+        s.disk_free = free;
+    }
+
+    /// Whether a test's simulated crash stopped the writer.
+    pub fn isCrashed(s: *Store) bool {
+        s.lockS();
+        defer s.unlockS();
+        return s.crashed;
+    }
+
+    pub const Summary = struct {
+        conversations: u64 = 0,
+        shared_states: u64 = 0,
+        forks: u64 = 0,
+        turns_kept_max: u64 = 0,
+        conversation_bytes_max: u64 = 0,
+        conversation_tokens_max: u64 = 0,
+    };
+
+    /// What the store holds by conversation (for /health): conversations, shared states, abandoned forks, the most
+    /// states on one active path, the largest conversation's own bytes and tokens.
+    pub fn summary(s: *Store) Summary {
+        const gpa = s.gpa;
+        s.lockS();
+        defer s.unlockS();
+        var out: Summary = .{};
+        var t = s.tree() catch return out;
+        defer t.deinit(gpa);
+        var v = s.victims(null) catch return out;
+        defer v.deinit(gpa);
+        for (v.items) |x| switch (x.why) {
+            .pruned_forks => out.forks += 1,
+            .pruned_shared => out.shared_states += 1,
+            else => {},
+        };
+        var convs: std.AutoHashMapUnmanaged(usize, void) = .empty;
+        defer convs.deinit(gpa);
+        for (t.conv) |cv| if (cv) |x| {
+            convs.put(gpa, x, {}) catch {};
+        };
+        out.conversations = convs.count();
+        var cit = convs.keyIterator();
+        var keys: std.ArrayList(Digest) = .empty;
+        defer keys.deinit(gpa);
+        while (cit.next()) |cv| {
+            keys.clearRetainingCapacity();
+            var tokens: u64 = 0;
+            for (t.keys, 0..) |k, j| if (t.conv[j] == cv.*) {
+                keys.append(gpa, k) catch {};
+                tokens = @max(tokens, s.points.get(k).?.at);
+            };
+            out.conversation_bytes_max = @max(out.conversation_bytes_max, s.convBytes(keys.items));
+            out.conversation_tokens_max = @max(out.conversation_tokens_max, tokens);
+            // its active path's length (from its newest leaf)
+            var newest: ?Digest = null;
+            var used: i96 = std.math.minInt(i96);
+            for (keys.items) |k| {
+                const p = s.points.get(k).?;
+                if (p.used > used) {
+                    used = p.used;
+                    newest = k;
+                }
+            }
+            var len: u64 = 0;
+            var cur = newest;
+            while (cur) |k| {
+                const p = s.points.get(k) orelse break;
+                if (p.shared) break;
+                len += 1;
+                cur = s.parent.get(k) orelse null;
+            }
+            out.turns_kept_max = @max(out.turns_kept_max, len);
+        }
+        return out;
+    }
+};
diff --git a/zig/src/core/spill/store_test.zig b/zig/src/core/spill/store_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..fc57fda0d81d146b1ca58b1e2e4094a9a90462e9
--- /dev/null
+++ b/zig/src/core/spill/store_test.zig
@@ -0,0 +1,1909 @@
+//! Port of wojo's GLM 0110 `tools/spill_blocks_check.py` and `tools/spill_blocks_mutants.sh` (PR #124) as Zig tests,
+//! plus PORT-SPILL-V2.md's stage-1 (format, lineage, dedup, references, eviction, quotas) and stage-5 (durability
+//! fault campaign) cases for the native store. A real store over a scratch directory, a fake "device" of rows per
+//! source the test engine packs blocks from, and the engine's side of every call (stage, staged, captured,
+//! readReady, readRelease) played by the test. Each check returns error.CheckFailed when a property fails; the
+//! mutant test switches each authored fix back off (`mutants.zig`) and requires some check to fail.
+const std = @import("std");
+const c = std.c;
+const format = @import("format.zig");
+const fsio = @import("fsio.zig");
+const slots = @import("slots.zig");
+const store = @import("store.zig");
+const mutants = @import("mutants.zig");
+const Allocator = std.mem.Allocator;
+const Store = store.Store;
+const Digest = format.Digest;
+const Lineage = format.Lineage;
+const testing = std.testing;
+const io = std.testing.io;
+
+const block_tokens = 16;
+const bpt = 256; // bytes a token on this rank
+const block_bytes = block_tokens * bpt;
+const max_tokens = 1024;
+const small_max = 8192;
+const secs = [_]store.SectionSpec{ .{ .name = "ring", .len = 300 }, .{ .name = "raw", .len = 200 } };
+
+var quiet = false; // a mutant run: failures are expected, not printed
+var serial: u32 = 0;
+
+const CheckFailed = error.CheckFailed;
+
+fn ensure(ok: bool, src: std.builtin.SourceLocation) !void {
+    if (ok) return;
+    if (!quiet) std.debug.print("     check failed at {s}:{d}\n", .{ src.file, src.line });
+    return CheckFailed;
+}
+
+const Opts = struct {
+    tag: []const u8,
+    write_slots: usize = 8,
+    read_slots: usize = 8,
+    small_slots: usize = 4,
+    restore_slots: usize = 2,
+    cap: u64 = 64 << 20,
+    floor: u64 = 0,
+    turns: u32 = 4,
+    quota: f64 = 0,
+    max_reads: u32 = 2,
+    keep_builds: u32 = 1,
+    backlog: u64 = 1 << 30,
+    free: ?u64 = null,
+    no_direct: bool = false,
+    prefix: []const u8 = "native-spill-", // the lifted checks' namespace
+    bpt: usize = bpt, // bytes a token (the block's bytes follow)
+};
+
+const Ev = struct { ev: fsio.Event, name: [96]u8, len: usize };
+
+/// The test's side of the hooks: event log, an action at a step, a crash point, a pwrite script, a disk-free value.
+const Hk = struct {
+    mutex: std.Io.Mutex = .init,
+    events: std.ArrayList(Ev) = .empty,
+    gpa: Allocator,
+    action_step: ?fsio.Step = null,
+    action_suffix: []const u8 = "",
+    action: ?*const fn (h: *H) void = null,
+    crash_step: ?fsio.Step = null,
+    crash_suffix: []const u8 = "",
+    crash_skip: u32 = 0,
+    nospace_writes: u32 = 0, // the next pwrites failing with ENOSPC
+    short_intr: bool = false, // every pwrite short (at most 1000 bytes), and every other one EINTR first
+    flip: bool = false,
+    free: ?u64 = null,
+    h: *H = undefined,
+
+    fn crash(ctx: ?*anyopaque, step: fsio.Step, name: []const u8) bool {
+        const k: *Hk = @ptrCast(@alignCast(ctx.?));
+        if (std.c.getenv("SPILL_DEBUG") != null) std.debug.print("hook {t} {s}\n", .{ step, name });
+        if (k.action) |f| if (k.action_step == step and std.mem.endsWith(u8, name, k.action_suffix)) {
+            k.action = null;
+            f(k.h);
+        };
+        if (k.crash_step) |cs| if (cs == step and std.mem.endsWith(u8, name, k.crash_suffix)) {
+            if (k.crash_skip > 0) {
+                k.crash_skip -= 1;
+                return false;
+            }
+            k.crash_step = null;
+            return true;
+        };
+        return false;
+    }
+
+    fn event(ctx: ?*anyopaque, ev: fsio.Event, name: []const u8) void {
+        const k: *Hk = @ptrCast(@alignCast(ctx.?));
+        var e: Ev = .{ .ev = ev, .name = undefined, .len = @min(name.len, 96) };
+        @memcpy(e.name[0..e.len], name[0..e.len]);
+        k.mutex.lockUncancelable(io);
+        defer k.mutex.unlock(io);
+        k.events.append(k.gpa, e) catch {};
+    }
+
+    fn pwrite(ctx: ?*anyopaque, fd: c.fd_t, buf: []const u8, off: u64) fsio.Error!usize {
+        const k: *Hk = @ptrCast(@alignCast(ctx.?));
+        if (k.nospace_writes > 0) {
+            k.nospace_writes -= 1;
+            return error.NoSpace;
+        }
+        var want = buf.len;
+        if (k.short_intr) {
+            k.flip = !k.flip;
+            if (k.flip) return error.Interrupted;
+            if (off % fsio.alignment == 0 and want > 1000) want = 1000;
+        }
+        const n = fsio.pwritePartial(fd, buf, want, off);
+        if (n < 0) return error.Io;
+        return @intCast(n);
+    }
+
+    fn freeBytes(ctx: ?*anyopaque) u64 {
+        const k: *Hk = @ptrCast(@alignCast(ctx.?));
+        return k.free orelse (1 << 40);
+    }
+
+    fn clear(k: *Hk) void {
+        k.mutex.lockUncancelable(io);
+        defer k.mutex.unlock(io);
+        k.events.clearRetainingCapacity();
+    }
+};
+
+/// A store over a fresh scratch directory and the test's fake device.
+const H = struct {
+    gpa: Allocator,
+    path: [256]u8 = undefined,
+    root: [:0]const u8 = undefined,
+    bufs: [4][]align(slots.alignment) u8 = @splat(&.{}),
+    lists: [4][1]slots.Buffer = undefined,
+    cfg: store.Config = undefined,
+    s: *Store = undefined,
+    rows: std.AutoHashMapUnmanaged(u64, []u8) = .empty,
+    hk: Hk,
+    opened: bool = false,
+    bpt: usize = bpt,
+
+    fn init(gpa: Allocator, o: Opts) !*H {
+        const h = try gpa.create(H);
+        errdefer gpa.destroy(h);
+        h.* = .{ .gpa = gpa, .hk = .{ .gpa = gpa, .free = o.free }, .bpt = o.bpt };
+        h.hk.h = h;
+        serial += 1;
+        var tb: [64]u8 = undefined;
+        const tag = try std.fmt.bufPrint(&tb, "{s}-{d}", .{ o.tag, serial });
+        const r = try fsio.testRoot(&h.path, tag);
+        h.root = r;
+        const dfd = try fsio.freshDir(gpa, r);
+        _ = c.close(dfd);
+        const counts = [4]usize{ o.write_slots, o.read_slots, o.small_slots, o.restore_slots };
+        const bb = block_tokens * o.bpt;
+        const slot = std.mem.alignForward(usize, bb, slots.alignment);
+        const per = [4]usize{ slot, slot, small_max, small_max };
+        for (0..4) |i| {
+            h.bufs[i] = try gpa.alignedAlloc(u8, .fromByteUnits(slots.alignment), @max(counts[i] * per[i], 0));
+            h.lists[i] = .{h.bufs[i]};
+        }
+        h.cfg = .{
+            .root = h.root, .prefix = o.prefix, .rank = 0, .compat = @splat(0x5a),
+            .limits = .{ .max_tokens = max_tokens, .block_tokens = block_tokens, .block_bytes = bb, .max_small_bytes = small_max },
+            .cap_bytes = o.cap, .floor_bytes = o.floor, .quota = o.quota, .turns = o.turns, .min_tokens = 16, .backlog_bytes = o.backlog,
+            .staging = .{ .write = &h.lists[0], .read = &h.lists[1], .small = &h.lists[2], .restore = &h.lists[3] },
+            .readers = 3, .max_reads = o.max_reads, .keep_builds = o.keep_builds,
+            .hooks = .{ .ctx = &h.hk, .crash = Hk.crash, .event = Hk.event, .pwrite = Hk.pwrite, .free = Hk.freeBytes, .no_direct = o.no_direct },
+        };
+        try h.open();
+        return h;
+    }
+
+    fn open(h: *H) !void {
+        h.s = try Store.open(h.gpa, io, h.cfg);
+        h.opened = true;
+    }
+
+    fn closeStore(h: *H) void {
+        if (h.opened) h.s.close();
+        h.opened = false;
+    }
+
+    fn reopen(h: *H) !void {
+        h.closeStore();
+        try h.open();
+    }
+
+    fn deinit(h: *H) void {
+        h.closeStore();
+        fsio.dropDir(h.gpa, h.root);
+        for (h.bufs) |b| h.gpa.free(b);
+        var it = h.rows.valueIterator();
+        while (it.next()) |r| h.gpa.free(r.*);
+        h.rows.deinit(h.gpa);
+        h.hk.events.deinit(h.gpa);
+        h.gpa.destroy(h);
+    }
+
+    /// Source `id`'s rows on the fake device (deterministic bytes, made on first use).
+    fn src(h: *H, id: u64) []u8 {
+        const gop = h.rows.getOrPut(h.gpa, id) catch @panic("oom");
+        if (!gop.found_existing) {
+            const r = h.gpa.alloc(u8, max_tokens * h.bpt) catch @panic("oom");
+            var prng = std.Random.DefaultPrng.init(id *% 0x9e3779b97f4a7c15 +% 1);
+            prng.random().bytes(r);
+            gop.value_ptr.* = r;
+        }
+        return gop.value_ptr.*;
+    }
+
+    fn dir(h: *H, which: enum { blocks, points }) c.fd_t {
+        return if (which == .blocks) h.s.blocks_fd else h.s.points_fd;
+    }
+};
+
+fn smallByte(source: u64, at: usize, i: usize) u8 {
+    return @truncate(i *% 131 +% source *% 7 +% at);
+}
+
+const KO = struct {
+    lineage: Lineage,
+    source: u64,
+    gen: u64 = 1,
+    shared: bool = false,
+    group: u64 = 0,
+    media: []const format.Media = &.{},
+    raw: ?[]const u32 = null, // with media: the raw ids (the same length as the keyed ones)
+    capture: bool = true,
+};
+
+/// The engine at a keep: `keep`, then the small state and tail captured from the device, reported.
+fn keepIds(h: *H, ids: []const u32, o: KO) store.KeepResult {
+    const at = ids.len;
+    const tail_tokens = at % block_tokens;
+    const r = h.s.keep(.{
+        .keyed = ids, .raw = if (o.raw) |r| r[0..ids.len] else null, .media = o.media, .lineage = o.lineage, .shared = o.shared, .group = o.group, .sections = &secs,
+        .tail_bytes = tail_tokens * h.bpt, .source = .{ .id = o.source, .generation = o.gen },
+    });
+    if (r == .queued) {
+        const q = r.queued;
+        for (q.sections) |sec| {
+            for (0..@intCast(sec.len)) |i| q.small[@intCast(sec.offset + i)] = smallByte(o.source, at, i);
+        }
+        if (q.tail) |t| @memcpy(t, h.src(o.source)[(at - tail_tokens) * h.bpt .. at * h.bpt]);
+        if (o.capture) h.s.captured(q.job, true);
+    }
+    return r;
+}
+
+/// The engine between rounds: every requested block packed from its source and reported.
+fn pump(h: *H) void {
+    var reqs: [16]store.StageReq = undefined;
+    while (true) {
+        const n = h.s.stage(&reqs);
+        if (n == 0) return;
+        for (reqs[0..n]) |r| {
+            @memcpy(r.dst, h.src(r.source.id)[r.first * h.bpt ..][0..r.dst.len]);
+            h.s.staged(r.ticket, true);
+        }
+    }
+}
+
+/// The engine until nothing waits on it: blocks staged as write slots come back, then a drain.
+fn settle(h: *H) store.Store.Drain {
+    var i: usize = 0;
+    while (i < 5000) : (i += 1) {
+        pump(h);
+        if (h.s.pendingStage() == 0) break;
+        std.Io.sleep(io, .fromMilliseconds(1), .awake) catch {};
+    }
+    return h.s.drain(5 * std.time.ns_per_s);
+}
+
+/// Keep and write `ids` at once; the point's key once it is published.
+fn write(h: *H, ids: []const u32, o: KO) !Digest {
+    const r = keepIds(h, ids, o);
+    try ensure(r == .queued, @src());
+    const d = settle(h);
+    try ensure(d.done, @src());
+    const key = format.pointKey(ids, block_tokens, o.media);
+    try ensure(h.s.presence(key), @src());
+    return key;
+}
+
+/// A restore of `key` through the engine's side: rows (at * h.bpt bytes, gpa-owned) or null when it fails.
+fn restore(h: *H, key: Digest) !?[]u8 {
+    const id = h.s.beginRead(key) catch return null;
+    const p = h.s.points.get(key) orelse return null;
+    const at = p.at;
+    const out = try h.gpa.alloc(u8, at * h.bpt);
+    errdefer h.gpa.free(out);
+    var i: u32 = 0;
+    const total: u32 = @intCast(p.blocks.len);
+    while (i < total) {
+        if (!h.s.readAwait(id, i, 5 * std.time.ns_per_s, .{})) break;
+        var rb: [4]store.ReadyBlock = undefined;
+        const got = h.s.readReady(id, null, &rb);
+        if (got.status == .failed and got.n == 0) break;
+        for (rb[0..got.n]) |b| {
+            @memcpy(out[b.first * h.bpt ..][0..b.data.len], b.data);
+            h.s.readRelease(b.slot);
+            i += 1;
+        }
+    }
+    var small_ok = false;
+    for (0..2500) |_| {
+        if (h.s.readSmallView(id) != null) {
+            small_ok = true;
+            break;
+        }
+        if (h.s.readFailure(id).err != null) break;
+        std.Io.sleep(io, .fromMilliseconds(2), .awake) catch {};
+    }
+    if (i < total or !small_ok) {
+        _ = h.s.endRead(id, .abort) catch {};
+        h.gpa.free(out);
+        return null;
+    }
+    var done = (h.s.endRead(id, .commit) catch {
+        h.gpa.free(out);
+        return null;
+    }) orelse {
+        h.gpa.free(out);
+        return null;
+    };
+    done.lineage.deinit(h.gpa);
+    return out;
+}
+
+/// A restore that fails, its failure forgotten the way every rank forgets it: true when it failed.
+fn restoreFails(h: *H, key: Digest) !bool {
+    const id = h.s.beginRead(key) catch return true;
+    const total: u32 = @intCast((h.s.points.get(key) orelse return true).blocks.len);
+    var failed = false;
+    var i: u32 = 0;
+    while (i < total) {
+        _ = h.s.readAwait(id, i, 5 * std.time.ns_per_s, .{});
+        var rb: [4]store.ReadyBlock = undefined;
+        const got = h.s.readReady(id, null, &rb);
+        for (rb[0..got.n]) |b| h.s.readRelease(b.slot);
+        i += @intCast(got.n);
+        if (got.status == .failed) {
+            failed = true;
+            break;
+        }
+        if (got.n == 0 and got.status == .waiting and h.s.readFailure(id).err != null) {
+            failed = true;
+            break;
+        }
+    }
+    const f = h.s.readFailure(id);
+    if (f.err != null) failed = true;
+    if (failed) {
+        const bad = try h.gpa.dupe(Digest, f.bad);
+        defer h.gpa.free(bad);
+        const lost = try h.gpa.dupe(Digest, f.lost);
+        defer h.gpa.free(lost);
+        h.s.forget(key, bad, lost);
+    }
+    _ = h.s.endRead(id, if (failed) .abort else .cancel) catch {};
+    return failed;
+}
+
+fn idsOf(gpa: Allocator, n: usize, seed: u64) ![]u32 {
+    var prng = std.Random.DefaultPrng.init(seed);
+    const ids = try gpa.alloc(u32, n);
+    for (ids) |*x| x.* = prng.random().intRangeAtMost(u32, 1, 150000);
+    return ids;
+}
+
+fn cat(gpa: Allocator, a: []const u32, b: []const u32) ![]u32 {
+    const out = try gpa.alloc(u32, a.len + b.len);
+    @memcpy(out[0..a.len], a);
+    @memcpy(out[a.len..], b);
+    return out;
+}
+
+fn lin(n: u8) Lineage {
+    return .{ .root = @splat(n) };
+}
+
+fn manifestShared(h: *H, key: Digest) ?bool {
+    var nb: [80]u8 = undefined;
+    const h64 = format.hex(&key);
+    const name = std.fmt.bufPrintSentinel(&nb, "{s}.man", .{h64}, 0) catch return null;
+    const raw = fsio.readSmall(h.gpa, h.s.points_fd, name, 1 << 20) catch return null;
+    defer h.gpa.free(raw);
+    var m = format.Manifest.parse(h.gpa, raw, h.cfg.compat, h.cfg.limits) catch return null;
+    defer m.deinit(h.gpa);
+    return m.flags.shared;
+}
+
+fn fileExists(dirfd: c.fd_t, name: []const u8) bool {
+    var nb: [128]u8 = undefined;
+    const z = std.fmt.bufPrintSentinel(&nb, "{s}", .{name}, 0) catch return false;
+    _ = fsio.statAt(dirfd, z) catch return false;
+    return true;
+}
+
+fn blockFile(buf: []u8, name: Digest) []const u8 {
+    const x = format.hex(&name);
+    return std.fmt.bufPrint(buf, "{s}.blk", .{x}) catch unreachable;
+}
+
+fn pointFile(buf: []u8, key: Digest, suffix: []const u8) []const u8 {
+    const x = format.hex(&key);
+    return std.fmt.bufPrint(buf, "{s}{s}", .{ x, suffix }) catch unreachable;
+}
+
+fn countFiles(gpa: Allocator, dirfd: c.fd_t, temps_only: bool) usize {
+    var names = fsio.list(gpa, dirfd) catch return 0;
+    defer fsio.freeList(gpa, &names);
+    var n: usize = 0;
+    for (names.items) |x| {
+        if (temps_only and x[0] != '.') continue;
+        n += 1;
+    }
+    return n;
+}
+
+fn waitUntil(cond: anytype, ctx: anytype, ms: u32) bool {
+    var i: u32 = 0;
+    while (i < ms) : (i += 2) {
+        if (cond(ctx)) return true;
+        std.Io.sleep(io, .fromMilliseconds(2), .awake) catch {};
+    }
+    return cond(ctx);
+}
+
+// -- the checks ------------------------------------------------------------------------------------------------------
+
+/// GLM review 1: the block a kept state's end cuts holds the rows of the keep, not what the stream writes after
+/// it; it is captured with the small state, never staged later from the source.
+fn checkTail(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "tail" });
+    defer h.deinit();
+    const n = 2 * block_tokens + 6;
+    const ids = try idsOf(gpa, n, 1);
+    defer gpa.free(ids);
+    const kept = try gpa.dupe(u8, h.src(1)[0 .. n * bpt]);
+    defer gpa.free(kept);
+    const r = keepIds(h, ids, .{ .lineage = lin(1), .source = 1 });
+    try ensure(r == .queued, @src());
+    const had_tail = r.queued.tail != null;
+    // the stream goes on decoding in its extent past the keep: the tail block's rows change
+    var prng = std.Random.DefaultPrng.init(9);
+    prng.random().bytes(h.src(1)[2 * block_tokens * bpt .. (n + 8) * bpt]);
+    try ensure(settle(h).done, @src());
+    const got = (try restore(h, format.pointKey(ids, block_tokens, &.{}))) orelse return CheckFailed;
+    defer gpa.free(got);
+    try ensure(std.mem.eql(u8, got, kept), @src());
+    try ensure(had_tail and h.s.counts().staged_blocks == 2, @src());
+}
+
+/// The reader reads; the engine copies, only as far as it is told (LOADPART's boundary), the rest after.
+fn checkUpto(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "upto" });
+    defer h.deinit();
+    const ids = try idsOf(gpa, 3 * block_tokens, 2);
+    defer gpa.free(ids);
+    const key = try write(h, ids, .{ .lineage = lin(2), .source = 2 });
+    const id = try h.s.beginRead(key);
+    for (0..3) |i| try ensure(h.s.readAwait(id, @intCast(i), 5 * std.time.ns_per_s, .{}), @src()); // (readers finish in any order)
+    var rb: [8]store.ReadyBlock = undefined;
+    const a = h.s.readReady(id, 2, &rb);
+    try ensure(a.n == 2 and a.status == .done, @src());
+    for (rb[0..a.n]) |b| h.s.readRelease(b.slot);
+    const b2 = h.s.readReady(id, null, &rb);
+    try ensure(b2.n == 1 and b2.status == .done and rb[0].index == 2, @src());
+    h.s.readRelease(rb[0].slot);
+    try ensure(waitUntil(struct {
+        fn f(x: struct { *H, store.ReadId }) bool {
+            return x[0].s.readSmallView(x[1]) != null;
+        }
+    }.f, .{ h, id }, 5000), @src());
+    const v = h.s.readSmallView(id).?;
+    try ensure(v.sections.len == 2 and std.mem.eql(u8, v.sections[0].name.slice(), "ring"), @src());
+    for (v.sections) |sec| for (0..@intCast(sec.len)) |i| {
+        try ensure(v.bytes[@intCast(sec.offset + i)] == smallByte(2, 3 * block_tokens, i), @src());
+    };
+    var done = (try h.s.endRead(id, .commit)) orelse return CheckFailed;
+    defer done.lineage.deinit(gpa);
+    try ensure(done.at == 3 * block_tokens and done.lineage.eql(lin(2)), @src());
+}
+
+/// Last use survives a restart (the manifest's time): the least recently used conversation is still evicted first.
+fn checkLastUse(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "lastuse" });
+    defer h.deinit();
+    const a = try idsOf(gpa, block_tokens, 2100);
+    defer gpa.free(a);
+    const b = try idsOf(gpa, block_tokens, 2101);
+    defer gpa.free(b);
+    const ka = try write(h, a, .{ .lineage = lin(21), .source = 21 });
+    const kb = try write(h, b, .{ .lineage = lin(22), .source = 22 });
+    std.Io.sleep(io, .fromMilliseconds(5), .awake) catch {};
+    h.s.touch(ka);
+    try ensure(h.s.drain(5 * std.time.ns_per_s).done, @src());
+    try h.reopen();
+    const order = h.s.evictionOrder() catch return CheckFailed;
+    defer gpa.free(order);
+    try ensure(order.len == 2 and std.mem.eql(u8, &order[0].key, &kb) and std.mem.eql(u8, &order[1].key, &ka), @src());
+}
+
+/// Keeps the store refuses say why and hold nothing: too short, invalid, out of staging, past the backlog.
+fn checkRefusals(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "refuse", .small_slots = 1, .backlog = 3 * block_bytes + 2048 });
+    defer h.deinit();
+    const ids = try idsOf(gpa, 2 * block_tokens, 2200);
+    defer gpa.free(ids);
+    try ensure(keepIds(h, ids[0..8], .{ .lineage = lin(1), .source = 1 }) == .short, @src());
+    const bad = h.s.keep(.{ .keyed = ids, .lineage = lin(1), .sections = &.{.{ .name = "a-section-name-longer-than-32-bytes", .len = 8 }}, .source = .{ .id = 1, .generation = 1 } });
+    try ensure(bad == .invalid, @src());
+    const tail = h.s.keep(.{ .keyed = ids[0 .. block_tokens + 3], .lineage = lin(1), .sections = &secs, .tail_bytes = 0, .source = .{ .id = 1, .generation = 1 } });
+    try ensure(tail == .invalid, @src());
+    const r1 = keepIds(h, ids, .{ .lineage = lin(1), .source = 1, .capture = false });
+    try ensure(r1 == .queued, @src());
+    const other = try idsOf(gpa, block_tokens, 2201);
+    defer gpa.free(other);
+    try ensure(keepIds(h, other, .{ .lineage = lin(2), .source = 2 }) == .no_staging, @src());
+    h.s.captured(r1.queued.job, true);
+    try ensure(settle(h).done, @src());
+    try ensure(keepIds(h, other, .{ .lineage = lin(2), .source = 2 }) == .queued, @src());
+    try ensure(settle(h).done, @src());
+    const big = try idsOf(gpa, 4 * block_tokens, 2202);
+    defer gpa.free(big);
+    try ensure(keepIds(h, big, .{ .lineage = lin(3), .source = 3 }) == .backlog, @src());
+    const ct = h.s.counts();
+    try ensure(ct.short == 1 and ct.invalid == 2 and ct.no_staging == 1 and ct.backlog_refused == 1 and ct.staging_bytes == 0, @src());
+    try ensure(ct.committed == 2 and ct.points == 2, @src());
+}
+
+/// Shared flag 3: the same ids kept again as a shared prefix make the stored point shared, its manifest rewritten
+/// through a temporary name, fsynced, renamed, then the folder fsynced; a restart reads it shared.
+fn checkSharedUpgrade(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "upgrade" });
+    defer h.deinit();
+    const ids = try idsOf(gpa, block_tokens + 5, 51);
+    defer gpa.free(ids);
+    const key = try write(h, ids, .{ .lineage = lin(51), .source = 51 });
+    h.hk.clear();
+    try ensure(keepIds(h, ids, .{ .lineage = lin(51), .source = 51, .shared = true }) == .stored, @src());
+    try ensure(h.s.points.get(key).?.shared, @src());
+    try ensure(h.s.drain(5 * std.time.ns_per_s).done, @src());
+    try ensure(manifestShared(h, key) == true, @src());
+    // the rewrite's own events: written to a temporary name, fsynced, pages dropped, renamed, the folder fsynced
+    h.hk.mutex.lockUncancelable(io);
+    var saw: [8]fsio.Event = undefined;
+    var k: usize = 0;
+    for (h.hk.events.items) |e| if (std.mem.endsWith(u8, e.name[0..e.len], ".man") or std.mem.eql(u8, e.name[0..e.len], "points")) {
+        if (k < saw.len) saw[k] = e.ev;
+        k += 1;
+    };
+    h.hk.mutex.unlock(io);
+    try ensure(k == 5 and std.mem.eql(fsio.Event, saw[0..5], &.{ .write, .fsync, .drop_pages, .rename, .dir_fsync }), @src());
+    try h.reopen();
+    const p = h.s.points.get(key) orelse return CheckFailed;
+    try ensure(p.shared, @src());
+}
+
+/// ... also when they were still waiting to be written.
+fn checkSharedWaiting(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "waiting" });
+    defer h.deinit();
+    const ids = try idsOf(gpa, block_tokens + 5, 52);
+    defer gpa.free(ids);
+    try ensure(keepIds(h, ids, .{ .lineage = lin(52), .source = 52 }) == .queued, @src());
+    try ensure(keepIds(h, ids, .{ .lineage = lin(52), .source = 52, .shared = true }) == .stored, @src());
+    try ensure(settle(h).done, @src());
+    const key = format.pointKey(ids, block_tokens, &.{});
+    try ensure((h.s.points.get(key) orelse return CheckFailed).shared and manifestShared(h, key) == true, @src());
+}
+
+fn markWhileWriting(h: *H) void {
+    const ids = h.rows.get(0xdead).?; // the ids stashed as bytes
+    const s: []const u32 = @alignCast(std.mem.bytesAsSlice(u32, ids));
+    _ = keepIds(h, s, .{ .lineage = lin(53), .source = 53, .shared = true });
+}
+
+/// ... and when kept again as shared while its own files were being written: its manifest is rewritten shared.
+fn checkSharedDuringWrite(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "during" });
+    defer h.deinit();
+    const ids = try idsOf(gpa, block_tokens + 5, 53);
+    defer gpa.free(ids);
+    try h.rows.put(gpa, 0xdead, try gpa.dupe(u8, std.mem.sliceAsBytes(ids)));
+    h.hk.action_step = .written;
+    h.hk.action_suffix = ".ids";
+    h.hk.action = markWhileWriting;
+    const key = try write(h, ids, .{ .lineage = lin(53), .source = 53 });
+    try ensure(h.hk.action == null, @src()); // (it ran)
+    try ensure(h.s.drain(5 * std.time.ns_per_s).done, @src());
+    try ensure((h.s.points.get(key) orelse return CheckFailed).shared and manifestShared(h, key) == true, @src());
+}
+
+var drop_key: Digest = undefined;
+fn dropDuring(h: *H) void {
+    h.s.forget(drop_key, &.{}, &.{});
+}
+
+/// A point dropped while its manifest is rewritten does not get the manifest back (no resurrection).
+fn checkDropDuringRewrite(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "resurrect" });
+    defer h.deinit();
+    const ids = try idsOf(gpa, block_tokens + 5, 54);
+    defer gpa.free(ids);
+    const key = try write(h, ids, .{ .lineage = lin(54), .source = 54 });
+    drop_key = key;
+    h.hk.action_step = .written;
+    h.hk.action_suffix = ".man";
+    h.hk.action = dropDuring;
+    try ensure(keepIds(h, ids, .{ .lineage = lin(54), .source = 54, .shared = true }) == .stored, @src());
+    _ = h.s.drain(5 * std.time.ns_per_s);
+    try ensure(h.hk.action == null and !h.s.points.contains(key), @src());
+    var nb: [96]u8 = undefined;
+    try ensure(!fileExists(h.s.points_fd, pointFile(&nb, key, ".man")), @src());
+}
+
+fn slowRewrite(_: *H) void {
+    std.Io.sleep(io, .fromMilliseconds(300), .awake) catch {};
+}
+
+/// A drain (a clean stop) waits for a queued metadata rewrite.
+fn checkDrainWaitsRewrite(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "drainrw" });
+    defer h.deinit();
+    const ids = try idsOf(gpa, block_tokens + 5, 55);
+    defer gpa.free(ids);
+    const key = try write(h, ids, .{ .lineage = lin(55), .source = 55 });
+    h.hk.action_step = .written;
+    h.hk.action_suffix = ".man";
+    h.hk.action = slowRewrite;
+    try ensure(keepIds(h, ids, .{ .lineage = lin(55), .source = 55, .shared = true }) == .stored, @src());
+    try ensure(h.s.drain(5 * std.time.ns_per_s).done, @src());
+    try ensure(manifestShared(h, key) == true, @src());
+}
+
+/// A (2 blocks), B (other ids, the same rows: its blocks links to A's) and C (A's ids and a block more, A's lineage:
+/// it names A's blocks).
+fn linked(h: *H) ![3]Digest {
+    const gpa = h.gpa;
+    const ia = try idsOf(gpa, 2 * block_tokens, 61);
+    defer gpa.free(ia);
+    const ib = try idsOf(gpa, 2 * block_tokens, 62);
+    defer gpa.free(ib);
+    const more = try idsOf(gpa, block_tokens, 63);
+    defer gpa.free(more);
+    const ic = try cat(gpa, ia, more);
+    defer gpa.free(ic);
+    const ka = try write(h, ia, .{ .lineage = lin(1), .source = 60 });
+    const kb = try write(h, ib, .{ .lineage = lin(2), .source = 60 });
+    const kc = try write(h, ic, .{ .lineage = lin(1), .source = 60 });
+    return .{ ka, kb, kc };
+}
+
+/// GLM review 4: a read failing on a missing block file drops that name and the points naming it, not the points
+/// whose blocks are links to the same bytes (they still read back).
+fn checkForgetLost(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "lost" });
+    defer h.deinit();
+    const k = try linked(h);
+    const pa = h.s.points.get(k[0]) orelse return CheckFailed;
+    const pb = h.s.points.get(k[1]) orelse return CheckFailed;
+    try ensure(h.s.counts().dedup_blocks == 2, @src());
+    for (0..2) |i| try ensure(h.s.have.get(pa.blocks[i].name).?.ino == h.s.have.get(pb.blocks[i].name).?.ino, @src());
+    const pb_names = [2]Digest{ pb.blocks[0].name, pb.blocks[1].name };
+    var nb: [96]u8 = undefined;
+    var zb: [96]u8 = undefined;
+    _ = c.unlinkat(h.s.blocks_fd, try std.fmt.bufPrintSentinel(&zb, "{s}", .{blockFile(&nb, pa.blocks[0].name)}, 0), 0);
+    try ensure(try restoreFails(h, k[0]), @src());
+    try ensure(!h.s.points.contains(k[0]) and !h.s.points.contains(k[2]), @src());
+    try ensure(h.s.points.contains(k[1]), @src());
+    _ = h.s.drain(5 * std.time.ns_per_s);
+    for (pb_names) |n| try ensure(fileExists(h.s.blocks_fd, blockFile(&nb, n)), @src());
+    const got = (try restore(h, k[1])) orelse return CheckFailed;
+    defer gpa.free(got);
+    try ensure(std.mem.eql(u8, got, h.src(60)[0 .. 2 * block_tokens * bpt]), @src());
+}
+
+/// ... one failing on damaged bytes drops every name of them (A, B and C).
+fn checkForgetDamaged(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "damaged" });
+    defer h.deinit();
+    const k = try linked(h);
+    const pa = h.s.points.get(k[0]) orelse return CheckFailed;
+    const pb = h.s.points.get(k[1]) orelse return CheckFailed;
+    const b0 = pb.blocks[0].name;
+    // C names A's blocks and is being read when A's read fails: it goes too (unlisted, freed when its read ends)
+    const rc = try h.s.beginRead(k[2]);
+    var nb: [96]u8 = undefined;
+    var zb: [96]u8 = undefined;
+    const name = try std.fmt.bufPrintSentinel(&zb, "{s}", .{blockFile(&nb, pa.blocks[0].name)}, 0);
+    const fd = c.openat(h.s.blocks_fd, name, .{ .ACCMODE = .WRONLY, .CLOEXEC = true }, @as(c.mode_t, 0));
+    try ensure(fd >= 0, @src());
+    const junk: [64]u8 = @splat(0xff);
+    _ = c.pwrite(fd, &junk, junk.len, 0);
+    _ = c.close(fd);
+    try ensure(try restoreFails(h, k[0]), @src());
+    const gone = !h.s.points.contains(k[0]) and !h.s.points.contains(k[1]) and !h.s.points.contains(k[2]);
+    _ = h.s.endRead(rc, .cancel) catch {};
+    try ensure(gone, @src());
+    try ensure(h.s.counts().points == 0, @src());
+    _ = h.s.drain(5 * std.time.ns_per_s);
+    var nb2: [96]u8 = undefined;
+    try ensure(!fileExists(h.s.blocks_fd, blockFile(&nb2, b0)), @src());
+}
+
+/// A point's small files (.ids, .st, .man) each have their pages dropped after their fsync.
+fn checkPages(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "pages" });
+    defer h.deinit();
+    const ids = try idsOf(gpa, block_tokens + 7, 71);
+    defer gpa.free(ids);
+    h.hk.clear();
+    const key = try write(h, ids, .{ .lineage = lin(71), .source = 71 });
+    var nb: [96]u8 = undefined;
+    for ([_][]const u8{ ".ids", ".st", ".man" }) |suffix| {
+        const want = pointFile(&nb, key, suffix);
+        var seq: [4]fsio.Event = undefined;
+        var k: usize = 0;
+        h.hk.mutex.lockUncancelable(io);
+        for (h.hk.events.items) |e| if (std.mem.eql(u8, e.name[0..e.len], want) and (e.ev == .fsync or e.ev == .drop_pages)) {
+            if (k < seq.len) seq[k] = e.ev;
+            k += 1;
+        };
+        h.hk.mutex.unlock(io);
+        try ensure(k == 2 and seq[0] == .fsync and seq[1] == .drop_pages, @src());
+    }
+}
+
+/// Publication order: every block renamed and its folder fsynced before the point's files; the ids and small state
+/// renamed and the points folder fsynced before the manifest, which is renamed last.
+fn checkPublishOrder(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "order" });
+    defer h.deinit();
+    const ids = try idsOf(gpa, 3 * block_tokens, 72);
+    defer gpa.free(ids);
+    h.hk.clear();
+    const key = try write(h, ids, .{ .lineage = lin(72), .source = 72 });
+    var nb: [96]u8 = undefined;
+    const man = pointFile(&nb, key, ".man");
+    var last_blk: ?usize = null;
+    var blocks_sync: ?usize = null;
+    var ids_ren: ?usize = null;
+    var st_ren: ?usize = null;
+    var points_sync: ?usize = null;
+    var man_ren: ?usize = null;
+    h.hk.mutex.lockUncancelable(io);
+    for (h.hk.events.items, 0..) |e, i| {
+        const n = e.name[0..e.len];
+        if (e.ev == .rename and std.mem.endsWith(u8, n, ".blk")) last_blk = i;
+        if (e.ev == .dir_fsync and std.mem.eql(u8, n, "blocks") and blocks_sync == null) blocks_sync = i;
+        if (e.ev == .rename and std.mem.endsWith(u8, n, ".ids")) ids_ren = i;
+        if (e.ev == .rename and std.mem.endsWith(u8, n, ".st")) st_ren = i;
+        if (e.ev == .dir_fsync and std.mem.eql(u8, n, "points") and points_sync == null and st_ren != null) points_sync = i;
+        if (e.ev == .rename and std.mem.eql(u8, n, man)) man_ren = i;
+    }
+    h.hk.mutex.unlock(io);
+    const all = last_blk != null and blocks_sync != null and ids_ren != null and st_ren != null and points_sync != null and man_ren != null;
+    try ensure(all, @src());
+    try ensure(last_blk.? < blocks_sync.? and blocks_sync.? < ids_ren.? and ids_ren.? < st_ren.? and st_ren.? < points_sync.? and points_sync.? < man_ren.?, @src());
+}
+
+const Pending = struct {
+    h: *H,
+    held: std.ArrayList(slots.Slot) = .empty,
+
+    fn recycle(ctx: ?*anyopaque) void {
+        const p: *Pending = @ptrCast(@alignCast(ctx.?));
+        for (p.held.items) |s| p.h.s.readRelease(s);
+        p.held.clearRetainingCapacity();
+    }
+};
+
+/// PR 124's hang: a follower whose peer failed early (LOADED with nothing copied before) and more blocks left than
+/// read slots. Its copies complete only when it recycles; its wait for a block gives those slots back each time.
+fn checkHang(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "hang", .read_slots = 4 });
+    defer h.deinit();
+    const n = 12 * block_tokens;
+    const ids = try idsOf(gpa, n, 501);
+    defer gpa.free(ids);
+    const key = try write(h, ids, .{ .lineage = lin(50), .source = 500 });
+    const id = try h.s.beginRead(key);
+    var pend: Pending = .{ .h = h };
+    defer pend.held.deinit(gpa);
+    const out = try gpa.alloc(u8, n * bpt);
+    defer gpa.free(out);
+    var ok = true;
+    for (0..12) |i| {
+        if (!h.s.readAwait(id, @intCast(i), 2 * std.time.ns_per_s, .{ .ctx = &pend, .recycle = Pending.recycle })) {
+            ok = false;
+            break;
+        }
+        var rb: [1]store.ReadyBlock = undefined;
+        const got = h.s.readReady(id, @intCast(i + 1), &rb);
+        if (got.n != 1) {
+            ok = false;
+            break;
+        }
+        @memcpy(out[rb[0].first * bpt ..][0..rb[0].data.len], rb[0].data);
+        try pend.held.append(gpa, rb[0].slot); // its copy's event not complete yet
+    }
+    Pending.recycle(&pend);
+    if (!ok) _ = h.s.endRead(id, .abort) catch {};
+    try ensure(ok, @src());
+    _ = waitUntil(struct {
+        fn f(x: struct { *H, store.ReadId }) bool {
+            return x[0].s.readSmallView(x[1]) != null;
+        }
+    }.f, .{ h, id }, 5000);
+    var done = (h.s.endRead(id, .commit) catch return CheckFailed) orelse return CheckFailed;
+    done.lineage.deinit(gpa);
+    try ensure(std.mem.eql(u8, out, h.src(500)[0 .. n * bpt]), @src());
+}
+
+/// Read-ahead accounting: preallocated buffers are kept and only the shortfall is charged.
+fn checkCarve(gpa: Allocator) !void {
+    const per = 3 * slots.alignment;
+    const pre = try gpa.alignedAlloc(u8, .fromByteUnits(slots.alignment), 2 * per + per / 2);
+    defer gpa.free(pre);
+    try ensure(slots.extraBytes(&.{pre}, per, 7) == 5 * per, @src());
+    try ensure(slots.extraBytes(&.{pre}, per, 2) == 0, @src());
+}
+
+const Slow = struct {
+    h: *H,
+    calls: std.ArrayList(store.ReadId) = .empty,
+
+    fn copy(ctx: ?*anyopaque, id: store.ReadId, b: store.ReadyBlock) bool {
+        const s: *Slow = @ptrCast(@alignCast(ctx.?));
+        s.calls.append(s.h.gpa, id) catch {};
+        std.Io.sleep(io, .fromMilliseconds(30), .awake) catch {};
+        s.h.s.readRelease(b.slot);
+        return true;
+    }
+};
+
+/// GLM review (wojo#2): the restores in flight share one copy budget a pause, each pause starting with the next.
+fn checkBudget(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "budget", .read_slots = 16, .restore_slots = 3, .max_reads = 3 });
+    defer h.deinit();
+    var ids: [3]store.ReadId = undefined;
+    for (0..3) |i| {
+        const x = try idsOf(gpa, 5 * block_tokens, 80 + i);
+        defer gpa.free(x);
+        const key = try write(h, x, .{ .lineage = lin(@intCast(80 + i)), .source = 80 + i });
+        ids[i] = try h.s.beginRead(key);
+    }
+    for (ids) |id| for (0..5) |i| try ensure(h.s.readAwait(id, @intCast(i), 5 * std.time.ns_per_s, .{}), @src());
+    var slow: Slow = .{ .h = h };
+    defer slow.calls.deinit(gpa);
+    var turn: usize = 0;
+    _ = h.s.stepReads(&ids, &turn, 40 * std.time.ns_per_ms, &slow, Slow.copy);
+    // copies counted, not wall time (a loaded machine stretches each 30 ms sleep, which let the every-read-its-own-
+    // budget mutant fit under a time bound): one shared 40 ms budget takes 1 or 2 copies; a budget each read takes
+    // at least one copy per read, 3
+    const first_calls = slow.calls.items.len;
+    var firsts: [3]store.ReadId = undefined;
+    for (0..3) |k| {
+        slow.calls.clearRetainingCapacity();
+        _ = h.s.stepReads(&ids, &turn, 40 * std.time.ns_per_ms, &slow, Slow.copy);
+        firsts[k] = if (slow.calls.items.len > 0) slow.calls.items[0] else 0;
+    }
+    for (ids) |id| _ = h.s.endRead(id, .cancel) catch {};
+    try ensure(first_calls >= 1 and first_calls <= 2, @src()); // (every read the whole budget: 3 or more)
+    std.mem.sort(store.ReadId, &firsts, {}, std.sort.asc(store.ReadId));
+    var want = ids;
+    std.mem.sort(store.ReadId, &want, {}, std.sort.asc(store.ReadId));
+    try ensure(std.mem.eql(store.ReadId, &firsts, &want), @src());
+}
+
+const CrashMode = enum {
+    publish, // a new point's publication
+    link, // ... whose first blocks equal a stored point's bytes (written as hard links)
+    rewrite, // a published point's manifest rewritten with the shared flag
+};
+
+const crash_points = [_]struct { step: fsio.Step, suffix: []const u8, skip: u32 = 0, mode: CrashMode = .publish }{
+    .{ .step = .written, .suffix = ".blk" },
+    .{ .step = .synced, .suffix = ".blk" },
+    .{ .step = .renamed, .suffix = ".blk" },
+    .{ .step = .renamed, .suffix = ".blk", .skip = 1 },
+    .{ .step = .dir_synced, .suffix = "blocks" },
+    .{ .step = .written, .suffix = ".ids" },
+    .{ .step = .renamed, .suffix = ".ids" },
+    .{ .step = .written, .suffix = ".st" },
+    .{ .step = .renamed, .suffix = ".st" },
+    .{ .step = .dir_synced, .suffix = "points" },
+    .{ .step = .written, .suffix = ".man" },
+    .{ .step = .synced, .suffix = ".man" },
+    .{ .step = .renamed, .suffix = ".man" },
+    .{ .step = .published, .suffix = "points" },
+    // PORT-SPILL-V2 stage 5: while a block is linked, and while shared metadata is rewritten
+    .{ .step = .linked, .suffix = ".blk", .mode = .link },
+    .{ .step = .linked, .suffix = ".blk", .skip = 1, .mode = .link },
+    .{ .step = .written, .suffix = ".man", .mode = .rewrite },
+    .{ .step = .synced, .suffix = ".man", .mode = .rewrite },
+    .{ .step = .renamed, .suffix = ".man", .mode = .rewrite },
+    .{ .step = .rewritten, .suffix = ".man", .mode = .rewrite },
+};
+
+fn crashed(h: *H) bool {
+    return h.s.isCrashed();
+}
+
+/// The durability fault campaign: a kill after every write, fsync and rename of a point's publication, after a
+/// dedup link is made (not yet renamed), and at every step of a shared-flag manifest rewrite. On restart an earlier
+/// point verifies and restores; the cut point is either whole (published, shared or not) or gone; no temporary file,
+/// orphan block or slot is left.
+fn checkCrashes(gpa: Allocator) !void {
+    for (crash_points, 0..) |cp, ci| {
+        const h = try H.init(gpa, .{ .tag = "crash" });
+        defer h.deinit();
+        const a = try idsOf(gpa, 2 * block_tokens, 900 + ci);
+        defer gpa.free(a);
+        const ka = try write(h, a, .{ .lineage = lin(90), .source = 90 });
+        const b = try idsOf(gpa, 3 * block_tokens + 3, 950 + ci);
+        defer gpa.free(b);
+        const src_b: u64 = if (cp.mode == .link) 90 else 91; // link: B's rows are A's (other ids, other names)
+        var kb = format.pointKey(b, block_tokens, &.{});
+        if (cp.mode == .rewrite) kb = try write(h, b, .{ .lineage = lin(91), .source = src_b });
+        h.hk.crash_step = cp.step;
+        h.hk.crash_suffix = cp.suffix;
+        h.hk.crash_skip = cp.skip;
+        if (cp.mode == .rewrite) {
+            h.s.markShared(kb);
+        } else {
+            try ensure(keepIds(h, b, .{ .lineage = lin(91), .source = src_b }) == .queued, @src());
+            pump(h);
+        }
+        if (!waitUntil(crashed, h, 3000)) {
+            if (!quiet) std.debug.print("     no crash at {t} {s} (+{d}, {t})\n", .{ cp.step, cp.suffix, cp.skip, cp.mode });
+            return CheckFailed;
+        }
+        const temps_before = countFiles(gpa, h.s.blocks_fd, true) + countFiles(gpa, h.s.points_fd, true);
+        h.hk.crash_step = null;
+        try h.reopen();
+        try ensure(countFiles(gpa, h.s.blocks_fd, true) == 0 and countFiles(gpa, h.s.points_fd, true) == 0, @src());
+        if (temps_before > 0) try ensure(h.s.counts().temps_removed >= temps_before, @src());
+        try ensure(countFiles(gpa, h.s.blocks_fd, false) == h.s.have.count(), @src());
+        try ensure(countFiles(gpa, h.s.points_fd, false) == 3 * h.s.points.count(), @src());
+        const got = (try restore(h, ka)) orelse return CheckFailed;
+        defer gpa.free(got);
+        try ensure(std.mem.eql(u8, got, h.src(90)[0 .. 2 * block_tokens * bpt]), @src());
+        const published = cp.mode == .rewrite or (cp.step == .renamed and std.mem.eql(u8, cp.suffix, ".man")) or cp.step == .published;
+        try ensure(h.s.presence(kb) == published, @src());
+        if (published) {
+            const gb = (try restore(h, kb)) orelse return CheckFailed;
+            defer gpa.free(gb);
+            try ensure(std.mem.eql(u8, gb, h.src(src_b)[0 .. b.len * bpt]), @src());
+        }
+        if (cp.mode == .rewrite) { // whole either way; durably shared once the rewrite's directory fsync ran
+            const on_disk = manifestShared(h, kb) orelse return CheckFailed;
+            try ensure((h.s.points.get(kb) orelse return CheckFailed).shared == on_disk, @src());
+            if (cp.step == .rewritten) try ensure(on_disk, @src());
+            if (cp.step == .written or cp.step == .synced) try ensure(!on_disk, @src());
+        }
+    }
+}
+
+/// Recovery: a truncated block, a missing small state and a damaged manifest each drop only their point; a stale
+/// temporary file and unreferenced blocks are collected.
+fn checkRecovery(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "recover" });
+    defer h.deinit();
+    var keys: [4]Digest = undefined;
+    for (0..4) |i| {
+        const x = try idsOf(gpa, 2 * block_tokens + 4, 300 + i);
+        defer gpa.free(x);
+        keys[i] = try write(h, x, .{ .lineage = lin(@intCast(30 + i)), .source = 300 + i });
+    }
+    const p0 = h.s.points.get(keys[0]) orelse return CheckFailed;
+    var nb: [96]u8 = undefined;
+    var zb: [96]u8 = undefined;
+    const bname = try std.fmt.bufPrintSentinel(&zb, "{s}", .{blockFile(&nb, p0.blocks[0].name)}, 0);
+    const fd = c.openat(h.s.blocks_fd, bname, .{ .ACCMODE = .WRONLY, .CLOEXEC = true }, @as(c.mode_t, 0));
+    _ = c.ftruncate(fd, block_bytes - 100);
+    _ = c.close(fd);
+    var nb2: [96]u8 = undefined;
+    var zb2: [96]u8 = undefined;
+    _ = c.unlinkat(h.s.points_fd, try std.fmt.bufPrintSentinel(&zb2, "{s}", .{pointFile(&nb2, keys[1], ".st")}, 0), 0);
+    const mname = try std.fmt.bufPrintSentinel(&zb2, "{s}", .{pointFile(&nb2, keys[2], ".man")}, 0);
+    const mfd = c.openat(h.s.points_fd, mname, .{ .ACCMODE = .WRONLY, .CLOEXEC = true }, @as(c.mode_t, 0));
+    const junk: [4]u8 = @splat(0x33);
+    _ = c.pwrite(mfd, &junk, 4, 40);
+    _ = c.close(mfd);
+    const tfd = c.openat(h.s.blocks_fd, ".stale.blk.1.1.tmp", .{ .ACCMODE = .WRONLY, .CREAT = true, .CLOEXEC = true }, @as(c.mode_t, 0o600));
+    _ = c.close(tfd);
+    try h.reopen();
+    try ensure(!h.s.points.contains(keys[0]) and !h.s.points.contains(keys[1]) and !h.s.points.contains(keys[2]), @src());
+    try ensure(h.s.points.contains(keys[3]), @src());
+    try ensure(h.s.counts().recovered_dropped == 3 and h.s.counts().temps_removed >= 1, @src());
+    try ensure(countFiles(gpa, h.s.blocks_fd, false) == h.s.have.count() and h.s.have.count() == 3, @src());
+    const got = (try restore(h, keys[3])) orelse return CheckFailed;
+    defer gpa.free(got);
+    try ensure(std.mem.eql(u8, got, h.src(303)[0 .. (2 * block_tokens + 4) * bpt]), @src());
+}
+
+/// CRC-32 forging: the 4 bytes that make `data[0 .. len - 4] ++ them` hash to `target` (reflected, ISO-HDLC).
+fn forgeCrc(data: []u8, target: u32) void {
+    var table: [256]u32 = undefined;
+    for (&table, 0..) |*t, i| {
+        var x: u32 = @intCast(i);
+        for (0..8) |_| x = if (x & 1 != 0) (x >> 1) ^ 0xEDB88320 else x >> 1;
+        t.* = x;
+    }
+    const head = data[0 .. data.len - 4];
+    const before = ~std.hash.Crc32.hash(head); // the register after the head
+    var x: u32 = ~target; // the register wanted after the last 4 bytes
+    for (0..4) |_| {
+        const top: u8 = @truncate(x >> 24);
+        var idx: u32 = 0;
+        for (table, 0..) |t, i| if (@as(u8, @truncate(t >> 24)) == top) {
+            idx = @intCast(i);
+            break;
+        };
+        x = ((x ^ table[idx]) << 8) | idx;
+    }
+    std.mem.writeInt(u32, data[data.len - 4 ..][0..4], x ^ before, .little);
+}
+
+/// Dedup links only equal bytes: a block with the same CRC-32 and length but other bytes is written, not linked.
+fn checkDedupSha(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "dedup" });
+    defer h.deinit();
+    const ia = try idsOf(gpa, block_tokens, 41);
+    defer gpa.free(ia);
+    const ib = try idsOf(gpa, block_tokens, 42);
+    defer gpa.free(ib);
+    const ka = try write(h, ia, .{ .lineage = lin(41), .source = 41 });
+    const want = std.hash.Crc32.hash(h.src(41)[0..block_bytes]);
+    const rows = h.src(42);
+    @memcpy(rows[0..block_bytes], h.src(41)[0..block_bytes]);
+    rows[17] ^= 0x5a;
+    forgeCrc(rows[0..block_bytes], want);
+    try ensure(std.hash.Crc32.hash(rows[0..block_bytes]) == want, @src());
+    const kb = try write(h, ib, .{ .lineage = lin(42), .source = 42 });
+    const pa = h.s.points.get(ka) orelse return CheckFailed;
+    const pb = h.s.points.get(kb) orelse return CheckFailed;
+    try ensure(h.s.have.get(pa.blocks[0].name).?.ino != h.s.have.get(pb.blocks[0].name).?.ino, @src());
+    const got = (try restore(h, kb)) orelse return CheckFailed;
+    defer gpa.free(got);
+    try ensure(std.mem.eql(u8, got, rows[0..block_bytes]), @src());
+}
+
+/// A guard before source rows change: the point's blocks still to stage are staged now (the engine queues those
+/// copies before the change), never cancelled while slots allow.
+fn checkGuard(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "guard" });
+    defer h.deinit();
+    const ids = try idsOf(gpa, 4 * block_tokens, 7);
+    defer gpa.free(ids);
+    const kept = try gpa.dupe(u8, h.src(5)[0 .. 4 * block_tokens * bpt]);
+    defer gpa.free(kept);
+    try ensure(keepIds(h, ids, .{ .lineage = lin(7), .source = 5 }) == .queued, @src());
+    try ensure(h.s.pins(.{ .id = 5, .generation = 1 }, 0), @src());
+    var any: [3]bool = undefined;
+    h.s.pinsAny(&.{ 6, 5, 9 }, &any); // (pins for many sources, one lock)
+    try ensure(!any[0] and any[1] and !any[2], @src());
+    var out: [8]store.StageReq = undefined;
+    const g = h.s.guard(.{ .id = 5, .generation = 1 }, 0, &out);
+    try ensure(g.staged == 4 and g.cancelled == 0, @src());
+    h.s.pinsAny(&.{ 6, 5, 9 }, &any); // (every block staged: nothing left to pin, as pins says)
+    try ensure(!any[1] and any[1] == h.s.pins(.{ .id = 5, .generation = 1 }, 0), @src());
+    for (out[0..g.staged]) |r| @memcpy(r.dst, h.src(5)[r.first * bpt ..][0..r.dst.len]); // queued before the change
+    @memset(h.src(5)[0 .. 4 * block_tokens * bpt], 0xee); // the change
+    for (out[0..g.staged]) |r| h.s.staged(r.ticket, true);
+    try ensure(settle(h).done, @src());
+    const got = (try restore(h, format.pointKey(ids, block_tokens, &.{}))) orelse return CheckFailed;
+    defer gpa.free(got);
+    try ensure(std.mem.eql(u8, got, kept), @src());
+}
+
+/// ... past the room it has, or for an older generation of the source, the unpublished point is cancelled, its
+/// staging back, a completion saying why.
+fn checkGuardCancel(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "guardc" });
+    defer h.deinit();
+    const ids = try idsOf(gpa, 4 * block_tokens, 8);
+    defer gpa.free(ids);
+    try ensure(keepIds(h, ids, .{ .lineage = lin(8), .source = 6 }) == .queued, @src());
+    var out: [2]store.StageReq = undefined;
+    const g = h.s.guard(.{ .id = 6, .generation = 1 }, 0, &out);
+    try ensure(g.staged == 0 and g.cancelled == 1, @src());
+    const ids2 = try idsOf(gpa, 2 * block_tokens, 9);
+    defer gpa.free(ids2);
+    try ensure(keepIds(h, ids2, .{ .lineage = lin(9), .source = 7, .gen = 1 }) == .queued, @src());
+    var o2: [8]store.StageReq = undefined;
+    const g2 = h.s.guard(.{ .id = 7, .generation = 2 }, 0, &o2);
+    try ensure(g2.cancelled == 1, @src());
+    var comp: [4]store.Completion = undefined;
+    const n = h.s.poll(&comp);
+    try ensure(n == 2 and comp[0] == .cancelled and comp[0].cancelled.why == .guard and comp[1].cancelled.why == .source_gone, @src());
+    _ = settle(h);
+    const ct = h.s.counts();
+    try ensure(ct.staging_bytes == 0 and ct.points == 0 and ct.pending_jobs == 0, @src());
+}
+
+/// The staging cap holds for a point larger than all of staging (the GPU's 250k-token point is ~220 MB against a
+/// 128 MiB cap): its blocks are staged a few slots at a time as the writer frees them, its restore reads through a
+/// few read slots, a guard that cannot stage what is left cancels instead of overshooting, and the peak counter is
+/// what was held at once (at most the slots carved), never more.
+fn checkStagingCap(gpa: Allocator) !void {
+    const o: Opts = .{ .tag = "stagecap", .write_slots = 3, .read_slots = 2, .small_slots = 2, .restore_slots = 1 };
+    const cap: u64 = (o.write_slots + o.read_slots) * block_bytes + (o.small_slots + o.restore_slots) * small_max;
+    const h = try H.init(gpa, o);
+    defer h.deinit();
+    const ids = try idsOf(gpa, max_tokens, 3100); // 64 blocks: 256 KiB against 44 KiB of staging
+    defer gpa.free(ids);
+    try ensure(max_tokens * bpt > 4 * cap, @src());
+    try ensure(keepIds(h, ids, .{ .lineage = lin(31), .source = 310 }) == .queued, @src());
+    var reqs: [16]store.StageReq = undefined;
+    var staged: usize = 0;
+    var i: usize = 0;
+    while (i < 20000 and h.s.pendingStage() > 0) : (i += 1) {
+        const n = h.s.stage(&reqs);
+        try ensure(n <= o.write_slots, @src());
+        try ensure(h.s.counts().staging_bytes <= cap, @src());
+        for (reqs[0..n]) |r| {
+            @memcpy(r.dst, h.src(310)[r.first * bpt ..][0..r.dst.len]);
+            h.s.staged(r.ticket, true);
+        }
+        staged += n;
+        if (n == 0) std.Io.sleep(io, .fromMilliseconds(1), .awake) catch {};
+    }
+    try ensure(staged == max_tokens / block_tokens, @src());
+    try ensure(h.s.drain(5 * std.time.ns_per_s).done, @src());
+    const key = format.pointKey(ids, block_tokens, &.{});
+    try ensure(h.s.presence(key), @src());
+    const got = (try restore(h, key)) orelse return CheckFailed;
+    defer gpa.free(got);
+    try ensure(std.mem.eql(u8, got, h.src(310)[0 .. max_tokens * bpt]), @src());
+    // a second large point guarded before any of it staged: more blocks left than free write slots, so it is cancelled
+    const ids2 = try idsOf(gpa, max_tokens, 3101);
+    defer gpa.free(ids2);
+    try ensure(keepIds(h, ids2, .{ .lineage = lin(32), .source = 311 }) == .queued, @src());
+    var out: [64]store.StageReq = undefined;
+    const g = h.s.guard(.{ .id = 311, .generation = 1 }, 0, &out);
+    try ensure(g.staged == 0 and g.cancelled == 1, @src());
+    _ = settle(h);
+    const ct = h.s.counts();
+    try ensure(ct.staging_peak_bytes <= cap and ct.staging_peak_bytes >= block_bytes, @src());
+    try ensure(ct.staging_bytes == 0 and ct.guard_staged == 0 and ct.cancelled_guard == 1, @src());
+}
+
+/// 0110's eviction order: old turns, abandoned forks, whole conversations least recently used first (longest state
+/// first within one), shared prefixes last.
+fn checkEvictionOrder(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "evict", .turns = 2 });
+    defer h.deinit();
+    const sys = try idsOf(gpa, 2 * block_tokens, 1000);
+    defer gpa.free(sys);
+    const r1 = try idsOf(gpa, block_tokens, 1001);
+    defer gpa.free(r1);
+    const r2 = try idsOf(gpa, block_tokens, 1002);
+    defer gpa.free(r2);
+    const r3 = try idsOf(gpa, block_tokens, 1003);
+    defer gpa.free(r3);
+    const r4 = try idsOf(gpa, block_tokens, 1004);
+    defer gpa.free(r4);
+    const b1 = try cat(gpa, sys, r1);
+    defer gpa.free(b1);
+    const a1 = try cat(gpa, sys, r2);
+    defer gpa.free(a1);
+    const a2f = try cat(gpa, a1, r3);
+    defer gpa.free(a2f);
+    const a2 = try cat(gpa, a1, r4);
+    defer gpa.free(a2);
+    const ks = try write(h, sys, .{ .lineage = lin(1), .source = 1, .shared = true });
+    const kb1 = try write(h, b1, .{ .lineage = lin(2), .source = 2 });
+    const ka1 = try write(h, a1, .{ .lineage = lin(3), .source = 3 });
+    const ka2f = try write(h, a2f, .{ .lineage = lin(4), .source = 4 });
+    const ka2 = try write(h, a2, .{ .lineage = lin(5), .source = 5 });
+    const order = h.s.evictionOrder() catch return CheckFailed;
+    defer gpa.free(order);
+    const W = Store.Why;
+    const want = [_]struct { k: Digest, w: W }{
+        .{ .k = ka2f, .w = .pruned_forks },
+        .{ .k = kb1, .w = .pruned_conversations },
+        .{ .k = ka2, .w = .pruned_conversations },
+        .{ .k = ka1, .w = .pruned_conversations },
+        .{ .k = ks, .w = .pruned_shared },
+    };
+    try ensure(order.len == want.len, @src());
+    for (order, want) |o, w| try ensure(std.mem.eql(u8, &o.key, &w.k) and o.why == w.w, @src());
+    const sm = h.s.summary();
+    try ensure(sm.conversations == 2 and sm.shared_states == 1 and sm.forks == 1 and sm.turns_kept_max == 2, @src());
+}
+
+/// Old turns past retention on the active path go as soon as a newer turn is written; their blocks stay (the
+/// newer turn names them).
+fn checkTurns(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "turns", .turns = 2 });
+    defer h.deinit();
+    const t3 = try idsOf(gpa, 3 * block_tokens, 1100);
+    defer gpa.free(t3);
+    const k1 = try write(h, t3[0..block_tokens], .{ .lineage = lin(1), .source = 11 });
+    const k2 = try write(h, t3[0 .. 2 * block_tokens], .{ .lineage = lin(1), .source = 11 });
+    const k3 = try write(h, t3, .{ .lineage = lin(1), .source = 11 });
+    try ensure(!h.s.points.contains(k1) and h.s.points.contains(k2) and h.s.points.contains(k3), @src());
+    const ct = h.s.counts();
+    try ensure(ct.trimmed_turns == 1 and ct.blocks == 3 and ct.staged_blocks == 3, @src());
+    const got = (try restore(h, k3)) orelse return CheckFailed;
+    defer gpa.free(got);
+    try ensure(std.mem.eql(u8, got, h.src(11)[0 .. 3 * block_tokens * bpt]), @src());
+}
+
+const glm_bpt = 3 * 256; // like GLM's 6,204 B a token: a whole block fills whole pages, a grid tail does not
+
+fn parentIs(h: *H, key: Digest, want: ?Digest) bool {
+    const got = h.s.parent.get(key) orelse return false;
+    if (got == null or want == null) return got == null and want == null;
+    return std.mem.eql(u8, &got.?, &want.?);
+}
+
+/// GLM's shape: one conversation (one 0111 group) kept on a grid inside blocks (4 here, GLM's 64 of 2,048), with
+/// bytes a token that do not divide a page. Turns inside one block extend each other, so `turns` trims them. A turn
+/// past a block boundary does not extend the turn before it (`extends` keeps only the last block's ids): it starts a
+/// new path and the turns before it stay past `turns` (docs/glm-port/spill-store.md, open issue 1; a fix there
+/// changes this check). Every point, its tail off the page grid, restores exactly.
+fn checkGridTurns(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "grid", .turns = 2, .bpt = glm_bpt });
+    defer h.deinit();
+    const ids = try idsOf(gpa, 3 * block_tokens, 1150);
+    defer gpa.free(ids);
+    const ats = [_]usize{ 20, 24, 28, 36, 40, 44 };
+    var k: [ats.len]Digest = undefined;
+    for (ats[0..3], 0..) |at, i| k[i] = try write(h, ids[0..at], .{ .lineage = lin(15), .source = 15, .group = 9 });
+    try ensure(!h.s.points.contains(k[0]) and h.s.points.contains(k[1]) and h.s.points.contains(k[2]), @src());
+    try ensure(parentIs(h, k[2], k[1]) and h.s.counts().trimmed_turns == 1, @src());
+    k[3] = try write(h, ids[0..ats[3]], .{ .lineage = lin(15), .source = 15, .group = 9 });
+    try ensure(parentIs(h, k[3], null) and h.s.counts().trimmed_turns == 1, @src()); // the boundary: nothing trimmed
+    k[4] = try write(h, ids[0..ats[4]], .{ .lineage = lin(15), .source = 15, .group = 9 });
+    try ensure(parentIs(h, k[4], k[3]) and h.s.counts().trimmed_turns == 1, @src());
+    k[5] = try write(h, ids[0..ats[5]], .{ .lineage = lin(15), .source = 15, .group = 9 });
+    try ensure(parentIs(h, k[5], k[4]) and h.s.counts().trimmed_turns == 2, @src());
+    try ensure(!h.s.points.contains(k[3]) and h.s.points.contains(k[4]) and h.s.points.contains(k[5]), @src());
+    try ensure(h.s.points.contains(k[1]) and h.s.points.contains(k[2]), @src()); // stranded behind the boundary
+    try ensure(h.s.summary().conversations == 1, @src()); // the group still makes them one conversation
+    for ([_]usize{ 1, 2, 4, 5 }) |i| {
+        try ensure((ats[i] % block_tokens) * glm_bpt % fsio.alignment != 0, @src());
+        const got = (try restore(h, k[i])) orelse return CheckFailed;
+        defer gpa.free(got);
+        try ensure(std.mem.eql(u8, got, h.src(15)[0 .. ats[i] * glm_bpt]), @src());
+    }
+}
+
+/// A resume forks the lineage at its cut: the same names before it (nothing restaged), its own after.
+fn checkFork(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "fork" });
+    defer h.deinit();
+    const p = try idsOf(gpa, 3 * block_tokens, 1200);
+    defer gpa.free(p);
+    const more = try idsOf(gpa, 2 * block_tokens, 1201);
+    defer gpa.free(more);
+    const q = try cat(gpa, p[0 .. 2 * block_tokens], more);
+    defer gpa.free(q);
+    _ = try write(h, p, .{ .lineage = lin(12), .source = 12 });
+    const before = h.s.counts().staged_blocks;
+    var forked = try lin(12).fork(gpa, @splat(77), 2 * block_tokens);
+    defer forked.deinit(gpa);
+    const kq = try write(h, q, .{ .lineage = forked, .source = 12 });
+    try ensure(h.s.counts().staged_blocks - before == 2, @src());
+    const got = (try restore(h, kq)) orelse return CheckFailed;
+    defer gpa.free(got);
+    try ensure(std.mem.eql(u8, got, h.src(12)[0 .. 4 * block_tokens * bpt]), @src());
+}
+
+/// 0111 groups: branches of one conversation that share only a shared prefix count as one conversation.
+fn checkGroups(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "groups" });
+    defer h.deinit();
+    const sys = try idsOf(gpa, block_tokens, 1300);
+    defer gpa.free(sys);
+    _ = try write(h, sys, .{ .lineage = lin(13), .source = 13, .shared = true });
+    for (0..3) |i| {
+        const x = try idsOf(gpa, block_tokens, 1301 + i);
+        defer gpa.free(x);
+        const y = try cat(gpa, sys, x);
+        defer gpa.free(y);
+        _ = try write(h, y, .{ .lineage = lin(@intCast(14 + i)), .source = 14 + i, .group = if (i < 2) 7 else 0 });
+    }
+    try ensure(h.s.summary().conversations == 2, @src());
+}
+
+/// A conversation over its quota trims its own old turns and forks first, not another conversation's states.
+fn checkQuota(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "quota", .cap = 400 << 10, .quota = 0.1, .turns = 0 });
+    defer h.deinit();
+    const other = try idsOf(gpa, 2 * block_tokens, 1400);
+    defer gpa.free(other);
+    const ko = try write(h, other, .{ .lineage = lin(40), .source = 40 });
+    const conv = try idsOf(gpa, 8 * block_tokens, 1401);
+    defer gpa.free(conv);
+    var keys: [8]Digest = undefined;
+    for (1..9) |t| {
+        const r = keepIds(h, conv[0 .. t * block_tokens], .{ .lineage = lin(41), .source = 41 });
+        if (r != .queued) break;
+        try ensure(settle(h).done, @src());
+        keys[t - 1] = format.pointKey(conv[0 .. t * block_tokens], block_tokens, &.{});
+    }
+    const ct = h.s.counts();
+    try ensure(ct.quota_trims > 0 and ct.pruned_turns > 0, @src());
+    try ensure(h.s.points.contains(ko), @src());
+    try ensure(h.s.points.contains(keys[7]), @src());
+}
+
+/// The free-disk floor: no write leaves less free; room is made in eviction order, else the write is refused.
+fn checkFloor(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "floor", .floor = 1 << 20, .free = (1 << 20) + 200 * 1024 });
+    defer h.deinit();
+    const a = try idsOf(gpa, 4 * block_tokens, 1500);
+    defer gpa.free(a);
+    const ka = try write(h, a, .{ .lineage = lin(50), .source = 50 });
+    // the disk fills with other files: the next write evicts A first
+    h.hk.free = (1 << 20) + 2 * 1024;
+    h.s.refreshDiskFree();
+    const b = try idsOf(gpa, 2 * block_tokens, 1501);
+    defer gpa.free(b);
+    try ensure(keepIds(h, b, .{ .lineage = lin(51), .source = 51 }) == .queued, @src());
+    try ensure(!h.s.points.contains(ka), @src());
+    _ = settle(h);
+    // full of other things: nothing could make room, the write is refused
+    h.hk.free = 1 << 10;
+    h.s.refreshDiskFree();
+    const c2 = try idsOf(gpa, 2 * block_tokens, 1502);
+    defer gpa.free(c2);
+    try ensure(keepIds(h, c2, .{ .lineage = lin(52), .source = 52 }) == .no_space, @src());
+}
+
+/// The cap: a write that would pass it evicts the least recently used conversation, not a newer one.
+fn checkCap(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "cap", .cap = 12 * 1024 });
+    defer h.deinit();
+    var keys: [3]Digest = undefined;
+    for (0..3) |i| {
+        const x = try idsOf(gpa, block_tokens, 1600 + i);
+        defer gpa.free(x);
+        keys[i] = try write(h, x, .{ .lineage = lin(@intCast(60 + i)), .source = 60 + i });
+    }
+    try ensure(!h.s.points.contains(keys[0]) and h.s.points.contains(keys[1]) and h.s.points.contains(keys[2]), @src());
+    try ensure(h.s.counts().pruned_conversations >= 1 and h.s.counts().stored_bytes <= h.cfg.cap_bytes, @src());
+}
+
+/// A second owner of a live store is refused before it scans or deletes anything.
+fn checkOwner(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "owner" });
+    defer h.deinit();
+    const tfd = c.openat(h.s.blocks_fd, ".pending.blk.9.9.tmp", .{ .ACCMODE = .WRONLY, .CREAT = true, .CLOEXEC = true }, @as(c.mode_t, 0o600));
+    _ = c.close(tfd);
+    if (Store.open(gpa, io, h.cfg)) |other| {
+        other.close();
+        try ensure(false, @src());
+    } else |e| try ensure(e == error.StoreBusy, @src());
+    try ensure(fileExists(h.s.blocks_fd, ".pending.blk.9.9.tmp"), @src());
+}
+
+/// Other builds' namespaces: pruned unless live (locked).
+fn checkPrune(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "prune", .keep_builds = 0 });
+    defer h.deinit();
+    const rfd = try fsio.openDir(h.root);
+    defer _ = c.close(rfd);
+    try fsio.ensureDirAt(rfd, "native-spill-00000000deadbeef");
+    const ofd = try fsio.openDirAt(rfd, "native-spill-00000000deadbeef");
+    defer _ = c.close(ofd);
+    try fsio.ensureDirAt(ofd, "rank0");
+    const r0 = try fsio.openDirAt(ofd, "rank0");
+    var live = try fsio.Lock.take(r0);
+    try h.reopen();
+    try ensure(fileExists(ofd, "rank0"), @src());
+    live.release();
+    _ = c.close(r0);
+    try h.reopen();
+    try ensure(!fileExists(rfd, "native-spill-00000000deadbeef"), @src());
+}
+
+/// Families sharing a root: open prunes only its own family's namespaces, by their exact shape. Another family's
+/// (DeepSeek's `native-spill-`) and a name that only starts like ours stay, unlocked as they are.
+fn checkPruneFamilies(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "families", .keep_builds = 0, .prefix = "glm-spill-" });
+    defer h.deinit();
+    const rfd = try fsio.openDir(h.root);
+    defer _ = c.close(rfd);
+    const names = [_][:0]const u8{ "native-spill-00000000cafef00d", "glm-spill-notabuild", "glm-spill-00000000deadbeef0", "glm-spill-00000000deadbeef" };
+    for (names) |n| {
+        try fsio.ensureDirAt(rfd, n);
+        const d = try fsio.openDirAt(rfd, n);
+        defer _ = c.close(d);
+        try fsio.ensureDirAt(d, "rank0");
+    }
+    try h.reopen();
+    for (names[0..3]) |n| try ensure(fileExists(rfd, n), @src());
+    try ensure(!fileExists(rfd, names[3]) and h.s.counts().builds_pruned == 1, @src());
+    var nb: [64]u8 = undefined;
+    try ensure(fileExists(rfd, try std.fmt.bufPrint(&nb, "glm-spill-{s}", .{format.hex(&h.cfg.compat)[0..16]})), @src());
+}
+
+/// Lookups: the longest complete point the prompt extends within its bounds; media must match.
+fn checkLookup(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "lookup", .turns = 0 });
+    defer h.deinit();
+    const ids = try idsOf(gpa, 5 * block_tokens, 1700);
+    defer gpa.free(ids);
+    const m = [_]format.Media{.{ .start = 3, .len = 4, .digest = @splat(1) }};
+    const raw = try gpa.dupe(u32, ids);
+    defer gpa.free(raw);
+    for (3..7) |i| { // the picture's keyed ids made from its digest, its raw ids the placeholder
+        ids[i] = format.pictureId(&m[0].digest, @intCast(i - 3));
+        raw[i] = 99;
+    }
+    // a point whose ids do not agree with its media is refused at keep (and would be at recovery)
+    try ensure(keepIds(h, ids[0 .. 2 * block_tokens], .{ .lineage = lin(70), .source = 70, .media = &m }) == .invalid, @src());
+    var forged = m;
+    forged[0].digest[20] ^= 1; // (the first 8 bytes seed the ids: the same ids, another picture past them)
+    const kf = try write(h, ids[0 .. 2 * block_tokens], .{ .lineage = lin(70), .source = 70, .media = &forged, .raw = raw });
+    var seeded = m;
+    seeded[0].digest[0] ^= 1; // (a seed byte changed: its ids no longer derive from it)
+    try ensure(keepIds(h, ids[0 .. 2 * block_tokens], .{ .lineage = lin(70), .source = 70, .media = &seeded, .raw = raw }) == .invalid, @src());
+    var placeholder = try gpa.dupe(u32, raw);
+    defer gpa.free(placeholder);
+    placeholder[4] = ids[4]; // a raw id inside the picture that is a picture's keyed id, not a model id
+    try ensure(keepIds(h, ids[0 .. 2 * block_tokens], .{ .lineage = lin(70), .source = 70, .media = &m, .raw = placeholder }) == .invalid, @src());
+    const k2 = try write(h, ids[0 .. 2 * block_tokens], .{ .lineage = lin(70), .source = 70, .media = &m, .raw = raw });
+    const k4 = try write(h, ids[0 .. 4 * block_tokens], .{ .lineage = lin(70), .source = 70, .media = &m, .raw = raw });
+    const q = struct {
+        fn at(hh: *H, x: store.Query) ?Digest {
+            return if (hh.s.lookup(x)) |hit| hit.key else null;
+        }
+    };
+    try ensure(std.meta.eql(q.at(h, .{ .keyed = ids, .media = &m, .max_at = 70 }), k4), @src());
+    try ensure(std.meta.eql(q.at(h, .{ .keyed = ids, .media = &m, .max_at = 50 }), k2), @src());
+    try ensure(q.at(h, .{ .keyed = ids, .media = &m, .max_at = 50, .longer_than = 40 }) == null, @src());
+    try ensure(std.meta.eql(q.at(h, .{ .keyed = ids, .media = &m, .max_at = 80, .grid = 64 }), k4), @src());
+    var other = m;
+    other[0].digest[0] = 2;
+    try ensure(q.at(h, .{ .keyed = ids, .media = &other, .max_at = 80 }) == null, @src());
+    // the same shortened ids from another payload (only the full digest tells them apart): its own point, never m's
+    try ensure(std.meta.eql(q.at(h, .{ .keyed = ids, .media = &forged, .max_at = 80 }), kf), @src());
+    try ensure(!std.meta.eql(kf, k2), @src());
+    try ensure(q.at(h, .{ .keyed = ids, .media = &.{}, .max_at = 80 }) == null, @src());
+    var changed = try gpa.dupe(u32, ids);
+    defer gpa.free(changed);
+    changed[20] +%= 1;
+    try ensure(std.meta.eql(q.at(h, .{ .keyed = changed, .media = &m, .max_at = 80 }), null), @src());
+    // across a restart: the points with pictures recover (their ids checked against their media) and match as before
+    try h.reopen();
+    try ensure(std.meta.eql(q.at(h, .{ .keyed = ids, .media = &m, .max_at = 70 }), k4), @src());
+    try ensure(std.meta.eql(q.at(h, .{ .keyed = ids, .media = &forged, .max_at = 80 }), kf), @src());
+    try ensure(q.at(h, .{ .keyed = ids, .media = &other, .max_at = 80 }) == null, @src());
+}
+
+/// Replace a point file's bytes (same name, truncated first).
+fn rewritePointFile(h: *H, key: Digest, suffix: []const u8, bytes: []const u8) !void {
+    var nb: [96]u8 = undefined;
+    var zb: [96]u8 = undefined;
+    const name = try std.fmt.bufPrintSentinel(&zb, "{s}", .{pointFile(&nb, key, suffix)}, 0);
+    const fd = c.openat(h.s.points_fd, name, .{ .ACCMODE = .WRONLY, .TRUNC = true, .CLOEXEC = true }, @as(c.mode_t, 0));
+    if (fd < 0) return CheckFailed;
+    defer _ = c.close(fd);
+    if (c.pwrite(fd, bytes.ptr, bytes.len, 0) != @as(isize, @intCast(bytes.len))) return CheckFailed;
+}
+
+/// A picture point's raw ids altered on disk with every CRC made good (the .ids file's in the manifest, the
+/// manifest's trailer): raw ids are not in the point key, so only recovery's `format.mediaIds` check catches it. A
+/// raw id inside the picture made a picture id, and a raw id outside it changed, each drop their point; an untouched
+/// picture point beside them recovers and still matches.
+fn checkPictureRecovery(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "picrecover", .turns = 0 });
+    defer h.deinit();
+    const m = [_]format.Media{.{ .start = 3, .len = 4, .digest = @splat(7) }};
+    const n = 2 * block_tokens;
+    var keys: [3]Digest = undefined;
+    var keyed: [3][]u32 = undefined;
+    for (0..3) |i| {
+        keyed[i] = try idsOf(gpa, n, 1900 + i);
+        const raw = try gpa.dupe(u32, keyed[i]);
+        defer gpa.free(raw);
+        for (3..7) |j| {
+            keyed[i][j] = format.pictureId(&m[0].digest, @intCast(j - 3));
+            raw[j] = 99;
+        }
+        keys[i] = try write(h, keyed[i], .{ .lineage = lin(@intCast(80 + i)), .source = 80 + i, .media = &m, .raw = raw });
+    }
+    defer for (keyed) |k| gpa.free(k);
+    for (0..2) |i| {
+        var nb: [96]u8 = undefined;
+        var zb: [96]u8 = undefined;
+        const ids_raw = try fsio.readSmall(gpa, h.s.points_fd, try std.fmt.bufPrintSentinel(&zb, "{s}", .{pointFile(&nb, keys[i], ".ids")}, 0), 1 << 20);
+        defer gpa.free(ids_raw);
+        try ensure(ids_raw.len >= 2 * n * 4, @src());
+        const raw_ids: []align(1) u32 = std.mem.bytesAsSlice(u32, ids_raw[n * 4 ..][0 .. n * 4]);
+        if (i == 0) raw_ids[4] = keyed[i][4] else raw_ids[10] +%= 1; // a picture id inside, another model id outside
+        try rewritePointFile(h, keys[i], ".ids", ids_raw);
+        const man = try fsio.readSmall(gpa, h.s.points_fd, try std.fmt.bufPrintSentinel(&zb, "{s}", .{pointFile(&nb, keys[i], ".man")}, 0), 1 << 20);
+        defer gpa.free(man);
+        var mf = try format.Manifest.parse(gpa, man, h.cfg.compat, h.cfg.limits);
+        defer mf.deinit(gpa);
+        const same = try mf.encode(gpa, h.cfg.compat);
+        defer gpa.free(same);
+        try ensure(std.mem.eql(u8, same, man), @src()); // (the re-encoding is the manifest's own bytes)
+        mf.ids_crc = format.crc32(ids_raw);
+        const fixed = try mf.encode(gpa, h.cfg.compat);
+        defer gpa.free(fixed);
+        try rewritePointFile(h, keys[i], ".man", fixed);
+    }
+    try h.reopen();
+    try ensure(h.s.counts().recovered_dropped == 2, @src());
+    try ensure(!h.s.presence(keys[0]) and !h.s.presence(keys[1]) and h.s.presence(keys[2]), @src());
+    for (0..2) |i| try ensure(h.s.lookup(.{ .keyed = keyed[i], .media = &m, .max_at = 80 }) == null, @src());
+    const hit = h.s.lookup(.{ .keyed = keyed[2], .media = &m, .max_at = 80 }) orelse return CheckFailed;
+    try ensure(std.mem.eql(u8, &hit.key, &keys[2]), @src());
+}
+
+/// Disk faults on the write path: ENOSPC fails the point and leaves no temporary file or staging behind; short
+/// writes and EINTR still write every byte; a file system without O_DIRECT is written buffered.
+fn checkWriteFaults(gpa: Allocator) !void {
+    {
+        const h = try H.init(gpa, .{ .tag = "enospc" });
+        defer h.deinit();
+        const ids = try idsOf(gpa, 3 * block_tokens, 1800);
+        defer gpa.free(ids);
+        h.hk.nospace_writes = 1;
+        try ensure(keepIds(h, ids, .{ .lineage = lin(80), .source = 80 }) == .queued, @src());
+        _ = settle(h);
+        var comp: [4]store.Completion = undefined;
+        const n = h.s.poll(&comp);
+        try ensure(n == 1 and comp[0] == .failed and comp[0].failed.why == .no_space, @src());
+        try ensure(!h.s.presence(format.pointKey(ids, block_tokens, &.{})), @src());
+        try ensure(countFiles(gpa, h.s.blocks_fd, true) == 0 and countFiles(gpa, h.s.points_fd, false) == 0, @src());
+        try ensure(h.s.counts().staging_bytes == 0, @src());
+    }
+    inline for (.{ false, true }) |nd| {
+        const h = try H.init(gpa, .{ .tag = "short", .no_direct = nd });
+        defer h.deinit();
+        const ids = try idsOf(gpa, 3 * block_tokens + 9, 1801);
+        defer gpa.free(ids);
+        h.hk.short_intr = true;
+        const key = try write(h, ids, .{ .lineage = lin(81), .source = 81 });
+        h.hk.short_intr = false;
+        try h.reopen();
+        const got = (try restore(h, key)) orelse return CheckFailed;
+        defer gpa.free(got);
+        try ensure(std.mem.eql(u8, got, h.src(81)[0 .. ids.len * bpt]), @src());
+    }
+}
+
+/// A restore cancelled while its reads are in flight gives every slot back, and the point back to eviction.
+fn checkCancelRead(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "cancelread", .read_slots = 3 });
+    defer h.deinit();
+    const ids = try idsOf(gpa, 8 * block_tokens, 1900);
+    defer gpa.free(ids);
+    const key = try write(h, ids, .{ .lineage = lin(90), .source = 90 });
+    const id = try h.s.beginRead(key);
+    var rb: [1]store.ReadyBlock = undefined;
+    _ = h.s.readAwait(id, 0, 5 * std.time.ns_per_s, .{});
+    const got = h.s.readReady(id, null, &rb);
+    _ = try h.s.endRead(id, .cancel);
+    for (rb[0..got.n]) |b| h.s.readRelease(b.slot);
+    try ensure(waitUntil(struct {
+        fn f(hh: *H) bool {
+            const ct = hh.s.counts();
+            return ct.staging_bytes == 0 and hh.s.reads.items.len == 0;
+        }
+    }.f, h, 3000), @src());
+    try ensure(!h.s.reading.contains(key), @src());
+}
+
+/// Two restores share the read slots: each gets blocks in turn.
+fn checkFairReads(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "fair", .read_slots = 2 });
+    defer h.deinit();
+    var ids: [2]store.ReadId = undefined;
+    for (0..2) |i| {
+        const x = try idsOf(gpa, 6 * block_tokens, 2000 + i);
+        defer gpa.free(x);
+        const key = try write(h, x, .{ .lineage = lin(@intCast(100 + i)), .source = 100 + i });
+        ids[i] = try h.s.beginRead(key);
+    }
+    // the first restore took both slots (the second was not there yet); the slots it gives back go to the second
+    try ensure(h.s.readAwait(ids[0], 0, 5 * std.time.ns_per_s, .{}) and h.s.readAwait(ids[0], 1, 5 * std.time.ns_per_s, .{}), @src());
+    var rb: [2]store.ReadyBlock = undefined;
+    const got = h.s.readReady(ids[0], null, &rb);
+    try ensure(got.n == 2, @src());
+    h.s.readRelease(rb[0].slot);
+    try ensure(h.s.readAwait(ids[1], 0, 5 * std.time.ns_per_s, .{}), @src());
+    h.s.readRelease(rb[1].slot);
+    for (ids) |id| _ = try h.s.endRead(id, .cancel);
+    try ensure(waitUntil(struct {
+        fn f(hh: *H) bool {
+            return hh.s.counts().staging_bytes == 0;
+        }
+    }.f, h, 3000), @src());
+}
+
+/// Replicated and owner-sharded points never read as each other: a store of another layout drops them as foreign.
+fn checkLayout(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "layout" });
+    defer h.deinit();
+    const ids = try idsOf(gpa, 2 * block_tokens, 2300);
+    defer gpa.free(ids);
+    const key = try write(h, ids, .{ .lineage = lin(23), .source = 23 });
+    h.cfg.owner_layout = .owner_sharded;
+    try h.reopen();
+    try ensure(!h.s.presence(key) and h.s.counts().recovered_dropped == 1, @src());
+}
+
+/// 0118's owner-sharded store: a rank keeps a point of its own part with full blocks of every plane and a point of
+/// another part with only the replicated planes (foreign_block_bytes); every point names its part (a part-less keep is
+/// invalid), the sizes survive a restart, a lookup and partOf say the part, the same ids under two parts are two
+/// block names (the salt), and a rank that owns another part reads the first rank's manifests as damaged.
+fn checkOwnerParts(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "parts" });
+    defer h.deinit();
+    const foreign = block_bytes / 4;
+    h.cfg.owner_layout = .owner_sharded;
+    h.cfg.limits.foreign_block_bytes = foreign;
+    h.cfg.limits.own_part = 0;
+    try h.reopen();
+    const ids = try idsOf(gpa, 2 * block_tokens, 2500);
+    defer gpa.free(ids);
+    try ensure(keepIds(h, ids, .{ .lineage = lin(25), .source = 25 }) == .invalid, @src()); // (no part)
+    const own = try write(h, ids, .{ .lineage = lin(25).inPart(0), .source = 25 });
+    const other_ids = try idsOf(gpa, 3 * block_tokens, 2501);
+    defer gpa.free(other_ids);
+    const other = try write(h, other_ids, .{ .lineage = lin(26).inPart(1), .source = 26 });
+    for (h.s.points.get(own).?.blocks) |b| try ensure(b.bytes == block_bytes, @src());
+    for (h.s.points.get(other).?.blocks) |b| try ensure(b.bytes == foreign, @src());
+    // the same ids from another part: other names (never the first point's blocks by name)
+    const pa = h.s.points.get(own).?;
+    var spans: [4]format.Span = undefined;
+    var ch: std.ArrayList(Digest) = .empty;
+    defer ch.deinit(gpa);
+    try format.chain(gpa, ids, block_tokens, &ch);
+    format.blockNames(lin(25).inPart(1), ch.items, ids, block_tokens, spans[0..2]);
+    for (pa.blocks, spans[0..2]) |b, sp| try ensure(!std.mem.eql(u8, &b.name, &sp.name), @src());
+    format.blockNames(lin(25).inPart(1).inPart(0), ch.items, ids, block_tokens, spans[0..2]); // (re-salted: replaced)
+    for (pa.blocks, spans[0..2]) |b, sp| try ensure(std.mem.eql(u8, &b.name, &sp.name), @src());
+    // the restored rows are the stored sizes: a foreign block is its source's first bytes of the block's rows
+    const got = (try restore(h, other)) orelse return CheckFailed;
+    defer gpa.free(got);
+    for (0..3) |k| try ensure(std.mem.eql(u8, got[k * block_tokens * bpt ..][0..foreign], h.src(26)[k * block_tokens * bpt ..][0..foreign]), @src());
+    try h.reopen();
+    try ensure(h.s.presence(own) and h.s.presence(other), @src());
+    try ensure(h.s.partOf(own).?.part == 0 and h.s.partOf(other).?.part == 1 and h.s.partOf(@splat(9)) == null, @src());
+    const hit = h.s.lookup(.{ .keyed = other_ids, .max_at = max_tokens }) orelse return CheckFailed;
+    try ensure(hit.part == 1 and std.mem.eql(u8, &hit.key, &other), @src());
+    // a rank owning part 1 with these files: the sizes are not its own, both points damaged
+    h.cfg.limits.own_part = 1;
+    try h.reopen();
+    try ensure(!h.s.presence(own) and !h.s.presence(other) and h.s.counts().recovered_dropped == 2, @src());
+    // a foreign size past the block's, or one on a replicated store, is no configuration
+    h.closeStore();
+    h.cfg.limits.foreign_block_bytes = block_bytes + 1;
+    try ensure(if (Store.open(gpa, io, h.cfg)) |_| false else |e| e == error.BadConfig, @src());
+    h.cfg.limits.foreign_block_bytes = foreign;
+    h.cfg.owner_layout = .replicated;
+    try ensure(if (Store.open(gpa, io, h.cfg)) |_| false else |e| e == error.BadConfig, @src());
+}
+
+/// GLM 0110's pin (review of the native port): a resumed conversation that is the least recently used one, kept
+/// under cap pressure, makes room without evicting the blocks it reuses. Its old turn goes (room), its blocks stay
+/// (the new turn names them), the new turn stages only its new block, publishes and restores.
+fn checkKeepReuse(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "reuse", .cap = 24 * 1024 });
+    defer h.deinit();
+    const a = try idsOf(gpa, 3 * block_tokens, 2400);
+    defer gpa.free(a);
+    const ka1 = try write(h, a[0 .. 2 * block_tokens], .{ .lineage = lin(24), .source = 24 });
+    for (0..2) |i| {
+        const x = try idsOf(gpa, block_tokens, 2401 + i);
+        defer gpa.free(x);
+        _ = try write(h, x, .{ .lineage = lin(@intCast(25 + i)), .source = 25 + i });
+    }
+    const before = h.s.counts();
+    const ka2 = try write(h, a, .{ .lineage = lin(24), .source = 24 });
+    const after = h.s.counts();
+    try ensure(!h.s.points.contains(ka1) and after.pruned_conversations > before.pruned_conversations, @src()); // (the pressure)
+    try ensure(after.staged_blocks - before.staged_blocks == 1 and after.stored_bytes <= h.cfg.cap_bytes, @src());
+    const got = (try restore(h, ka2)) orelse return CheckFailed;
+    defer gpa.free(got);
+    try ensure(std.mem.eql(u8, got, h.src(24)[0 .. 3 * block_tokens * bpt]), @src());
+}
+
+/// A cancelled write's unstaged blocks go to another waiting write that names them, and so does their
+/// reservation: the backlog, cap and floor keep counting those bytes until they are written.
+fn checkHandOver(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "handover" });
+    defer h.deinit();
+    const ids = try idsOf(gpa, 3 * block_tokens, 2600);
+    defer gpa.free(ids);
+    const r1 = keepIds(h, ids[0 .. 2 * block_tokens], .{ .lineage = lin(28), .source = 28 });
+    try ensure(r1 == .queued, @src());
+    try ensure(keepIds(h, ids, .{ .lineage = lin(28), .source = 28 }) == .queued, @src());
+    try ensure(h.s.cancel(r1.queued.job), @src());
+    try ensure(h.s.counts().queued_bytes >= 3 * block_bytes, @src()); // the second write's 3 blocks, all reserved
+    try ensure(settle(h).done, @src());
+    const got = (try restore(h, format.pointKey(ids, block_tokens, &.{}))) orelse return CheckFailed;
+    defer gpa.free(got);
+    try ensure(std.mem.eql(u8, got, h.src(28)[0 .. 3 * block_tokens * bpt]), @src());
+    try ensure(h.s.counts().queued_bytes == 0, @src());
+}
+
+/// A quota that is not a fraction in [0, 1], or a namespace prefix that is empty, too long or a path, is refused at
+/// open.
+fn checkBadConfig(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "badcfg" });
+    defer h.deinit();
+    h.closeStore();
+    for ([_]f64{ std.math.nan(f64), -0.1, 1.5, std.math.inf(f64) }) |q| {
+        var cfg = h.cfg;
+        cfg.quota = q;
+        if (Store.open(gpa, io, cfg)) |s2| {
+            s2.close();
+            try ensure(false, @src());
+        } else |e| try ensure(e == error.BadConfig, @src());
+    }
+    for ([_][]const u8{ "", "0123456789abcdef0123456789abcdef-", "../glm-spill-", "glm\x00spill-" }) |p| {
+        var cfg = h.cfg;
+        cfg.prefix = p;
+        if (Store.open(gpa, io, cfg)) |s2| {
+            s2.close();
+            try ensure(false, @src());
+        } else |e| try ensure(e == error.BadConfig, @src());
+    }
+}
+
+fn chmodAt(dirfd: c.fd_t, name: []const u8, mode: c.mode_t) !void {
+    var zb: [128]u8 = undefined;
+    const z = try std.fmt.bufPrintSentinel(&zb, "{s}", .{name}, 0);
+    if (c.fchmodat(dirfd, z, mode, 0) != 0) return error.Unexpected;
+}
+
+/// Recovery deletes only damage: a point it cannot read for another reason (here: its ids, or one of its blocks,
+/// unreadable) keeps every file, and so does every block; the next open recovers it whole.
+fn checkRecoverTransient(gpa: Allocator) !void {
+    if (c.geteuid() == 0) return; // (permissions do not stop root)
+    const h = try H.init(gpa, .{ .tag = "transient" });
+    defer h.deinit();
+    const ia = try idsOf(gpa, 2 * block_tokens + 3, 2500);
+    defer gpa.free(ia);
+    const ib = try idsOf(gpa, 2 * block_tokens, 2501);
+    defer gpa.free(ib);
+    const ic = try idsOf(gpa, block_tokens, 2502);
+    defer gpa.free(ic);
+    const ka = try write(h, ia, .{ .lineage = lin(25), .source = 250 });
+    const kb = try write(h, ib, .{ .lineage = lin(26), .source = 251 });
+    const kc = try write(h, ic, .{ .lineage = lin(27), .source = 252 });
+    const files = countFiles(gpa, h.s.blocks_fd, false) + countFiles(gpa, h.s.points_fd, false);
+    var nb: [96]u8 = undefined;
+    const b0 = (h.s.points.get(kb) orelse return CheckFailed).blocks[0].name;
+    try chmodAt(h.s.points_fd, pointFile(&nb, ka, ".ids"), 0);
+    try chmodAt(h.s.blocks_fd, blockFile(&nb, b0), 0);
+    try h.reopen();
+    const ct = h.s.counts();
+    const deferred = !h.s.points.contains(ka) and !h.s.points.contains(kb) and h.s.points.contains(kc);
+    const kept = countFiles(gpa, h.s.blocks_fd, false) + countFiles(gpa, h.s.points_fd, false);
+    chmodAt(h.s.points_fd, pointFile(&nb, ka, ".ids"), 0o600) catch {}; // (gone if recovery deleted them)
+    chmodAt(h.s.blocks_fd, blockFile(&nb, b0), 0o600) catch {};
+    try ensure(deferred and ct.recover_deferred == 2 and ct.recovered_dropped == 0, @src());
+    try ensure(kept == files, @src());
+    try h.reopen();
+    try ensure(h.s.points.contains(ka) and h.s.points.contains(kb) and h.s.points.contains(kc), @src());
+    const got = (try restore(h, kb)) orelse return CheckFailed;
+    defer gpa.free(got);
+    try ensure(std.mem.eql(u8, got, h.src(251)[0 .. 2 * block_tokens * bpt]), @src());
+}
