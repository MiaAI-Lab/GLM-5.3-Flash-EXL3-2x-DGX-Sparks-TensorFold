+test "a key kept again by a newer reply is that reply's copy, so evicting the older one frees no key the map holds" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var k = KeptReasoning.init(std.testing.allocator, std.testing.io, 1, 1);
+    defer k.deinit();
+    const history = (try json.parse(a, "[{\"role\":\"user\",\"content\":\"go\"}]")).ok;
+    const calls = (try json.parse(a, "[{\"id\":\"call_0123456789abcdef01234567\",\"function\":{\"name\":\"f\",\"arguments\":{}}}]")).ok;
+    // the same step twice (a retried request): the second reply keeps the same keys, then the first is evicted
+    try k.remember(history, calls.array, "first");
+    try k.remember(history, calls.array, "second");
+    try std.testing.expectEqual(@as(usize, 1), k.items.count());
+    const live = k.items.values()[0].keys;
+    var it = k.by_key.keyIterator();
+    while (it.next()) |stored| {
+        var owned = false;
+        for (live) |key| owned = owned or key.ptr == stored.*.ptr;
+        try std.testing.expect(owned); // a key from the evicted reply would be freed memory the next lookup reads
+    }
+    try std.testing.expectEqualStrings("second", (try k.find(a, live)).?);
+}
