+//! Spill v2's GLM tier on the host, for its tests (cuda_spill_tier_test.zig, and native/cuda.zig's through the prompt
+//! cache): an engine whose kept states are real GLM kept-state buffers (cuda_snapshot.sections at TP=2) in host memory,
+//! their bytes a function of their tokens, so a pass resumed from a restored state draws what a fresh pass draws
+//! exactly when every byte of the state came back (`first`); and a pair of ranks in one thread, each with its lane
+//! backend, its own store under TF_SPILL_TEST_DIR and the tier, rank 1 following rank 0's notes and asks. Test code only:
+//! glm_cuda exports it in test builds alone (cuda.zig's `spill_tier_rig`).
+const std = @import("std");
+const core = @import("core");
+const lanes = @import("lanes");
+const lane_backend = @import("cuda_lanes.zig");
+const st = @import("cuda_spill_state.zig");
+const snapshot = @import("cuda_snapshot.zig");
+const state = @import("cuda_state.zig");
+const tier = @import("cuda_spill_tier.zig");
+const wire = @import("cuda_spill_wire.zig");
+
+const spill = core.spill;
+const format = spill.format;
+const G = state.Geometry;
+const testing = std.testing;
+
+extern "c" fn memcmp(a: [*]const u8, b: [*]const u8, n: usize) c_int;
+
+/// An engine whose sequence is its tokens and whose kept state is a GLM kept-state buffer filled from them (`fill`).
+/// Its device is host memory: copies are synchronous, an event stays pending `delay` polls after its record.
+pub const HostEngine = struct {
+    pub const snap_holds_rows = true;
+    pub const Seq = struct { tokens: std.ArrayList(u32) = .empty };
+    pub const Buf = struct { ptr: u64, bytes: []u8 };
+    pub const Snap = struct { id: u64 = 0, pos: usize = 0, mtp_len: usize = 0, buf: ?Buf = null, sec: snapshot.Sections = undefined, refs: std.atomic.Value(u32) = .init(1) };
+    pub const PrefillOptions = struct { keep_at: ?usize = null, resume_from: ?*const Snap = null, live_from: ?usize = null, mask: []const u32 = &.{}, media: ?*const lanes.Media = null };
+    pub const Prefilled = struct { first: u32, kept: ?*Snap = null };
+    pub const Window = struct { seq: *Seq, tokens: []const u32 };
+    pub const DraftReq = struct { seq: *Seq };
+
+    gpa: std.mem.Allocator,
+    layout: st.Layout,
+    bound: ?*Seq = null,
+    next_id: u64 = 0,
+    /// kept-state buffers alive
+    snaps: usize = 0,
+    /// passes that resumed a kept state, and those whose state was a fresh pass's byte for byte
+    resumed: usize = 0,
+    exact: usize = 0,
+    /// each event's polls left before it completes (0: complete), and what a record leaves
+    events: []u8 = &.{},
+    delay: u8 = 0,
+    waits: usize = 0,
+    /// tierDest refuses (a rank at its keep floor)
+    refuse_dest: bool = false,
+    scratch: []u8 = &.{},
+
+    pub fn init(gpa: std.mem.Allocator, layout: st.Layout) HostEngine {
+        return .{ .gpa = gpa, .layout = layout };
+    }
+
+    pub fn deinit(e: *HostEngine) void {
+        e.gpa.free(e.events);
+        e.gpa.free(e.scratch);
+    }
+
+    pub fn first(tokens: []const u32) u32 {
+        return @truncate(std.hash.Wyhash.hash(3, std.mem.sliceAsBytes(tokens)));
+    }
+
+    fn mix(h: u64, t: u32) u64 {
+        var x = (h ^ t) *% 0x9e3779b97f4a7c15;
+        x ^= x >> 29;
+        return x *% 0xbf58476d1ce4e5b9;
+    }
+
+    fn row(dst: []u8, v: u64) void {
+        @memset(dst, @truncate(v >> 11));
+        std.mem.writeInt(u64, dst[0..8], v, .little);
+        std.mem.writeInt(u64, dst[dst.len - 8 ..][0..8], ~v, .little);
+    }
+
+    /// The state ranges a kept state holds (every layer's latent rows and complete pools, each section): `f` on each.
+    fn ranges(l: *const st.Layout, sec: snapshot.Sections, ctx: anytype, comptime f: fn (@TypeOf(ctx), usize, usize) void) void {
+        for (0..G.dsa_layers) |i| {
+            f(ctx, sec.latent + i * sec.latentBytes(), sec.at * G.latent_row);
+            f(ctx, sec.pooled + i * sec.pooledBytes(), sec.at / 4 * G.pool_row);
+        }
+        const at = [_]usize{ sec.rings, sec.rec, sec.conv, sec.draft };
+        for (l.specs(), l.order[0..l.n]) |s, o| f(ctx, at[@backingInt(o)], s.len);
+    }
+
+    /// The state a fresh pass of `tokens` keeps at their end: each latent row from the tokens through it, each complete
+    /// pool from its four, the sections from all of them; pooled row at/4 and the padding stale bytes (0xee).
+    pub fn fill(l: *const st.Layout, out: []u8, sec: snapshot.Sections, tokens: []const u32) void {
+        @memset(out[0..sec.total], 0xee);
+        var h: u64 = 0x51ed;
+        for (tokens[0..sec.at], 0..) |t, r| {
+            h = mix(h, t);
+            for (0..G.dsa_layers) |i| {
+                row(out[sec.latent + i * sec.latentBytes() + r * G.latent_row ..][0..G.latent_row], h +% i);
+                if (r % 4 == 3) row(out[sec.pooled + i * sec.pooledBytes() + r / 4 * G.pool_row ..][0..G.pool_row], h ^ (@as(u64, i) << 40));
+            }
+        }
+        const at = [_]usize{ sec.rings, sec.rec, sec.conv, sec.draft };
+        for (l.specs(), l.order[0..l.n]) |s, o| row(out[at[@backingInt(o)]..][0..s.len], h ^ @backingInt(o));
+    }
+
+    /// Whether `a` and `b` hold the same state (the ranges a kept state holds; pooled row at/4 and padding aside).
+    pub fn same(l: *const st.Layout, sec: snapshot.Sections, a: []const u8, b: []const u8) bool {
+        const C = struct {
+            a: []const u8,
+            b: []const u8,
+            ok: bool = true,
+            fn f(c: *@This(), off: usize, len: usize) void {
+                if (len > 0 and memcmp(c.a[off..].ptr, c.b[off..].ptr, len) != 0) c.ok = false;
+            }
+        };
+        var c: C = .{ .a = a, .b = b };
+        ranges(l, sec, &c, C.f);
+        return c.ok;
+    }
+
+    pub fn bytesOf(snap: *const Snap) []u8 {
+        return snap.buf.?.bytes;
+    }
+
+    fn newSnap(e: *HostEngine, at: usize) !*Snap {
+        const sec = e.layout.sections(at);
+        const bytes = try e.gpa.alloc(u8, sec.total);
+        errdefer e.gpa.free(bytes);
+        const s = try e.gpa.create(Snap);
+        e.next_id += 1;
+        s.* = .{ .id = e.next_id, .pos = at, .buf = .{ .ptr = @intFromPtr(bytes.ptr), .bytes = bytes }, .sec = sec };
+        e.snaps += 1;
+        return s;
+    }
+
+    /// Whether `snap` holds the state a fresh pass of `tokens` keeps.
+    pub fn exactFor(e: *HostEngine, snap: *const Snap, tokens: []const u32) bool {
+        if (e.scratch.len < snap.sec.total) {
+            e.gpa.free(e.scratch);
+            e.scratch = e.gpa.alloc(u8, snap.sec.total) catch return false;
+        }
+        fill(&e.layout, e.scratch, snap.sec, tokens);
+        return same(&e.layout, snap.sec, e.scratch, bytesOf(snap));
+    }
+
+    pub fn seqBytes(_: *const HostEngine, rows: usize) usize {
+        return rows * 10;
+    }
+    pub fn snapBytes(e: *const HostEngine, at: usize) usize {
+        return e.layout.sections(at).total;
+    }
+    pub fn newSeq(e: *HostEngine, _: usize) !*Seq {
+        const s = try e.gpa.create(Seq);
+        s.* = .{};
+        return s;
+    }
+    pub fn freeSeq(e: *HostEngine, s: *Seq) void {
+        s.tokens.deinit(e.gpa);
+        e.gpa.destroy(s);
+    }
+    pub fn bind(e: *HostEngine, s: *Seq) void {
+        e.bound = s;
+    }
+    pub fn copyPrefix(_: *HostEngine, _: *Seq, _: *Seq, _: usize, _: usize) !void {
+        return error.NotUsed;
+    }
+    pub fn commitWindow(_: *HostEngine, _: usize, _: usize) !void {
+        return error.NotUsed;
+    }
+    pub fn current(_: *const HostEngine) void {}
+
+    /// A resumed pass draws what a fresh one draws only from a state byte-identical to a fresh pass's.
+    pub fn prefillWith(e: *HostEngine, prompt: []const u32, _: ?lanes.Sampling, o: PrefillOptions) !Prefilled {
+        const q = e.bound.?;
+        var ok = true;
+        if (o.live_from) |p| {
+            if (o.resume_from != null or q.tokens.items.len != p) return error.ResumeMustExtend;
+        } else if (o.resume_from) |snap| {
+            if (snap.pos >= prompt.len) return error.ResumeOtherPrompt;
+            e.resumed += 1;
+            ok = e.exactFor(snap, prompt[0..snap.pos]);
+            if (ok) e.exact += 1;
+            q.tokens.clearRetainingCapacity();
+            try q.tokens.appendSlice(e.gpa, prompt[0..snap.pos]);
+        } else q.tokens.clearRetainingCapacity();
+        try q.tokens.appendSlice(e.gpa, prompt[q.tokens.items.len..]);
+        var kept: ?*Snap = null;
+        if (o.keep_at) |k| {
+            kept = try e.newSnap(k);
+            fill(&e.layout, bytesOf(kept.?), kept.?.sec, prompt[0..k]);
+        }
+        return .{ .first = if (ok) first(q.tokens.items) else first(q.tokens.items) ^ 1, .kept = kept };
+    }
+
+    pub fn freeSnapshot(e: *HostEngine, snap: *Snap) void {
+        if (snap.refs.fetchSub(1, .acq_rel) != 1) return;
+        e.gpa.free(snap.buf.?.bytes);
+        e.gpa.destroy(snap);
+        e.snaps -= 1;
+    }
+
+    // -- the tier's device (cuda_spill_tier) --------------------------------------------------------------------
+
+    pub fn tierKept(_: *const HostEngine, snap: *const Snap) st.Kept {
+        return .{ .buf = snap.buf.?.ptr, .sec = snap.sec };
+    }
+    fn d2h(_: *anyopaque, dst: []u8, src: u64) anyerror!void {
+        const s: [*]const u8 = @ptrFromInt(src);
+        @memcpy(dst, s[0..dst.len]);
+    }
+    fn h2d(_: *anyopaque, dst: u64, src: []const u8) anyerror!void {
+        const d: [*]u8 = @ptrFromInt(dst);
+        @memcpy(d[0..src.len], src);
+    }
+    fn fillBytes(_: *anyopaque, dst: u64, byte: u8, n: usize) anyerror!void {
+        const d: [*]u8 = @ptrFromInt(dst);
+        @memset(d[0..n], byte);
+    }
+    pub fn tierCopier(e: *HostEngine) st.Copier {
+        return .{ .ptr = e, .d2h = d2h, .h2d = h2d, .fill = fillBytes };
+    }
+    pub fn tierEvents(e: *HostEngine, n: usize) !void {
+        if (e.events.len >= n) return;
+        const ev = try e.gpa.alloc(u8, n);
+        @memset(ev, 0);
+        e.gpa.free(e.events);
+        e.events = ev;
+    }
+    pub fn tierRecord(e: *HostEngine, ev: usize) void {
+        e.events[ev] = e.delay;
+    }
+    pub fn tierDone(e: *HostEngine, ev: usize) bool {
+        if (e.events[ev] == 0) return true;
+        e.events[ev] -= 1;
+        return false;
+    }
+    pub fn tierWait(e: *HostEngine, ev: usize) void {
+        if (e.events[ev] > 0) e.waits += 1;
+        e.events[ev] = 0;
+    }
+    pub fn tierDest(e: *HostEngine, at: usize) !*Snap {
+        if (e.refuse_dest) return error.BelowMemoryReserve;
+        const s = try e.newSnap(at);
+        @memset(bytesOf(s), 0x33);
+        return s;
+    }
+};
+
+pub const Lanes = lane_backend.Lanes(HostEngine);
+pub const Leader = tier.Leader(HostEngine);
+pub const Follower = tier.Follower(HostEngine);
+
+/// Rank 0's notes and asks in order (an ask behind `ask_mark`), for rank 1 to apply.
+pub const Sink = struct {
+    gpa: std.mem.Allocator,
+    notes: std.ArrayList([]u8) = .empty,
+    flushes: usize = 0,
+    const ask_mark = 0xff;
+
+    fn send(ptr: *anyopaque, bytes: []const u8) void {
+        const s: *Sink = @ptrCast(@alignCast(ptr));
+        s.notes.append(s.gpa, s.gpa.dupe(u8, bytes) catch return) catch {};
+    }
+    fn ask(ptr: *anyopaque, bytes: []const u8) anyerror!void {
+        const s: *Sink = @ptrCast(@alignCast(ptr));
+        const b = try s.gpa.alloc(u8, 1 + bytes.len);
+        errdefer s.gpa.free(b);
+        b[0] = ask_mark;
+        @memcpy(b[1..], bytes);
+        try s.notes.append(s.gpa, b);
+    }
+    fn flush(ptr: *anyopaque) void {
+        const s: *Sink = @ptrCast(@alignCast(ptr));
+        s.flushes += 1;
+    }
+    pub fn notesOf(s: *Sink) lane_backend.Notes {
+        return .{ .ptr = s, .send = send, .ask = ask, .flush = flush };
+    }
+    /// Every note and ask so far applied on rank 1, in order (an ask's gather inside it).
+    pub fn take(s: *Sink, r1: *Lanes) !void {
+        while (s.notes.items.len > 0) {
+            const n = s.notes.orderedRemove(0);
+            defer s.gpa.free(n);
+            if (n.len > 0 and n[0] == ask_mark) try r1.applyAsk(n[1..]) else try r1.applyNote(n);
+        }
+    }
+    pub fn deinit(s: *Sink) void {
+        for (s.notes.items) |n| s.gpa.free(n);
+        s.notes.deinit(s.gpa);
+    }
+};
+
+/// Two ranks' gather in one thread: rank 0's hands what waits in the sink to rank 1 first, whose gather (inside its
+/// ask's handler) finds rank 0's words there.
+pub const Gather = struct {
+    sink: *Sink,
+    r1: *Lanes,
+    mine0: [wire.stats_words]u64 = undefined,
+    mine1: [wire.stats_words]u64 = undefined,
+    n: usize = 0,
+    fatals: usize = 0,
+    asks: usize = 0, // rank 0's gathers (its asks)
+
+    pub fn gate(g: *Gather, rank: u32) lane_backend.Gate {
+        return .{ .ptr = g, .agree = agree, .fatal = fatal, .gather = if (rank == 0) gather0 else gather1 };
+    }
+    fn of(p: *anyopaque) *Gather {
+        return @ptrCast(@alignCast(p));
+    }
+    fn agree(_: *anyopaque, ok: bool) anyerror!bool {
+        return ok;
+    }
+    fn fatal(p: *anyopaque, _: []const u8, _: anyerror) void {
+        of(p).fatals += 1;
+    }
+    fn gather0(p: *anyopaque, mine: []const u64, out: []u64) anyerror!usize {
+        const g = of(p);
+        g.asks += 1;
+        g.n = mine.len;
+        @memcpy(g.mine0[0..mine.len], mine);
+        try g.sink.take(g.r1);
+        return g.both(out);
+    }
+    fn gather1(p: *anyopaque, mine: []const u64, out: []u64) anyerror!usize {
+        const g = of(p);
+        if (mine.len != g.n) return error.TestWidthsDiffer;
+        @memcpy(g.mine1[0..mine.len], mine);
+        return g.both(out);
+    }
+    fn both(g: *Gather, out: []u64) usize {
+        @memcpy(out[0..g.n], g.mine0[0..g.n]);
+        @memcpy(out[g.n..][0..g.n], g.mine1[0..g.n]);
+        return 2;
+    }
+};
+
+/// The layout the tests use: TP=2's, a 64-row index ring, no drafter (the sections still ~74 MiB: the recurrences).
+pub fn testLayout() !st.Layout {
+    return st.Layout.init(try G.init(2, 0), 64, null);
+}
+
+/// Two ranks with the tier on each (`lead`, `fol`), their stores in fresh folders.
+pub const Pair = struct {
+    gpa: std.mem.Allocator,
+    layout: st.Layout,
+    e: [2]HostEngine,
+    r: [2]Lanes,
+    sink: Sink,
+    pg: Gather,
+    settings: tier.Settings,
+    paths: [2][256]u8 = undefined,
+    roots: [2][:0]const u8 = undefined,
+    staging: [2][]align(spill.slots.alignment) u8 = undefined,
+    compat: format.Digest,
+    lead: ?*Leader = null,
+    fol: ?*Follower = null,
+    hooks: lane_backend.CacheHooks = undefined,
+
+    /// Settings for the tests: a small store over the scratch folders, a staging of `write` block slots, one read-ahead
+    /// slot, one small state and one restore (and `restores` of each when asked).
+    pub fn settingsFor(restores: u32) tier.Settings {
+        return .{ .dir = "", .gib = 4, .min_free_gib = 0, .min_tokens = 64, .stage_mib = 26, .read_blocks = 2, .smalls = 1, .restores = restores, .readers = 2, .direct = false, .hold_bytes = 1 << 30 };
+    }
+
+    pub fn init(p: *Pair, gpa: std.mem.Allocator, tag: []const u8, s: tier.Settings) !void {
+        const layout = try testLayout();
+        p.* = .{ .gpa = gpa, .layout = layout, .e = .{ HostEngine.init(gpa, layout), HostEngine.init(gpa, layout) }, .r = undefined, .sink = .{ .gpa = gpa }, .pg = undefined, .settings = s, .compat = format.compatDigest(layout.digest(), .replicated, @intCast(st.block_tokens), layout.block_bytes) };
+        p.r = .{ Lanes.init(gpa, &p.e[0], true, 1 << 20, 8), Lanes.init(gpa, &p.e[1], true, 1 << 20, 8) };
+        p.r[1].follower = true;
+        p.r[0].notes = p.sink.notesOf();
+        p.pg = .{ .sink = &p.sink, .r1 = &p.r[1] };
+        p.r[0].gate = p.pg.gate(0);
+        p.r[1].gate = p.pg.gate(1);
+        p.hooks = p.r[0].cacheHooks(1 << 40, .{}, 0, 5);
+        const plan = try tier.plan(s, &layout);
+        for (0..2) |i| {
+            var tb: [64]u8 = undefined;
+            p.roots[i] = try spill.fsio.testRoot(&p.paths[i], try std.fmt.bufPrint(&tb, "glm-tier-{s}-r{d}", .{ tag, i }));
+            _ = std.c.close(try spill.fsio.freshDir(gpa, p.roots[i]));
+            p.staging[i] = try gpa.alignedAlloc(u8, .fromByteUnits(spill.slots.alignment), plan.bytes());
+        }
+        try p.open();
+    }
+
+    /// Each rank's store opened (recovering what its folder holds), the tier on both.
+    pub fn open(p: *Pair) !void {
+        var sides: [2]*Leader.S = undefined;
+        for (0..2) |i| {
+            var s = p.settings;
+            s.dir = p.roots[i];
+            sides[i] = try Leader.S.open(p.gpa, testing.io, &p.e[i], p.layout, s, @intCast(i), p.compat, 1 << 20, p.staging[i], .{});
+        }
+        p.lead = try Leader.create(p.gpa, sides[0], &p.r[0], p.settings, @splat(7));
+        p.fol = try Follower.create(p.gpa, sides[1], &p.r[1]);
+        p.r[1].spill_side = p.fol.?.spillSide();
+    }
+
+    /// The tiers closed (a process's end: nothing flushed).
+    pub fn close(p: *Pair) void {
+        p.r[1].spill_side = null;
+        if (p.lead) |l| l.destroy();
+        if (p.fol) |f| f.destroy();
+        p.lead = null;
+        p.fol = null;
+        for (p.sink.notes.items) |n| p.gpa.free(n);
+        p.sink.notes.clearRetainingCapacity();
+    }
+
+    /// A restart: every kept state gone from memory on both ranks (each released to its tier first, as the store
+    /// does), the tiers closed and opened again over the same folders.
+    pub fn restart(p: *Pair) !void {
+        try p.dropAll();
+        p.close();
+        try p.open();
+    }
+
+    pub fn deinit(p: *Pair) void {
+        p.close();
+        p.r[0].deinit();
+        p.r[1].deinit();
+        p.sink.deinit();
+        for (0..2) |i| {
+            spill.fsio.dropDir(p.gpa, p.roots[i]);
+            p.gpa.free(p.staging[i]);
+            p.e[i].deinit();
+        }
+    }
+
+    pub fn lead0(p: *Pair) *Leader {
+        return p.lead.?;
+    }
+
+    /// A pass of `prompt` on both ranks keeping its state at `mark` (the store's mark hook on rank 0 adopts it and
+    /// writes it at keep: Tier.keep); rank 1 hears the pass's notes. Rank 0's kept state and its point's id.
+    pub fn keepPass(p: *Pair, prompt: []const u32, mark: u32, group: u64) !struct { saved: *anyopaque, point: ?u64 } {
+        var w: Writer = .{ .p = p, .group = group };
+        _ = try p.passBoth(prompt, &.{mark}, .{ .ptr = &w, .at = Writer.at }, null);
+        return .{ .saved = w.saved orelse return error.TestNothingKept, .point = w.point };
+    }
+
+    /// A pass of `prompt` on both ranks cut at `marks`, rank 0's mark hook `hook` (the prompt cache's), resumed from
+    /// rank 0's `from` (and rank 1's copy under its key) when given; rank 1 hears the pass's notes after. Rank 0's first
+    /// token.
+    pub fn passBoth(p: *Pair, prompt: []const u32, marks: []const u32, hook: ?lanes.stream.MarkHook, from: ?*anyopaque) !u32 {
+        const at: u32 = if (from) |f| @as(*Lanes.Kept, @ptrCast(@alignCast(f))).at else 0;
+        const from1: ?*anyopaque = if (from) |f| p.r[1].savedFor(@as(*Lanes.Kept, @ptrCast(@alignCast(f))).key) else null;
+        var s0 = try lanes.Stream.init(p.gpa, .{ .id = "k", .prompt = prompt, .max_new = 4, .reuse = .{ .saved = from, .at = at, .marks = marks, .hook = hook } });
+        defer s0.deinit(p.gpa);
+        var s1 = try lanes.Stream.init(p.gpa, .{ .id = "k", .prompt = prompt, .max_new = 4, .reuse = .{ .saved = from1, .at = at, .marks = marks } });
+        defer s1.deinit(p.gpa);
+        try Lanes.prefillFn(&p.r[0], &s0);
+        try Lanes.prefillFn(&p.r[1], &s1);
+        const first = try firstOf(&p.r[0], &s0);
+        if (try firstOf(&p.r[1], &s1) != first) return error.TestRanksDrewApart;
+        Lanes.releaseFn(&p.r[0], &s0);
+        Lanes.releaseFn(&p.r[1], &s1);
+        try p.sink.take(&p.r[1]);
+        return first;
+    }
+
+    const Writer = struct {
+        p: *Pair,
+        group: u64,
+        saved: ?*anyopaque = null,
+        point: ?u64 = null,
+        fn at(ptr: *anyopaque, s: *lanes.Stream, mark: u32) void {
+            const w: *Writer = @ptrCast(@alignCast(ptr));
+            const saved = w.p.hooks.save(w.p.hooks.ptr, null, mark) catch return;
+            w.saved = saved;
+            w.point = w.p.lead0().keep(.{ .saved = saved, .key = s.prompt()[0..mark], .at = mark, .group = w.group });
+        }
+    };
+
+    /// Pumps both ranks (rank 1 by rank 0's pump notes) until neither has a write to stage or publish.
+    pub fn settle(p: *Pair) !void {
+        var i: usize = 0;
+        while (i < 10_000) : (i += 1) {
+            p.lead0().pump(5 * std.time.ns_per_ms);
+            try p.sink.take(&p.r[1]);
+            const a = p.lead0().side.store.counts();
+            const b = p.fol.?.side.store.counts();
+            if (a.pending_jobs == 0 and b.pending_jobs == 0 and !p.lead0().side.busy() and !p.fol.?.side.busy()) return;
+            std.Io.sleep(testing.io, .fromMilliseconds(1), .awake) catch {};
+        }
+        return error.TestNotSettled;
+    }
+
+    /// Rank 0's kept state `saved` leaves memory as the store frees it: the tier's release, then the family's drop
+    /// (a `.drop` note, rank 1's release and free).
+    pub fn evict(p: *Pair, saved: *anyopaque) !void {
+        p.lead0().release(saved);
+        p.hooks.drop(p.hooks.ptr, saved);
+        try p.sink.take(&p.r[1]);
+    }
+
+    pub fn dropAll(p: *Pair) !void {
+        while (p.r[0].kept.items.len > 0) try p.evict(p.r[0].kept.items[0]);
+    }
+
+    /// A restore of the longest point `prompt` extends, polled to its end; rank 1 hears every note on the way.
+    pub fn restore(p: *Pair, prompt: []const u32) !tier.Poll {
+        const l = p.lead0();
+        const pt = l.lookup(prompt, 0, @intCast(prompt.len - 1), &.{}, 0) orelse return error.TestNoPoint;
+        const job = try l.begin(pt.id, pt.at, pt.shared);
+        try p.sink.take(&p.r[1]);
+        var i: usize = 0;
+        while (i < 10_000) : (i += 1) {
+            const r = l.poll(job, 5 * std.time.ns_per_ms);
+            try p.sink.take(&p.r[1]);
+            if (r != .pending) return r;
+            std.Io.sleep(testing.io, .fromMilliseconds(1), .awake) catch {};
+        }
+        return error.TestRestoreHung;
+    }
+
+    /// A pass of `prompt` resumed from rank 0's `saved` on rank 0 and from rank 1's own copy under the same key: both
+    /// first tokens.
+    pub fn resumeBoth(p: *Pair, prompt: []const u32, saved: *anyopaque, at: u32) ![2]u32 {
+        const k0: *Lanes.Kept = @ptrCast(@alignCast(saved));
+        var s0 = try lanes.Stream.init(p.gpa, .{ .id = "r", .prompt = prompt, .max_new = 4, .reuse = .{ .saved = saved, .at = at } });
+        defer s0.deinit(p.gpa);
+        var s1 = try lanes.Stream.init(p.gpa, .{ .id = "r", .prompt = prompt, .max_new = 4, .reuse = .{ .saved = p.r[1].savedFor(k0.key), .at = at } });
+        defer s1.deinit(p.gpa);
+        try Lanes.prefillFn(&p.r[0], &s0);
+        try Lanes.prefillFn(&p.r[1], &s1);
+        defer Lanes.releaseFn(&p.r[0], &s0);
+        defer Lanes.releaseFn(&p.r[1], &s1);
+        return .{ try firstOf(&p.r[0], &s0), try firstOf(&p.r[1], &s1) };
+    }
+
+    fn firstOf(r: *Lanes, s: *lanes.Stream) !u32 {
+        return Lanes.readFn(r, try Lanes.firstFn(r, s, s.prompt_len));
+    }
+
+    /// Rank `rank`'s store folder: `<root>/glm-spill-<16 hex>/rank<N>/<sub>` (gpa-owned).
+    pub fn storeDir(p: *Pair, rank: usize, sub: []const u8) ![]u8 {
+        var root = try std.Io.Dir.cwd().openDir(testing.io, p.roots[rank], .{ .iterate = true });
+        defer root.close(testing.io);
+        var it = root.iterate();
+        while (try it.next(testing.io)) |ns| {
+            if (ns.kind != .directory or !std.mem.startsWith(u8, ns.name, tier.prefix)) continue;
+            return std.fmt.allocPrint(p.gpa, "{s}/{s}/rank{d}/{s}", .{ p.roots[rank], ns.name, rank, sub });
+        }
+        return error.TestNoStore;
+    }
+
+    pub const Damage = enum { flip, truncate, remove };
+
+    /// Damage to every block file of rank `rank`'s store.
+    pub fn damage(p: *Pair, rank: usize, how: Damage) !void {
+        const path = try p.storeDir(rank, "blocks");
+        defer p.gpa.free(path);
+        var d = try std.Io.Dir.cwd().openDir(testing.io, path, .{ .iterate = true });
+        defer d.close(testing.io);
+        var it = d.iterate();
+        var names: std.ArrayList([]u8) = .empty;
+        defer {
+            for (names.items) |n| p.gpa.free(n);
+            names.deinit(p.gpa);
+        }
+        while (try it.next(testing.io)) |b| if (b.kind == .file) try names.append(p.gpa, try p.gpa.dupe(u8, b.name));
+        if (names.items.len == 0) return error.TestNoBlocks;
+        for (names.items) |n| switch (how) {
+            .remove => try d.deleteFile(testing.io, n),
+            .flip, .truncate => {
+                var f = try d.openFile(testing.io, n, .{ .mode = .read_write });
+                defer f.close(testing.io);
+                if (how == .truncate) {
+                    try f.setLength(testing.io, (try f.length(testing.io)) / 2);
+                } else {
+                    var one: [1]u8 = undefined;
+                    _ = try f.readPositionalAll(testing.io, &one, 4099);
+                    one[0] ^= 0xff;
+                    try f.writePositionalAll(testing.io, &one, 4099);
+                }
+            },
+        };
+    }
+
+    /// Every point manifest of rank `rank`'s store removed (a store that lost them: recovery drops the rest).
+    pub fn dropManifests(p: *Pair, rank: usize) !void {
+        const path = try p.storeDir(rank, "points");
+        defer p.gpa.free(path);
+        var d = try std.Io.Dir.cwd().openDir(testing.io, path, .{ .iterate = true });
+        defer d.close(testing.io);
+        var it = d.iterate();
+        var names: std.ArrayList([]u8) = .empty;
+        defer {
+            for (names.items) |n| p.gpa.free(n);
+            names.deinit(p.gpa);
+        }
+        while (try it.next(testing.io)) |b| if (std.mem.endsWith(u8, b.name, ".man")) try names.append(p.gpa, try p.gpa.dupe(u8, b.name));
+        if (names.items.len == 0) return error.TestNoPoints;
+        for (names.items) |n| try d.deleteFile(testing.io, n);
+    }
+};
+
+/// `buf` filled with ids from `seed`.
+pub fn idsOf(buf: []u32, seed: u32) []u32 {
+    var prng = std.Random.DefaultPrng.init(seed);
+    for (buf) |*t| t.* = prng.random().intRangeLessThan(u32, 0, 154880);
+    return buf;
+}
diff --git a/zig/src/families/glm_cuda/cuda_spill_tier_test.zig b/zig/src/families/glm_cuda/cuda_spill_tier_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..eaf83cf09441e946286c4059132303aee0a7730c
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_spill_tier_test.zig
@@ -0,0 +1,492 @@
+//! Spill v2's GLM tier on two ranks in one thread (cuda_spill_tier_rig.zig): host-memory kept states of the real GLM
+//! layout, each rank's own core/spill store under TF_SPILL_TEST_DIR, rank 1 following rank 0's notes and asks.
+const std = @import("std");
+const core = @import("core");
+const lanes = @import("lanes");
+const tier = @import("cuda_spill_tier.zig");
+const rig = @import("cuda_spill_tier_rig.zig");
+const st = @import("cuda_spill_state.zig");
+const wire = @import("cuda_spill_wire.zig");
+const lane_backend = @import("cuda_lanes.zig");
+
+const spill = core.spill;
+const format = spill.format;
+const testing = std.testing;
+const HostEngine = rig.HostEngine;
+
+const at = 2112; // one whole block and a 64-token tail
+
+fn pointKey(ids: []const u32) format.Digest {
+    return format.pointKey(ids, @intCast(st.block_tokens), &.{});
+}
+
+test "a kept state written at keep on both ranks, evicted, restored byte for byte on both, resumes as a fresh pass" {
+    const gpa = testing.allocator;
+    var p: rig.Pair = undefined;
+    try p.init(gpa, "restore", rig.Pair.settingsFor(1));
+    defer p.deinit();
+    var buf: [2200]u32 = undefined;
+    const ids = rig.idsOf(&buf, 1);
+    // the pass keeps at `at`; rank 0 writes at keep, rank 1 once its own pass adopted the state (the `.pass` note)
+    const k = try p.keepPass(ids, at, 1 << 32 | 1);
+    try testing.expect(k.point != null);
+    try testing.expectEqual(tier.pointId(pointKey(ids[0..at])), k.point.?);
+    try p.settle();
+    const key = pointKey(ids[0..at]);
+    try testing.expect(p.lead0().side.store.presence(key));
+    try testing.expect(p.fol.?.side.store.presence(key));
+    try testing.expectEqual(@as(u64, 0), p.fol.?.skipped);
+    // its memory copy goes on both ranks; only the disks hold it
+    const original = try gpa.dupe(u8, HostEngine.bytesOf(@as(*rig.Lanes.Kept, @ptrCast(@alignCast(k.saved))).snap));
+    defer gpa.free(original);
+    try p.evict(k.saved);
+    try testing.expectEqual(@as(usize, 0), p.r[0].kept.items.len);
+    try testing.expectEqual(@as(usize, 0), p.r[1].kept.items.len);
+    try testing.expectEqual(@as(usize, 0), p.e[0].snaps + p.e[1].snaps);
+    // restored: has, begin, progress, validate; both ranks hold it under rank 0's key, byte for byte the kept state
+    const r = try p.restore(ids);
+    try testing.expect(r == .ready);
+    const k0: *rig.Lanes.Kept = @ptrCast(@alignCast(r.ready.saved));
+    const k1: *rig.Lanes.Kept = @ptrCast(@alignCast(p.r[1].savedFor(k0.key) orelse return error.TestNotOnRank1));
+    try testing.expectEqual(@as(u32, at), k0.at);
+    try testing.expectEqual(@as(u32, at), k1.at);
+    try testing.expect(HostEngine.same(&p.layout, k0.snap.sec, original, HostEngine.bytesOf(k0.snap)));
+    try testing.expect(HostEngine.same(&p.layout, k1.snap.sec, original, HostEngine.bytesOf(k1.snap)));
+    // pooled row at/4 of every layer reads zeros (cuda_spill_state: never state)
+    for (0..11) |i| {
+        const sec = k0.snap.sec;
+        const row = HostEngine.bytesOf(k0.snap)[sec.pooled + i * sec.pooledBytes() + at / 4 * 144 ..][0..144];
+        try testing.expect(std.mem.allEqual(u8, row, 0));
+    }
+    // the restored lineage comes back for the store (its root at least)
+    try testing.expect(r.ready.lineage.len >= 1);
+    // a longer prompt resumes from it on both ranks and draws what a fresh pass draws
+    const exact = [2]usize{ p.e[0].exact, p.e[1].exact };
+    const firsts = try p.resumeBoth(ids, r.ready.saved, at);
+    try testing.expectEqual(HostEngine.first(ids), firsts[0]);
+    try testing.expectEqual(HostEngine.first(ids), firsts[1]);
+    for (0..2) |i| {
+        try testing.expectEqual(exact[i] + 1, p.e[i].exact);
+        try testing.expectEqual(p.e[i].resumed, p.e[i].exact); // (every resume on either rank from an exact state)
+    }
+    // every rank's counters reach rank 0 (a stats ask), each its own store's
+    p.lead0().stats_at = 0;
+    p.lead0().pump(1);
+    var counts: [4]tier.Counts = undefined;
+    try testing.expectEqual(@as(usize, 2), p.lead0().counts(&counts));
+    for (counts[0..2]) |c| {
+        try testing.expectEqual(@as(u64, 1), c.points);
+        try testing.expectEqual(@as(u64, 1), c.writes_committed);
+        try testing.expectEqual(@as(u64, 1), c.reads);
+        try testing.expectEqual(@as(u64, 2), c.blocks);
+    }
+    try testing.expectEqual(@as(usize, 0), p.pg.fatals);
+}
+
+test "a point is found again after a restart on both ranks; one a rank lost is restored on no rank, and both forget it" {
+    const gpa = testing.allocator;
+    var p: rig.Pair = undefined;
+    try p.init(gpa, "restart", rig.Pair.settingsFor(1));
+    defer p.deinit();
+    var b1: [2200]u32 = undefined;
+    var b2: [2300]u32 = undefined;
+    const a = rig.idsOf(&b1, 2);
+    const b = rig.idsOf(&b2, 3);
+    // (one small-state slot: each write publishes before the next keep)
+    _ = try p.keepPass(a, at, 1);
+    try p.settle();
+    _ = try p.keepPass(b, at + 64, 2);
+    try p.settle();
+    try testing.expectEqual(@as(u64, 2), p.lead0().side.store.counts().points);
+    try testing.expectEqual(@as(u64, 2), p.fol.?.side.store.counts().points);
+    // a restart: memory empty, both stores recover the published points (manifest last)
+    try p.restart();
+    try testing.expectEqual(@as(u64, 2), p.lead0().side.store.counts().recovered_points);
+    try testing.expectEqual(@as(u64, 2), p.fol.?.side.store.counts().recovered_points);
+    const r = try p.restore(a);
+    try testing.expect(r == .ready);
+    const firsts = try p.resumeBoth(a, r.ready.saved, at);
+    try testing.expectEqual(HostEngine.first(a), firsts[0]);
+    try testing.expectEqual(HostEngine.first(a), firsts[1]);
+    // rank 1 loses its manifests across the next restart: rank 0 still finds b, `has` refuses it, both forget it
+    try p.restart();
+    p.close();
+    try p.dropManifests(1);
+    try p.open();
+    try testing.expectEqual(@as(u64, 0), p.fol.?.side.store.counts().points);
+    const kb = pointKey(b[0 .. at + 64]);
+    try testing.expect(p.lead0().side.store.presence(kb));
+    try testing.expectError(error.SpillNotOnEveryRank, p.restore(b));
+    try testing.expect(!p.lead0().side.store.presence(kb));
+    try testing.expectEqual(@as(u64, 1), p.lead0().presence_refused);
+    try testing.expect(p.lead0().lookup(b, 0, @intCast(b.len - 1), &.{}, 0) == null);
+    // the request prefills: exact from 0
+    try testing.expectEqual(@as(usize, 0), p.r[0].kept.items.len);
+    try testing.expectEqual(@as(usize, 0), p.pg.fatals);
+}
+
+test "damage on either rank (a flipped byte, a truncated or a missing block) aborts the restore everywhere and both ranks forget the point" {
+    const gpa = testing.allocator;
+    const Case = struct { rank: usize, how: rig.Pair.Damage, why: anyerror };
+    for ([_]Case{
+        .{ .rank = 0, .how = .flip, .why = error.SpillDamaged },
+        .{ .rank = 1, .how = .flip, .why = error.SpillDamaged },
+        .{ .rank = 1, .how = .truncate, .why = error.SpillDamaged },
+        .{ .rank = 0, .how = .remove, .why = error.SpillMissing },
+        .{ .rank = 1, .how = .remove, .why = error.SpillMissing },
+    }, 0..) |c, n| {
+        var p: rig.Pair = undefined;
+        var tb: [32]u8 = undefined;
+        try p.init(gpa, try std.fmt.bufPrint(&tb, "damage{d}", .{n}), rig.Pair.settingsFor(1));
+        defer p.deinit();
+        var buf: [2200]u32 = undefined;
+        const ids = rig.idsOf(&buf, @intCast(10 + n));
+        const k = try p.keepPass(ids, at, 1);
+        try p.settle();
+        try p.evict(k.saved);
+        try p.damage(c.rank, c.how);
+        const r = try p.restore(ids);
+        try testing.expect(r == .failed);
+        try testing.expectEqual(c.why, r.failed);
+        // every rank forgot it; no rank holds a restored state; nothing is left reading or reserved
+        const key = pointKey(ids[0..at]);
+        try testing.expect(!p.lead0().side.store.presence(key));
+        try testing.expect(!p.fol.?.side.store.presence(key));
+        try testing.expectEqual(@as(usize, 0), p.r[0].kept.items.len);
+        try testing.expectEqual(@as(usize, 0), p.r[1].kept.items.len);
+        try testing.expectEqual(@as(usize, 0), p.e[0].snaps + p.e[1].snaps);
+        try testing.expectEqual(@as(usize, 0), p.lead0().side.rxs.count() + p.fol.?.side.rxs.count());
+        try testing.expect(p.lead0().lookup(ids, 0, @intCast(ids.len - 1), &.{}, 0) == null);
+        // the request recomputes: a pass from 0 draws what a fresh one does
+        const again = try p.keepPass(ids, at, 1);
+        _ = again;
+        try p.settle();
+        try testing.expect(p.lead0().side.store.presence(key) and p.fol.?.side.store.presence(key));
+    }
+}
+
+test "restores refused for capacity (the cap of restores in flight, no read slot) are the deferrable ones; a cancel frees every rank's destination" {
+    const gpa = testing.allocator;
+    var p: rig.Pair = undefined;
+    try p.init(gpa, "defer", rig.Pair.settingsFor(1));
+    defer p.deinit();
+    var b1: [2200]u32 = undefined;
+    var b2: [2300]u32 = undefined;
+    const a = rig.idsOf(&b1, 20);
+    const b = rig.idsOf(&b2, 21);
+    const ka = try p.keepPass(a, at, 1);
+    try p.settle();
+    const kb = try p.keepPass(b, at + 64, 2);
+    try p.settle();
+    try p.evict(ka.saved);
+    try p.evict(kb.saved);
+    const l = p.lead0();
+    try testing.expect(!l.full());
+    const pa = l.lookup(a, 0, @intCast(a.len - 1), &.{}, 0).?;
+    const pb = l.lookup(b, 0, @intCast(b.len - 1), &.{}, 0).?;
+    // `check`, which the prompt cache asks before it makes room: a point no lookup gave, or at another position, is
+    // refused with nothing read; a's passes
+    try testing.expectError(error.UnknownPoint, l.check(std.math.maxInt(u64), pa.at));
+    try testing.expectError(error.BadPoint, l.check(pa.id, pa.at + 64));
+    try l.check(pa.id, pa.at);
+    try testing.expectEqual(@as(usize, 0), l.side.rxs.count());
+    const job = try l.begin(pa.id, pa.at, false);
+    try p.sink.take(&p.r[1]);
+    // one restore in flight is the cap: full before any room is made, and a begin refused for capacity
+    try testing.expect(l.full());
+    try testing.expectError(error.TooManyRestores, l.begin(pb.id, pb.at, false));
+    try testing.expect(std.mem.indexOfScalar(anyerror, &capacity_errors, error.TooManyRestores) != null);
+    // with a wider cap the store's one restore slot is the bound (NoSlot or TooMany: the store's capacity refusals)
+    l.max_restores = 2;
+    const second: anyerror = if (l.begin(pb.id, pb.at, false)) |_| error.TestBegun else |e| e;
+    try testing.expect(second == error.TooMany or second == error.NoSlot);
+    try testing.expect(std.mem.indexOfScalar(anyerror, &capacity_errors, second) != null);
+    l.max_restores = 1;
+    // a cancel: every rank's destination goes, the point stays everywhere, and the next begin goes through
+    l.cancel(job);
+    try p.sink.take(&p.r[1]);
+    try testing.expectEqual(@as(usize, 0), p.e[0].snaps + p.e[1].snaps);
+    try testing.expectEqual(@as(usize, 0), p.fol.?.restores.count());
+    try testing.expect(l.side.store.presence(pointKey(a[0..at])) and p.fol.?.side.store.presence(pointKey(a[0..at])));
+    // (the read slot comes back once the cancelled read's blocks finish)
+    var r: tier.Poll = undefined;
+    var i: usize = 0;
+    while (i < 5000) : (i += 1) {
+        r = p.restore(b) catch |e| switch (e) {
+            error.NoSlot, error.TooMany => {
+                std.Io.sleep(testing.io, .fromMilliseconds(1), .awake) catch {};
+                continue;
+            },
+            else => return e,
+        };
+        break;
+    }
+    try testing.expect(r == .ready);
+    // a rank 1 at its keep floor cannot reserve: validate fails there (reserve), every rank aborts, the point stays
+    try p.evict(r.ready.saved);
+    p.e[1].refuse_dest = true;
+    const f = try p.restore(b);
+    try testing.expect(f == .failed);
+    try testing.expectEqual(error.SpillReserve, f.failed);
+    try testing.expect(l.side.store.presence(pointKey(b[0 .. at + 64])));
+    try testing.expectEqual(@as(usize, 0), p.e[0].snaps + p.e[1].snaps);
+}
+
+/// prompt_cache.capacity_errors (glm_cuda cannot import the engine API; native/cuda.zig's test checks the two agree).
+const capacity_errors = [_]anyerror{ error.TierFull, error.TooManyRestores, error.TooMany, error.NoSlot, error.Busy };
+
+test "the release guard holds a released state while its write still reads it; past its limit the rest is staged at the release" {
+    const gpa = testing.allocator;
+    var p: rig.Pair = undefined;
+    var s = rig.Pair.settingsFor(1);
+    s.stage_mib = 52; // a tail's slot and two whole blocks at once (the rest staged at a release)
+    try p.init(gpa, "guard", s);
+    defer p.deinit();
+    var b1: [4300]u32 = undefined;
+    const a = rig.idsOf(&b1, 30);
+    // copies take a few polls to complete on both ranks: the write is still reading the state when it is released
+    p.e[0].delay = 3;
+    p.e[1].delay = 3;
+    const k = try p.keepPass(a, 4224, 1); // two whole blocks and a tail
+    const snap0 = @as(*rig.Lanes.Kept, @ptrCast(@alignCast(k.saved))).snap;
+    try testing.expect(p.lead0().side.store.pins(st.sourceOf(snap0.id), 0));
+    try p.evict(k.saved);
+    // held on rank 0 (its buffer alive past the cache's free), and on rank 1 at the `.drop` note
+    try testing.expectEqual(@as(usize, 1), p.lead0().side.guard.held.items.len);
+    try testing.expectEqual(@as(usize, 1), p.fol.?.side.guard.held.items.len);
+    try testing.expectEqual(@as(usize, 2), p.e[0].snaps + p.e[1].snaps);
+    try p.settle();
+    // let go once the blocks are staged and copied; the point published on both
+    try testing.expectEqual(@as(usize, 0), p.lead0().side.guard.held.items.len + p.fol.?.side.guard.held.items.len);
+    try testing.expectEqual(@as(usize, 0), p.e[0].snaps + p.e[1].snaps);
+    const key = pointKey(a[0..4224]);
+    try testing.expect(p.lead0().side.store.presence(key) and p.fol.?.side.store.presence(key));
+    // past the limit: the rest staged at the release (waited for there), the buffer freed by the cache's free
+    p.lead0().side.guard.limit = 0;
+    p.fol.?.side.guard.limit = 0;
+    var b2: [4300]u32 = undefined;
+    const b = rig.idsOf(&b2, 31);
+    const kb = try p.keepPass(b, 4224, 2);
+    try p.evict(kb.saved);
+    try testing.expectEqual(@as(usize, 0), p.e[0].snaps + p.e[1].snaps);
+    try p.settle();
+    const key_b = pointKey(b[0..4224]);
+    try testing.expect(p.lead0().side.store.presence(key_b) and p.fol.?.side.store.presence(key_b));
+    try testing.expect(p.lead0().side.store.counts().guard_staged >= 1);
+    const r = try p.restore(b);
+    try testing.expect(r == .ready);
+    const firsts = try p.resumeBoth(b, r.ready.saved, 4224);
+    try testing.expectEqual(HostEngine.first(b), firsts[0]);
+    try testing.expectEqual(HostEngine.first(b), firsts[1]);
+}
+
+test "a clean stop: rank 0's flush drains every rank's writes before it returns, and a restart finds them" {
+    const gpa = testing.allocator;
+    var p: rig.Pair = undefined;
+    try p.init(gpa, "flush", rig.Pair.settingsFor(1));
+    defer p.deinit();
+    var b1: [2200]u32 = undefined;
+    const a = rig.idsOf(&b1, 40);
+    _ = try p.keepPass(a, at, 1);
+    // nothing pumped yet: the flush stages, writes and publishes on both ranks (rank 1's at the `flush` note, before
+    // it answers the stats ask that ends rank 0's flush)
+    try testing.expectEqual(@as(u64, 0), p.lead0().flush(10 * std.time.ns_per_s));
+    try testing.expectEqual(@as(u64, 1), p.lead0().side.store.counts().points);
+    try testing.expectEqual(@as(u64, 1), p.fol.?.side.store.counts().points);
+    try testing.expectEqual(@as(u64, 1), p.lead0().peers[0].points);
+    try p.restart();
+    try testing.expect((try p.restore(a)) == .ready);
+}
+
+test "keeps and lookups under the minimum or off the grid write and find nothing; a lineage the keep note cannot carry is not written" {
+    const gpa = testing.allocator;
+    var p: rig.Pair = undefined;
+    var s = rig.Pair.settingsFor(1);
+    s.min_tokens = 2048;
+    try p.init(gpa, "rules", s);
+    defer p.deinit();
+    var b1: [2200]u32 = undefined;
+    const a = rig.idsOf(&b1, 50);
+    // under the minimum: written on no rank (no keep note either)
+    const k1 = try p.keepPass(a, 1024, 1);
+    try testing.expect(k1.point == null);
+    try testing.expectEqual(@as(u64, 0), p.lead0().side.store.counts().queued + p.fol.?.side.store.counts().queued);
+    try testing.expect(p.lead0().keep(.{ .saved = k1.saved, .key = a, .at = 2000 }) == null); // off the grid
+    // a lineage longer than a keep note carries: not written (no rank holds a point another lacks)
+    const k2 = try p.keepPass(a, 2048, 1);
+    try testing.expect(k2.point != null);
+    var forks: [wire.max_forks + 2]tier.Fork = undefined;
+    for (&forks, 0..) |*f, i| f.* = .{ .name = i + 1, .at = @intCast(i) };
+    try testing.expect(p.lead0().keep(.{ .saved = k2.saved, .key = a, .at = 2048, .lineage = &forks }) == null);
+    try p.settle();
+    // found on its grid only, under max_at, and on the request's chunk starts when it names any
+    try testing.expect(p.lead0().lookup(a, 0, 2047, &.{}, 0) == null);
+    try testing.expectEqual(@as(u32, 2048), p.lead0().lookup(a, 0, 2100, &.{}, 0).?.at);
+    try testing.expect(p.lead0().lookup(a, 0, 2100, &.{ 64, 1024 }, 0) == null);
+    try testing.expectEqual(@as(u32, 2048), p.lead0().lookup(a, 0, 2100, &.{ 64, 2048 }, 0).?.at);
+}
+
+test "a lookup with chunk starts finds the longest point on one of them, under a longer point off them" {
+    const gpa = testing.allocator;
+    var p: rig.Pair = undefined;
+    try p.init(gpa, "starts", rig.Pair.settingsFor(1));
+    defer p.deinit();
+    var b1: [4300]u32 = undefined;
+    const a = rig.idsOf(&b1, 55);
+    _ = try p.keepPass(a, 2048, 1);
+    try p.settle();
+    _ = try p.keepPass(a, 4160, 1); // (an earlier turn's end, off this request's chunk starts)
+    try p.settle();
+    const l = p.lead0();
+    try testing.expectEqual(@as(?u32, 4160), if (l.lookup(a, 0, 4200, &.{}, 0)) |x| x.at else null);
+    try testing.expectEqual(@as(?u32, 2048), if (l.lookup(a, 0, 4200, &.{ 2048, 4096 }, 0)) |x| x.at else null);
+    try testing.expectEqual(@as(?u32, 2048), if (l.lookup(a, 0, 4200, &.{ 4096, 64, 2048 }, 0)) |x| x.at else null); // (in any order)
+    try testing.expect(l.lookup(a, 0, 4200, &.{ 64, 4096 }, 0) == null);
+    try testing.expect(l.lookup(a, 2048, 4200, &.{ 2048, 4096 }, 0) == null); // (only past `beyond`)
+    // the point found restores on both ranks
+    const pt = l.lookup(a, 0, 4200, &.{ 2048, 4096 }, 0) orelse return error.TestNoPoint;
+    const job = try l.begin(pt.id, pt.at, pt.shared);
+    try p.sink.take(&p.r[1]);
+    var r: tier.Poll = .{ .pending = .{} };
+    var i: usize = 0;
+    while (r == .pending and i < 10_000) : (i += 1) {
+        r = l.poll(job, 5 * std.time.ns_per_ms);
+        try p.sink.take(&p.r[1]);
+        if (r == .pending) std.Io.sleep(testing.io, .fromMilliseconds(1), .awake) catch {};
+    }
+    try testing.expect(r == .ready);
+    try testing.expectEqual(@as(u32, 2048), @as(*rig.Lanes.Kept, @ptrCast(@alignCast(r.ready.saved))).at);
+}
+
+test "a keep that cannot record its point queues no write: nothing reads a state the prompt cache then frees without a release" {
+    const gpa = testing.allocator;
+    var p: rig.Pair = undefined;
+    try p.init(gpa, "keep-oom", rig.Pair.settingsFor(1));
+    defer p.deinit();
+    var b1: [2200]u32 = undefined;
+    const a = rig.idsOf(&b1, 56);
+    // rank 0's point table cannot grow: the keep is null on every rank (the cache records no point, so never releases)
+    p.lead0().gpa = testing.failing_allocator;
+    const got = p.keepPass(a, at, 1);
+    p.lead0().gpa = gpa;
+    const k = try got;
+    try testing.expect(k.point == null);
+    try testing.expectEqual(@as(usize, 0), p.lead0().side.writes.count());
+    try testing.expectEqual(@as(u64, 0), p.lead0().side.store.counts().pending_jobs + p.fol.?.side.store.counts().pending_jobs);
+    // freed by the family's drop alone on both ranks; nothing stages from it after
+    p.hooks.drop(p.hooks.ptr, k.saved);
+    try p.sink.take(&p.r[1]);
+    try testing.expectEqual(@as(usize, 0), p.e[0].snaps + p.e[1].snaps);
+    try p.settle();
+    try testing.expectEqual(@as(u64, 0), p.lead0().side.store.counts().points + p.fol.?.side.store.counts().points);
+    // the next keep of it writes on both
+    try testing.expect((try p.keepPass(a, at, 1)).point != null);
+    try p.settle();
+    const key = pointKey(a[0..at]);
+    try testing.expect(p.lead0().side.store.presence(key) and p.fol.?.side.store.presence(key));
+}
+
+test "every rank's counters are asked for only after rank 0 sent the others something: an idle pair asks nothing" {
+    const gpa = testing.allocator;
+    var p: rig.Pair = undefined;
+    try p.init(gpa, "stats", rig.Pair.settingsFor(1));
+    defer p.deinit();
+    const l = p.lead0();
+    // the first pump asks (the stores recovered their points at open); then nothing moved
+    l.pump(1);
+    try testing.expectEqual(@as(usize, 1), p.pg.asks);
+    for (0..5) |_| {
+        l.stats_at = 0; // (as if a second passed)
+        l.pump(1);
+        try p.sink.take(&p.r[1]);
+    }
+    try testing.expectEqual(@as(usize, 1), p.pg.asks);
+    // a keep: asked again until an answer shows rank 1's write done, then idle again
+    var b1: [2200]u32 = undefined;
+    const a = rig.idsOf(&b1, 57);
+    _ = try p.keepPass(a, at, 1);
+    try p.settle();
+    var i: usize = 0;
+    while (l.peer_writes and i < 1000) : (i += 1) {
+        l.stats_at = 0;
+        l.pump(1);
+        try p.sink.take(&p.r[1]);
+    }
+    try testing.expect(!l.peer_writes);
+    const asked = p.pg.asks;
+    try testing.expect(asked > 1);
+    var counts: [2]tier.Counts = undefined;
+    try testing.expectEqual(@as(usize, 2), l.counts(&counts));
+    try testing.expectEqual(@as(u64, 1), counts[1].writes_committed);
+    for (0..5) |_| {
+        l.stats_at = 0;
+        l.pump(1);
+        try p.sink.take(&p.r[1]);
+    }
+    try testing.expectEqual(asked, p.pg.asks);
+    // a touch is sent: the next pump asks once
+    l.touch(tier.pointId(pointKey(a[0..at])));
+    l.stats_at = 0;
+    l.pump(1);
+    try p.sink.take(&p.r[1]);
+    try testing.expectEqual(asked + 1, p.pg.asks);
+}
+
+test "the staging plan: the ring, read-ahead and small states as asked; under two write blocks refused" {
+    const l = try rig.testLayout();
+    const p = try tier.plan(.{ .dir = "/s", .gib = 1 }, &l);
+    try testing.expectEqual(@as(usize, 21), p.write); // 256 MiB of 12,705,792-byte blocks (Python's ring)
+    try testing.expectEqual(@as(usize, 16), p.read);
+    try testing.expectEqual(@as(usize, 4), p.small);
+    try testing.expectEqual(@as(usize, 2), p.restore);
+    try testing.expectEqual(@as(usize, l.block_bytes), p.block_slot);
+    try testing.expectEqual(std.mem.alignForward(usize, l.small_bytes, 4096), p.small_slot);
+    try testing.expectEqual(@as(usize, 21 + 16 + 4 + 2 + 1), tier.eventCount(p));
+    try testing.expectError(error.StagingTooSmall, tier.plan(.{ .dir = "/s", .gib = 1, .stage_mib = 20 }, &l));
+    try testing.expectError(error.StagingTooSmall, tier.plan(.{ .dir = "/s", .gib = 1, .read_blocks = 0 }, &l));
+    // with DFlash2's rings the small slot grows by the drafter's 22,282,240 bytes
+    const d = try st.Layout.init(l.g, 64, .{ .kv = 4, .ring = 2176 });
+    try testing.expectEqual(std.mem.alignForward(usize, l.small_bytes + 22_282_240, 4096), (try tier.plan(.{ .dir = "/s", .gib = 1 }, &d)).small_slot);
+}
+
+test "spill v2 off: a two-rank pass with no tier sends only the pass's note, writes nothing and allocates no staging" {
+    const gpa = testing.allocator;
+    const layout = try rig.testLayout();
+    var e0 = HostEngine.init(gpa, layout);
+    defer e0.deinit();
+    var e1 = HostEngine.init(gpa, layout);
+    defer e1.deinit();
+    var r0 = rig.Lanes.init(gpa, &e0, true, 1 << 20, 8);
+    defer r0.deinit();
+    var r1 = rig.Lanes.init(gpa, &e1, true, 1 << 20, 8);
+    defer r1.deinit();
+    r1.follower = true;
+    var sink: rig.Sink = .{ .gpa = gpa };
+    defer sink.deinit();
+    r0.notes = sink.notesOf();
+    const hooks = r0.cacheHooks(1 << 40, .{}, 0, 5);
+    var buf: [2200]u32 = undefined;
+    const ids = rig.idsOf(&buf, 60);
+    const A = struct {
+        hooks: lane_backend.CacheHooks,
+        fn at(ptr: *anyopaque, _: *lanes.Stream, mark: u32) void {
+            const a: *@This() = @ptrCast(@alignCast(ptr));
+            _ = a.hooks.save(a.hooks.ptr, null, mark) catch return;
+        }
+    };
+    var a: A = .{ .hooks = hooks };
+    var s0 = try lanes.Stream.init(gpa, .{ .id = "o", .prompt = ids, .max_new = 4, .reuse = .{ .marks = &.{at}, .hook = .{ .ptr = &a, .at = A.at } } });
+    defer s0.deinit(gpa);
+    var s1 = try lanes.Stream.init(gpa, .{ .id = "o", .prompt = ids, .max_new = 4, .reuse = .{ .marks = &.{at} } });
+    defer s1.deinit(gpa);
+    try rig.Lanes.prefillFn(&r0, &s0);
+    try rig.Lanes.prefillFn(&r1, &s1);
+    try testing.expectEqual(@as(usize, 1), sink.notes.items.len);
+    try testing.expectEqual(@as(u8, @backingInt(lane_backend.Note.pass)), sink.notes.items[0][0]);
+    try testing.expectEqual(@as(usize, 0), sink.flushes);
+    try sink.take(&r1);
+    try testing.expect(r1.savedFor(r0.kept.items[0].key) != null);
+    try testing.expectEqual(@as(usize, 0), e0.events.len + e1.events.len);
+    rig.Lanes.releaseFn(&r0, &s0);
+    rig.Lanes.releaseFn(&r1, &s1);
+}
diff --git a/zig/src/families/glm_cuda/cuda_spill_wire.zig b/zig/src/families/glm_cuda/cuda_spill_wire.zig
new file mode 100644
index 0000000000000000000000000000000000000000..04d3bc3985ca1f44bf7816eaef5614bdb4038ac5
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_spill_wire.zig
@@ -0,0 +1,501 @@
+//! Spill v2's messages between the ranks of a GLM pair: rank 0's decisions for every rank's disk tier, in the order its
+//! calls make them. Port of wojo's GLM 0110 (PR #124: HAS, LOAD, LOADPART, LOADED, FLUSH) in the shape of the DeepSeek
+//! port's rank_wire.zig, but carried by Flash Next's mirror (cuda_mirror.zig) instead of a wire of its own: rank 1
+//! replays rank 0's calls from one ordered record stream, so a message needs no sequence number, epoch or reply frame.
+//! Two kinds:
+//!   - notes (one-way): the lane backend's `.tier` note (cuda_lanes.Note) in the mirror's next batch, or at once when
+//!     rank 0 flushes them (a restore's progress, staged writes and the flush must not wait for the next collective:
+//!     rank 1 has no idle hook, it waits in a receive);
+//!   - asks: the mirror's `spill` call, sent at once; every rank then gives `width` words to one all-gather
+//!     (cuda_lanes.Gate.gather) and acts on every rank's words in rank order, so all reach the same verdict
+//!     (`presence`, `validation`). A rank whose own step failed answers with its failure, never skips the gather.
+//! A message is op u8, then its fields in this order, little endian, no padding, nothing after it:
+//!   keep      kept u64, at u32, point [32], group u64, shared u8, root [16], part opt u32, forks (u32 count, then
+//!             name [16] and at u32 each), origin opt (key [32], at u32)
+//!   begin     txn u64, kept u64, point [32], at u32, blocks u32
+//!   progress  txn u64, upto u32
+//!   cancel    txn u64, why u8 (Failure), forget u8
+//!   touch, share, forget   point [32]
+//!   pump, flush            budget_ns u64
+//!   has       point [32], at u32, blocks u32           (answer: 1 word, an Absence)
+//!   validate  txn u64, shared u8                       (answer: 1 word, a Failure; none is ok)
+//!   stats     nothing                                  (answer: stats_words words, `words` of the tier's counters)
+//! where `opt X` is a u8 (0 absent, 1 present) and then X.
+const std = @import("std");
+const core = @import("core");
+const format = core.spill.format;
+
+pub const Digest = [32]u8;
+
+/// Bumped with any change to the messages or their meaning (the fingerprint's `wire` field carries it, so ranks built
+/// with another protocol refuse to start together).
+pub const version: u16 = 1;
+
+pub const Op = enum(u8) {
+    // notes
+    keep = 1, // write this rank's copy of kept state `kept` (rank 0's key) as point `point`
+    begin = 2, // restore `point` into a new state every rank names `kept`: reserve, then read
+    progress = 3, // rank 0 copied blocks [0, upto) of restore `txn`: copy this rank's that far
+    cancel = 4, // restore `txn` ends without a commit (cancelled, or failed on rank 0 before validate)
+    touch = 5, // the point was resumed (its last use)
+    share = 6, // the point became a shared prefix
+    forget = 7, // drop the point, published or queued
+    pump = 8, // rank 0 staged its queued writes for `budget_ns`: stage this rank's as long
+    flush = 9, // a clean stop: stage and drain this rank's writes within `budget_ns`
+    // asks
+    has = 16, // does this rank hold every block of the point, published?
+    validate = 17, // did this rank's copies of restore `txn` pass their checks?
+    stats = 18, // this rank's counters
+    _,
+};
+
+/// A rank's answer to `has` (DeepSeek rank_wire's codes): present, else why not.
+pub const Absence = enum(u8) {
+    present = 0,
+    missing = 1, // not held (pruned by this rank's cap, floor or turns; a write it cancelled or never made)
+    incompatible = 2, // held under another layout or compat
+    incomplete = 3, // this rank's own write of it is still queued (it will be there shortly)
+    damaged = 4, // its copy failed a check
+    disabled = 5, // this rank runs without the tier
+    _,
+};
+
+/// Why a restore failed on a rank (a `validate` answer, a `cancel`'s reason); none: it passed.
+pub const Failure = enum(u8) {
+    none = 0,
+    presence = 1, // a rank lacked the point (has)
+    reserve = 2, // the destination could not be made
+    read = 3, // a disk read failed
+    crc = 4, // a block or the small state failed its CRC or digest
+    truncated = 5, // a file was shorter than its manifest
+    missing = 6, // a file was gone
+    cancelled = 7, // the request went away
+    timeout = 8, // this rank's own copy bound passed (an answer, not silence)
+    unpack = 9, // a block or the small state did not install
+    superseded = 10, // a better source appeared
+    shutdown = 11,
+    unknown = 12, // this rank holds no restore by that txn
+    _,
+};
+
+/// Whether a failure is damage to the stored point: every rank then forgets it (DeepSeek spill_tier `damage`).
+pub fn damage(why: Failure) bool {
+    return switch (why) {
+        .crc, .truncated, .missing, .unpack => true,
+        else => false,
+    };
+}
+
+pub const Keep = struct {
+    kept: u64,
+    at: u32,
+    /// format.pointKey of the state's ids (lineage-free): the follower writes its copy only when its own ids give it
+    point: Digest,
+    group: u64,
+    shared: bool,
+    /// the store's lineage of the write (its forks live in the decode arena)
+    lineage: format.Lineage,
+    origin: ?format.Origin = null,
+};
+pub const Begin = struct { txn: u64, kept: u64, point: Digest, at: u32, blocks: u32 };
+pub const Progress = struct { txn: u64, upto: u32 };
+pub const Cancel = struct { txn: u64, why: Failure, forget: bool };
+pub const Has = struct { point: Digest, at: u32, blocks: u32 };
+pub const Validate = struct { txn: u64, shared: bool };
+
+pub const Msg = union(enum) {
+    keep: Keep,
+    begin: Begin,
+    progress: Progress,
+    cancel: Cancel,
+    touch: Digest,
+    share: Digest,
+    forget: Digest,
+    pump: u64,
+    flush: u64,
+    has: Has,
+    validate: Validate,
+    stats,
+
+    pub fn op(m: Msg) Op {
+        return switch (m) {
+            inline else => |_, tag| @field(Op, @tagName(tag)),
+        };
+    }
+
+    /// The words each rank answers an ask with (null: a note, no answer).
+    pub fn width(m: Msg) ?usize {
+        return switch (m) {
+            .has, .validate => 1,
+            .stats => stats_words,
+            else => null,
+        };
+    }
+};
+
+/// The most words a rank answers with (`stats`): a count, then the counters.
+pub const stats_words = 64;
+/// The most ranks an ask's gather holds (cuda_comm.max_world).
+pub const max_world = 4;
+
+/// A forks count past this is refused (core/spill format.Limits' default).
+pub const max_forks = 4096;
+
+// -- encoding -----------------------------------------------------------------------------------------------------
+
+const Out = struct {
+    list: *std.ArrayList(u8),
+    gpa: std.mem.Allocator,
+
+    fn int(o: Out, comptime T: type, v: T) !void {
+        var b: [@sizeOf(T)]u8 = undefined;
+        std.mem.writeInt(T, &b, v, .little);
+        try o.list.appendSlice(o.gpa, &b);
+    }
+    fn flag(o: Out, v: bool) !void {
+        try o.int(u8, @intFromBool(v));
+    }
+    fn bytes(o: Out, b: []const u8) !void {
+        try o.list.appendSlice(o.gpa, b);
+    }
+};
+
+/// `m`'s bytes, appended to `list`.
+pub fn encode(list: *std.ArrayList(u8), gpa: std.mem.Allocator, m: Msg) !void {
+    const o: Out = .{ .list = list, .gpa = gpa };
+    try o.int(u8, @backingInt(m.op()));
+    switch (m) {
+        .keep => |k| {
+            if (k.lineage.forks.len > max_forks) return error.TooManyForks;
+            try o.int(u64, k.kept);
+            try o.int(u32, k.at);
+            try o.bytes(&k.point);
+            try o.int(u64, k.group);
+            try o.flag(k.shared);
+            try o.bytes(&k.lineage.root);
+            try o.flag(k.lineage.part != null);
+            if (k.lineage.part) |p| try o.int(u32, p);
+            try o.int(u32, @intCast(k.lineage.forks.len));
+            for (k.lineage.forks) |f| {
+                try o.bytes(&f.name);
+                try o.int(u32, f.at);
+            }
+            try o.flag(k.origin != null);
+            if (k.origin) |g| {
+                try o.bytes(&g.key);
+                try o.int(u32, g.at);
+            }
+        },
+        .begin => |b| {
+            try o.int(u64, b.txn);
+            try o.int(u64, b.kept);
+            try o.bytes(&b.point);
+            try o.int(u32, b.at);
+            try o.int(u32, b.blocks);
+        },
+        .progress => |p| {
+            try o.int(u64, p.txn);
+            try o.int(u32, p.upto);
+        },
+        .cancel => |c| {
+            try o.int(u64, c.txn);
+            try o.int(u8, @backingInt(c.why));
+            try o.flag(c.forget);
+        },
+        .touch, .share, .forget => |p| try o.bytes(&p),
+        .pump, .flush => |ns| try o.int(u64, ns),
+        .has => |h| {
+            try o.bytes(&h.point);
+            try o.int(u32, h.at);
+            try o.int(u32, h.blocks);
+        },
+        .validate => |v| {
+            try o.int(u64, v.txn);
+            try o.flag(v.shared);
+        },
+        .stats => {},
+    }
+}
+
+// -- decoding -----------------------------------------------------------------------------------------------------
+
+const In = struct {
+    bytes: []const u8,
+    at: usize = 0,
+
+    fn int(i: *In, comptime T: type) !T {
+        const n = @sizeOf(T);
+        if (i.bytes.len - i.at < n) return error.ShortMessage;
+        const v = std.mem.readInt(T, i.bytes[i.at..][0..n], .little);
+        i.at += n;
+        return v;
+    }
+    fn flag(i: *In) !bool {
+        return switch (try i.int(u8)) {
+            0 => false,
+            1 => true,
+            else => error.BadMessage,
+        };
+    }
+    fn fixed(i: *In, comptime n: usize) ![n]u8 {
+        if (i.bytes.len - i.at < n) return error.ShortMessage;
+        defer i.at += n;
+        return i.bytes[i.at..][0..n].*;
+    }
+    /// A position a point ends at (never 0).
+    fn end(i: *In) !u32 {
+        const v = try i.int(u32);
+        return if (v == 0) error.BadMessage else v;
+    }
+};
+
+/// A message's fields; a keep's forks live in `arena`. Refused: an unknown op or value, a flag past 1, a zero position or
+/// block count, a cut message, bytes after it.
+pub fn decode(arena: std.mem.Allocator, bytes: []const u8) !Msg {
+    var i: In = .{ .bytes = bytes };
+    const op: Op = @fromBackingInt(try i.int(u8));
+    const m: Msg = switch (op) {
+        .keep => blk: {
+            var k: Keep = .{ .kept = try i.int(u64), .at = try i.end(), .point = try i.fixed(32), .group = try i.int(u64), .shared = try i.flag(), .lineage = .{ .root = try i.fixed(16) } };
+            if (try i.flag()) k.lineage.part = try i.int(u32);
+            const n = try i.int(u32);
+            // every fork takes 20 bytes: a corrupt count cannot ask for more than the message holds
+            if (n > max_forks or n > (bytes.len - i.at) / 20) return error.ShortMessage;
+            const forks = try arena.alloc(format.Fork, n);
+            for (forks) |*f| f.* = .{ .name = try i.fixed(16), .at = try i.int(u32) };
+            k.lineage.forks = forks;
+            if (try i.flag()) k.origin = .{ .key = try i.fixed(32), .at = try i.int(u32) };
+            break :blk .{ .keep = k };
+        },
+        .begin => .{ .begin = .{ .txn = try i.int(u64), .kept = try i.int(u64), .point = try i.fixed(32), .at = try i.end(), .blocks = try i.end() } },
+        .progress => .{ .progress = .{ .txn = try i.int(u64), .upto = try i.int(u32) } },
+        .cancel => .{ .cancel = .{ .txn = try i.int(u64), .why = try failure(try i.int(u8)), .forget = try i.flag() } },
+        .touch => .{ .touch = try i.fixed(32) },
+        .share => .{ .share = try i.fixed(32) },
+        .forget => .{ .forget = try i.fixed(32) },
+        .pump => .{ .pump = try i.int(u64) },
+        .flush => .{ .flush = try i.int(u64) },
+        .has => .{ .has = .{ .point = try i.fixed(32), .at = try i.end(), .blocks = try i.end() } },
+        .validate => .{ .validate = .{ .txn = try i.int(u64), .shared = try i.flag() } },
+        .stats => .stats,
+        _ => return error.UnknownOp,
+    };
+    if (i.at != bytes.len) return error.TrailingBytes;
+    return m;
+}
+
+fn failure(v: u8) !Failure {
+    const f: Failure = @fromBackingInt(v);
+    return if (std.enums.tagName(Failure, f) == null) error.BadMessage else f;
+}
+
+// -- verdicts -----------------------------------------------------------------------------------------------------
+
+/// What every rank does after an ask, from every rank's answer (the same answers, so the same verdict on every rank).
+pub const Verdict = struct {
+    /// every rank answered yes: the restore goes on (has) or commits (validate)
+    ok: bool,
+    /// every rank drops the point (a rank lacks it or holds it damaged, or a read found it damaged)
+    forget: bool = false,
+    /// the first rank that said no, and what it said (an Absence or a Failure's value)
+    rank: ?u16 = null,
+    code: u8 = 0,
+};
+
+/// `has`, from every rank's Absence (one word each, rank order): every rank holds the point, or no rank restores it.
+/// A rank that lacks it (`missing`), holds it under another layout (`incompatible`) or damaged makes every rank forget
+/// it: rank 0's copy could never restore on the pair, and the next keep writes it again on every rank. One still
+/// writing it (`incomplete`) or running without the tier keeps it. A code this build does not know counts as damaged.
+pub fn presence(codes: []const u64) Verdict {
+    var v: Verdict = .{ .ok = true };
+    for (codes, 0..) |c, r| {
+        const a: Absence = if (c > 255) .damaged else @fromBackingInt(@as(u8, @intCast(c)));
+        if (a == .present) continue;
+        if (v.ok) {
+            v = .{ .ok = false, .rank = @intCast(r), .code = @intCast(@min(c, 255)) };
+        }
+        switch (a) {
+            .incomplete, .disabled => {},
+            else => v.forget = true,
+        }
+    }
+    return v;
+}
+
+/// `validate`, from every rank's Failure (one word each, rank order): the restore commits only when every rank's
+/// copies passed; else every rank aborts it, and every rank forgets the point when any rank's failure is damage.
+pub fn validation(codes: []const u64) Verdict {
+    var v: Verdict = .{ .ok = true };
+    for (codes, 0..) |c, r| {
+        if (c == 0) continue;
+        const f: Failure = if (c > 255) .unpack else @fromBackingInt(@as(u8, @intCast(c)));
+        if (v.ok) v = .{ .ok = false, .rank = @intCast(r), .code = @intCast(@min(c, 255)) };
+        // a code this build does not know: treated as damage, so no rank serves the point again
+        if (damage(f) or std.enums.tagName(Failure, f) == null) v.forget = true;
+    }
+    return v;
+}
+
+/// What a rank without the tier answers an ask with: `disabled` to has (the point is kept elsewhere), `unknown` to
+/// validate, zero counters to stats.
+pub fn disabled(m: Msg, out: []u64) void {
+    @memset(out, 0);
+    switch (m) {
+        .has => out[0] = @backingInt(Absence.disabled),
+        .validate => out[0] = @backingInt(Failure.unknown),
+        else => {},
+    }
+}
+
+/// A struct of u64 counters as an answer's words: its field count, then each field in declaration order.
+pub fn words(comptime T: type, v: *const T, out: []u64) void {
+    const names = @typeInfo(T).@"struct".field_names;
+    comptime std.debug.assert(names.len + 1 <= stats_words);
+    std.debug.assert(out.len >= names.len + 1);
+    @memset(out, 0);
+    out[0] = names.len;
+    inline for (names, 1..) |name, i| out[i] = @field(v, name);
+}
+
+/// The counters `words` wrote (fields past the count it gives stay zero).
+pub fn fromWords(comptime T: type, in: []const u64) T {
+    var v: T = .{};
+    if (in.len == 0) return v;
+    const n: usize = @intCast(@min(in[0], in.len - 1));
+    inline for (@typeInfo(T).@"struct".field_names, 1..) |name, i| {
+        if (i <= n) @field(v, name) = in[i];
+    }
+    return v;
+}
