+    try writeSafetensors(io, tmp.dir, "model/model-00002.safetensors", "{\"a.weight\":{\"dtype\":\"BF16\",\"shape\":[2],\"data_offsets\":[0,4]},\"x\":{}}", "ijkl");
+    const g1 = try build(gpa, io, try testRank(root, a, 1));
