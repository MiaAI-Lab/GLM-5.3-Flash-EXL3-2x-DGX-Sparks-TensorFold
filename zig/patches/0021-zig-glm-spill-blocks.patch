+    try std.testing.expectEqualSlices(u8, &.{ 4, 1, 0, 0, 0, 0, 0, 0, 0, 6, 1 }, list.items);
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
