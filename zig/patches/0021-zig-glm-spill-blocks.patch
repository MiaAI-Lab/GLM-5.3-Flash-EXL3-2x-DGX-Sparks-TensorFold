+    try testing.expect(!std.mem.eql(u8, &f0.rankDigest(), &f1.rankDigest()));
+    try testing.expectEqual(@as(?u16, null), f0.exchange().differs(&f1.exchange()));
+    const named = struct {
+        fn of(x: Fingerprint, y: Fingerprint) ?Field {
