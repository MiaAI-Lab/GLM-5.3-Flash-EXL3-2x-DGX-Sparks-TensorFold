+test "the race's margin grows with the score, so a dropped bound past 2^24 still keeps a gap" {
+    const big: f64 = 1 << 30;
+    try std.testing.expect(raceBound(big) > big); // an absolute 1e-9 would round back to the bound here
+    try std.testing.expectEqual(2.0 + 2.0 * race_margin, raceBound(2.0));
+    try std.testing.expectEqual(-0.5 + race_margin, raceBound(-0.5));
+}
