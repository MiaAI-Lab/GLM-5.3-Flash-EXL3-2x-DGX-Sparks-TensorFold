@@ -188,8 +188,11 @@ pub fn drawSharesWithUnion(gpa: Allocator, sh: Shares, positions: []const u64, s
 /// glm_race_top's kept scores a rank (RACE_KEEP in glm_ops.cu).
 pub const race_keep: usize = 4;
 /// The host's exact score may differ from the GPU's by a few ulp (each side's log is within 1 ulp): a winner closer
-/// than this to the best dropped score is a near tie, drawn from whole shards instead.
+/// than this (relative past 1) to the best dropped score is a near tie, drawn from whole shards instead.
 pub const race_margin: f64 = 1e-9;
+fn raceBound(bound: f64) f64 {
+    return bound + race_margin * @max(1.0, @abs(bound));
+}
 
 /// A draw with no top_p cut and no min_p keeps every token: the race decides it.
